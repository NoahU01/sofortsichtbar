.r--dunkel .bw__v{background:linear-gradient(100deg,#12c4ec,#a93fe8);-webkit-background-clip:text;background-clip:text}
.r-glow--oben{top:20cqi;height:110cqi;background:radial-gradient(closest-side,rgba(134,19,161,.5),rgba(11,159,189,.18) 55%,transparent)}
.r-sprech--mitte{top:50%;transform:translateY(-50%);font-size:19cqi;line-height:.95;letter-spacing:-.05em}
.r-sprech--unten{top:auto;bottom:44cqi}
.r-blase{position:absolute;left:7cqi;right:7cqi;top:46cqi;padding:10cqi 8cqi 11cqi;border-radius:8cqi;background:#fff;color:var(--tinte)}
.r-blase::after{content:"";position:absolute;left:14cqi;bottom:-9cqi;border-style:solid;border-width:9.4cqi 10cqi 0 0;border-color:#fff transparent transparent transparent}
.r-blase .r-sprech{position:static;font-size:11.6cqi;line-height:1;text-shadow:none}
.r-blase .bw__v{background:linear-gradient(100deg,#0b9fbd,#8613a1);-webkit-background-clip:text;background-clip:text}
.an .r-blase{animation:r-pop .35s cubic-bezier(.2,.9,.3,1.2) both}
.r-stapel{left:20cqi;right:20cqi;top:26cqi;height:58cqi}
.an .r-stapel{animation:r-fallen .5s cubic-bezier(.3,1.3,.5,1) both}
.an .r-stapel--weg{animation:r-wegfliegen .7s cubic-bezier(.6,0,.8,.4) 1.2s both}
@keyframes r-fallen{from{transform:translateY(-90cqi) rotate(-8deg)}to{transform:none}}
@keyframes r-wegfliegen{to{transform:translate(110cqi,-30cqi) rotate(38deg);opacity:0}}
.r-uhr{position:absolute;left:50%;top:38cqi;width:62cqi;height:62cqi;margin-left:-31cqi;border-radius:50%;display:grid;place-content:center;text-align:center;background:conic-gradient(#0b9fbd,#8613a1 var(--w,0%),rgba(255,255,255,.1) 0)}
.r-uhr::before{content:"";position:absolute;inset:2.4cqi;border-radius:50%;background:#0b0b12}
.r-uhr b,.r-uhr span{position:relative}
.r-uhr b{font:700 26cqi/.9 "BW Tight",sans-serif;letter-spacing:-.05em}
.r-uhr span{font:600 4.6cqi/1 "BW Inter",sans-serif;color:#a1a1a6}
@property --w{syntax:"<percentage>";inherits:false;initial-value:0%}
.an .r-uhr{animation:r-uhr 1.6s ease-out .2s both}
@keyframes r-uhr{to{--w:100%}}
.rl__video{display:grid;grid-template-columns:minmax(0,9.5rem) minmax(0,1fr);gap:1.2rem;align-items:center;padding:1rem;border-radius:16px;background:#fff;box-shadow:0 0 0 1px #e2e2df}
.rl__video video{display:block;width:100%;aspect-ratio:9/16;border-radius:10px;background:#000}
.rl__video b{font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--grau)}
.rl__video p{margin:.4rem 0 .9rem;font-size:.95rem;line-height:1.45}
.rl__video a{display:inline-block;padding:.6rem 1.1rem;border-radius:99px;background:var(--tinte);color:#fff;font-weight:600;font-size:.9rem;text-decoration:none}
@media (max-width:480px){.rl__video{grid-template-columns:minmax(0,1fr)}.rl__video video{max-width:14rem}}
.bw__serie-kopf{margin-top:clamp(80px,9vw,128px)}
.bw__serie-kopf h2{margin:0;font:700 clamp(2rem,4vw,3.2rem)/1.05 "BW Tight",system-ui,sans-serif;letter-spacing:-.03em}
.bw__serie-kopf p{margin:.9rem 0 0;color:var(--grau);font-size:1rem}
.bw__serie{display:grid;gap:clamp(28px,3vw,44px);margin:clamp(32px,4vw,48px) 0 0;padding:0;list-style:none}
.bw__eintrag{display:grid;grid-template-columns:minmax(0,22rem) minmax(0,1.2fr) minmax(0,1fr);gap:clamp(18px,2vw,28px);align-items:start;padding-top:clamp(28px,3vw,44px);border-top:1px solid #e2e2df}
.bw__bild{position:relative}
.bw__nr{position:absolute;left:-.6rem;top:-.6rem;z-index:3;display:grid;place-items:center;width:2rem;height:2rem;border-radius:50%;background:var(--tinte);color:#fff;font:700 .85rem/1 "BW Inter",sans-serif}
.bw__text{min-width:0;padding:1.1rem 1.2rem 1.2rem;border-radius:16px;background:#fff;box-shadow:0 0 0 1px #e2e2df}
.bw__text-kopf{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:.7rem}
.bw__text-kopf b{font:600 .8rem/1 "BW Inter",sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--grau)}
.bw__text-kopf button{padding:.35rem .75rem;border:0;border-radius:99px;background:var(--hell);color:var(--tinte);font:600 .8rem "BW Inter",sans-serif;cursor:pointer}
.bw__text-kopf button:hover{background:#e8e8ed}
.bw__text-inhalt{white-space:pre-line;color:#2d2d30;font-size:.92rem;line-height:1.55}
@media (max-width:1100px){.bw__eintrag{grid-template-columns:minmax(0,18rem) minmax(0,1fr)}.bw__eintrag .bw__text:last-child{grid-column:2}}
@media (max-width:700px){.bw__eintrag{grid-template-columns:minmax(0,1fr)}.bw__eintrag .bw__text:last-child{grid-column:auto}.bw__bild{max-width:22rem}}

</style>

<section class="bw">
  <div class="bw__in">
    <a class="bw__zurueck" href="/entwicklung/kampagnen/avrg/">← AVRG</a>
    <p class="bw__kicker">AVRG · Black Week · eigene Postings von sofort sichtbar</p>
    <h1>Drei Stile. <span class="bw__v">Je ein Muster.</span></h1>
    <p class="bw__lead">Oben die drei Stile, darunter die Serie mit {{ bw.postings | length }} Postings – jedes mit Text für LinkedIn und einem gemeinsamen Text für Facebook und Instagram. Angebot: die AVRG-Vertriebsstrecke für 39&nbsp;€ statt 89&nbsp;€ im Monat, bis 04.12.</p>

    <div class="bw__reihe">

      <div class="bw__stil">
        <div class="po po--wand" aria-label="Muster Posting-Wand">
          <div class="po__kopf">
            <p class="po__kicker">Neue Altersvorsorge 2027</p>
            <h3>Nur wer gefunden wird, <span class="bw__v">mit dem wird gesprochen.</span></h3>
          </div>
          <div class="po__wand" aria-hidden="true">
            {%- set reihen = [[1,4,7,10,13,16,19],[2,5,8,11,14,17,20],[3,6,9,12,15,18,21],[22,24,26,28,30,23,25]] -%}
            {%- for r in reihen %}
            <div class="po__spalte"><div class="po__band">
              {%- for durchgang in [1,2] %}{% for n in r %}<img src="{{ A }}/black-week/sofort/p{% if n < 10 %}0{% endif %}{{ n }}.webp" alt="" loading="lazy">{% endfor %}{% endfor -%}
            </div></div>
            {%- endfor %}
          </div>
          <div class="po__fuss"></div>
          <span class="po__adresse">sofortsichtbar.de/zielgruppen/avrg</span>
        </div>
        <h2>1 · Die Posting-Wand</h2>
        <p>Zeigt sofort, was man bekommt: die echten Postings aus dem Paket laufen schräg in vier Bahnen. Als Bild oder als kurzes Video.</p>
      </div>

      <div class="bw__stil">
        <div class="po po--schwarz" aria-label="Muster Satz auf Schwarz">
          <div class="po__glow"></div>
          <div class="po__satz">
            <h3>Deine Kunden brauchen jemanden, der Klarheit in die neue Altersvorsorge bringt. <span class="bw__v">Finden sie dich?</span></h3>
          </div>
          <p class="po__aktion">Black Week <b>39 €</b> <s>89 €</s> im Monat</p>
        </div>
        <h2>2 · Der Satz auf Schwarz</h2>
        <p>Eine Aussage aus Sicht der Agentur, groß auf Tiefschwarz wie die Hintergrundbilder. Unten der Aktionspreis, nach dem 04.12. ohne Preis.</p>
      </div>

      <div class="bw__stil">
        <div class="po po--produkt" aria-label="Muster Produkt in der Hand">
          <div class="po__kopf">
            <h3>Deine Bestandskunden landen hier <span class="bw__v">und buchen einen Termin.</span></h3>
          </div>
          <div class="po__buehne">
            <div class="po__glow"></div>
            <div class="po__mac"><div class="po__mac-bild"><img src="{{ A }}/black-week/lp-mac-sofort.webp" alt="AVRG-Landingpage am Rechner"></div><div class="po__mac-fuss"></div></div>
            <div class="po__iphone"><img src="{{ A }}/black-week/lp-iphone-sofort.webp" alt="AVRG-Landingpage auf dem iPhone"></div>
          </div>
          <div class="po__stempel"><b>39 €</b><span>statt <s>89 €</s><br>im Monat</span></div>
        </div>
        <h2>3 · Das Produkt in der Hand</h2>
        <p>Hell, die Landingpage am Rechner und auf dem iPhone, mit Glow. Zeigt, was die Strecke löst: Interessenten und Bestandskunden kommen bis zum Termin.</p>
      </div>

    </div>

    {#- Serie der eigenen Postings (Daniel, 21.11.2026, zweite Fassung): jedes Posting ein eigenes Motiv, Sätze auf Schwarz riesig, Texte gesprochen und direkt. Daten: black-week.11tydata.json (Generator postings_bw2.py) -#}
    <div class="bw__serie-kopf">
      <h2>Die Serie. <span class="bw__v">{{ bw.postings | length }} Postings.</span></h2>
      <p>Jedes Posting mit eigenem Motiv. Die Reihenfolge ist ein Vorschlag. Die beiden Postings mit Preis laufen bis 04.12., alle anderen auch danach.</p>
    </div>
    <ol class="bw__serie">
      {%- for x in bw.postings %}
      {%- set H = x.h | replace("<v>", '<span class="bw__v">') | replace("</v>", "</span>") %}
      <li class="bw__eintrag">
        <div class="bw__bild">
          <span class="bw__nr">{{ x.nr }}</span>
          {%- set U = '<span class="m-url">sofortsichtbar.de/zielgruppen/avrg</span>' %}
          {%- if x.motiv == "satz" %}
          <div class="po m m--schwarz m-satz" aria-label="Posting {{ x.nr }}">
            <div class="m-glow"></div>
            <h3 class="m-riesig">{{ H | safe }}</h3>{{ U | safe }}
          </div>
          {%- elif x.motiv == "suche" %}
          <div class="po m m--weiss m-suche" aria-label="Posting {{ x.nr }}">
            <h3 class="m-k">{{ H | safe }}</h3>
            <div class="m-suche__feld"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M15 15l6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg><span>Altersvorsorgedepot Berater in meiner Nähe</span></div>
            <ol class="m-suche__liste">
              {%- for t in x.treffer %}{% set tt = t.split(" · ") %}<li><small>{{ tt[0] }}</small><b>{{ tt[1] }}</b><i></i></li>{% endfor %}
              <li class="m-suche__leer"><small>Deine Agentur</small><b>Keine Treffer.</b></li>
            </ol>
          </div>
          {%- elif x.motiv == "unterlagen" %}
          <div class="po m m--hell m-unterlagen" aria-label="Posting {{ x.nr }}">
            <div class="m-stapel" aria-hidden="true">
              {%- for s in [3,2,1] %}<div class="m-blatt m-blatt--{{ s }}"><i class="m-blatt__kopf"></i>{% for z in range(0,7) %}<i class="m-blatt__z"></i>{% endfor %}<div class="m-blatt__tab">{% for z in range(0,12) %}<i></i>{% endfor %}</div>{% for z in range(0,5) %}<i class="m-blatt__z"></i>{% endfor %}<span class="m-blatt__seite">Seite {{ 13 - s }} von 12</span></div>{% endfor %}
            </div>
            <h3 class="m-unten">{{ H | safe }}</h3>
          </div>
          {%- elif x.motiv == "chat" %}
          <div class="po m m--petrol m-chat" aria-label="Posting {{ x.nr }}">
            <h3 class="m-k">{{ H | safe }}</h3>
            <div class="m-chat__fenster">
              <div class="m-chat__kopf"><i></i><b>Familie</b><small>Mama, Papa, Lena, Jonas</small></div>
              {%- for c in x.chat %}<p class="m-chat__msg m-chat__msg--{{ c[1] }}">{{ c[0] }}</p>{% endfor %}
            </div>
          </div>
          {%- elif x.motiv == "feed" %}
          <div class="po m m--weiss m-feed" aria-label="Posting {{ x.nr }}">
            <div class="m-feed__gitter" aria-hidden="true">{% for i in range(0,12) %}<div class="m-feed__kachel"><i></i><b>Altersvorsorge&shy;depot</b><span>Jetzt informieren!</span><em></em></div>{% endfor %}</div>
            <div class="m-feed__karte"><h3>{{ H | safe }}</h3></div>
          </div>
          {%- elif x.motiv == "sekunden" %}
          <div class="po m m--schwarz m-sekunden" aria-label="Posting {{ x.nr }}">
            <div class="m-glow"></div>
            <div class="m-sekunden__zahl">2</div>
            <p class="m-sekunden__wort">Sekunden.</p>
            <p class="m-sekunden__satz">So lange hast du im Feed.</p>{{ U | safe }}
          </div>
          {%- elif x.motiv == "spiegel" %}
          <div class="po m m--verlauf m-spiegel" aria-label="Posting {{ x.nr }}">
            <div class="m-spiegel__blase"><h3>{{ H | safe }}</h3></div>{{ U | safe }}
          </div>
          {%- elif x.motiv == "fachbegriffe" %}
          <div class="po m m--weiss m-begriffe" aria-label="Posting {{ x.nr }}">
            <div class="m-begriffe__wolke" aria-hidden="true">{% for b in x.begriffe %}<s class="m-g{{ loop.index % 4 }}">{{ b }}</s>{% endfor %}</div>
            <h3 class="m-unten m-unten--riesig">{{ H | safe }}</h3>
          </div>
          {%- elif x.motiv == "postfach" %}
          <div class="po m m--hell m-postfach" aria-label="Posting {{ x.nr }}">
            <h3 class="m-k">{{ H | safe }}</h3>
            <div class="m-postfach__liste">
              {%- for a in x.absender %}<div class="m-postfach__zeile"><i>{{ a[0] }}</i><b>{{ a }}</b><span>Altersvorsorgedepot: Das ändert sich 2027</span><small>{{ ["9:12","Gestern","Mo.","Fr."][loop.index0] }}</small></div>{% endfor %}
              <div class="m-postfach__zeile m-postfach__leer"><i>?</i><b>Du</b><span>Keine Mail.</span></div>
            </div>
          </div>
          {%- elif x.motiv == "knoepfe" %}
          <div class="po m m--schwarz m-knoepfe" aria-label="Posting {{ x.nr }}">
            <h3 class="m-k">{{ H | safe }}</h3>
            <div class="m-knoepfe__paar"><span class="m-knopf m-knopf--voll">Mitnehmen</span><span class="m-knopf">Abhaken</span></div>{{ U | safe }}
          </div>
          {%- elif x.motiv == "zitat" %}
          <div class="po m m--weiss m-zitat" aria-label="Posting {{ x.nr }}">
            <h3>{{ H | safe }}</h3>
            <p class="m-zitat__quelle">Den Satz hören wir jede Woche.</p>{{ U | safe }}
          </div>
          {%- elif x.motiv == "preis" %}
          <div class="po m m--verlauf m-preis" aria-label="Posting {{ x.nr }}">
            <div class="m-preis__faden" aria-hidden="true"></div>
            <div class="m-preis__schild"><i class="m-preis__loch"></i><small>Black Week</small><b>39&nbsp;€</b><span>statt <s>89&nbsp;€</s> im Monat</span><em>Deine AVRG-Vertriebsstrecke · bis 04.12.</em></div>{{ U | safe }}
          </div>
          {%- elif x.motiv == "countdown" %}
          <div class="po m m--schwarz m-countdown" aria-label="Posting {{ x.nr }}">
            <h3 class="m-k">{{ H | safe }}</h3>
            <div class="m-countdown__paar">
              <div class="m-countdown__feld m-countdown__feld--jetzt"><small>bis 04.12.</small><b>39&nbsp;€</b></div>
              <div class="m-countdown__feld"><small>ab 05.12.</small><b>89&nbsp;€</b></div>
            </div>{{ U | safe }}
          </div>
          {%- elif x.motiv == "kalender" %}
          <div class="po m m--weiss m-kalender" aria-label="Posting {{ x.nr }}">
            <h3 class="m-k">{{ H | safe }}</h3>
            <div class="m-kalender__paar">
              <div class="m-monat"><b>Dezember</b><div class="m-monat__tage">{% for t in range(1,32) %}<i{% if t in [2,5,9,12,16,19] %} class="p"{% endif %}>{{ t }}</i>{% endfor %}</div><small><i class="p"></i> Postings</small></div>
              <div class="m-monat m-monat--voll"><b>Januar</b><div class="m-monat__tage">{% for t in range(1,32) %}<i{% if t not in [1,3,4,10,11,17,18,24,25,31] %} class="t"{% endif %}>{{ t }}</i>{% endfor %}</div><small><i class="t"></i> Termine</small></div>
            </div>
          </div>
          {%- elif x.motiv == "riester" %}
          <div class="po m m--hell m-riester" aria-label="Posting {{ x.nr }}">
            <h3 class="m-k">{{ H | safe }}</h3>
            <div class="m-anruf"><i class="m-anruf__insel"></i><small>Mobil</small><b>Hausbank</b><span>ruft an …</span><p class="m-anruf__notiz">„Ist mein Riester-Vertrag jetzt schlecht?“</p><div class="m-anruf__knoepfe"><i class="ab"></i><i class="an"></i></div></div>
          </div>
          {%- elif x.motiv == "karton" %}
          <div class="po m m--weiss m-karton" aria-label="Posting {{ x.nr }}">
            <h3 class="m-k">{{ H | safe }}</h3>
            <div class="m-karton__box" aria-hidden="true">
              {%- for f in [1,2,3,4] %}<div class="m-flyer m-flyer--{{ f }}"><i></i><b>Altersvorsorgedepot</b><span>Ihre Chance 2027</span></div>{% endfor %}
              <div class="m-karton__front"><i class="m-karton__band"></i><span>Flyer AVRG · 500 Stück</span></div>
            </div>
          </div>
          {%- elif x.motiv == "telefon" %}
          <div class="po m m--hell m-telefon" aria-label="Posting {{ x.nr }}">
            <h3 class="m-k">{{ H | safe }}</h3>
            <div class="m-telefon__buehne"><div class="m-glow m-glow--hell"></div>
              <div class="m-telefon__iphone"><img src="{{ A }}/black-week/lp-iphone-sofort.webp" alt="" loading="lazy"></div>
              <div class="m-telefon__toast"><i></i><div><b>Neuer Termin gebucht</b><span>Do., 08.01. · 10:30 Uhr · Video</span></div></div>
            </div>
          </div>
          {%- elif x.motiv == "farben" %}
          <div class="po m m--weiss m-farben" aria-label="Posting {{ x.nr }}">
            <h3 class="m-k">{{ H | safe }}</h3>
            <div class="m-farben__faecher">{% for f in ["sofort","rot","blau","gruen"] %}<img class="f{{ loop.index }}" src="{{ A }}/black-week/konfig/lp3-{{ f }}.webp" alt="" loading="lazy">{% endfor %}</div>
          </div>
          {%- elif x.motiv == "vergleich" %}
          <div class="po m m--weiss m-vergleich" aria-label="Posting {{ x.nr }}">
            <h3 class="m-k">{{ H | safe }}</h3>
            <div class="m-vergleich__paar">
              <div class="m-seite m-seite--alt"><small>Detailberater</small>{% for z in range(0,9) %}<i></i>{% endfor %}<b>Kunde meldet sich nicht.</b></div>
              <div class="m-seite m-seite--neu"><small>Problemlöser</small><p>Betrifft es dich?</p><p>Wie genau?</p><p>Hast du einen Vorteil?</p><b>Kalender voll.</b></div>
            </div>
          </div>
          {%- elif x.motiv == "mail" %}
          <div class="po m m--petrol m-mail" aria-label="Posting {{ x.nr }}">
            <h3 class="m-k">{{ H | safe }}</h3>
            <div class="m-mail__fenster">
              <div class="m-mail__leiste"><i></i><i></i><i></i></div>
              <p class="m-mail__feld"><small>Von</small>Max Mustermann</p>
              <p class="m-mail__feld"><small>Betreff</small><b>Betrifft Sie das neue Altersvorsorgedepot?</b></p>
              <p class="m-mail__text">Liebe Frau Müller, ab 2027 gibt es eine neue Förderung für die Altersvorsorge. Ob sie für Sie passt, klären wir in 30&nbsp;Minuten.</p>
              <span class="m-mail__knopf">Termin wählen</span>
            </div>
          </div>
          {%- elif x.motiv == "frage" %}
          <div class="po m m--weiss m-frage" aria-label="Posting {{ x.nr }}">
            <h3 class="m-frage__satz">Betrifft <span class="bw__v">mich das?</span></h3>
            <p class="m-frage__unter">Mehr will dein Kunde nicht wissen.</p>{{ U | safe }}
          </div>
          {%- endif %}
        </div>
        <div class="bw__text">
          <div class="bw__text-kopf"><b>LinkedIn</b><button type="button" data-kopie>Kopieren</button></div>
          <div class="bw__text-inhalt" data-text>{{ x.li }}</div>
        </div>
        <div class="bw__text">
          <div class="bw__text-kopf"><b>Facebook und Instagram</b><button type="button" data-kopie>Kopieren</button></div>
          <div class="bw__text-inhalt" data-text>{{ x.fb }}</div>
        </div>
      </li>
      {%- endfor %}
    </ol>

    {#- Reels (Daniel, 21.11.2026): drei Ideen für kurze Videos (Instagram, Facebook, YouTube Shorts über Google Ads), je eigener Stil und eigene Aussage.
        Maßstab: hält den Daumen in der ersten Sekunde an, funktioniert ohne Ton, eine Aussage pro Reel, endet auf der Landingpage. Vorschau läuft als Animation in 9:16. -#}
    <div class="bw__serie-kopf" id="reels">
      <h2>Reels. <span class="bw__v">Drei Ideen.</span></h2>
      <p>Für Instagram, Facebook und YouTube Shorts über Google Ads. Jedes Reel hat einen eigenen Stil und eine eigene Aussage. Links läuft die Vorschau, unter jedem Ablauf liegt das fertige Video mit Stimme zum Anschauen und Herunterladen.</p>
    </div>
    <div class="rl">

      <article class="rl__eintrag">
        <div class="r r--hell" data-reel data-standbild="2" aria-label="Vorschau Reel 1">
          <i class="r-balken"><i></i></i>
