<script>
(function(){
  var euro = function(n){ return Math.round(n).toLocaleString('de-DE') + ' €'; };

  var euro = function(n){ return Math.round(n).toLocaleString('de-DE') + ' €'; };

  /* Rechner nach dem Altersvorsorgereformgesetz (BGBl. I 2026 Nr. 156, §§ 84–86 EStG neu):
     Grundzulage 50 % der Beiträge bis 360 €, 25 % der Beiträge von 360,01 bis 1.800 €;
     Kinderzulage je Kind 100 % der Beiträge, höchstens 300 € pro Kind – für jedes Kind auf denselben Beitrag;
     unter 25 zu Beginn des Beitragsjahres einmalig 200 € mehr; Zulagen erst ab 120 € Mindesteigenbeitrag (Regler ab 10 €/Monat).
     Hochrechnung: nur die Zulage, gleichbleibend bis 67, 5 % im Jahr angenommen,
     Einzahlung zum Jahresende, bewusst gerundet. Einstellwerte schwarz, Ergebnisse rot. */
  var ZINS = 0.05, ZIEL = 67, KG_STANDARD = 18, KG_MAX = 25;
  var beitrag = document.getElementById('beitrag'), alter = document.getElementById('alter'), kinder = 0;
  var $ = function(id){ return document.getElementById(id); };
  var kids = [];   /* je Kind: {alter, bis} – bis = Kindergeld bis (18, höchstens 25) */
  function fuell(r){ r.style.setProperty('--wert', ((r.value - r.min) / (r.max - r.min) * 100) + '%'); }
  /* Ein Doppelschieber je Kind: links das Alter heute, rechts „Kindergeld bis“ */
  function zeichneKinder(){
    while (kids.length < kinder) kids.push({alter: 0, bis: KG_STANDARD});
    kids.length = kinder;
    var box = $('kinder-alter');
    box.innerHTML = kids.map(function (k, i) {
      return '<div class="rk__feld rk__kind" data-i="' + i + '">' +
        '<div class="rk__kopf"><span>Alter Kind ' + (i + 1) + '</span><output class="rk__wert" data-w="alter"></output></div>' +
        '<div class="doppel"><span class="doppel__spur"><span class="doppel__fuell"></span></span>' +
        '<input type="range" min="0" max="' + KG_MAX + '" step="1" value="' + k.alter + '" data-r="alter" aria-label="Alter Kind ' + (i + 1) + '">' +
        '<input type="range" min="0" max="' + KG_MAX + '" step="1" value="' + k.bis + '" data-r="bis" aria-label="Kindergeld bis, Kind ' + (i + 1) + '"></div>' +
        '<div class="doppel__skala"><span class="doppel__lab doppel__alt" data-w="alt"></span><span class="doppel__lab doppel__bis" data-w="bis"></span></div></div>';
    }).join('');
    box.querySelectorAll('.rk__kind').forEach(function (feld) {
      var i = +feld.dataset.i, rA = feld.querySelector('[data-r="alter"]'), rB = feld.querySelector('[data-r="bis"]');
      function zeige(){
        var k = kids[i];
        feld.querySelector('[data-w="alter"]').textContent = k.alter + (k.alter === 1 ? ' Jahr' : ' Jahre');
        /* Beschriftungen fahren unter den Kreisen mit (Kreismitte = 14 px + Anteil der Restbreite).
           Sie bleiben im Kasten und schieben sich bei Berührung auseinander – nie überlappend. */
        var altEl = feld.querySelector('[data-w="alt"]'), bisEl = feld.querySelector('[data-w="bis"]');
        altEl.textContent = 'Alter ' + k.alter;
        bisEl.textContent = 'Kindergeld bis ' + k.bis;
        var W = feld.querySelector('.doppel__skala').clientWidth, wa = altEl.offsetWidth, wb = bisEl.offsetWidth, LUFT = 10;
        var mitte = function (v) { return 14 + (W - 28) * v / KG_MAX; };
        var La = Math.max(0, Math.min(mitte(k.alter) - wa / 2, W - wb - LUFT - wa));
        var Lb = Math.max(La + wa + LUFT, Math.min(mitte(k.bis) - wb / 2, W - wb));
        altEl.style.left = La + 'px'; bisEl.style.left = Lb + 'px';
        var f = feld.querySelector('.doppel__fuell');
        f.style.left = (k.alter / KG_MAX * 100) + '%';
        f.style.width = (Math.max(0, k.bis - k.alter) / KG_MAX * 100) + '%';
      }
      rA.addEventListener('input', function(){ kids[i].alter = +rA.value; zeige(); rechne(); });
      rB.addEventListener('input', function(){
        var v = Math.max(KG_STANDARD, +rB.value); rB.value = v; kids[i].bis = v; zeige(); rechne(); });
      zeige();
    });
  }
  function rechne(){
    var m = +beitrag.value, jahr = m * 12;
    var grund = 0.5 * Math.min(jahr, 360) + 0.25 * Math.max(0, Math.min(jahr, 1800) - 360);
    var jeKind = Math.min(jahr, 300);
    var kind = kinder * jeKind;
    var zulage = grund + kind, summe = jahr + zulage;
    var a = +alter.value, jahre = ZIEL - a;
    var s = function (n) { return n > 0 ? (Math.pow(1 + ZINS, n) - 1) / ZINS : 0; };
    /* Zulagen kommen jeweils am Jahresende und werden erst ab dem Folgejahr verzinst (nachschüssig).
       Grundzulage: jedes Jahr bis 67. Kinderzulage: je Kind nur, solange es Kindergeld gibt –
       danach verzinst sich das Angesparte bis 67 weiter. Startbonus: einmalig unter 25. */
    var bonus = a < 25 ? 200 : 0;
    var end = grund * s(jahre) + bonus * Math.pow(1 + ZINS, jahre - 1);
    var kindJahre = kids.map(function (k) { return Math.max(0, Math.min(k.bis - k.alter, jahre)); });
    kindJahre.forEach(function (n) { end += jeKind * s(n) * Math.pow(1 + ZINS, jahre - n); });
    var stufe = end >= 100000 ? 5000 : end >= 10000 ? 1000 : 10;
    $('beitrag-wert').textContent = m + ' €';
    $('alter-wert').textContent = a + ' Jahre';
    $('kinder').textContent = kinder;
    $('zulage').textContent = euro(zulage);
    $('z-satz').textContent = 'So viel legt der Staat dazu. Mit deinem Beitrag sind das zusammen ' + euro(summe) + ' im Jahr.';
    $('z-eigen').textContent = euro(jahr);
    $('z-grund').textContent = euro(grund);
    $('z-kind').textContent = kinder ? euro(kind) : '–';
    $('z-summe').textContent = euro(summe);
    $('hoch').textContent = euro(Math.round(end / stufe) * stufe);
    var kText = kinder ? ' Die Kinderzulage zählt nur, solange es Kindergeld gibt – in der Regel bis 18, höchstens bis 25 (etwa in Ausbildung oder Studium): ' +
      kindJahre.map(function (n, i) { return 'Kind ' + (i + 1) + ' noch ' + n + (n === 1 ? ' Jahr' : ' Jahre'); }).join(', ') + '. Danach verzinst sich das Angesparte weiter.' : '';
    $('hoch-info').textContent = 'Die Grundzulage von ' + euro(grund) + ' im Jahr' + (bonus ? ' – im ersten Jahr plus 200 € Startbonus, weil du unter 25 bist –' : '') + ' kommt jeweils am Jahresende und wird ab dem Folgejahr mit angenommenen 5 % im Jahr verzinst, ' + jahre + (jahre === 1 ? ' Jahr' : ' Jahre') + ' lang bis 67.' + kText + ' Dein eigener Beitrag ist hier nicht eingerechnet, Kosten und Steuern fehlen. Ein Gefühl für die Größenordnung – keine Prognose und nicht Teil eines Angebots.';
    $('kind-minus').disabled = kinder === 0;
    $('kind-plus').disabled = kinder === 5;
    fuell(beitrag); fuell(alter);
  }
  beitrag.addEventListener('input', rechne);
  alter.addEventListener('input', rechne);
  $('kind-minus').onclick = function(){ kinder = Math.max(0, kinder - 1); zeichneKinder(); rechne(); };
  $('kind-plus').onclick = function(){ kinder = Math.min(5, kinder + 1); zeichneKinder(); rechne(); };
  zeichneKinder();
  rechne();


  /* Terminwahl (Attrappe): die nächsten fünf Werktage, feste Zeiten */
  var tage = document.getElementById('tage'), d = new Date(), n = 0;
  var wt = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
  while (n < 5) {
    d.setDate(d.getDate() + 1);
    if (d.getDay() === 0 || d.getDay() === 6) continue;
    var l = document.createElement('label'); l.className = 'chip';
    l.innerHTML = '<input type="radio" name="tag" value="' + wt[d.getDay()] + ', ' + d.getDate() + '.' + (d.getMonth() + 1) + '."' + (n === 0 ? ' checked' : '') + '><span>' + wt[d.getDay()] + '<small>' + d.getDate() + '.' + (d.getMonth() + 1) + '.</small></span>';
    tage.appendChild(l); n++;
  }
  ['09:00', '10:30', '13:00', '16:30', '18:00'].forEach(function(z, i){
    var l = document.createElement('label'); l.className = 'chip';
    l.innerHTML = '<input type="radio" name="zeit" value="' + z + '"' + (i === 1 ? ' checked' : '') + '><span>' + z + '</span>';
    document.getElementById('zeiten').appendChild(l);
  });
  document.getElementById('buchung-form').addEventListener('submit', function(e){
    e.preventDefault();
    var f = e.target, art = f.art.value;
    document.getElementById('danke-text').textContent = 'Dein Wunschtermin: ' + f.tag.value + ' um ' + f.zeit.value + ' Uhr' + (art === 'Büro' ? ' bei uns im Büro.' : art === 'Video' ? ' per Video. Den Link bekommst du per E-Mail.' : '. Max ruft dich an.');
    document.getElementById('buchung').classList.add('ist-gebucht');
  });

  /* Kopf-Linie beim Scrollen, Haken in der Gesprächskarte, mobiler Knopf */
  var kopf = document.getElementById('kopf'), cta = document.getElementById('mobil-cta'), termin = document.getElementById('termin');
  function scroll(){
    kopf.classList.toggle('ist-gescrollt', window.scrollY > 8);
    var t = termin.getBoundingClientRect();
    cta.classList.toggle('ist-sichtbar', window.scrollY > 600 && (t.top > window.innerHeight || t.bottom < 0));
  }
  window.addEventListener('scroll', scroll, {passive: true}); scroll();
})();
</script>
<script>
/* Auswahl im Aufmacher: Foto, Frage und die drei Punkte wechseln mit der Person */
(function(){
  var P = {"jung": {"bild": "/entwicklung/kampagnen/avrg/assets/fotos/junger-mann.jpg", "label": "Gerade gestartet", "wer": "Anfang 20, erster Job", "frage": "„Lohnt sich das für mich überhaupt schon?“", "punkte": ["Ob sich ein früher Start für dich rechnet", "Was der Startbonus bis 25 für dich bedeutet", "Wie wenig im Monat schon reicht"]}, "familie": {"bild": "/entwicklung/kampagnen/avrg/assets/fotos/vater-kinder.jpg", "label": "Mit Kindern", "wer": "Familie mit zwei Kindern", "frage": "„Was bringt uns das mit Kindern?“", "punkte": ["Welche Zulagen für eure Kinder infrage kommen", "Ob das zu eurem Budget passt", "Was ihr dafür tun müsst – und was nicht"]}, "riester": {"bild": "/entwicklung/kampagnen/avrg/assets/fotos/frau-40.jpg", "label": "Mit Riester-Vertrag", "wer": "Mitte 40, spart seit Jahren", "frage": "„Ist mein Riester-Vertrag jetzt schlecht?“", "punkte": ["Ob du überhaupt etwas tun musst", "Ob sich ein Wechsel für dich lohnen würde", "Warum diese Entscheidung gut überlegt sein will"]}, "selbst": {"bild": "/entwicklung/kampagnen/avrg/assets/fotos/handwerker.jpg", "label": "Selbstständig", "wer": "Eigene Werkstatt", "frage": "„Bin ich diesmal auch dabei?“", "punkte": ["Ob du die Förderung bekommen kannst", "Wie das zu deiner übrigen Vorsorge passt", "Was es dich im Monat kosten würde"]}, "rente": {"bild": "/entwicklung/kampagnen/avrg/assets/fotos/frau-55.jpg", "label": "Rente in Sicht", "wer": "Mitte 50", "frage": "„Lohnt sich das so kurz vor der Rente noch?“", "punkte": ["Ob sich ein Einstieg in deinem Alter noch rechnet", "Wie die Auszahlung später aussehen kann", "Was mit deinen bestehenden Verträgen ist"]}};
  var knoepfe = document.querySelectorAll('.v2-person'), bild = document.getElementById('v2-bild');
  knoepfe.forEach(function(k){
    k.addEventListener('click', function(){
      var p = P[k.dataset.p];
      knoepfe.forEach(function(x){ x.setAttribute('aria-pressed', x === k ? 'true' : 'false'); });
      bild.style.opacity = 0;
      setTimeout(function(){ bild.src = p.bild; bild.style.opacity = 1; }, 180);
      document.getElementById('v2-wer').textContent = p.wer;
      document.getElementById('v2-frage').textContent = p.frage;
      document.getElementById('v2-punkte').innerHTML = p.punkte.map(function(t){ return '<li><svg class="ico" aria-hidden="true"><use href="#i-haken"/></svg>' + t + '</li>'; }).join('');
    });
  });
})();
