  var knoepfe = document.querySelectorAll('.v2-person'), bild = document.getElementById('v2-bild');
  knoepfe.forEach(function(k){
    k.addEventListener('click', function(){
      var p = P[k.dataset.p];
      knoepfe.forEach(function(x){ x.setAttribute('aria-pressed', x === k ? 'true' : 'false'); });
      bild.style.opacity = 0;
      setTimeout(function(){ bild.src = p.bild; bild.style.opacity = 1; }, 180);
      document.getElementById('v2-wer').textContent = p.wer;
      document.getElementById('v2-frage').textContent = p.frage;
      document.getElementById('v2-punkte').innerHTML = p.punkte.map(function(t){ return '<li><svg class="ico" aria-hidden="true"><use href="#i-haken"/></svg>' + t + '</li>'; }).join('');
    });
  });
})();
