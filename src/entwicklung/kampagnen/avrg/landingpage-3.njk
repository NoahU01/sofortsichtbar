          <button type="button" id="kind-plus" aria-label="Ein Kind mehr">+</button>
        </div>
        <p class="regler__hinweis">Unter 25? Dann gibt es einmalig 200 € Startbonus obendrauf.</p>
      </div>
      <div class="beispiele">
        <p>Oder ein Beispiel antippen</p>
        <div class="chips">
          <button type="button" class="beispiel" data-m="150" data-k="0">Single<small>150 € mtl.</small></button>
          <button type="button" class="beispiel" data-m="150" data-k="1">1 Kind<small>150 € mtl.</small></button>
          <button type="button" class="beispiel" data-m="50" data-k="2">2 Kinder<small>50 € mtl.</small></button>
        </div>
      </div>
    </div>
    <div class="rechner__ergebnis" aria-live="polite">
      <p class="kicker">Der Staat legt dazu</p>
      <p class="gross"><span id="zulage">540 €</span><small>im Jahr</small></p>
      <div class="balken" aria-hidden="true">
        <div class="balken__zeile"><span>Dein Beitrag</span><span class="balken__spur"><span class="b-eigen" id="b-eigen"></span></span></div>
        <div class="balken__zeile"><span>Vom Staat</span><span class="balken__spur"><span class="b-staat" id="b-staat"></span></span></div>
      </div>
