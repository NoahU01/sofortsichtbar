    <div class="danke" role="status">
      <span class="rund"><svg class="ico" aria-hidden="true"><use href="#i-haken"/></svg></span>
      <h3>Danke, das passt.</h3>
      <p id="danke-text">Max meldet sich kurz vorher bei dir.</p>
      <p class="attrappe">Entwurf: Es wurde nichts versendet.</p>
    </div>
  </div>
</div></section>

<section class="v3-sek v3-sek--hell" id="faq"><div class="wrap">
  <p class="v3-kicker">Fragen</p>
  <h2 class="v3-h2" style="margin-bottom:clamp(28px,3.4vw,44px)">Kurz beantwortet.</h2>
  <div class="v3-kasten"><div class="faq">
    <details><summary>Ich habe einen Riester-Vertrag. Muss ich jetzt etwas tun?<span class="plus"><svg class="ico" aria-hidden="true"><use href="#i-plus"/></svg></span></summary><p>Nicht sofort. Dein Riester-Vertrag läuft weiter. Ab 2027 kannst du in die neue Förderung wechseln – das ist allerdings eine Entscheidung, die du nicht mehr rückgängig machen kannst. Ob sich der Wechsel für dich lohnt, hängt von deinem Vertrag ab. Genau das schauen wir uns gemeinsam an.</p></details>
    <details><summary>Ab wann gibt es die neue Altersvorsorge?<span class="plus"><svg class="ico" aria-hidden="true"><use href="#i-plus"/></svg></span></summary><p>Die Reform gilt ab dem 1. Januar 2027, die neuen Verträge gibt es ab Januar 2027. Du hast also Zeit, dich jetzt in Ruhe zu orientieren – ohne Hektik zum Jahreswechsel.</p></details>
    <details><summary>Ich bin selbstständig. Betrifft mich das?<span class="plus"><svg class="ico" aria-hidden="true"><use href="#i-plus"/></svg></span></summary><p>Gut möglich – und das ist neu. Bisher waren die meisten Selbstständigen bei der staatlichen Förderung außen vor. Mit der Reform können auch sie Zulagen bekommen. Ob das für dich sinnvoll ist, klären wir im Gespräch.</p></details>
    <details><summary>Muss ich danach etwas abschließen?<span class="plus"><svg class="ico" aria-hidden="true"><use href="#i-plus"/></svg></span></summary><p>Nein. Wenn du einen Vorteil hast, zeigen wir ihn dir und sagen dir, was wir empfehlen. Entscheiden tust du – in Ruhe. Und wenn es für dich nicht passt, sagen wir dir das genauso deutlich.</p></details>
    <details><summary>Was kostet das Gespräch?<span class="plus"><svg class="ico" aria-hidden="true"><use href="#i-plus"/></svg></span></summary><p>Nichts. Das Gespräch ist kostenlos und unverbindlich.</p></details>
    <details><summary>Was soll ich zum Gespräch mitbringen?<span class="plus"><svg class="ico" aria-hidden="true"><use href="#i-plus"/></svg></span></summary><p>Eigentlich nichts. Wenn du schon einen Riester-Vertrag hast, ist es hilfreich, die letzte Jahresmitteilung griffbereit zu haben.</p></details>
  </div>
</div></section>

<section class="v3-sek v3-sek--rot v3-schluss"><div class="wrap">
  <h2 class="v3-h2">Mitnehmen oder abhaken?</h2>
  <p class="v3-lead" style="margin-left:auto;margin-right:auto">In 15 Minuten weißt du es.</p>
  <div class="v3-knoepfe"><a class="knopf knopf--weiss" href="#termin">Ticket einlösen</a></div>
</div></section>

</main>

<footer class="fuss"><div class="wrap"><img src="/entwicklung/kampagnen/avrg/assets/logo-platzhalter.svg" alt="Logo"><nav><a href="#">Impressum</a><a href="#">Datenschutz</a></nav></div></footer>

<div class="mobil-cta" id="mobil-cta"><a class="knopf" href="#termin">Ticket einlösen</a></div>

<script>
(function(){
  var euro = function(n){ return Math.round(n).toLocaleString('de-DE') + ' €'; };

  /* Rechner: Grundzulage 50 ct je € bis 360 €, 25 ct je € von 361 bis 1.800 €;
     Kinderzulage 1 € je eingezahltem €, bis 300 € je Kind (Eckdaten der Reform, Stand 09/2026).
     Balken auf fester Skala (3.000 € = höchster Jahresbeitrag des Reglers), damit
     beide Balken mit dem Beitrag wachsen und die Zulage nie optisch schrumpft. */
  var SKALA = 3000;
  var beitrag = document.getElementById('beitrag'), kinder = 1;
  var beispiele = document.querySelectorAll('.beispiel');
  function rechne(){
    var m = +beitrag.value, jahr = m * 12;
    var grund = 0.5 * Math.min(jahr, 360) + 0.25 * Math.max(0, Math.min(jahr, 1800) - 360);
    var kind = Math.min(jahr, 300 * kinder);
    var zulage = grund + kind;
    document.getElementById('beitrag-wert').innerHTML = m + ' € <small>/ Monat</small>';
    document.getElementById('zulage').textContent = euro(zulage);
    document.getElementById('z-eigen').textContent = euro(jahr);
    document.getElementById('z-grund').textContent = euro(grund);
    document.getElementById('z-kind').textContent = kinder ? euro(kind) : '–';
    document.getElementById('z-summe').textContent = euro(jahr + zulage);
    document.getElementById('b-eigen').style.width = Math.min(100, jahr / SKALA * 100) + '%';
    document.getElementById('b-staat').style.width = Math.min(100, zulage / SKALA * 100) + '%';
    var cent = Math.round(zulage / jahr * 100);
    document.getElementById('satz').innerHTML = 'Auf jeden Euro, den du einzahlst, legt der Staat <b>' + (cent >= 100 ? (cent / 100).toLocaleString('de-DE', {minimumFractionDigits: 2}) + ' €' : cent + ' Cent') + '</b> drauf.';
    var h;
    if (jahr > 1800) h = 'Über 150 € im Monat gibt es keine zusätzliche Grundzulage mehr.';
    else if (jahr <= 360) h = 'Bis 30 € im Monat gibt es 50 Cent auf jeden Euro.';
    else h = 'Ab 150 € im Monat ist die volle Grundzulage erreicht.';
    if (kinder && jahr < 300 * kinder) h = 'Für die volle Kinderzulage braucht es ' + (25 * kinder) + ' € im Monat.';
    document.getElementById('beitrag-hinweis').textContent = h;
    beitrag.style.setProperty('--wert', ((m - beitrag.min) / (beitrag.max - beitrag.min) * 100) + '%');
    document.getElementById('kind-minus').disabled = kinder === 0;
    document.getElementById('kind-plus').disabled = kinder === 5;
    document.getElementById('kinder').textContent = kinder;
    beispiele.forEach(function(b){ b.classList.toggle('ist-aktiv', +b.dataset.m === m && +b.dataset.k === kinder); });
  }
  beispiele.forEach(function(b){ b.onclick = function(){ beitrag.value = b.dataset.m; kinder = +b.dataset.k; rechne(); }; });
  beitrag.addEventListener('input', rechne);
  document.getElementById('kind-minus').onclick = function(){ kinder = Math.max(0, kinder - 1); rechne(); };
  document.getElementById('kind-plus').onclick = function(){ kinder = Math.min(5, kinder + 1); rechne(); };
  rechne();

  /* Terminwahl (Attrappe): die nächsten fünf Werktage, feste Zeiten */
  var tage = document.getElementById('tage'), d = new Date(), n = 0;
  var wt = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
  while (n < 5) {
    d.setDate(d.getDate() + 1);
    if (d.getDay() === 0 || d.getDay() === 6) continue;
    var l = document.createElement('label'); l.className = 'chip';
    l.innerHTML = '<input type="radio" name="tag" value="' + wt[d.getDay()] + ', ' + d.getDate() + '.' + (d.getMonth() + 1) + '."' + (n === 0 ? ' checked' : '') + '><span>' + wt[d.getDay()] + '<small>' + d.getDate() + '.' + (d.getMonth() + 1) + '.</small></span>';
    tage.appendChild(l); n++;
  }
  ['09:00', '10:30', '13:00', '16:30', '18:00'].forEach(function(z, i){
    var l = document.createElement('label'); l.className = 'chip';
    l.innerHTML = '<input type="radio" name="zeit" value="' + z + '"' + (i === 1 ? ' checked' : '') + '><span>' + z + '</span>';
    document.getElementById('zeiten').appendChild(l);
  });
  document.getElementById('buchung-form').addEventListener('submit', function(e){
    e.preventDefault();
    var f = e.target, art = f.art.value;
    document.getElementById('danke-text').textContent = 'Dein Wunschtermin: ' + f.tag.value + ' um ' + f.zeit.value + ' Uhr' + (art === 'Büro' ? ' bei uns im Büro.' : art === 'Video' ? ' per Video. Den Link bekommst du per E-Mail.' : '. Max ruft dich an.');
    document.getElementById('buchung').classList.add('ist-gebucht');
  });

  /* Kopf-Linie beim Scrollen, Haken in der Gesprächskarte, mobiler Knopf */
  var kopf = document.getElementById('kopf'), cta = document.getElementById('mobil-cta'), termin = document.getElementById('termin');
  function scroll(){
    kopf.classList.toggle('ist-gescrollt', window.scrollY > 8);
    var t = termin.getBoundingClientRect();
    cta.classList.toggle('ist-sichtbar', window.scrollY > 600 && (t.top > window.innerHeight || t.bottom < 0));
  }
  window.addEventListener('scroll', scroll, {passive: true}); scroll();
  /* Chat im Telefon startet, sobald es sichtbar ist */
  var tel = document.getElementById('v3-phone');
  if (tel) { if ('IntersectionObserver' in window) { new IntersectionObserver(function(es, o){ es.forEach(function(e){ if (e.isIntersecting) { tel.classList.add('ist-sichtbar'); o.disconnect(); } }); }, {threshold: .35}).observe(tel); } else tel.classList.add('ist-sichtbar'); }

  /* Die Haken auf den Tickets setzen sich, sobald ein Ticket sichtbar wird */
  document.querySelectorAll('.ticket').forEach(function(t){
    if (!('IntersectionObserver' in window)) { t.classList.add('ist-sichtbar'); return; }
    new IntersectionObserver(function(es, o){ es.forEach(function(e){ if (e.isIntersecting) { setTimeout(function(){ t.classList.add('ist-sichtbar'); }, 350); o.disconnect(); } }); }, {threshold: .5}).observe(t);
  });
})();
</script>
</body>
</html>
