---
title: "Strategie-Levels – Entwicklung"
description: "Vier Darstellungsvarianten der Strategie – Zielbild, Stränge und Ergebnisstufen."
permalink: /entwicklung/strategie-levels/index.html
devHeadline: "Strategie-Levels"
devIntro: "Vier Darstellungen derselben Sache. Ein Zielbild, drei Stränge, vier Ergebnisstufen. Eine Stufe ist erst durch, wenn alle drei Stränge ihr Ergebnis erreicht haben."
devWide: true
---
{% set s = strategie %}

{% macro dot(status) %}<span class="dot dot--{{ status }}" aria-hidden="true"></span>{% endmacro %}

{% set varianten = [
  { "id": "ruhig",     "name": "Ruhig",     "info": "Viel Luft, große Typo, kaum Linien" },
  { "id": "zeitstrahl","name": "Zeitstrahl","info": "Alles auf einem Blick, Stufen von links nach rechts" },
  { "id": "gates",     "name": "Tore",      "info": "Jede Stufe endet sichtbar in einem Tor" },
  { "id": "matrix",    "name": "Cockpit",   "info": "Dichteste Form, eine Zeile pro Stufe" }
] %}

<div class="strategie">

  <section class="zielbild">
    <div class="zielbild__kopf">
      <span class="zielbild__marke">Zielbild</span>
      <p class="zielbild__text">{{ s.zielbild.text }}</p>
    </div>
    <ul class="zielbild__punkte">
      {% for p in s.zielbild.punkte %}
        <li><strong>{{ p.label }}</strong> {{ p.text }}</li>
      {% endfor %}
    </ul>
  </section>

  <div class="schalter" role="tablist" aria-label="Darstellungsvariante">
    {% for v in varianten %}
      <button class="schalter__btn" type="button" role="tab"
              data-variante="{{ v.id }}"
              aria-selected="{{ "true" if loop.first else "false" }}">
        <span class="schalter__name">{{ v.name }}</span>
        <span class="schalter__info">{{ v.info }}</span>
      </button>
    {% endfor %}
  </div>

  <div class="legende">
    {% for key, st in s.status %}
      <span class="legende__eintrag">{{ dot(key) }}<b>{{ st.label }}</b> {{ st.beschreibung }}</span>
    {% endfor %}
    <span class="legende__tipp">Auf eine Aufgabe klicken für Details</span>
  </div>


  {# ============ 1 · Ruhig ============ #}
  <div class="v-ruhig" data-panel="ruhig">
    {% for stufe in s.stufen %}
      <article class="ruhig ruhig--{{ stufe.status }}">
        <div class="ruhig__kopf">
          <span class="ruhig__nr">{{ stufe.nr }}</span>
          <div>
            <h3 class="ruhig__titel">{{ stufe.titel }}</h3>
            <p class="ruhig__ergebnis">{{ stufe.ergebnis }}</p>
          </div>
        </div>
        <div class="ruhig__spalten">
          {% for strang in s.straenge %}
            {% set a = stufe.aufgaben[strang.id] %}
            <button class="ruhig__task" type="button" data-open="s{{ stufe.nr }}-{{ strang.id }}">
              <span class="ruhig__strang">{{ strang.kurz }}</span>
              <span class="ruhig__task-titel">{{ a.titel }}</span>
              <span class="ruhig__task-status">{{ dot(a.status) }}{{ s.status[a.status].label }}</span>
            </button>
          {% endfor %}
        </div>
      </article>
    {% endfor %}
  </div>


  {# ============ 2 · Zeitstrahl ============ #}
  <div class="v-zeit" data-panel="zeitstrahl" hidden>
    <div class="zeit" style="--spalten: {{ s.stufen.length }}">
      <div class="zeit__ecke"></div>
      {% for stufe in s.stufen %}
        <div class="zeit__kopf zeit__kopf--{{ stufe.status }}">
          <span class="zeit__nr">Stufe {{ stufe.nr }} · {{ stufe.titel }}</span>
          <span class="zeit__ergebnis">{{ stufe.ergebnis }}</span>
        </div>
      {% endfor %}

      {% for strang in s.straenge %}
        <div class="zeit__lane">
          <span class="zeit__lane-name">{{ strang.label }}</span>
          <span class="zeit__lane-frage">{{ strang.frage }}</span>
        </div>
        {% for stufe in s.stufen %}
          {% set a = stufe.aufgaben[strang.id] %}
          <button class="zeit__zelle zeit__zelle--{{ a.status }}" type="button"
                  data-open="s{{ stufe.nr }}-{{ strang.id }}">
            {{ dot(a.status) }}<span>{{ a.titel }}</span>
          </button>
        {% endfor %}
      {% endfor %}
    </div>
  </div>


  {# ============ 3 · Tore ============ #}
  <div class="v-gates" data-panel="gates" hidden>
    {% for stufe in s.stufen %}
      <section class="gate gate--{{ stufe.status }}">
        <header class="gate__kopf">
          <span class="gate__badge">Stufe {{ stufe.nr }}</span>
          <h3 class="gate__titel">{{ stufe.titel }}</h3>
        </header>

        <div class="gate__karten">
          {% for strang in s.straenge %}
            {% set a = stufe.aufgaben[strang.id] %}
            <button class="karte karte--{{ a.status }}" type="button"
                    data-open="s{{ stufe.nr }}-{{ strang.id }}">
              <span class="karte__strang">{{ strang.label }}</span>
              <span class="karte__titel">{{ a.titel }}</span>
              <span class="karte__ergebnis">{{ a.ergebnis }}</span>
              <span class="karte__status">{{ dot(a.status) }}{{ s.status[a.status].label }}</span>
            </button>
          {% endfor %}
        </div>

        <div class="tor">
          <span class="tor__label">Ergebnisstufe {{ stufe.nr }}</span>
          <span class="tor__text">{{ stufe.ergebnis }}</span>
        </div>
      </section>
    {% endfor %}
  </div>


  {# ============ 4 · Cockpit ============ #}
  <div class="v-matrix" data-panel="matrix" hidden>
    <div class="matrix">
      <div class="matrix__kopf">
        <div class="matrix__kopf-zelle">Ergebnisstufe</div>
        {% for strang in s.straenge %}
          <div class="matrix__kopf-zelle">{{ strang.label }}</div>
        {% endfor %}
      </div>

      {% for stufe in s.stufen %}
        <div class="matrix__zeile matrix__zeile--{{ stufe.status }}">
          <div class="matrix__stufe">
            <span class="matrix__nr">{{ stufe.nr }}</span>
            <span class="matrix__titel">{{ stufe.titel }}</span>
            <span class="matrix__ergebnis">{{ stufe.ergebnis }}</span>
          </div>
          {% for strang in s.straenge %}
            {% set a = stufe.aufgaben[strang.id] %}
            <button class="matrix__task matrix__task--{{ a.status }}" type="button"
                    data-open="s{{ stufe.nr }}-{{ strang.id }}">
              {{ dot(a.status) }}<span>{{ a.titel }}</span>
            </button>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>


  {# ============ Details (für alle Varianten) ============ #}
  {% for stufe in s.stufen %}
    {% for strang in s.straenge %}
      {% set a = stufe.aufgaben[strang.id] %}
      <dialog class="dlg" id="dialog-s{{ stufe.nr }}-{{ strang.id }}">
        <div class="dlg__inner">
          <div class="dlg__kopf">
            <span class="dlg__herkunft">{{ strang.label }} · Stufe {{ stufe.nr }} {{ stufe.titel }}</span>
            <button class="dlg__close" type="button" data-close aria-label="Schließen">&times;</button>
          </div>

          <div class="dlg__titel-zeile">
            <h3 class="dlg__titel">{{ a.titel }}</h3>
            <span class="dlg__status">{{ dot(a.status) }}{{ s.status[a.status].label }}</span>
          </div>

          <div class="dlg__block">
            <h4>Erreicht, wenn</h4>
            <p>{{ a.ergebnis }}</p>
          </div>

          {% if a.details.length %}
            <div class="dlg__block">
              <h4>Inhalte</h4>
              <ul>{% for d in a.details %}<li>{{ d }}</li>{% endfor %}</ul>
            </div>
          {% endif %}

          {% if a.braucht %}
            <div class="dlg__block">
              <h4>Setzt voraus</h4>
              <p>{{ a.braucht }}</p>
            </div>
          {% endif %}

          {% if a.offen.length %}
            <div class="dlg__block">
              <h4>Offen</h4>
              <ul class="dlg__offen">{% for o in a.offen %}<li>{{ o }}</li>{% endfor %}</ul>
            </div>
          {% endif %}

          <div class="dlg__fuss">
            <span>Ergebnis der ganzen Stufe {{ stufe.nr }}:</span> {{ stufe.ergebnis }}
          </div>
        </div>
      </dialog>
    {% endfor %}
  {% endfor %}

  <p class="strategie__hinweis">{{ s.hinweis }}</p>

</div>
