---
title: "Strategie-Levels – Entwicklung"
description: "Vier Konzepte, wie sich die Strategie darstellen lässt."
permalink: /entwicklung/strategie-levels/index.html
devHeadline: "Strategie-Levels"
devIntro: "Vier Konzepte auf eigenen Seiten. Sie zeigen dieselben 22 Schritte, beantworten aber je eine andere Frage. Zum Aussuchen und Verwerfen."
devWide: true
---
{%- set g = strategieGraph -%}

<div class="hub">

  <div class="hub__stand">
    <div>
      <span class="hub__zahl">{{ g.anzahl }}</span>
      <span class="hub__label">Schritte</span>
    </div>
    <div>
      <span class="hub__zahl">{{ g.machbar.length }}</span>
      <span class="hub__label">jetzt machbar</span>
    </div>
    <div>
      <span class="hub__zahl">{{ g.blockiert.length }}</span>
      <span class="hub__label">blockiert</span>
    </div>
    <div>
      <span class="hub__zahl">{{ g.meilensteine.length }}</span>
      <span class="hub__label">Ergebnisstufen</span>
    </div>
    <div>
      <span class="hub__zahl">{{ g.graph.querAnzahl }}</span>
      <span class="hub__label">Abhängigkeiten über Strangrenzen</span>
    </div>
  </div>

  <div class="hub__karten">
    {% for k in konzepte %}
      <a class="hub__karte hub__karte--{{ k.id }}" href="{{ k.href }}">
        <span class="hub__vorschau" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="hub__name">{{ k.name }}</span>
        <span class="hub__claim">{{ k.claim }}</span>
        <span class="hub__frage">{{ k.frage }}</span>
        <span class="hub__idee">{{ k.idee }}</span>
        <span class="hub__zeile"><b>Stark bei</b> {{ k.gutFuer }}</span>
        <span class="hub__zeile hub__zeile--schwach"><b>Schwach bei</b> {{ k.schwaeche }}</span>
      </a>
    {% endfor %}
  </div>

  <p class="hub__hinweis">{{ g.hinweis }}</p>
</div>
