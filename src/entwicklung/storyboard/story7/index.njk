        <p class="s7-lead">{{ DL.lead }}</p>
        <p class="mx7-dl__meta">{% for x in DL.meta %}<span>{{ x }}</span>{% endfor %}</p>
        <a class="s7-knopf" href="{{ B6 }}/assets/maas/{{ DL.datei }}" target="_blank" rel="noopener">{{ DL.knopf }} <svg class="s7-pfeil" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg></a>
