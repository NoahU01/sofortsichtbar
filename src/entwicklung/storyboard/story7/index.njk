          </div></div>
          <p class="mx7-rolle">{{ MO.rollen[L[2].rolle] }}</p><h3>{{ L[2].titel }}</h3><p class="mx7-kreis__t">{{ L[2].text }}</p>
        </li>
        <li class="mx7-kreis__schritt">
          <div class="mx7-kreis__bild" aria-hidden="true"><div class="s7-mini">
            <p class="s7-mini__kopf">Empfehlungen</p>
            <ul class="mx7-mliste"><li><span>Bauherren: Abschnitt umstellen</span><em>erledigt</em></li><li><span>Junge Familien: neues Posting-Thema</span><em>in Arbeit</em></li></ul>
          </div></div>
          <p class="mx7-rolle">{{ MO.rollen[L[3].rolle] }}</p><h3>{{ L[3].titel }}</h3><p class="mx7-kreis__t">{{ L[3].text }}</p>
        </li>
      </ol>
    </div>
  </section>

  {%- set BS = M.bausteine %}{%- set K = BS.liste[0] %}
  {%- macro bfenster(b) -%}
  {%- set F = b.fenster %}
  <dialog class="mx7-d" id="mx7-{{ b.id }}" aria-labelledby="mx7-{{ b.id }}-t">
    {{ schliessen() }}
    <p class="mx7-d__meta">{{ F.meta }}</p>
    <h3 id="mx7-{{ b.id }}-t">{{ F.titel }}</h3>
    {%- for x in F.intro %}<p>{{ x }}</p>{% endfor %}
    {%- for g in F.gruppen %}
    <p class="mx7-d__label">{{ g.label }}</p>
    {%- for l in g.leistungen %}
    <div class="mx7-d__punkt"><b>{{ l.titel }}</b>{% if l.text %}<p>{{ l.text }}</p>{% endif %}{% if l.liste %}<ul>{% for x in l.liste %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}</div>
    {%- endfor %}
    {%- endfor %}
    {%- if F.hinweis %}<p class="mx7-d__hinweis">{{ F.hinweis }}</p>{% endif %}
  </dialog>
  {%- endmacro %}
  <section class="s7-band" id="bausteine">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ BS.kicker }}</p>
      <h2 class="s7-h2">{{ BS.h2 }}</h2>
      <p class="s7-lead">{{ BS.lead }}</p>
      <article class="mx7-kern">
        <div>
          <p class="mx7-art">{{ K.art }}</p>
          <h3>{{ K.name }}</h3>
          <p class="mx7-preis"><b>{{ K.preis }}</b> {{ K.einheit }}</p>
          <p class="mx7-kurz">{{ K.kurz }}</p>
          <button type="button" class="mx7-mehr mx7-mehr--hell" data-mx7-auf="mx7-{{ K.id }}">Alle Leistungen {{ pfeil | safe }}</button>
        </div>
        {%- for g in K.gruppen %}
        <div>
          <p class="mx7-art">{{ g.titel }}</p>
          <ul class="mx7-haken">{% for y in g.punkte %}<li>{{ y }}</li>{% endfor %}</ul>
        </div>
        {%- endfor %}
        {{ bfenster(K) }}
      </article>
      <div class="mx7-erg">
        {%- for b in BS.liste %}{% if not loop.first %}
        <article class="mx7-karte">
          <div class="mx7-karte__bild" aria-hidden="true"><div class="s7-mini">
          {%- if b.id == "linkedin" %}
            <p class="s7-mini__kopf">LinkedIn · Beitrag</p>
            <div class="mx7-mpost"><b>Deine Agentur</b><span>Drei Fragen, die Bauherren vor der Unterschrift klären sollten.</span></div>
            <div><i class="an">Anlass für die Direktansprache</i></div>
          {%- elif b.id == "paid-ads" %}
            <p class="s7-mini__kopf">Anzeige · Junge Familien</p>
            <div class="mx7-mpost"><b>Gut abgesichert ins Familienleben</b><span>In 30 Minuten wissen, was wirklich wichtig ist.</span></div>
            <div><i class="an">Termin auswählen</i></div>
          {%- else %}
            <div class="mx7-mbrowser"><span><i></i><i></i><i></i></span><b>Versicherung, die mitwächst.</b><em></em><em></em><i class="an">Termin auswählen</i></div>
          {%- endif %}
          </div></div>
          <p class="mx7-art">{{ b.art }}</p>
          <h3>{{ b.name }}</h3>
          <p class="mx7-preis"><b>{{ b.preis }}</b> {{ b.einheit }}</p>
          <p class="mx7-zusatz">{{ b.zusatz }}</p>
          <p class="mx7-kurz">{{ b.kurz }}</p>
          <ul class="mx7-haken mx7-karte__punkte">{% for y in b.punkte %}<li>{{ y }}</li>{% endfor %}</ul>
          <button type="button" class="mx7-mehr" data-mx7-auf="mx7-{{ b.id }}">Alle Leistungen {{ pfeil | safe }}</button>
          {{ bfenster(b) }}
        </article>
        {%- endif %}{% endfor %}
      </div>
      <p class="mx7-fuss"><span>{{ BS.hinweis }}</span><a class="s7-link" href="{{ B6 }}/assets/maas/{{ BS.pdf_datei }}" target="_blank" rel="noopener">{{ BS.pdf }} {{ pfeil | safe }}</a></p>
    </div>
  </section>

  {%- set TM = M.team %}
  <section class="s7-band s7-band--flaeche" id="team">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ TM.kicker }}</p>
      <h2 class="s7-h2">{{ TM.h2 }}<br><span class="s7-wort">{{ TM.h2_akzent }}</span></h2>
      <p class="s7-lead">{{ TM.lead }}</p>
      <div class="mx7-team">
        <p class="s7-gruppe mx7-team__g1">{{ TM.gruppen[0] }}</p>
        <p class="s7-gruppe mx7-team__g2">{{ TM.gruppen[1] }}</p>
        {%- for x in TM.liste %}
        {%- set F = x.fenster %}{% set wo = TM.gruppen[0] if x.gruppe == "kern" else TM.gruppen[1] %}
        <article class="mx7-profil">
          <h3>{{ x.titel }}</h3>
          <p class="mx7-profil__stelle">{{ x.stelle }}</p>
          <p class="mx7-profil__t">{{ x.text }}</p>
          <button type="button" class="mx7-mehr" data-mx7-auf="mx7-profil-{{ loop.index }}">Rollenprofil {{ pfeil | safe }}</button>
          <dialog class="mx7-d" id="mx7-profil-{{ loop.index }}" aria-labelledby="mx7-profil-{{ loop.index }}-t">
            {{ schliessen() }}
            <p class="mx7-d__meta">Rollenprofil · {{ wo }}</p>
            <h3 id="mx7-profil-{{ loop.index }}-t">{{ x.titel }}</h3>
            <p class="mx7-d__stelle">{{ x.stelle }}</p>
            <p>{{ F.einleitung }}</p>
            {%- for t2 in [["Aufgaben", F.aufgaben], ["Anforderungen", F.anforderungen], ["Ausbildung und Erfahrung", F.ausbildung]] %}
            <p class="mx7-d__label">{{ t2[0] }}</p>
            <ul class="mx7-d__ul">{% for y in t2[1] %}<li>{{ y }}</li>{% endfor %}</ul>
            {%- endfor %}
            <p class="mx7-d__hinweis">{{ TM.fenster_hinweis }}</p>
          </dialog>
        </article>
        {%- endfor %}
      </div>
    </div>
  </section>

  {{ kontakt() }}
</main>
<script>
/* Pop-ups: Knopf öffnet, Kreuz, Escape oder Klick daneben schließt */
(function () {
  document.querySelectorAll("[data-mx7-auf]").forEach(function (k) {
    k.addEventListener("click", function () { var d = document.getElementById(k.getAttribute("data-mx7-auf")); if (d) d.showModal(); });
  });
  document.querySelectorAll(".mx7-d").forEach(function (d) {
    d.querySelector(".mx7-d__zu").addEventListener("click", function () { d.close(); });
    d.addEventListener("click", function (e) { if (e.target === d) d.close(); });
  });
})();
</script>
{%- else %}
<main>
  {{ held() }}
  {{ schritte() }}
  {{ pakete() }}

  <!-- Zielgruppen: ein großes Bild als Beweis, die 20 Zielgruppen als ruhige Liste mit Anlass -->
  {%- set Z = S.zielgruppen %}
