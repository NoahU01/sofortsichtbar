{#- Homepage-Story 7 · Startseite mit der Grundstory „Die digitale Maschine vor deinem Vertrieb“ (A und B vereint)
    und die Stilproben (drei Richtungen auf denselben Bausteinen).
    Der Stil hängt ausschließlich an den Stellschrauben (:root = Arbeitslook; .s7-stil--… = eine Richtung).
    Bausteine (Einstieg, Schritte, Pakete …) als Makros – Startseite und Stilproben nutzen dieselben.
    Inhalte: story7.11tydata.json → s7 · Grafik: maschine_holen.py · Schriften: assets/fonts (OFL, selbst gehostet).
    Eigenständige Seiten (layout: false), alles in src/entwicklung/. -#}
{%- set S = s7 -%}
{%- set H7 = "/entwicklung/storyboard/story7" -%}
{#- Echte Seiten (Startseite und Unterseiten) tragen Stil, Farbschalter und Hauptmenü; Stil- und Farbproben nicht -#}
{%- set istSeite = s.slug != "stilproben" and s.slug != "farbproben" and s.slug != "seitenplan" -%}
{%- set B6 = "/entwicklung/storyboard/story6" -%}
{%- set A7 = "/entwicklung/storyboard/story7/assets" -%}
{%- set pfeil -%}<svg class="s7-pfeil" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endset -%}

{#- ======================= Bausteine ======================= -#}
{%- macro erklaerbild(detail=false) -%}
{%- set E = S.erklaerbild -%}
{%- if detail %}
{#- Schnitt durch die Maschine: quer als Grafik, am Handy als Liste derselben Lagen (Quelle: erklaerbild.py SCHNITT) -#}
<div class="ek2 ek2--schnitt" role="img" aria-label="Schnitt durch die Maschine: {% for z in S.maas.schnitt %}{{ z.name }} ({{ z.marke }}): {{ z.text }}. {% endfor %}An der Mündung der Messpunkt Leads, danach dein Vertrieb, der daraus Kunden macht.">{{ S.ek_schnitt_quer | safe }}</div>
<div class="mx7-schnitt" aria-hidden="true">
  {%- for z in S.maas.schnitt %}
  <div class="mx7-schnitt__lage mx7-schnitt__lage--{{ loop.index }}"><p><b>{{ z.name }}</b><span>{{ z.marke }}</span></p><p>{{ z.text }}</p></div>
  {%- endfor %}
  <span class="mx7-schnitt__unten mx7-schnitt__unten--1"></span><span class="mx7-schnitt__unten mx7-schnitt__unten--2"></span><span class="mx7-schnitt__unten mx7-schnitt__unten--3"></span>
  <p class="mx7-schnitt__mess">Messpunkt: Leads</p>
  <div class="mx7-schnitt__vertrieb"><b>Dein Vertrieb</b><span>macht daraus Kunden</span></div>
</div>
{%- else %}<div class="ek2" role="img" aria-label="Die digitale Maschine: Marketing – wir gewinnen Interessenten. Ein Trichter aus Lagen mit sofort sichtbar im Kern; an der Mündung der Messpunkt Leads. Vertrieb – du machst daraus Kunden: Termin, Beratung, Abschluss, dann Kundenbetreuung. Regelmäßige Präsenz pflegt deinen Bestand und bringt neue Anlässe.">{{ S.ek_quer | safe }}{{ S.ek_hoch | safe }}</div>
<p class="ek__mehr"><a class="s7-link" href="{{ E.link_ziel }}">{{ E.link }} {{ pfeil | safe }}</a></p>
{%- endif %}
{%- endmacro -%}

{%- macro held(mitIds=true) -%}
  <section class="s7-held">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ S.hero.kicker }}</p>
      <h1>{{ S.hero.h1 }} <span class="s7-wort">{{ S.hero.h1_akzent }}</span></h1>
      <p class="s7-lead">{{ S.hero.lead }}</p>
      <div class="s7-held__knoepfe">
        <a class="s7-knopf" href="#kontakt">{{ S.hero.knopf }} {{ pfeil | safe }}</a>
        <a class="s7-knopf s7-knopf--rand" href="{{ H7 }}/strategiekompass/">{{ S.hero.knopf2 }}</a>
      </div>
      <figure class="s7-maschine">
        {{ erklaerbild() }}
      </figure>
    </div>
  </section>
{%- endmacro -%}

{%- macro schritte(mitIds=true) -%}
  {#- Ablauf statt drei Kästen: eine Linie Strategie → Maschine → Steuerung, eine Bildsprache (graue Linien, Tinte), Farbe nur im Trichter -#}
  {%- set L = S.schritte.liste %}
  <section class="s7-band s7-band--akzent"{% if mitIds %} id="maschine"{% endif %}>
    <div class="s7-wrap">
      <p class="s7-kicker">{{ S.schritte.kicker }}</p>
      <h2 class="s7-h2">{{ S.schritte.h2 }}</h2>
      <ol class="s7-ablauf">
        <li class="s7-ablauf__schritt">
          <div class="s7-ablauf__bild" aria-hidden="true"><div class="s7-mini">
            <div class="s7-mini__zeile"><span>Segment</span><div><i class="an">Privatkunden</i><i>Firmenkunden</i></div></div>
            <div class="s7-mini__zeile"><span>Sparte</span><div><i class="an">Leben</i><i>Kranken</i><i>Schaden/Unfall</i><i>Kfz</i></div></div>
            <div class="s7-mini__zeile"><span>Zielgruppe</span><div><i class="an ziel">Junge Familien</i><i class="an">Bauherren</i><i class="mehr">+ weitere</i></div></div>
          </div></div>
          <p class="s7-ablauf__nr">{{ L[0].nr }} · {{ L[0].label }}</p>
          <h3>{{ L[0].h | replace('|', '<br>') | safe }}</h3>
          <p class="s7-ablauf__t">{{ L[0].t }}</p>
          <a class="s7-link" href="{{ H7 }}/strategiekompass/">{{ L[0].link }} {{ pfeil | safe }}</a>
        </li>
        <li class="s7-ablauf__schritt">
          <div class="s7-ablauf__bild" aria-hidden="true"><div class="s7-mini">
            <p class="s7-mini__kopf">Vertriebsstrecke · Junge Familien</p>
            <div class="s7-mini__strecke"><ul><li>Landingpage</li><li>Postings</li><li>Kundenmailing</li></ul><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg><div class="s7-mini__lead ziel"><b>Neuer Lead</b><span>Familie M.</span><span>Rückruf heute</span></div></div>
          </div></div>
          <p class="s7-ablauf__nr">{{ L[1].nr }} · {{ L[1].label }}</p>
          <h3>{{ L[1].h | replace('|', '<br>') | safe }}</h3>
          <p class="s7-ablauf__t">{{ L[1].t }}</p>
          <a class="s7-link" href="{{ H7 }}/vertriebsstrecken/">{{ L[1].link }} {{ pfeil | safe }}</a>
        </li>
        <li class="s7-ablauf__schritt">
          <div class="s7-ablauf__bild" aria-hidden="true"><div class="s7-mini">
            <p class="s7-mini__kopf">Dashboard</p>
            <div class="s7-mini__kacheln"><div><b>Aufmerksamkeit</b><svg viewBox="0 0 60 16" preserveAspectRatio="none"><polyline points="0,13 12,11 24,12 36,8 48,6 60,3"/></svg></div><div class="ziel"><b>Verweildauer</b><svg viewBox="0 0 60 16" preserveAspectRatio="none"><polyline points="0,4 12,5 24,4 36,8 48,10 60,13"/></svg></div><div><b>Google</b><svg viewBox="0 0 60 16" preserveAspectRatio="none"><polyline points="0,13 12,11 24,12 36,8 48,6 60,3"/></svg></div><div><b>Leads</b><svg viewBox="0 0 60 16" preserveAspectRatio="none"><polyline points="0,13 12,11 24,12 36,8 48,6 60,3"/></svg></div></div>
            <p class="s7-mini__empf"><b>Empfehlung:</b> Bauherren – Abschnitt umstellen, der kaum gelesen wird</p>
          </div></div>
          <p class="s7-ablauf__nr">{{ L[2].nr }} · {{ L[2].label }}</p>
          <h3>{{ L[2].h | replace('|', '<br>') | safe }}</h3>
          <p class="s7-ablauf__t">{{ L[2].t }}</p>
        </li>
      </ol>
    </div>
  </section>
{%- endmacro -%}

{#- Karte einer Zielgruppe (Wisch-Reihe): Anlass, Name, Landingpage im Anschnitt. Daten: vertriebsstrecken.json + zielgruppen.json -#}
{%- macro zgKarte(z) -%}
{%- set slug = z.href | replace("/zielgruppen/", "") %}
{%- set bild = "" %}{% for x in zielgruppen %}{% if x.slug == slug %}{% for st in x.styles %}{% if st.name == "Elegant" %}{% set bild = st.image %}{% endif %}{% endfor %}{% if not bild %}{% set bild = x.styles[0].image %}{% endif %}{% endif %}{% endfor %}
{%- if S.vs.bild_korrektur[slug] %}{% set bild = S.vs.bild_korrektur[slug] %}{% endif %}
{%- set an = "" %}{% for a in vertriebsstrecken.anlaesse %}{% if a.href == z.href and not an %}{% set an = a.label %}{% endif %}{% endfor %}
<li><a class="vs7-karte" href="{{ H7 }}/zielgruppen/{{ slug }}/">
  <span class="vs7-karte__anlass">{{ an or "Vertriebsstrecke" }}</span>
  <b>{{ z.label }}</b>
  <img src="/assets/img/{{ bild }}" alt="" width="868" height="446" loading="lazy">
</a></li>
{%- endmacro -%}

{%- macro kontaktBand(K=null) -%}
{%- set KB = K or S.kontakt %}
  <section class="s7-band s7-band--tinte" id="kontakt">
    <div class="s7-wrap s7-kontakt">
      <div>
        <h2 class="s7-h2">{{ KB.h2 }} <span class="s7-wort s7-nowrap">{{ KB.h2_akzent }}</span></h2>
        <p class="s7-lead">{{ KB.t }}</p>
      </div>
      <div class="s7-kontakt__wege">
        {%- if s.slug %}{#- Unterseiten: Gesichter zum Termin (auf der Startseite steht das Gruppenbild direkt darüber) -#}
        <p class="s7-kontakt__team"><span aria-hidden="true">{% for n in ["kerstin", "daniel", "noah"] %}<img src="{{ B6 }}/assets/img/ansprechpartner-{{ n }}.webp" alt="" width="480" height="480" loading="lazy">{% endfor %}</span>{{ S.kontakt.team_satz }}</p>
        {%- endif %}
        <a class="s7-knopf" href="{{ H7 }}/kontakt/">Termin auswählen {{ pfeil | safe }}</a>
        <a href="mailto:{{ S.kontakt.mail }}">{{ S.kontakt.mail }}</a>
        <a href="tel:{{ S.kontakt.tel | replace(' ', '') }}">{{ S.kontakt.tel }}</a>
      </div>
    </div>
  </section>
{%- endmacro -%}

{%- macro pakete(mitIds=true) -%}
  <section class="s7-band"{% if mitIds %} id="pakete"{% endif %}>
    <div class="s7-wrap">
      <p class="s7-kicker">{{ S.pakete.kicker }}</p>
      <h2 class="s7-h2">{{ S.pakete.h2 }}</h2>
      <p class="s7-lead">{{ S.pakete.lead }}</p>
      <div class="s7-pakete">
        <p class="s7-gruppe s7-gruppe--a">{{ S.pakete.gruppen[0][0] }}</p>
        <p class="s7-gruppe s7-gruppe--b">{{ S.pakete.gruppen[1][0] }}</p>
        {%- for p in S.pakete.liste %}
        <article class="s7-paket s7-paket--{{ p.id }}">
          <h3>{{ p.name }}</h3>
          <p class="s7-paket__fuer">{{ p.fuer }}</p>
          <p class="s7-paket__preis">{% if p.preis %}<b>{{ p.preis }}</b><span>{{ p.einheit }}</span>{% else %}<b>Auf Anfrage</b><span>monatlich</span>{% endif %}</p>
          <p class="s7-paket__vorspann">{{ p.vorspann }}</p>
          <ul>{% for x in p.punkte %}<li>{{ x }}</li>{% endfor %}</ul>
          <span></span>
          <a class="s7-knopf{% if p.id != "komplett" %} s7-knopf--rand{% endif %}" href="{% if p.id == "komplett" %}{{ H7 }}/marketing-as-a-service/{% else %}#kontakt{% endif %}">{{ p.knopf }}</a>
        </article>
        {%- endfor %}
      </div>
      <p class="s7-pakete__fuss">{{ S.pakete.fuss }}</p>
    </div>
  </section>
{%- endmacro -%}
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if s.slug %}{{ s.titel }} · {% endif %}Homepage-Story 7 · Die digitale Maschine – Entwicklung</title>
<meta name="robots" content="noindex,nofollow">
<link rel="icon" href="/assets/img/logos/favicon.png" type="image/png">
<style>
/* ---------- Schriften (selbst gehostet, OFL) ---------- */
{%- for f in [["Inter", "inter", [400, 500, 600]], ["Inter Tight", "inter-tight", [600, 700]]] %}{% for w in f[2] %}
@font-face { font-family: "{{ f[0] }}"; font-weight: {{ w }}; font-style: normal; font-display: swap; src: url("{{ A7 }}/fonts/{{ f[1] }}-latin-{{ w }}-normal.woff2") format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
@font-face { font-family: "{{ f[0] }}"; font-weight: {{ w }}; font-style: normal; font-display: swap; src: url("{{ A7 }}/fonts/{{ f[1] }}-latin-ext-{{ w }}-normal.woff2") format("woff2"); unicode-range: U+0100-02AF, U+0304, U+0308, U+0329, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
{%- endfor %}{% endfor %}

/* ===================================================================================
   STELLSCHRAUBEN – :root ist der Arbeitslook (neutral, Platzhalter).
   Eine Stilrichtung setzt nur diese Werte neu (siehe .s7-stil--… weiter unten).
   =================================================================================== */
:root, .s7-stil {
  --s7-schrift-titel: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --s7-schrift-text: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --s7-titel-gewicht: 700;
  --s7-titel-abstand: -0.02em;
  --s7-h1: clamp(2.6rem, 6.6vw, 5.6rem);   --s7-h1-hoehe: 1.04;
  --s7-h2: clamp(2rem, 4.2vw, 3.2rem);     --s7-h2-hoehe: 1.12;
  --s7-text-groesse: 1.0625rem;
  --s7-grund: #ffffff;          /* Seitenhintergrund */
  --s7-flaeche: #f4f4f3;        /* helle Fläche */
  --s7-tinte: #181818;          /* Überschriften, dunkle Flächen */
  --s7-text: #3b3b3b;           /* Fließtext */
  --s7-grau: #7a7a7a;           /* Kicker, Nebeninfos */
  --s7-linie: #e2e2df;          /* Trennlinien, Rahmen */
  --s7-akzent: #c9d4e3;         /* Markierung: Auswahl, Leads, Kern des Trichters */
  --s7-akzent-fill: var(--s7-akzent);   /* dieselbe Markierung in Grafiken (darf url(#…) sein) */
  --s7-akzent-verlauf: var(--s7-akzent); /* zarte Akzentfläche, darf ein Verlauf sein (Pills, Leads) */
  --s7-akzent-ende: var(--s7-akzent);   /* Endfarbe des Verlaufs (dort, wo der Trichter mündet) */
  --s7-akzent-fill-hoch: var(--s7-akzent-fill); /* Verlauf für senkrechte Grafiken (oben → unten) */
  --s7-auf-akzent: #181818;     /* Schrift auf dem Akzent */
  --s7-wort: var(--s7-tinte);   /* hervorgehobenes Wort der Hauptüberschrift */
  --s7-wort-verlauf: none;      /* … oder als Verlauf */
  --s7-knopf-grund: var(--s7-tinte); --s7-knopf-text: #ffffff;
  --s7-buehne: var(--s7-flaeche);      /* Fläche hinter der Maschine */
  --s7-band-akzent: var(--s7-flaeche); /* Band „So läuft die Maschine“ */
  --s7-karte: var(--s7-grund);         /* Karten auf Bändern */
  --s7-schatten: none;                 /* Karten-Schatten */
  --s7-komplett-grund: var(--s7-tinte); --s7-komplett-text: #e9e9e9; --s7-komplett-titel: #ffffff; --s7-komplett-haken: var(--s7-akzent); --s7-komplett-knopf-text: var(--s7-tinte);
  --s7-lage-1: #dededb; --s7-lage-2: #e9e9e7; --s7-lage-3: #f2f2f1;   /* Lagen des Trichters */
  --s7-rund: 18px;              /* Rundung Karten */
  --s7-rund-knopf: 999px;       /* Rundung Knöpfe */
  --s7-band: clamp(4.5rem, 9vw, 7.5rem);   /* Abstand oben/unten je Band */
}

/* ---------- Grundlagen ---------- */
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: #fff; color: #3b3b3b; font: 400 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased; }
img, svg { display: block; max-width: 100%; }
img { height: auto; }
a { color: inherit; }
p { margin: 0; }
.s7-stil { background: var(--s7-grund); color: var(--s7-text); font-family: var(--s7-schrift-text); font-size: var(--s7-text-groesse); line-height: 1.6; }
.s7-stil h1, .s7-stil h2, .s7-stil h3 { margin: 0; color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-weight: var(--s7-titel-gewicht); letter-spacing: var(--s7-titel-abstand); text-wrap: balance; }
.s7-wrap { width: min(100% - 2.5rem, 76rem); margin-inline: auto; }
.s7-band { padding: var(--s7-band) 0; }
.s7-band--flaeche { background: var(--s7-flaeche); }
.s7-band--akzent { background: var(--s7-band-akzent); }
.s7-band--tinte { background: var(--s7-tinte); color: #e9e9e9; }
.s7-stil .s7-band--tinte h2 { color: #fff; }
.s7-kicker { margin-bottom: 1rem; color: var(--s7-grau); font-size: .78rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
.s7-stil .s7-h2 { max-width: 22ch; font-size: var(--s7-h2); line-height: var(--s7-h2-hoehe); }
.s7-lead { max-width: 40rem; margin-top: 1.2rem; font-size: 1.15rem; line-height: 1.6; }
.s7-knopf { display: inline-flex; align-items: center; gap: .6rem; padding: .95rem 1.5rem; border: 2px solid var(--s7-knopf-grund); border-radius: var(--s7-rund-knopf); background: var(--s7-knopf-grund); color: var(--s7-knopf-text); font-weight: 600; font-size: 1rem; text-decoration: none; transition: transform .15s ease; }
.s7-knopf:hover { transform: translateY(-2px); }
.s7-knopf--rand { background: transparent; border-color: var(--s7-tinte); color: var(--s7-tinte); }
.s7-pfeil { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.s7-link { display: inline-flex; align-items: center; gap: .45rem; color: var(--s7-tinte); font-weight: 600; text-decoration: none; }
.s7-link:hover { text-decoration: underline; }
.s7-wort { color: var(--s7-wort); background-image: var(--s7-wort-verlauf); -webkit-background-clip: text; background-clip: text; }

/* ---------- Entwicklungsleiste + Kopf ---------- */
.s7-dev { background: #111; color: #bbb; font-size: 12.5px; }
.s7-dev .s7-wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .3rem 1rem; padding: .45rem 0; }
.s7-dev b { color: #fff; font-weight: 600; }
.s7-dev a { color: #fff; margin-left: 1rem; }
.s7-schalter { display: inline-flex; align-items: center; gap: .3rem; margin-left: .4rem; }
.s7-schalter button { width: 1.6rem; height: 1.3rem; padding: 0; border: 1px solid #555; border-radius: 6px; background: transparent; color: #ddd; font: 600 11px/1 system-ui, sans-serif; cursor: pointer; }
.s7-schalter button[aria-pressed="true"] { border-color: #fff; background: #fff; color: #111; }
.s7-kopf { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--s7-grund) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--s7-linie); }
.s7-kopf .s7-wrap { display: flex; align-items: center; gap: 2rem; height: 72px; }
.s7-marke { display: flex; align-items: center; gap: .35rem; }
.s7-marke img { height: 2.4rem; width: auto; }
.s7-nav { display: flex; gap: 1.8rem; margin-left: auto; }
.s7-nav a { color: var(--s7-text); font-size: .95rem; text-decoration: none; }
.s7-nav a:hover { color: var(--s7-tinte); }
.s7-nav a[aria-current="page"] { color: var(--s7-tinte); font-weight: 600; }
@media (max-width: 1200px) { .s7-nav { gap: 1.2rem; } .s7-nav a { font-size: .9rem; } }
.s7-kopf .s7-knopf { padding: .6rem 1.1rem; font-size: .9rem; }
.s7-kopf--nur-marke .s7-knopf { margin-left: auto; }
.s7-dd { position: relative; }
.s7-dd__auf { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; padding: 0; border: 0; border-radius: 50%; background: none; color: var(--s7-grau); cursor: pointer; }
.s7-dd__auf:hover, .s7-dd__auf[aria-expanded="true"] { background: var(--s7-flaeche); color: var(--s7-tinte); }
.s7-dd__auf svg { width: .7rem; height: .7rem; fill: currentColor; }
.s7-dd__panel { position: absolute; top: calc(100% + .9rem); left: -6rem; z-index: 80; width: 21rem;  padding: .7rem; border: 1px solid var(--s7-linie); border-radius: 16px; background: #fff; box-shadow: 0 20px 50px rgba(0,0,0,.12); }
.s7-dd__panel[hidden] { display: none; }
.s7-dd__hinweis { margin: 0 0 .5rem; padding: .7rem .8rem; border-radius: 10px; background: var(--s7-flaeche); color: var(--s7-tinte); font-size: .78rem; line-height: 1.45; }
.s7-dd__gruppe { margin: .7rem .8rem .2rem; color: var(--s7-grau); font-size: .7rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
.s7-dd__panel a { display: block; padding: .5rem .8rem; border-radius: 8px; color: var(--s7-tinte); font-size: .9rem; text-decoration: none; }
.s7-dd__panel a:hover { background: var(--s7-flaeche); }
.s7-dd__panel a[aria-current="page"] { font-weight: 600; background: var(--s7-flaeche); }
/* Zweite Ebene im Entwicklungsmenü: Kasten öffnet nach rechts (Hover, Tastatur); Brücke über die Lücke */
.s7-unter { position: relative; }
.s7-unter > a { display: flex !important; justify-content: space-between; align-items: center; }
.s7-unter__pfeil { margin-left: .8rem; font-size: 1.1rem; line-height: 1; }
.s7-unter__panel { display: none; position: absolute; left: calc(100% + .7rem); top: -.7rem; z-index: 90; width: 20rem; padding: .7rem; border: 1px solid var(--s7-linie); border-radius: 16px; background: #fff; box-shadow: 0 20px 50px rgba(0,0,0,.12); }
.s7-unter__panel::before { content: ""; position: absolute; left: -1.5rem; top: 0; bottom: 0; width: 1.5rem; }
.s7-unter:hover .s7-unter__panel, .s7-unter:focus-within .s7-unter__panel { display: block; }
.s7-unter:hover > a { background: var(--s7-flaeche); }

/* ---------- Einstieg ---------- */
.s7-held { padding: clamp(3.5rem, 7vw, 6rem) 0 calc(var(--s7-band) * .7); }
.s7-stil .s7-held h1 { max-width: 16ch; font-size: var(--s7-h1); line-height: var(--s7-h1-hoehe); letter-spacing: calc(var(--s7-titel-abstand) * 1.6); }
.s7-held .s7-lead { font-size: clamp(1.15rem, 1.7vw, 1.35rem); max-width: 36rem; }
.s7-held__knoepfe { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.2rem; }
.s7-maschine { margin: clamp(3rem, 6vw, 4.5rem) 0 0; padding: clamp(1.6rem, 3.5vw, 3rem) clamp(1.2rem, 3vw, 2.8rem) clamp(1.6rem, 3vw, 2.4rem); border-radius: calc(var(--s7-rund) * 1.4); background: var(--s7-buehne); }
.s7-maschine__bild { overflow-x: auto; }
.s7-maschine__bild svg { width: 100%; min-width: 640px; height: auto; }
/* Farben der Grafik an die Stellschrauben koppeln (CSS schlägt die Attribute der Grafik) */
.s7-maschine svg [fill="#fff400"] { fill: var(--s7-akzent-fill); }
.s7-maschine svg [stroke="#fff400"] { stroke: var(--s7-akzent); }
.s7-maschine svg [fill="#dcd8d2"] { fill: var(--s7-lage-1); }
.s7-maschine svg [fill="#e8e5e0"] { fill: var(--s7-lage-2); }
.s7-maschine svg [fill="#f3f1ee"] { fill: var(--s7-lage-3); }
.s7-maschine svg [fill="#1a1817"] { fill: var(--s7-tinte); }
.s7-maschine svg [stroke="#1a1817"] { stroke: var(--s7-tinte); }
.s7-maschine svg [fill="#3d3a37"] { fill: var(--s7-text); }
.s7-maschine svg [fill="#6f6a64"] { fill: var(--s7-grau); }
.s7-maschine svg text { font-family: var(--s7-schrift-text); }
.s7-maschine svg .s7-kern { fill: var(--s7-auf-akzent); }
.s7-maschine svg g.s7-kern { fill: none; stroke: var(--s7-auf-akzent); }

/* ---------- Erklärbild „Die digitale Maschine“ (erklaerbild.py): zwei Formen, ein Highlight; quer ab 820px, darunter hochkant ---------- */
.ek2 svg { display: block; width: 100%; height: auto; overflow: visible; }
.ek2-svg--hoch { display: none !important; max-width: 23rem; margin: 0 auto; }
.ek2 text { font-family: var(--s7-schrift-text); }
.ek2-t { fill: var(--s7-tinte); }
.ek2-grau { fill: var(--s7-grau); }
.ek2-lage { stroke: var(--s7-grund); stroke-width: 2; }
.ek2-l2, .ek2-l2-h { fill: var(--s7-lage-1); }
.ek2-l3, .ek2-l3-h { fill: var(--s7-lage-2); }
.ek2-l4, .ek2-l4-h { fill: var(--s7-lage-3); }
.ek2-kern { fill: var(--s7-akzent-fill); }
.ek2-kern-h { fill: var(--s7-akzent-fill-hoch); }
.ek2-kern-t, .ek2-kern-p { fill: var(--s7-auf-akzent); }
.ek2-band { fill: var(--s7-tinte); }
.ek2-band-t { fill: #ffffff; }
.ek2-band-s { fill: #a1a1a6; }
.ek2-linie { fill: none; stroke: var(--s7-tinte); stroke-width: 2; }
.ek2-linie--grau { stroke: var(--s7-linie); }
.ek2-linie--fein { stroke-width: 1.4; }
.ek2-pfeilkopf { fill: none; stroke: var(--s7-tinte); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.ek2-grund { fill: var(--s7-buehne); }
.ek__mehr { margin-top: 2.2rem; text-align: center; }
@media (max-width: 820px) { .ek2-svg--quer { display: none !important; } .ek2-svg--hoch { display: block !important; } }

/* ---------- Ablauf: Strategie → Maschine → Steuerung ---------- */
.s7-ablauf { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(5, auto); column-gap: clamp(2rem, 4vw, 3.6rem); margin: 3.2rem 0 0; padding: 0; list-style: none; }
.s7-ablauf__schritt { display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 0; }
.s7-ablauf__bild { position: relative; display: grid; align-items: center; min-height: 14rem; padding: 1.7rem 1.6rem; border-radius: var(--s7-rund); background: var(--s7-karte); }
.s7-mini { display: grid; gap: .8rem; font-size: .85rem; line-height: 1.3; color: var(--s7-tinte); }
.s7-mini__kopf { color: var(--s7-grau); font-size: .7rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
.s7-mini__zeile { display: grid; grid-template-columns: 5.2rem 1fr; align-items: center; gap: .5rem; }
.s7-mini__zeile > span { color: var(--s7-grau); font-size: .68rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
.s7-mini__zeile > div { display: flex; flex-wrap: wrap; gap: .3rem; }
.s7-mini i { padding: .24rem .6rem; border: 1px solid var(--s7-linie); border-radius: 99px; font-style: normal; white-space: nowrap; }
.s7-mini i.an { border-color: var(--s7-tinte); background: var(--s7-tinte); color: #fff; font-weight: 600; }
.s7-mini i.mehr { border-style: dashed; color: var(--s7-grau); }
.s7-mini__strecke { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: .6rem; }
.s7-mini__strecke ul { display: grid; gap: .35rem; margin: 0; padding: 0; list-style: none; }
.s7-mini__strecke li { padding: .42rem .6rem; border: 1px solid var(--s7-linie); border-radius: 8px; font-weight: 500; }
.s7-mini__strecke svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: var(--s7-tinte); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.s7-mini__lead { display: grid; gap: .15rem; padding: .7rem .75rem; border-radius: 10px; background: var(--s7-tinte); color: #c7c7cc; }
.s7-mini__lead b { color: #fff; font-weight: 700; }
.s7-mini__balken { display: grid; grid-template-columns: 6.4rem 1fr; align-items: center; gap: .55rem .6rem; }
.s7-mini__balken i { display: block; height: .6rem; padding: 0; border: 0; border-radius: 99px; background: var(--s7-tinte); }
.s7-mini__empf { padding: .5rem .65rem; border: 1px solid var(--s7-linie); border-radius: 8px; }
.s7-mini__kacheln { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; }
.s7-mini__kacheln > div { display: grid; gap: .3rem; padding: .5rem .6rem .45rem; border: 1px solid var(--s7-linie); border-radius: 8px; }
.s7-mini__kacheln b { font-weight: 600; }
.s7-mini__kacheln svg { width: 100%; height: .9rem; fill: none; stroke: var(--s7-tinte); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.s7-mini__kacheln > div.ziel { border-color: transparent; background: var(--s7-akzent-verlauf); color: var(--s7-auf-akzent); }
.s7-mini__kacheln > div.ziel svg { stroke: var(--s7-auf-akzent); }
/* Farbe als roter Faden: in jedem Bild nur das Ergebnis des Schritts in der Akzentfarbe */
.s7-mini i.ziel, .s7-mini__lead.ziel, .s7-mini__balken i.ziel { border-color: transparent; background: var(--s7-akzent-verlauf); color: var(--s7-auf-akzent); }
.s7-mini__lead.ziel { color: color-mix(in srgb, var(--s7-auf-akzent) 85%, transparent); }
.s7-mini__lead.ziel b { color: var(--s7-auf-akzent); }
.s7-ablauf__schritt:not(:last-child) .s7-ablauf__bild::after { content: ""; position: absolute; top: 50%; right: calc(-1 * clamp(2rem, 4vw, 3.6rem) / 2 - .55rem); width: 1.1rem; height: 1.1rem; border-top: 2px solid var(--s7-tinte); border-right: 2px solid var(--s7-tinte); transform: translateY(-50%) rotate(45deg); }
.s7-ablauf__nr { margin-top: 1.6rem; color: var(--s7-grau); font-size: .95rem; font-weight: 600; }
.s7-stil .s7-ablauf h3 { margin-top: .4rem; font-size: clamp(1.4rem, 2vw, 1.7rem); line-height: 1.2; }
.s7-ablauf__t { margin-top: .6rem; font-size: 1.02rem; line-height: 1.55; text-wrap: pretty; }
.s7-ablauf .s7-link { margin-top: 1rem; align-self: start; }

/* ---------- Zielgruppen: Bild + Liste ---------- */
.s7-zg-bild { margin: 3rem auto 0; max-width: 56rem; }
.s7-zg-bild img { width: 100%; }
.s7-zg-listen { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(2rem, 5vw, 4rem); margin-top: 3rem; }
.s7-zg-listen__titel { padding-bottom: .8rem; border-bottom: 2px solid var(--s7-tinte); color: var(--s7-tinte); font-size: .95rem; font-weight: 700; }
.s7-zg-listen ul { margin: 0; padding: 0; list-style: none; }
.s7-zg-listen a { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .85rem 0; border-bottom: 1px solid var(--s7-linie); text-decoration: none; }
.s7-zg-listen b { color: var(--s7-tinte); font-weight: 600; }
.s7-zg-listen span { color: var(--s7-grau); font-size: .92rem; text-align: right; }
.s7-zg-listen a:hover b { text-decoration: underline; }

/* ---------- Pakete ---------- */
.s7-pakete { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: auto repeat(7, auto); column-gap: 1.2rem; margin-top: 3rem; }
.s7-gruppe { grid-row: 1; display: flex; align-items: center; gap: .8rem; margin-bottom: 1rem; color: var(--s7-tinte); font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
.s7-gruppe::after { content: ""; flex: 1; height: 2px; background: var(--s7-tinte); }
.s7-gruppe--a { grid-column: 1 / span 2; }
.s7-gruppe--b { grid-column: 3; }
.s7-paket { display: grid; grid-row: 2 / span 7; grid-template-rows: subgrid; row-gap: 0; padding: 2rem 2rem 1.8rem; border: 1px solid var(--s7-linie); border-radius: var(--s7-rund); background: var(--s7-karte); box-shadow: var(--s7-schatten); }
.s7-paket--komplett { border-color: transparent; background: var(--s7-komplett-grund); color: var(--s7-komplett-text); }
.s7-stil .s7-paket--komplett h3, .s7-paket--komplett .s7-paket__preis b { color: var(--s7-komplett-titel); }
.s7-stil .s7-paket h3 { font-size: 1.7rem; line-height: 1.2; }
.s7-paket__fuer { margin-top: .5rem; font-size: 1rem; line-height: 1.5; }
.s7-paket__preis { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid var(--s7-linie); color: var(--s7-grau); font-size: .9rem; }
.s7-paket--komplett .s7-paket__preis { border-top-color: color-mix(in srgb, var(--s7-komplett-text) 25%, transparent); color: color-mix(in srgb, var(--s7-komplett-text) 75%, transparent); }
.s7-paket__preis span { display: block; margin-top: .15rem; }
.s7-paket__preis b { display: block; color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: 1.9rem; font-weight: 700; line-height: 1.15; }
.s7-paket__vorspann { margin-top: 1.2rem; font-size: .88rem; font-weight: 600; color: var(--s7-tinte); min-height: 1.3em; }
.s7-paket--komplett .s7-paket__vorspann { color: var(--s7-komplett-titel); }
.s7-paket ul { list-style: none; margin: .5rem 0 0; padding: 0; }
.s7-paket li { position: relative; padding: .45rem 0 .45rem 1.6rem; font-size: .98rem; line-height: 1.45; }
.s7-paket li::before { content: ""; position: absolute; left: .15rem; top: .85rem; width: .7rem; height: .35rem; border-left: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(-45deg); }
.s7-paket--komplett li::before { color: var(--s7-komplett-haken); }
.s7-paket .s7-knopf { margin-top: 1.4rem; align-self: end; justify-content: center; }
.s7-paket--komplett .s7-knopf { border-color: var(--s7-komplett-titel); background: var(--s7-komplett-titel); color: var(--s7-komplett-knopf-text); }
.s7-pakete__fuss { margin-top: 1.4rem; color: var(--s7-grau); font-size: .95rem; }

/* ---------- Zielgruppen · Vertrauen · Kontakt (nur Startseite) ---------- */
.s7-zg__fuss { margin-top: 2rem; }
.s7-stil .s7-vertrauen .s7-h2 { max-width: none; }

.s7-vertrauen { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(2rem, 5vw, 4rem); align-items: stretch; }
.s7-vertrauen__text { padding: 1rem 0; }

.s7-zitat { margin: 2rem 0 0; padding: 0 0 0 1.2rem; border-left: 2px solid var(--s7-tinte); }
.s7-zitat p { color: var(--s7-tinte); font-size: 1.15rem; line-height: 1.6; }
.s7-zitat cite { display: block; margin-top: .5rem; color: var(--s7-grau); font-size: .9rem; font-style: normal; }
/* Gruppenbild in eigenem Rahmen: so hoch wie die Textspalte, das Bild steht unten auf der Kante und füllt die Breite (Schnittkanten = Rahmenkante) */
.s7-vertrauen__bild { display: flex; flex-direction: column; justify-content: space-between; margin: 0; padding-top: 1.4rem; border-radius: var(--s7-rund); background: var(--s7-flaeche); overflow: hidden; }
.s7-vertrauen__bild figcaption { padding: 0 1.6rem; color: var(--s7-grau); font-size: .9rem; }
.s7-nowrap { white-space: nowrap; }
@media (max-width: 600px) { .s7-vertrauen__bild figcaption { padding: 0 1rem; font-size: .8rem; } }
.s7-vertrauen__bild img { display: block; width: 107%; max-width: none; margin-right: -7%; mix-blend-mode: multiply; } /* helle Reste im Foto verschmelzen mit der Fläche */
.s7-kontakt { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem 4rem; align-items: end; }
.s7-kontakt .s7-lead { max-width: 30rem; color: #cfcfcf; text-wrap: balance; }
.s7-kontakt__wege { display: grid; gap: .8rem; justify-items: start; }
.s7-kontakt__wege .s7-knopf { border-color: #fff; background: #fff; color: var(--s7-tinte); }
.s7-kontakt__team { display: flex; align-items: center; gap: .9rem; max-width: 20rem; margin-bottom: .6rem; color: #cfcfcf; font-size: .9rem; line-height: 1.4; }
.s7-kontakt__team span { display: flex; flex: none; }
.s7-kontakt__team img { width: 2.9rem; height: 2.9rem; border: 2px solid var(--s7-tinte); border-radius: 50%; object-fit: cover; }
.s7-kontakt__team img + img { margin-left: -.8rem; }
.s7-kontakt__wege a:not(.s7-knopf) { color: #fff; text-decoration: none; }
.s7-fuss { padding: 2rem 0; background: var(--s7-tinte); color: #888; font-size: .85rem; }
.s7-fuss .s7-wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
.s7-fuss a { color: #bbb; text-decoration: none; margin-left: 1.2rem; }


/* ---------- Für Vertriebsleiter (vl7-) ---------- */
/* Regionsgrafik: Kasten wie neben der Maschine, Ziel als Farbfläche (das Ergebnis), Pille gestrichelt für weitere Büros */
.ek2-kasten { fill: var(--s7-grund); stroke: var(--s7-tinte); stroke-width: 2; }
.ek2-pille { fill: var(--s7-grund); stroke: var(--s7-tinte); stroke-width: 1.4; }
.ek2-pille--mehr { stroke: var(--s7-grau); stroke-dasharray: 4 3; }
.ek2-ziel { fill: var(--s7-akzent-fill); }
.ek2-ziel-t { fill: var(--s7-auf-akzent); }
.vl7-problem { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
.s7-stil .vl7-h2 { max-width: 16ch; }
.vl7-problem .s7-lead:first-child { margin-top: 2.2rem; }
.vl7-problem .s7-lead + .s7-lead { margin-top: .9rem; }
.vl7-loesung .vs7-weg { background: var(--s7-flaeche); }
.vl7-link { margin-top: 1.6rem; }
.vl7-schritte { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; margin: 3rem 0 0; padding: 0; list-style: none; }
.vl7-schritte li { padding: clamp(1.6rem, 2.6vw, 2.2rem); border-radius: var(--s7-rund); background: var(--s7-karte); }
.vl7-schritte span { color: var(--s7-grau); font-weight: 600; }
.s7-stil .vl7-schritte h3 { margin-top: .5rem; font-size: clamp(1.4rem, 2vw, 1.7rem); line-height: 1.2; }
.vl7-schritte p { margin-top: .6rem; text-wrap: pretty; }
.vl7-schritte--sparring { background: var(--s7-komplett-grund) !important; color: #fff; }
.s7-stil .vl7-schritte--sparring h3, .vl7-schritte--sparring span { color: #fff; }
.vl7-zitat { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; max-width: 60rem; }
.vl7-zitat__bild { display: flex; align-items: flex-end; justify-content: center; margin: 0; border-radius: 50%; background: var(--s7-flaeche); overflow: hidden; aspect-ratio: 1; }
.vl7-zitat__bild img { display: block; width: 84%; height: auto; mix-blend-mode: multiply; } /* Kopf mit Luft zum Kreisrand, Schultern laufen unten aus */
.vl7-zitat blockquote { margin: 0; }
.vl7-zitat blockquote p { color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: clamp(1.5rem, 2.6vw, 2.1rem); font-weight: 700; line-height: 1.25; letter-spacing: -0.02em; text-wrap: balance; }
.vl7-zitat cite { display: block; margin-top: 1rem; color: var(--s7-grau); font-style: normal; }
@media (max-width: 1000px) { .vl7-problem, .vl7-schritte { grid-template-columns: minmax(0, 1fr); } .vl7-problem .s7-lead:first-child { margin-top: 0; } }
@media (max-width: 600px) { .vl7-zitat { grid-template-columns: minmax(0, 1fr); } .vl7-zitat__bild { width: 9rem; } }

/* ---------- Preise (pr7-) ---------- */
.pr7-held { padding-bottom: 0; }
.pr7-offen { display: inline-block; margin-top: 1.2rem; padding: .5rem .9rem; border: 1.5px dashed var(--s7-grau); border-radius: 10px; color: var(--s7-text); font-size: .95rem; }
.pr7-tabelle { margin-top: 2.4rem; padding: clamp(1.2rem, 2.6vw, 2.2rem); border-radius: var(--s7-rund); background: var(--s7-karte); }
.pr7-kopf, .pr7-zeile { display: grid; grid-template-columns: minmax(0, 2.2fr) repeat(3, minmax(0, 1fr)); gap: 1rem; align-items: center; }
.pr7-kopf { position: sticky; top: 72px; z-index: 2; padding: .8rem 0 1rem; background: var(--s7-karte); border-bottom: 2px solid var(--s7-tinte); }
.pr7-kopf b { color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: 1.35rem; font-weight: 700; text-align: center; }
.pr7-kopf b.pr7-komplett { color: transparent; background-image: var(--s7-wort-verlauf); -webkit-background-clip: text; background-clip: text; }
.pr7-gruppe { margin: 1.8rem 0 .3rem; color: var(--s7-grau); font-size: .9rem; font-weight: 600; }
.pr7-zeile { padding: .85rem 0; border-bottom: 1px solid var(--s7-linie); }
.pr7-zeile > span:first-child { color: var(--s7-tinte); }
.pr7-zelle { text-align: center; font-size: .95rem; line-height: 1.35; }
.pr7-zelle--offen { color: var(--s7-grau); font-style: italic; }
.pr7-ja { display: inline-block; width: .8rem; height: .42rem; border-left: 2px solid var(--s7-tinte); border-bottom: 2px solid var(--s7-tinte); transform: translateY(-2px) rotate(-45deg); }
.pr7-nein { color: var(--s7-grau); font-style: normal; }
.pr7-zeile--preis { border-bottom: 0; padding-top: 1.4rem; }
.pr7-zeile--preis b { display: block; color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: 1.6rem; font-weight: 700; }
.pr7-zeile--preis .pr7-zelle--offen b { color: var(--s7-grau); font-size: 1.1rem; }
.pr7-zeile--preis small { color: var(--s7-grau); font-size: .85rem; }
.pr7-erg { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; margin-top: 2.6rem; }
.pr7-erg__karte { display: flex; flex-direction: column; padding: clamp(1.6rem, 2.6vw, 2.2rem); border: 1px solid var(--s7-linie); border-radius: var(--s7-rund); }
.s7-stil .pr7-erg__karte h3 { font-size: 1.5rem; line-height: 1.2; }
.pr7-erg__karte > p:not(.pr7-erg__preis) { margin-top: .6rem; text-wrap: pretty; }
.pr7-erg__preis { display: grid; margin-top: auto; padding-top: 1.4rem; }
.pr7-erg__preis b { color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; }
.pr7-erg__preis span { color: var(--s7-grau); font-size: .9rem; }
.pr7-fuss { margin-top: 1.6rem; }
.pr7-hinweise { margin: 1.4rem 0 0; padding: 0; list-style: none; color: var(--s7-grau); font-size: .95rem; }
.pr7-hinweise li { margin-top: .3rem; }
@media (max-width: 1000px) { .pr7-erg { grid-template-columns: minmax(0, 1fr); } }
@media (max-width: 700px) {
  .pr7-kopf, .pr7-zeile { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; }
  .pr7-kopf > span:first-child { display: none; }
  .pr7-zeile > span:first-child { grid-column: 1 / -1; font-weight: 600; }
  .pr7-kopf b { font-size: 1.05rem; }
  .pr7-zelle { font-size: .85rem; }
}

/* ---------- Kontakt und Termin (ks7-): kompakt – Kopfzeile und Kalender in voller Breite auf einem Bildschirm (Cal.com zeigt ab ~900px drei Spalten) ---------- */
.ks7 { padding: clamp(1.4rem, 2.6vw, 2.2rem) 0 var(--s7-band); }
.ks7__kopf { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1.4rem clamp(2rem, 5vw, 4rem); align-items: end; }
.s7-stil .ks7__h1 { font-size: clamp(1.9rem, 3vw, 2.5rem); line-height: 1.1; }
.ks7 .s7-kicker { margin-bottom: .5rem; }
.ks7__lead { margin-top: .5rem; font-size: 1.05rem; }
.ks7__ablauf { display: flex; flex-wrap: wrap; gap: .3rem 1.4rem; margin: .7rem 0 0; padding: 0; list-style: none; counter-reset: k; color: var(--s7-tinte); font-size: .95rem; }
.ks7__ablauf li { counter-increment: k; }
.ks7__ablauf li::before { content: counter(k) " "; margin-right: .35rem; color: var(--s7-grau); font-weight: 700; }
.ks7__wir { display: grid; grid-template-columns: 13rem auto; gap: 1rem; align-items: end; }
.ks7__team { margin: 0; border-radius: 16px; background: var(--s7-flaeche); overflow: hidden; }
.ks7__team img { display: block; width: 100%; mix-blend-mode: multiply; }
.ks7__team figcaption { padding: .4rem .8rem .55rem; color: var(--s7-grau); font-size: .78rem; }
.ks7__wege { display: grid; gap: .3rem; }
.ks7__wege a { color: var(--s7-tinte); text-decoration: none; white-space: nowrap; }
.ks7__wege a:hover { text-decoration: underline; }
.ks7__kalender { margin-top: 1.2rem; padding: .6rem; border: 1px solid var(--s7-linie); border-radius: var(--s7-rund); background: #fff; }
.ks7__kalender > div { width: 100%; min-height: 33rem; }
@media (max-width: 1000px) {
  .ks7__kopf { grid-template-columns: minmax(0, 1fr); }
  .ks7__ablauf { display: grid; }
}
@media (max-width: 600px) { .ks7__wir { grid-template-columns: 8.5rem auto; } .ks7__team figcaption { display: none; } .ks7__wege a { font-size: .95rem; } }

/* ---------- Strategiekompass (ko7-): Konfigurator im Story-7-Stil, Farbe nur in der Zusammenfassung (das Ergebnis) ---------- */
.ko7-held { padding-bottom: 1rem; }
.ko7-app { padding-bottom: var(--s7-band); }
.kg.ko7 { --ink: var(--s7-tinte); --ink-2: var(--s7-text); --ink-3: var(--s7-grau); --line: var(--s7-linie); --line-2: var(--s7-linie); --panel: var(--s7-flaeche); --sel: var(--s7-tinte); --link: var(--s7-tinte); font-family: var(--s7-schrift-text); }
.s7-stil .kg.ko7 :is(h2, h3) { font-family: var(--s7-schrift-titel); font-weight: 700; letter-spacing: -0.025em; }
.s7-stil .kg.ko7 .q h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); }
.kg.ko7 .q { padding-block: 3.4rem .5rem; }
.kg.ko7 .q:first-child { padding-top: 1.5rem; }
.kg.ko7 .tile { border-radius: 18px; }
.kg.ko7 .tile b { font-size: 1.05rem; }
.kg.ko7 .tile .ic { display: none; } /* Story 7 ohne Icons */
.kg.ko7 .textlink { color: var(--s7-tinte); font-weight: 600; }
.kg.ko7 .rn { font-weight: 600; }
.kg.ko7 .g aside { top: 96px; margin-top: 1.5rem; }
.kg.ko7 .summary { padding: 1.8rem; border-radius: var(--s7-rund); background: var(--s7-komplett-grund); color: #fff; }
.s7-stil .kg.ko7 .summary h3 { color: #fff; font-size: 1.6rem; }
.kg.ko7 .summary .satz { color: rgba(255, 255, 255, .85); }
.kg.ko7 .summary .satz b { color: #fff; }
.kg.ko7 .summary .lbl { color: rgba(255, 255, 255, .75); font-weight: 600; }
.kg.ko7 .summary li { border-color: rgba(255, 255, 255, .3); color: #fff; }
.kg.ko7 .summary li small { color: rgba(255, 255, 255, .75); }
.kg.ko7 .price-leer { height: 1.4rem; }
.kg.ko7 .summary .btn { background: #fff; color: var(--s7-komplett-knopf-text); font-weight: 600; padding: 15px 22px; }
.kg.ko7 .summary .btn:disabled { background: rgba(255, 255, 255, .3); color: rgba(255, 255, 255, .8); }
.kg.ko7 .summary .fine { color: rgba(255, 255, 255, .8); font-size: .85rem; line-height: 1.45; }

/* ---------- Zielgruppenseite (zg7-), Vorlage für alle 20 ---------- */
.zg7-anlaesse { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .5rem; margin: 1.4rem auto 0; max-width: 46rem; }
.zg7-anlaesse span { color: var(--s7-grau); font-size: .95rem; font-weight: 600; }
.zg7-anlaesse b { padding: .25rem .8rem; border: 1.5px solid var(--s7-tinte); border-radius: 99px; color: var(--s7-tinte); font-size: .9rem; font-weight: 600; }
.s7-stil .s7-held .zg7-h1 { max-width: 20ch; font-size: clamp(2.6rem, 6.2vw, 5.4rem); }
.zg7-wer { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; margin-top: 3rem; }
.zg7-wer__karte { padding: clamp(1.6rem, 2.6vw, 2.2rem); border-radius: var(--s7-rund); background: var(--s7-karte); }
.s7-stil .zg7-wer__karte h3 { font-size: clamp(1.4rem, 2vw, 1.7rem); line-height: 1.2; }
.zg7-wer__karte ul { margin: 1rem 0 0; padding: 0; list-style: none; }
.zg7-wer__karte li { padding: .6rem 0; border-top: 1px solid var(--s7-linie); line-height: 1.45; }
.zg7-fragen { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
.zg7-faq details { border-top: 1px solid var(--s7-linie); }
.zg7-faq details:last-child { border-bottom: 1px solid var(--s7-linie); }
.zg7-faq summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.3rem 0; color: var(--s7-tinte); font-size: 1.15rem; font-weight: 600; cursor: pointer; list-style: none; }
.zg7-faq summary::-webkit-details-marker { display: none; }
.zg7-faq summary::after { content: "+"; flex: none; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--s7-flaeche); font-size: 1.3rem; font-weight: 400; transition: transform .2s ease; }
.zg7-faq details[open] summary::after { transform: rotate(45deg); }
.zg7-faq__a { padding: 0 0 1.4rem; }
.zg7-faq__a p + p, .zg7-faq__a ul { margin-top: .7rem; }
.zg7-faq__a strong { color: var(--s7-tinte); }
.zg7-faq__a ul { padding-left: 1.2rem; }
.zg7-faq__a li { margin: .3rem 0; }
.zg7-weitere .vs7-reihe { margin-top: 0; }
.s7-stil .zg7-weitere__h2 { flex: 1; font-size: clamp(1.6rem, 2.6vw, 2.2rem); line-height: 1.15; }
.zg7-weitere .vs7-karte { background: var(--s7-karte); }
.zg7-alle { margin-top: 1.6rem; }
@media (max-width: 1000px) {
  .zg7-wer, .zg7-fragen { grid-template-columns: minmax(0, 1fr); }
}

/* ---------- Unterseite Vertriebsstrecken (vs7-) ---------- */
.vs7-lead { max-width: 44rem !important; }
.vs7-held__bild { margin: clamp(2.5rem, 5vw, 4rem) 0 0; padding: clamp(.5rem, 1.5vw, 1.2rem) clamp(.5rem, 2vw, 2rem) 0; border-radius: calc(var(--s7-rund) * 1.4); background: var(--s7-flaeche); overflow: hidden; }
.vs7-held__bild img { display: block; width: 100%; margin: -8% auto 0; } /* oberer Rand des Bilds ist durchsichtig */ /* Bild steht unten auf der Kante der Bühne */
/* Drei Wege: gleich hohe Kacheln, echtes Bild läuft über rechte und untere Kante (Anschnitt) */
.vs7-wege { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; margin-top: 3rem; }
.vs7-weg { position: relative; display: flex; flex-direction: column; min-height: 27rem; padding: clamp(1.8rem, 3vw, 2.4rem) clamp(1.6rem, 2.6vw, 2.2rem) 0; border-radius: var(--s7-rund); background: var(--s7-karte); overflow: hidden; }
.s7-stil .vs7-weg h3 { font-size: clamp(1.6rem, 2.4vw, 2rem); line-height: 1.15; }
.vs7-weg p { margin-top: .6rem; max-width: 22rem; text-wrap: pretty; }
.vs7-weg img { width: 175%; max-width: none; margin: 1.6rem 0 -10% 0; align-self: flex-start; }
/* Zielgruppen: Wisch-Reihen mit großen Karten */
.vs7-reihe { margin-top: 3rem; }
.vs7-reihe__kopf { display: flex; align-items: center; gap: 1.2rem; margin-bottom: 1.2rem; }
.vs7-reihe__kopf .vs7-gruppe { flex: 1; margin: 0; }
.vs7-reihe__pfeile { display: flex; gap: .5rem; }
.vs7-reihe__pfeile button { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; padding: 0 0 .15rem; border: 0; border-radius: 50%; background: var(--s7-flaeche); color: var(--s7-tinte); font-size: 1.5rem; line-height: 1; cursor: pointer; }
.vs7-reihe__pfeile button:hover { background: var(--s7-linie); }
.vs7-reihe__pfeile button:focus { outline: none; }
.vs7-reihe__pfeile button:focus-visible { background: var(--s7-linie); }
.vs7-scroller { display: grid; grid-auto-flow: column; grid-auto-columns: clamp(16.5rem, 23vw, 20rem); gap: 1rem; margin: 0 calc(50% - 50vw) 0 0; padding: 0 1.25rem .5rem 0; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
.vs7-scroller::-webkit-scrollbar { display: none; }
.vs7-scroller li { scroll-snap-align: start; }
.vs7-karte { position: relative; display: flex; flex-direction: column; height: 20rem; padding: 1.6rem 1.5rem 0; border-radius: var(--s7-rund); background: var(--s7-flaeche); color: var(--s7-tinte); text-decoration: none; overflow: hidden; }
.vs7-karte__anlass { color: var(--s7-grau); font-size: .9rem; font-weight: 600; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.vs7-karte b { margin-top: .35rem; font-family: var(--s7-schrift-titel); font-size: clamp(1.5rem, 2vw, 1.75rem); font-weight: 700; line-height: 1.12; letter-spacing: -0.02em; }
.vs7-karte img { width: 170%; max-width: none; margin: auto 0 -14% 0; transform-origin: left bottom; transition: transform .3s ease; }
.vs7-karte:hover img { transform: scale(1.03); }
.vs7-kompass { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-top: 3rem; padding: 1.4rem 1.8rem; border-radius: var(--s7-rund); background: var(--s7-flaeche); color: var(--s7-tinte); font-weight: 600; }
@media (max-width: 1100px) {
}
@media (max-width: 760px) {
  .vs7-wege { grid-template-columns: minmax(0, 1fr); }
  .vs7-weg { min-height: 0; }
  .vs7-weg img { width: 115%; margin: 1.6rem 0 -8% 0; }
}
@media (max-width: 600px) {
  .vs7-scroller { grid-auto-columns: 78%; }
  .vs7-karte { height: 19rem; }
}

/* ---------- Seitenplan (sp7-) ---------- */
.s7-stil .sp7-h1 { font-size: var(--s7-h2); line-height: var(--s7-h2-hoehe); }
.sp7-legende { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.6rem; }
.sp7-stand { justify-self: start; display: inline-block; padding: .15rem .65rem; border: 1.5px solid var(--s7-tinte); border-radius: 99px; color: var(--s7-tinte); font-size: .8rem; font-weight: 600; }
.sp7-stand--gebaut, .sp7-karte--gebaut .sp7-stand { border-color: transparent; background: var(--s7-akzent-verlauf); color: var(--s7-auf-akzent); }
.sp7-stand--fehlt, .sp7-karte--fehlt .sp7-stand { border-style: dashed; }
.sp7-stand--stufe2, .sp7-karte--stufe2 .sp7-stand { border-color: var(--s7-grau); color: var(--s7-grau); }
.sp7-baum { margin-top: 3rem; }
.sp7-wurzel { position: relative; display: flex; justify-content: center; padding-bottom: 2.4rem; }
.sp7-wurzel .sp7-karte { width: min(100%, 26rem); }
.sp7-wurzel::after { content: ""; position: absolute; left: 50%; bottom: 0; height: 2.4rem; border-left: 2px solid var(--s7-tinte); }
.sp7-ebene { position: relative; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: .7rem; padding-top: 2rem; } /* so viele Spalten wie Äste */
.s7-stil .sp7-ebene .sp7-karte h3 { font-size: 1.05rem; hyphens: auto; -webkit-hyphens: auto; }
.sp7-ebene .sp7-karte { font-size: .85rem; overflow-wrap: break-word; }
.sp7-ast { min-width: 0; }
.sp7-ast .sp7-karte, .sp7-ast .sp7-unter { min-width: 0; }
.sp7-ast { position: relative; display: grid; align-content: start; gap: .8rem; }
.sp7-ast::before { content: ""; position: absolute; left: 50%; top: -2rem; height: 2rem; border-left: 2px solid var(--s7-tinte); }
.sp7-ast::after { content: ""; position: absolute; left: -.4rem; right: -.4rem; top: -2rem; border-top: 2px solid var(--s7-tinte); }
.sp7-ast:first-child::after { left: 50%; }
.sp7-ast:last-child::after { right: 50%; }
.sp7-karte { display: grid; align-content: start; gap: .5rem; padding: 1.1rem .9rem; border: 1px solid var(--s7-linie); border-radius: 16px; background: var(--s7-karte); font-size: .92rem; line-height: 1.45; }
.sp7-karte--fehlt { border-style: dashed; border-color: var(--s7-grau); }
.sp7-karte--stufe2 { background: var(--s7-flaeche); }
.s7-stil .sp7-karte h3 { font-size: 1.2rem; line-height: 1.2; }
.sp7-karte h3 a, .sp7-unter h4 a { text-decoration: none; }
.sp7-karte h3 a:hover, .sp7-unter h4 a:hover { text-decoration: underline; }
.sp7-zusatz { color: var(--s7-grau); font-size: .85rem; }
.sp7-frage { color: var(--s7-tinte); font-weight: 500; }
.sp7-karte dl { display: grid; gap: .1rem; margin: .2rem 0 0; }
.sp7-karte dt { color: var(--s7-grau); font-size: .78rem; font-weight: 600; }
.sp7-karte dd { margin: 0 0 .35rem; }
.sp7-offen { padding: .5rem .6rem; border-radius: 8px; background: var(--s7-flaeche); font-size: .85rem; }
.sp7-unter { display: grid; gap: .35rem; margin-left: 1rem; padding: .9rem 1rem; border-left: 2px solid var(--s7-tinte); background: var(--s7-flaeche); border-radius: 0 12px 12px 0; font-size: .88rem; line-height: 1.45; }
.sp7-unter h4 { margin: 0; color: var(--s7-tinte); font-size: 1rem; }
.sp7-immer { display: flex; justify-content: center; margin-top: 2.4rem; }
.sp7-immer .sp7-karte { width: min(100%, 26rem); }
.sp7-neben { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; margin-top: 3.4rem; }
.s7-stil .sp7-h2 { font-size: 1.4rem; }
.sp7-liste { margin: .8rem 0 0; padding: 0; list-style: none; }
.sp7-liste li { display: grid; gap: .1rem; padding: .7rem 0; border-top: 1px solid var(--s7-linie); }
.sp7-liste a, .sp7-liste b { color: var(--s7-tinte); font-weight: 600; }
.sp7-liste span { color: var(--s7-grau); font-size: .92rem; }
.sp7-schritte { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 2rem 1.6rem; margin: 2.6rem 0 0; padding: 0; list-style: none; }
.sp7-schritte li { padding-top: 1rem; border-top: 2px solid var(--s7-tinte); }
.sp7-schritte span { color: var(--s7-grau); font-weight: 600; }
.s7-stil .sp7-schritte h3 { margin-top: .3rem; font-size: 1.25rem; line-height: 1.25; }
.sp7-schritte p { margin-top: .4rem; font-size: .95rem; }
.sp7-schritte--erledigt { border-top-color: var(--s7-linie) !important; }
.sp7-schritte--erledigt h3, .sp7-schritte--erledigt p { color: var(--s7-grau) !important; }
.sp7-fuss { margin-top: 2rem; color: var(--s7-grau); }
@media (max-width: 1300px) {
  .sp7-ebene { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: 1.4rem; }
  .sp7-ast::before, .sp7-ast::after, .sp7-wurzel::after { display: none; }
  .sp7-wurzel { padding-bottom: 1.4rem; }
}
@media (max-width: 1100px) {
  .sp7-ebene { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.4rem; }
  .sp7-ast::before, .sp7-ast::after, .sp7-wurzel::after { display: none; }
  .sp7-wurzel { padding-bottom: 1.4rem; }
  .sp7-schritte { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 700px) {
  .sp7-ebene { grid-template-columns: minmax(0, 1fr); padding-top: 0; }
  .sp7-neben, .sp7-schritte { grid-template-columns: minmax(0, 1fr); }
}

/* ---------- Unterseite Marketing as a Service (mx7-) ---------- */
/* Bausteine: links die Basis als Farbfläche (dort landet das Auge), rechts „dazu buchbar“ als ruhige Liste – keine verschachtelten Kästen */
.mx7-bs { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 1.2rem; margin-top: 3rem; }
.mx7-marke { color: var(--s7-grau); font-size: .95rem; font-weight: 600; }
.mx7-basis { display: flex; flex-direction: column; padding: clamp(1.8rem, 3.4vw, 3rem); border-radius: var(--s7-rund); background: var(--s7-komplett-grund); color: var(--s7-komplett-text); }
.mx7-basis .mx7-marke { color: var(--s7-komplett-text); }
.s7-stil .mx7-basis h3 { margin-top: .6rem; color: #fff; font-size: clamp(1.7rem, 2.4vw, 2.1rem); line-height: 1.15; }
.mx7-basis__preis { display: flex; align-items: baseline; gap: .6rem; margin-top: 1.4rem; }
.mx7-basis__preis b { color: #fff; font-family: var(--s7-schrift-titel); font-size: clamp(3rem, 5vw, 4.2rem); font-weight: 700; line-height: 1; letter-spacing: -0.03em; }
.mx7-basis__kurz { margin-top: 1.4rem; text-wrap: pretty; }
.mx7-basis__gruppen { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.4rem; margin-top: 1.8rem; padding-top: 1.6rem; border-top: 1px solid color-mix(in srgb, #fff 30%, transparent); }
.mx7-basis__g { margin-bottom: .3rem; color: #fff; font-weight: 600; }
.mx7-basis .mx7-haken li { color: #fff; }
.mx7-basis__knopf { align-self: flex-start; margin-top: auto; border-color: #fff; background: #fff; color: var(--s7-komplett-knopf-text); font: inherit; font-weight: 600; cursor: pointer; }
.mx7-basis__gruppen + .mx7-basis__knopf { margin-top: 2rem; }
.mx7-haken { list-style: none; margin: 0; padding: 0; }
.mx7-haken li { position: relative; padding: .4rem 0 .4rem 1.6rem; font-size: 1rem; line-height: 1.45; }
.mx7-haken li::before { content: ""; position: absolute; left: .15rem; top: .8rem; width: .7rem; height: .35rem; border-left: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(-45deg); }
.mx7-dazu { display: flex; flex-direction: column; padding: clamp(1.8rem, 3.4vw, 3rem); border-radius: var(--s7-rund); background: var(--s7-karte); }
.mx7-erg { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem 2rem; flex: 1; align-content: center; padding: 1.6rem 0; border-bottom: 1px solid var(--s7-linie); }
.mx7-erg:last-of-type { border-bottom: 0; padding-bottom: 0; }
.mx7-dazu .mx7-marke + .mx7-erg { padding-top: 1rem; }
.s7-stil .mx7-erg h3 { font-size: clamp(1.35rem, 1.8vw, 1.6rem); line-height: 1.2; }
.mx7-erg__text > p { margin-top: .4rem; text-wrap: pretty; }
.mx7-erg__punkte { color: var(--s7-grau); font-size: .92rem; }
.mx7-erg__preis { display: flex; flex-direction: column; align-items: flex-end; text-align: right; }
.mx7-erg__preis b { color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: 2rem; font-weight: 700; line-height: 1.1; letter-spacing: -0.02em; white-space: nowrap; }
.mx7-erg__preis span { color: var(--s7-grau); font-size: .9rem; }
.mx7-mehr { display: inline-flex; align-items: center; gap: .45rem; margin-top: .8rem; padding: 0; border: 0; background: none; color: var(--s7-tinte); font: inherit; font-weight: 600; cursor: pointer; white-space: nowrap; }
.mx7-mehr:hover { text-decoration: underline; }
.mx7-fuss { margin-top: 1.4rem; color: var(--s7-grau); font-size: .95rem; }

/* Die ersten 30 Tage: Zeitleiste, der letzte Punkt (erster Report) in Farbe; darunter, was an dir hängt */
.mx7-zeit { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(4, auto); column-gap: clamp(1.4rem, 3vw, 2.6rem); margin: 3.4rem 0 0; padding: 0; list-style: none; }
.mx7-zeit__schritt { position: relative; display: grid; grid-row: span 4; grid-template-rows: subgrid; row-gap: 0; }
.mx7-zeit__wann { color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: 1.05rem; font-weight: 700; }
.mx7-zeit__punkt { position: relative; height: 2.6rem; }
.mx7-zeit__punkt::before { content: ""; position: absolute; left: 0; right: calc(-1 * clamp(1.4rem, 3vw, 2.6rem)); top: 50%; height: 2px; background: var(--s7-tinte); }
.mx7-zeit__schritt:last-child .mx7-zeit__punkt::before { right: 0; }
.mx7-zeit__punkt::after { content: ""; position: absolute; left: 0; top: 50%; width: 1.1rem; height: 1.1rem; border: 2px solid var(--s7-tinte); border-radius: 50%; background: var(--s7-grund); transform: translateY(-50%); }
.mx7-zeit__schritt--ziel .mx7-zeit__punkt::after { width: 1.5rem; height: 1.5rem; border: 0; background: var(--s7-akzent-verlauf); }
.s7-stil .mx7-zeit h3 { font-size: clamp(1.4rem, 2vw, 1.7rem); line-height: 1.2; }
.mx7-zeit__t { margin-top: .5rem; text-wrap: pretty; }
.mx7-aufwand { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem 2rem; margin-top: 3.4rem; padding: 1.4rem 1.8rem; border-radius: var(--s7-rund); background: var(--s7-flaeche); }
.mx7-aufwand__titel { color: var(--s7-tinte); font-weight: 700; }
.mx7-aufwand ul { display: flex; flex-wrap: wrap; gap: .5rem 1.8rem; margin: 0; padding: 0; list-style: none; }
.mx7-aufwand li { position: relative; padding-left: 1.4rem; }
.mx7-aufwand li::before { content: ""; position: absolute; left: .1rem; top: .55rem; width: .6rem; height: .3rem; border-left: 2px solid var(--s7-tinte); border-bottom: 2px solid var(--s7-tinte); transform: rotate(-45deg); }

/* Download */
.mx7-dl { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
.mx7-dl__bild { position: relative; aspect-ratio: 5 / 4; }
.mx7-dl__seite { position: absolute; width: 52%; height: auto; border-radius: 6px; box-shadow: 0 24px 50px rgba(0, 0, 0, .14); }
.mx7-dl__seite--hinten { right: 6%; top: 4%; transform: rotate(5deg); }
.mx7-dl__seite--vorn { left: 6%; top: 8%; transform: rotate(-4deg); }
.mx7-dl__meta { display: flex; gap: 1.2rem; margin: 1.4rem 0 1.8rem; color: var(--s7-grau); font-size: .95rem; }

/* Beleg */
.mx7-beleg { text-align: center; }
.mx7-beleg blockquote { max-width: 46rem; margin: 0 auto; }
.mx7-beleg blockquote p { color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; text-wrap: balance; }
.mx7-beleg cite { display: block; margin-top: 1rem; color: var(--s7-grau); font-style: normal; }
.mx7-beleg__link { margin-top: 2rem; }
/* Grafik: Zielgruppen als Pillen */
.mx7-held .s7-lead { max-width: 46rem; }
/* Schnitt durch die Maschine: quer als Grafik, unter 820px als Liste */
.mx7-schnitt { display: none; gap: 2px; max-width: 36rem; margin: 0 auto; }
.mx7-schnitt__lage { display: grid; gap: .2rem; padding: 1rem 1.1rem; background: var(--s7-lage-1); color: var(--s7-tinte); font-size: .95rem; line-height: 1.45; }
.mx7-schnitt__lage p:first-child span { margin-left: .5rem; }
.mx7-schnitt__lage span { color: var(--s7-grau); font-size: .8rem; font-weight: 600; white-space: nowrap; }
.mx7-schnitt__lage--1 { order: 4; background: var(--s7-akzent-verlauf); color: var(--s7-auf-akzent); }
.mx7-schnitt__lage--1 span { color: inherit; }
.mx7-schnitt__lage--2 { order: 3; }
.mx7-schnitt__lage--3 { order: 2; background: var(--s7-lage-2); }
.mx7-schnitt__lage--4 { order: 1; border-radius: 12px 12px 0 0; background: var(--s7-lage-3); }
.mx7-schnitt__unten { display: block; height: .9rem; }
.mx7-schnitt__unten--1 { order: 5; background: var(--s7-lage-1); }
.mx7-schnitt__unten--2 { order: 6; background: var(--s7-lage-2); }
.mx7-schnitt__unten--3 { order: 7; border-radius: 0 0 12px 12px; background: var(--s7-lage-3); }
.mx7-schnitt__mess { order: 8; margin: .8rem 0 .5rem; color: var(--s7-tinte); font-size: .9rem; font-weight: 700; text-align: center; }
.mx7-schnitt__mess::before { content: "↓ "; }
.mx7-schnitt__vertrieb { order: 9; display: grid; gap: .1rem; padding: 1rem; border-radius: 12px; background: var(--s7-tinte); color: #fff; text-align: center; }
.mx7-schnitt__vertrieb span { color: #a1a1a6; font-size: .9rem; }
@media (max-width: 1100px) { .ek2--schnitt { display: none; } .mx7-schnitt { display: grid; text-align: left; } }

/* Pop-ups: hell und ruhig, Grundschrift */
.mx7-d { width: min(100% - 2rem, 46rem); max-height: 86vh; padding: clamp(1.6rem, 4vw, 2.6rem); border: 0; border-radius: var(--s7-rund); background: #fff; color: var(--s7-text); font-family: var(--s7-schrift-text); font-size: 1rem; line-height: 1.6; text-align: left; }
.mx7-d__zu { position: absolute; top: 1rem; right: 1rem; width: 2.2rem; height: 2.2rem; border: 0; border-radius: 50%; background: var(--s7-flaeche); color: var(--s7-tinte); font-size: 1.3rem; line-height: 1; cursor: pointer; }
.mx7-d__zu:focus { outline: none; }
.mx7-d__zu:focus-visible { background: var(--s7-linie); }
.mx7-d::backdrop { background: rgba(0, 0, 0, .35); backdrop-filter: blur(4px); }
.mx7-d__meta { color: var(--s7-grau); font-size: .9rem; font-weight: 600; }
.s7-stil .mx7-d h3 { margin: .3rem 2.5rem 1.2rem 0; font-size: 1.7rem; line-height: 1.2; }
.mx7-d > p + p { margin-top: .8rem; }
.mx7-d > .mx7-d__label { margin: 1.8rem 0 .4rem; color: var(--s7-tinte); font-weight: 700; }
.mx7-d__punkt { padding: .8rem 0; border-top: 1px solid var(--s7-linie); }
.mx7-d__punkt b { color: var(--s7-tinte); }
.mx7-d__punkt p { margin-top: .2rem; }
.mx7-d ul { margin: .4rem 0 0; padding-left: 1.2rem; }
.mx7-d li { margin: .25rem 0; }
.mx7-d__hinweis { margin-top: 1.6rem !important; color: var(--s7-grau); font-size: .9rem; }

@media (max-width: 1000px) {
  .mx7-bs, .mx7-dl { grid-template-columns: minmax(0, 1fr); }
  .mx7-zeit { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(8, auto); row-gap: 0; }
  .mx7-zeit__t { padding-bottom: 2.4rem; }
  .mx7-zeit__schritt:nth-child(2) .mx7-zeit__punkt::before { right: 0; }
  .mx7-dl__bild { max-width: 30rem; }
}
@media (max-width: 600px) {
  .mx7-zeit { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; }
  .mx7-zeit__schritt { grid-row: auto; grid-template-rows: none; }
  .mx7-zeit__punkt { display: none; }
  .mx7-zeit__wann { margin-bottom: .3rem; }
  .mx7-erg { grid-template-columns: minmax(0, 1fr); }
  .mx7-erg__preis { align-items: flex-start; text-align: left; }
  .mx7-basis__gruppen { grid-template-columns: minmax(0, 1fr); }
}

/* ===================================================================================
   STILRICHTUNGEN – jede setzt die Stellschrauben neu, dazu wenige eigene Regeln
   =================================================================================== */

/* 1 · Apple-klar: Weiß/Hellgrau, sehr große Grotesk, Verlauf nur punktuell */
.s7-stil--apple {
  --s7-schrift-titel: "Inter Tight", "Inter", system-ui, sans-serif;
  --s7-schrift-text: "Inter", system-ui, sans-serif;
  --s7-titel-gewicht: 700; --s7-titel-abstand: -0.025em;
  --s7-h1: clamp(3rem, 7.6vw, 6.6rem); --s7-h1-hoehe: 1.0;
  --s7-h2: clamp(2.3rem, 5vw, 4rem);   --s7-h2-hoehe: 1.05;
  --s7-grund: #ffffff; --s7-flaeche: #f5f5f7; --s7-tinte: #1d1d1f; --s7-text: #424245; --s7-grau: #86868b; --s7-linie: #e5e5ea;
  --s7-akzent: #e3e8ff; --s7-akzent-fill: url(#s7v-pastell); --s7-akzent-verlauf: linear-gradient(100deg, #dfe6ff, #eddcff); --s7-auf-akzent: #1d1d1f;
  --s7-wort: transparent; --s7-wort-verlauf: linear-gradient(100deg, #2f6bff 0%, #7b3fe4 55%, #b44ce0 100%);
  --s7-knopf-grund: #1d1d1f; --s7-knopf-text: #ffffff;
  --s7-buehne: #ffffff; --s7-band-akzent: #f5f5f7; --s7-karte: #ffffff;
  --s7-schatten: none;
  --s7-komplett-grund: #1d1d1f; --s7-komplett-text: #d2d2d7; --s7-komplett-titel: #ffffff; --s7-komplett-haken: #9d8cff;
  --s7-lage-1: #d5d5db; --s7-lage-2: #e1e1e6; --s7-lage-3: #ececf0;
  --s7-rund: 24px;
}
.s7-stil--apple .s7-held { text-align: center; }
.s7-stil--apple .s7-held h1, .s7-stil--apple .s7-held .s7-lead { margin-left: auto; margin-right: auto; }
.s7-stil--apple .s7-held__knoepfe { justify-content: center; }
.s7-stil--apple .s7-held .s7-lead { color: #6e6e73; }
.s7-stil--apple .s7-kicker { letter-spacing: .02em; text-transform: none; font-size: 1rem; font-weight: 600; color: #6e6e73; }
.s7-stil--apple .s7-pille--an, .s7-stil--apple .s7-dash__kachel--an, .s7-stil--apple .s7-strecke__ziel b { background: var(--s7-akzent-verlauf); }

/* Farbakzente für Apple-klar (Farbproben): Farbe immer vollflächig mit weißer Schrift, im Wort als Verlauf – keine zarten Tönungen */
.s7-farbe--cyanviolett {
  --s7-wort-verlauf: linear-gradient(100deg, #0b9fbd 0%, #8613a1 100%);
  --s7-akzent: #0b9fbd; --s7-akzent-verlauf: linear-gradient(100deg, #0b9fbd, #8613a1); --s7-akzent-fill: url(#s7v-cyanviolett); --s7-akzent-fill-hoch: url(#s7v-cyanviolett-h); --s7-akzent-ende: #8613a1; --s7-auf-akzent: #ffffff;
  --s7-komplett-grund: linear-gradient(140deg, #0b9fbd 0%, #8613a1 100%); --s7-komplett-text: #efe6f4; --s7-komplett-haken: #ffffff; --s7-komplett-knopf-text: #8613a1;
}
.s7-farbe--magentaviolett {
  --s7-wort-verlauf: linear-gradient(100deg, #c51f5d 0%, #8613a1 100%);
  --s7-akzent: #c51f5d; --s7-akzent-verlauf: linear-gradient(100deg, #c51f5d, #8613a1); --s7-akzent-fill: url(#s7v-magentaviolett); --s7-akzent-fill-hoch: url(#s7v-magentaviolett-h); --s7-akzent-ende: #8613a1; --s7-auf-akzent: #ffffff;
  --s7-komplett-grund: linear-gradient(140deg, #c51f5d 0%, #8613a1 100%); --s7-komplett-text: #f6e7ef; --s7-komplett-haken: #ffffff; --s7-komplett-knopf-text: #8613a1;
}
/* Flächen-Test (Farbproben) */
.fp-kacheln { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; margin-top: 2rem; }
.fp-k { display: flex; flex-direction: column; justify-content: space-between; gap: 1.6rem; min-height: 11rem; padding: 1.6rem; border-radius: var(--s7-rund); }
.fp-k b { display: block; font-size: .85rem; font-weight: 600; }
.fp-k small { display: block; margin-top: .2rem; font-size: .85rem; opacity: .8; }
.fp-k--voll { background: var(--s7-komplett-grund); color: #fff; }
.fp-k--zart { background: var(--s7-akzent-verlauf); color: var(--s7-tinte); }
.fp-k--text { background: #fff; border: 1px solid var(--s7-linie); color: var(--s7-tinte); }
.fp-k__gross { font-family: var(--s7-schrift-titel); font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; }
@media (max-width: 760px) { .fp-kacheln { grid-template-columns: minmax(0, 1fr); } }

/* ---------- Stilproben-Seite: Steckbriefe ---------- */
.sp-kopf { padding: clamp(3rem, 6vw, 5rem) 0 3rem; border-bottom: 1px solid #e2e2df; }
.sp-kopf h1 { max-width: 18ch; font-size: clamp(2.4rem, 5.4vw, 4.4rem); line-height: 1.04; letter-spacing: -0.03em; }
.sp-massstab { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem 2rem; margin: 2rem 0 0; padding: 0; list-style: none; }
.sp-massstab li { padding-top: .7rem; border-top: 1px solid #e2e2df; font-size: .95rem; line-height: 1.45; }
.sp-sprung { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2rem; }
.sp-sprung a { padding: .55rem 1rem; border: 1.5px solid #181818; border-radius: 99px; color: #181818; font-weight: 600; font-size: .92rem; text-decoration: none; }
.sp-brief { position: relative; z-index: 2; background: #111; color: #cfcfcf; }
.sp-brief .s7-wrap { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 1rem 2.4rem; align-items: center; padding: 1.6rem 0; }
.sp-brief__nr { color: #fff; font: 700 2.6rem/1 system-ui, sans-serif; }
.sp-brief h2 { margin: 0; color: #fff; font: 700 1.5rem/1.2 system-ui, sans-serif; }
.sp-brief p { margin-top: .3rem; font-size: .95rem; line-height: 1.5; }
.sp-brief dl { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .25rem 1rem; margin: .8rem 0 0; font-size: .85rem; }
.sp-brief dt { color: #8a8a8a; }
.sp-brief dd { margin: 0; color: #e9e9e9; }
.sp-farben { display: flex; gap: .5rem; }
.sp-farben i { width: 2.4rem; height: 2.4rem; border-radius: 50%; border: 1px solid rgba(255,255,255,.25); }
.sp-ende { padding: 4rem 0 5rem; background: #f4f4f3; }
.sp-ende h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); letter-spacing: -0.02em; }
.sp-ende p { max-width: 40rem; margin-top: .8rem; }

/* ---------- Mobil ---------- */
@media (max-width: 1000px) {
  .s7-nav { display: none; }
  .s7-kopf .s7-knopf { margin-left: auto; }
  .s7-ablauf, .s7-pakete { grid-template-columns: minmax(0, 1fr); row-gap: 1rem; }
  .s7-ablauf__schritt, .s7-paket { grid-row: auto; grid-template-rows: none; }
  .s7-ablauf__schritt { margin-bottom: 2.4rem; }
  .s7-ablauf__schritt:not(:last-child) .s7-ablauf__bild::after { display: none; }
  .s7-zg-listen { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  .s7-gruppe { grid-row: auto; grid-column: 1; margin: 1rem 0 .2rem; }
  .s7-gruppe--b { order: 3; }
  .s7-paket--komplett { order: 4; }
  .s7-vertrauen, .s7-kontakt { grid-template-columns: minmax(0, 1fr); }
  .s7-vertrauen__text { padding: 0; }

  .sp-massstab { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .sp-brief .s7-wrap { grid-template-columns: auto minmax(0, 1fr); }
  .sp-farben { grid-column: 1 / -1; }
}
@media (max-width: 600px) {
  .sp-massstab { grid-template-columns: minmax(0, 1fr); }
  .s7-kopf .s7-knopf { display: none; }
}
</style>
</head>
<body>
{#- Verläufe für Grafiken (fill: url(#…)) – einmal je Seite -#}
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
  <linearGradient id="s7v-pastell" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#d9e2ff"/><stop offset="1" stop-color="#ecdbff"/></linearGradient>
  <linearGradient id="s7v-cyanviolett" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#0b9fbd"/><stop offset="1" stop-color="#8613a1"/></linearGradient>
  <linearGradient id="s7v-cyanviolett-h" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0b9fbd"/><stop offset="1" stop-color="#8613a1"/></linearGradient>
  <linearGradient id="s7v-magentaviolett-h" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c51f5d"/><stop offset="1" stop-color="#8613a1"/></linearGradient>
  <linearGradient id="s7v-magentaviolett" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#c51f5d"/><stop offset="1" stop-color="#8613a1"/></linearGradient>
</defs></svg>

<div class="s7-dev"><div class="s7-wrap"><span><b>Storyboard · Homepage-Story 7</b> · {% if s.slug == "stilproben" %}Stilproben: Apple-klar gewählt{% elif s.slug == "farbproben" %}Farbproben: drei Farbakzente für Apple-klar{% elif s.slug == "seitenplan" %}Seitenplan: alle Seiten, ihre Aufgabe und der Stand{% else %}{% if s.slug == "marketing-as-a-service" %}Unterseite Marketing as a Service (Weg B){% elif s.slug == "vertriebsstrecken" %}Unterseite Vertriebsstrecken{% elif s.slug == "strategiekompass" %}Unterseite Strategiekompass{% elif s.slug == "kontakt" %}Unterseite Kontakt und Termin{% elif s.slug == "preise" %}Unterseite Preise{% elif s.slug == "vertriebsleiter" %}Unterseite Für Vertriebsleiter (Story A){% elif s.zg %}Zielgruppenseite {{ s.titel }} (Vorlage für alle 20){% else %}Grundstory „Die digitale Maschine“{% endif %} · Stil Apple-klar · <span class="s7-schalter" role="group" aria-label="Farbe umstellen">Farbe <button type="button" data-farbe="cyanviolett" aria-pressed="true" title="Cyan → Violett">1</button><button type="button" data-farbe="magentaviolett" aria-pressed="false" title="Magenta → Violett">2</button></span>{% endif %}</span><span>{% if s.slug %}<a href="/entwicklung/storyboard/story7/">Startseite (Arbeitslook)</a>{% endif %}{% if s.slug != "stilproben" %}<a href="/entwicklung/storyboard/story7/stilproben/">Stilproben</a>{% endif %}{% if s.slug != "farbproben" %}<a href="/entwicklung/storyboard/story7/farbproben/">Farbproben</a>{% endif %}<a href="{{ B6 }}/story-varianten/">Story-Varianten</a></span></div></div>

<div class="s7-stil{% if istSeite or s.slug == "seitenplan" %} s7-stil--apple s7-farbe--cyanviolett{% endif %}" id="s7-seite">
<header class="s7-kopf{% if not istSeite %} s7-kopf--nur-marke{% endif %}">
  <div class="s7-wrap">
    <div class="s7-marke">
      <a href="/entwicklung/storyboard/story7/" aria-label="sofort sichtbar – Startseite"><img src="{{ B6 }}/assets/img/logo-dunkel.svg" alt="sofort sichtbar" width="78" height="40"></a>
      <div class="s7-dd" data-s7-dd>
        <button type="button" class="s7-dd__auf" aria-expanded="false" aria-controls="s7-dd-panel" aria-label="Entwicklungsmenü öffnen"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4z"/></svg></button>
        <div class="s7-dd__panel" id="s7-dd-panel" hidden>
          {%- for item in site.nav %}{% if item.devOnly %}{% for c in item.children %}
          {%- if c.typ == "hinweis" %}<p class="s7-dd__hinweis">{{ c.text }}</p>
          {%- elif c.typ == "gruppe" %}<p class="s7-dd__gruppe">{{ c.label }}</p>
          {%- elif c.children %}<div class="s7-unter"><a href="{{ c.href }}"{% if c.href | isCurrentPath(page.url) %} aria-current="page"{% endif %}>{{ c.label }}<span class="s7-unter__pfeil" aria-hidden="true">›</span></a><div class="s7-unter__panel">{% for u in c.children %}<a href="{{ u.href }}"{% if u.href | isCurrentPath(page.url) %} aria-current="page"{% endif %}>{{ u.label }}</a>{% endfor %}</div></div>
          {%- else %}<a href="{{ c.href }}"{% if c.href | isCurrentPath(page.url) %} aria-current="page"{% endif %}>{{ c.label }}</a>{% endif %}
          {%- endfor %}{% endif %}{% endfor %}
        </div>
      </div>
    </div>
    {%- if istSeite %}
    {#- Hauptmenü: echte Unterseiten; „Pakete“ und „Über uns“ springen zur Startseite, bis sie eigene Seiten haben -#}
    <nav class="s7-nav" aria-label="Hauptnavigation">
      <a href="{{ H7 }}/strategiekompass/"{% if s.slug == "strategiekompass" %} aria-current="page"{% endif %}>Strategiekompass</a>
      <a href="{{ H7 }}/vertriebsstrecken/"{% if s.slug == "vertriebsstrecken" or s.zg %} aria-current="page"{% endif %}>Vertriebsstrecken</a>
      <a href="{{ H7 }}/marketing-as-a-service/"{% if s.slug == "marketing-as-a-service" %} aria-current="page"{% endif %}>Marketing as a Service</a>
      <a href="{{ H7 }}/preise/"{% if s.slug == "preise" %} aria-current="page"{% endif %}>Preise</a>
      <a href="{{ H7 }}/#ueber-uns">Über uns</a>
      <a href="{{ H7 }}/vertriebsleiter/"{% if s.slug == "vertriebsleiter" %} aria-current="page"{% endif %}>Für Vertriebsleiter</a>
    </nav>
    {%- endif %}
    <a class="s7-knopf" href="{{ H7 }}/kontakt/">Termin auswählen</a>
  </div>
</header>

{%- if s.slug == "vertriebsleiter" %}
{#- Unterseite Für Vertriebsleiter (Story A, überarbeitet 12.11.2026): jedes Büro der Region bekommt seine Maschine,
    die Summe ist der Umsatz der Region; Einführung, Begleitung und monatliches Strategie-Sparring mit Rückmeldung.
    Kein Marketing as a Service. Grafik: erklaerbild.py region_quer/region_hoch. Inhalte: s7.vl -#}
{%- set VL = S.vl %}
<main>
  <section class="s7-held">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ VL.held.kicker }}</p>
      <h1>{{ VL.held.h1 }}<br><span class="s7-wort">{{ VL.held.h1_akzent }}</span></h1>
      <p class="s7-lead vs7-lead">{{ VL.held.lead }}</p>
      <div class="s7-held__knoepfe">
        <a class="s7-knopf" href="{{ H7 }}/kontakt/">{{ VL.held.knopf }} {{ pfeil | safe }}</a>
        <a class="s7-knopf s7-knopf--rand" href="#einfuehrung">{{ VL.held.knopf2 }}</a>
      </div>
      <figure class="s7-maschine"><div class="ek2" role="img" aria-label="Deine Region: Im Strategie-Sparring legen wir mit dir fest, wie es losgeht. Jedes Büro bekommt seine eigene Maschine, die Leads aller Büros ergeben mehr Umsatz in deiner Region. Jeden Monat Rückmeldung aus dem Dashboard: welches Büro wo steht, was läuft, was wir anpassen.">{{ S.ek_region_quer | safe }}{{ S.ek_region_hoch | safe }}</div></figure>
    </div>
  </section>

  {%- set PB = VL.problem %}
  <section class="s7-band s7-band--flaeche">
    <div class="s7-wrap vl7-problem">
      <div>
        <p class="s7-kicker">{{ PB.kicker }}</p>
        <h2 class="s7-h2 vl7-h2">{{ PB.h2 }}</h2>
      </div>
      <div>{% for x in PB.absaetze %}<p class="s7-lead">{{ x }}</p>{% endfor %}</div>
    </div>
  </section>

  {%- set LO = VL.loesung %}
  <section class="s7-band vl7-loesung">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ LO.kicker }}</p>
      <h2 class="s7-h2">{{ LO.h2 }}<br><span class="s7-wort">{{ LO.h2_akzent }}</span></h2>
      <p class="s7-lead">{{ LO.lead }}</p>
      <div class="vs7-wege">
        {%- for x in S.vs.teile.liste %}
        <article class="vs7-weg">
          <h3>{{ x.titel }}</h3>
          <p>{{ x.text }}</p>
          <img src="/assets/img/{{ x.bild }}" alt="" width="{{ x.b }}" height="{{ x.h }}" loading="lazy">
        </article>
        {%- endfor %}
      </div>
      <p class="vl7-link"><a class="s7-link" href="{{ H7 }}/vertriebsstrecken/">{{ LO.link }} {{ pfeil | safe }}</a></p>
    </div>
  </section>

  {%- set EF = VL.einfuehrung %}
  <section class="s7-band s7-band--flaeche" id="einfuehrung">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ EF.kicker }}</p>
      <h2 class="s7-h2">{{ EF.h2 }}</h2>
      <ol class="vl7-schritte">
        {%- for x in EF.liste %}
        <li{% if loop.last %} class="vl7-schritte--sparring"{% endif %}><span>0{{ loop.index }}</span><h3>{{ x.titel }}</h3><p>{{ x.text }}</p></li>
        {%- endfor %}
      </ol>
    </div>
  </section>

  {%- set ZI = VL.zitat %}
  <section class="s7-band">
    <div class="s7-wrap vl7-zitat">
      <figure class="vl7-zitat__bild"><img src="/assets/img/{{ ZI.bild }}" alt="{{ ZI.bild_alt }}" width="397" height="473" loading="lazy"></figure>
      <blockquote><p>„{{ ZI.text }}“</p><cite>{{ ZI.quelle }}</cite></blockquote>
    </div>
  </section>

  {{ kontaktBand(VL.kontakt) }}
</main>
{%- elif s.slug == "preise" %}
{#- Unterseite Preise: Pakete (Baustein der Startseite), Vergleich Fokus · Team · Komplett, Ergänzungen mit Preisen.
    Was noch nicht feststeht, steht sichtbar als „offen“ – nichts erfunden. Inhalte: s7.preise, s7.pakete, s7.maas.bausteine -#}
{%- set PR = S.preise %}{%- set VG = PR.vergleich %}
<main>
  <section class="s7-held pr7-held">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ PR.kicker }}</p>
      <h1 class="zg7-h1">{{ PR.h1 }}<br><span class="s7-wort">{{ PR.h1_akzent }}</span></h1>
      <p class="s7-lead vs7-lead">{{ PR.lead }}</p>
    </div>
  </section>
  {{ pakete(false) }}

  <section class="s7-band s7-band--flaeche">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ VG.kicker }}</p>
      <h2 class="s7-h2">{{ VG.h2 }}</h2>
      <p class="pr7-offen">{{ VG.offen_hinweis }}</p>
      <div class="pr7-tabelle" role="table" aria-label="{{ VG.h2 }}">
        <div class="pr7-kopf" role="row"><span role="columnheader"></span>{% for c in VG.spalten %}<b role="columnheader"{% if loop.last %} class="pr7-komplett"{% endif %}>{{ c }}</b>{% endfor %}</div>
        {%- for g in VG.gruppen %}
        <p class="pr7-gruppe">{{ g.titel }}</p>
        {%- for z in g.zeilen %}
        <div class="pr7-zeile" role="row">
          <span role="rowheader">{{ z[0] }}</span>
          {%- for c in z.slice(1) %}
          <span role="cell" class="pr7-zelle{% if c == 'offen' %} pr7-zelle--offen{% endif %}">{% if c == "ja" %}<i class="pr7-ja" aria-label="enthalten"></i>{% elif c == "nein" %}<i class="pr7-nein" aria-label="nicht enthalten">–</i>{% else %}{{ c }}{% endif %}</span>
          {%- endfor %}
        </div>
        {%- endfor %}
        {%- endfor %}
        <div class="pr7-zeile pr7-zeile--preis" role="row"><span role="rowheader">Preis</span>{% for c in VG.preis %}<span role="cell" class="pr7-zelle{% if c == 'offen' %} pr7-zelle--offen{% endif %}"><b>{{ c }}</b>{% if c != 'offen' %}<small>{{ VG.preis_einheit }}</small>{% endif %}</span>{% endfor %}</div>
      </div>
    </div>
  </section>

  {%- set EG = PR.ergaenzungen %}
  <section class="s7-band">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ EG.kicker }}</p>
      <h2 class="s7-h2">{{ EG.h2 }}</h2>
      <div class="pr7-erg">
        {%- for b in S.maas.bausteine.liste %}{% if not loop.first %}
        <article class="pr7-erg__karte">
          <h3>{{ b.name }}</h3>
          <p>{{ b.kurz }}</p>
          <p class="pr7-erg__preis"><b>{{ b.preis }}</b><span>{{ b.einheit }}</span>{% if b.zusatz %}<span>{{ b.zusatz }}</span>{% endif %}</p>
        </article>
        {%- endif %}{% endfor %}
      </div>
      <p class="pr7-fuss"><a class="s7-link" href="{{ H7 }}/marketing-as-a-service/#bausteine">{{ EG.link }} {{ pfeil | safe }}</a></p>
      <ul class="pr7-hinweise">{% for x in PR.fuss %}<li>{{ x }}</li>{% endfor %}</ul>
    </div>
  </section>

  {{ kontaktBand() }}
</main>
{%- elif s.slug == "kontakt" %}
{#- Unterseite Kontakt und Termin: ein Ziel – der Termin. Links, worum es geht und die direkten Wege; rechts der Kalender (Cal.com, hell).
    Entwicklungsseite: Kalender lädt ohne Einwilligungsabfrage. Vor dem Weg nach main die Einwilligung wie in partials/cal-embed.njk einbauen. -#}
{%- set KS = S.kontaktseite %}{%- set C = kontakt.cal %}
