{%- elif s.slug == "seitenplan" %}
{#- Seitenplan (Entwicklung): alle Seiten als Baum – je Seite Frage, Herkunft, Ziel, Stand. Ein Highlight: der Stand „neu gebaut“. Inhalte: s7.seitenplan -#}
{%- set P = S.seitenplan %}
{%- macro karte(x, klasse="") -%}
<article class="sp7-karte sp7-karte--{{ x.stand }} {{ klasse }}">
  <p class="sp7-stand">{{ P.staende[x.stand] }}</p>
  <h3>{% if x.link %}<a href="{{ x.link }}">{{ x.name }}</a>{% else %}{{ x.name }}{% endif %}</h3>
  {%- if x.zusatz %}<p class="sp7-zusatz">{{ x.zusatz }}</p>{% endif %}
  <p class="sp7-frage">„{{ x.frage }}“</p>
  <dl>
    <dt>Kommt von</dt><dd>{{ x.von }}</dd>
    {%- if x.zu %}<dt>Führt zu</dt><dd>{{ x.zu }}</dd>{% endif %}
  </dl>
  {%- if x.offen %}<p class="sp7-offen">{{ x.offen }}</p>{% endif %}
</article>
{%- endmacro -%}
<main>
  <section class="s7-band sp7">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ P.kicker }}</p>
      <h1 class="sp7-h1">{{ P.h1 }}</h1>
      <p class="s7-lead">{{ P.lead }}</p>
      <p class="sp7-legende">{% for k, v in P.staende %}<span class="sp7-stand sp7-stand--{{ k }}">{{ v }}</span>{% endfor %}</p>

      <div class="sp7-baum">
        <div class="sp7-wurzel">{{ karte(P.start) }}</div>
        <div class="sp7-ebene">
          {%- for x in P.ebene %}
          <div class="sp7-ast">
            {{ karte(x) }}
            {%- if x.unter %}
            <article class="sp7-unter"><h4><a href="{{ x.unter.link }}">{{ x.unter.name }}</a></h4><p class="sp7-frage">„{{ x.unter.frage }}“</p><p class="sp7-zusatz">{{ x.unter.hinweis }}</p></article>
            {%- endif %}
          </div>
