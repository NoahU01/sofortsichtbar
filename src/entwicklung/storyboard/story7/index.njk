<script>window.KOMPASS_CFG = { kopf: false, preis: false, ziel: "#kontakt", knopf: {{ KO.knopf | dump | safe }}, hinweis: {{ KO.hinweis | dump | safe }} };</script>
<script src="{{ B6 }}/assets/kompass/kompass-g.js"></script>
{%- elif s.slug == "stilproben" %}
{%- set SP = S.stilproben %}
<main>
