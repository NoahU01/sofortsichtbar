    </div>
  </section>

  {{ kontaktBand() }}
</main>
<script>
/* Pop-ups: Knopf öffnet, Kreuz, Escape oder Klick daneben schließt */
(function () {
  document.querySelectorAll("[data-mx7-auf]").forEach(function (k) {
    k.addEventListener("click", function () { var d = document.getElementById(k.getAttribute("data-mx7-auf")); if (d) d.showModal(); });
