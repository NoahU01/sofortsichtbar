---
layout: false
eleventyExcludeFromCollections: true
pagination:
  data: seiten
  size: 1
  alias: s
seiten:
  - slug: ""
    titel: "Startseite"
  - slug: "stilproben"
    titel: "Stilproben"
  - slug: "farbproben"
    titel: "Farbproben"
  - slug: "marketing-as-a-service"
    titel: "Marketing as a Service"
permalink: "/entwicklung/storyboard/story7/{% if s.slug %}{{ s.slug }}/{% endif %}index.html"
---
{#- Homepage-Story 7 · Startseite mit der Grundstory „Die digitale Maschine vor deinem Vertrieb“ (A und B vereint)
    und die Stilproben (drei Richtungen auf denselben Bausteinen).
    Der Stil hängt ausschließlich an den Stellschrauben (:root = Arbeitslook; .s7-stil--… = eine Richtung).
    Bausteine (Einstieg, Schritte, Pakete …) als Makros – Startseite und Stilproben nutzen dieselben.
    Inhalte: story7.11tydata.json → s7 · Grafik: maschine_holen.py · Schriften: assets/fonts (OFL, selbst gehostet).
    Eigenständige Seiten (layout: false), alles in src/entwicklung/. -#}
{%- set S = s7 -%}
{%- set H7 = "/entwicklung/storyboard/story7" -%}
{#- Echte Seiten (Startseite und Unterseiten) tragen Stil, Farbschalter und Hauptmenü; Stil- und Farbproben nicht -#}
{%- set istSeite = s.slug != "stilproben" and s.slug != "farbproben" -%}
{%- set B6 = "/entwicklung/storyboard/story6" -%}
{%- set A7 = "/entwicklung/storyboard/story7/assets" -%}
{%- set pfeil -%}<svg class="s7-pfeil" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endset -%}

{#- ======================= Bausteine ======================= -#}
{%- macro erklaerbild(detail=false) -%}
{%- set E = S.erklaerbild -%}
{%- if detail %}
<div class="ek2 ek2--detail" role="img" aria-label="Marketing as a Service im Detail: Strategie – wo willst du wachsen? Dann der Trichter aus Kernpaket, LinkedIn, Paid Ads und Website mit sofort sichtbar im Kern; an der Mündung der Messpunkt Leads. Vertrieb und Kundenbetreuung machst du. Danach die Steuerung – funktioniert es? Jeden Monat steuern wir mit Dashboard, Report und Betreuungscall nach.">{{ S.ek_detail_quer | safe }}{{ S.ek_detail_hoch | safe }}</div>
{%- else %}<div class="ek2" role="img" aria-label="Die digitale Maschine: Marketing – wir gewinnen Interessenten. Ein Trichter aus Lagen mit sofort sichtbar im Kern; an der Mündung der Messpunkt Leads. Vertrieb – du machst daraus Kunden: Termin, Beratung, Abschluss, dann Kundenbetreuung. Regelmäßige Präsenz pflegt deinen Bestand und bringt neue Anlässe.">{{ S.ek_quer | safe }}{{ S.ek_hoch | safe }}</div>
<p class="ek__mehr"><a class="s7-link" href="{{ E.link_ziel }}">{{ E.link }} {{ pfeil | safe }}</a></p>
{%- endif %}
{%- endmacro -%}

{%- macro held(mitIds=true) -%}
  <section class="s7-held">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ S.hero.kicker }}</p>
      <h1>{{ S.hero.h1 }} <span class="s7-wort">{{ S.hero.h1_akzent }}</span></h1>
      <p class="s7-lead">{{ S.hero.lead }}</p>
      <div class="s7-held__knoepfe">
        <a class="s7-knopf" href="#kontakt">{{ S.hero.knopf }} {{ pfeil | safe }}</a>
        <a class="s7-knopf s7-knopf--rand" href="{{ B6 }}/strategiekompass/">{{ S.hero.knopf2 }}</a>
      </div>
      <figure class="s7-maschine">
        {{ erklaerbild() }}
      </figure>
    </div>
  </section>
{%- endmacro -%}

{%- macro schritte(mitIds=true) -%}
  {#- Ablauf statt drei Kästen: eine Linie Strategie → Maschine → Steuerung, eine Bildsprache (graue Linien, Tinte), Farbe nur im Trichter -#}
  {%- set L = S.schritte.liste %}
  <section class="s7-band s7-band--akzent"{% if mitIds %} id="maschine"{% endif %}>
    <div class="s7-wrap">
      <p class="s7-kicker">{{ S.schritte.kicker }}</p>
      <h2 class="s7-h2">{{ S.schritte.h2 }}</h2>
      <ol class="s7-ablauf">
        <li class="s7-ablauf__schritt">
          <div class="s7-ablauf__bild" aria-hidden="true"><div class="s7-mini">
            <div class="s7-mini__zeile"><span>Segment</span><div><i class="an">Privatkunden</i><i>Firmenkunden</i></div></div>
            <div class="s7-mini__zeile"><span>Sparte</span><div><i class="an">Leben</i><i>Kranken</i><i>Schaden/Unfall</i><i>Kfz</i></div></div>
            <div class="s7-mini__zeile"><span>Zielgruppe</span><div><i class="an ziel">Junge Familien</i><i class="an">Bauherren</i><i class="mehr">+ weitere</i></div></div>
          </div></div>
          <p class="s7-ablauf__nr">{{ L[0].nr }} · {{ L[0].label }}</p>
          <h3>{{ L[0].h | replace('|', '<br>') | safe }}</h3>
          <p class="s7-ablauf__t">{{ L[0].t }}</p>
          <a class="s7-link" href="{{ B6 }}/strategiekompass/">{{ L[0].link }} {{ pfeil | safe }}</a>
        </li>
        <li class="s7-ablauf__schritt">
          <div class="s7-ablauf__bild" aria-hidden="true"><div class="s7-mini">
            <p class="s7-mini__kopf">Vertriebsstrecke · Junge Familien</p>
            <div class="s7-mini__strecke"><ul><li>Landingpage</li><li>Postings</li><li>Kundenmailing</li></ul><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg><div class="s7-mini__lead ziel"><b>Neuer Lead</b><span>Familie M.</span><span>Rückruf heute</span></div></div>
          </div></div>
          <p class="s7-ablauf__nr">{{ L[1].nr }} · {{ L[1].label }}</p>
          <h3>{{ L[1].h | replace('|', '<br>') | safe }}</h3>
          <p class="s7-ablauf__t">{{ L[1].t }}</p>
          <a class="s7-link" href="/vertriebsstrecken">{{ L[1].link }} {{ pfeil | safe }}</a>
        </li>
        <li class="s7-ablauf__schritt">
          <div class="s7-ablauf__bild" aria-hidden="true"><div class="s7-mini">
            <p class="s7-mini__kopf">Dashboard</p>
            <div class="s7-mini__kacheln"><div><b>Aufmerksamkeit</b><svg viewBox="0 0 60 16" preserveAspectRatio="none"><polyline points="0,13 12,11 24,12 36,8 48,6 60,3"/></svg></div><div class="ziel"><b>Verweildauer</b><svg viewBox="0 0 60 16" preserveAspectRatio="none"><polyline points="0,4 12,5 24,4 36,8 48,10 60,13"/></svg></div><div><b>Google</b><svg viewBox="0 0 60 16" preserveAspectRatio="none"><polyline points="0,13 12,11 24,12 36,8 48,6 60,3"/></svg></div><div><b>Leads</b><svg viewBox="0 0 60 16" preserveAspectRatio="none"><polyline points="0,13 12,11 24,12 36,8 48,6 60,3"/></svg></div></div>
            <p class="s7-mini__empf"><b>Empfehlung:</b> Bauherren – Abschnitt umstellen, der kaum gelesen wird</p>
          </div></div>
          <p class="s7-ablauf__nr">{{ L[2].nr }} · {{ L[2].label }}</p>
          <h3>{{ L[2].h | replace('|', '<br>') | safe }}</h3>
          <p class="s7-ablauf__t">{{ L[2].t }}</p>
        </li>
      </ol>
    </div>
  </section>
{%- endmacro -%}

{%- macro kontakt() -%}
  <section class="s7-band s7-band--tinte" id="kontakt">
    <div class="s7-wrap s7-kontakt">
      <div>
        <h2 class="s7-h2">{{ S.kontakt.h2 }} <span class="s7-wort s7-nowrap">{{ S.kontakt.h2_akzent }}</span></h2>
        <p class="s7-lead">{{ S.kontakt.t }}</p>
      </div>
      <div class="s7-kontakt__wege">
        <a class="s7-knopf" href="{{ B6 }}/kontakt/">Termin auswählen {{ pfeil | safe }}</a>
        <a href="mailto:{{ S.kontakt.mail }}">{{ S.kontakt.mail }}</a>
        <a href="tel:{{ S.kontakt.tel | replace(' ', '') }}">{{ S.kontakt.tel }}</a>
      </div>
    </div>
  </section>
{%- endmacro -%}

{%- macro pakete(mitIds=true) -%}
  <section class="s7-band"{% if mitIds %} id="pakete"{% endif %}>
    <div class="s7-wrap">
      <p class="s7-kicker">{{ S.pakete.kicker }}</p>
      <h2 class="s7-h2">{{ S.pakete.h2 }}</h2>
      <p class="s7-lead">{{ S.pakete.lead }}</p>
      <div class="s7-pakete">
        <p class="s7-gruppe s7-gruppe--a">{{ S.pakete.gruppen[0][0] }}</p>
        <p class="s7-gruppe s7-gruppe--b">{{ S.pakete.gruppen[1][0] }}</p>
        {%- for p in S.pakete.liste %}
        <article class="s7-paket s7-paket--{{ p.id }}">
          <h3>{{ p.name }}</h3>
          <p class="s7-paket__fuer">{{ p.fuer }}</p>
          <p class="s7-paket__preis">{% if p.preis %}<b>{{ p.preis }}</b><span>{{ p.einheit }}</span>{% else %}<b>Auf Anfrage</b><span>monatlich</span>{% endif %}</p>
          <p class="s7-paket__vorspann">{{ p.vorspann }}</p>
          <ul>{% for x in p.punkte %}<li>{{ x }}</li>{% endfor %}</ul>
          <span></span>
          <a class="s7-knopf{% if p.id != "komplett" %} s7-knopf--rand{% endif %}" href="{% if p.id == "komplett" %}{{ H7 }}/marketing-as-a-service/{% else %}#kontakt{% endif %}">{{ p.knopf }}</a>
        </article>
        {%- endfor %}
      </div>
      <p class="s7-pakete__fuss">{{ S.pakete.fuss }}</p>
    </div>
  </section>
{%- endmacro -%}
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if s.slug %}{{ s.titel }} · {% endif %}Homepage-Story 7 · Die digitale Maschine – Entwicklung</title>
<meta name="robots" content="noindex,nofollow">
<link rel="icon" href="/assets/img/logos/favicon.png" type="image/png">
<style>
/* ---------- Schriften (selbst gehostet, OFL) ---------- */
{%- for f in [["Inter", "inter", [400, 500, 600]], ["Inter Tight", "inter-tight", [600, 700]]] %}{% for w in f[2] %}
@font-face { font-family: "{{ f[0] }}"; font-weight: {{ w }}; font-style: normal; font-display: swap; src: url("{{ A7 }}/fonts/{{ f[1] }}-latin-{{ w }}-normal.woff2") format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
@font-face { font-family: "{{ f[0] }}"; font-weight: {{ w }}; font-style: normal; font-display: swap; src: url("{{ A7 }}/fonts/{{ f[1] }}-latin-ext-{{ w }}-normal.woff2") format("woff2"); unicode-range: U+0100-02AF, U+0304, U+0308, U+0329, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
{%- endfor %}{% endfor %}

/* ===================================================================================
   STELLSCHRAUBEN – :root ist der Arbeitslook (neutral, Platzhalter).
   Eine Stilrichtung setzt nur diese Werte neu (siehe .s7-stil--… weiter unten).
   =================================================================================== */
:root, .s7-stil {
  --s7-schrift-titel: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --s7-schrift-text: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --s7-titel-gewicht: 700;
  --s7-titel-abstand: -0.02em;
  --s7-h1: clamp(2.6rem, 6.6vw, 5.6rem);   --s7-h1-hoehe: 1.04;
  --s7-h2: clamp(2rem, 4.2vw, 3.2rem);     --s7-h2-hoehe: 1.12;
  --s7-text-groesse: 1.0625rem;
  --s7-grund: #ffffff;          /* Seitenhintergrund */
  --s7-flaeche: #f4f4f3;        /* helle Fläche */
  --s7-tinte: #181818;          /* Überschriften, dunkle Flächen */
  --s7-text: #3b3b3b;           /* Fließtext */
  --s7-grau: #7a7a7a;           /* Kicker, Nebeninfos */
  --s7-linie: #e2e2df;          /* Trennlinien, Rahmen */
  --s7-akzent: #c9d4e3;         /* Markierung: Auswahl, Leads, Kern des Trichters */
  --s7-akzent-fill: var(--s7-akzent);   /* dieselbe Markierung in Grafiken (darf url(#…) sein) */
  --s7-akzent-verlauf: var(--s7-akzent); /* zarte Akzentfläche, darf ein Verlauf sein (Pills, Leads) */
  --s7-akzent-ende: var(--s7-akzent);   /* Endfarbe des Verlaufs (dort, wo der Trichter mündet) */
  --s7-akzent-fill-hoch: var(--s7-akzent-fill); /* Verlauf für senkrechte Grafiken (oben → unten) */
  --s7-auf-akzent: #181818;     /* Schrift auf dem Akzent */
  --s7-wort: var(--s7-tinte);   /* hervorgehobenes Wort der Hauptüberschrift */
  --s7-wort-verlauf: none;      /* … oder als Verlauf */
  --s7-knopf-grund: var(--s7-tinte); --s7-knopf-text: #ffffff;
  --s7-buehne: var(--s7-flaeche);      /* Fläche hinter der Maschine */
  --s7-band-akzent: var(--s7-flaeche); /* Band „So läuft die Maschine“ */
  --s7-karte: var(--s7-grund);         /* Karten auf Bändern */
  --s7-schatten: none;                 /* Karten-Schatten */
  --s7-komplett-grund: var(--s7-tinte); --s7-komplett-text: #e9e9e9; --s7-komplett-titel: #ffffff; --s7-komplett-haken: var(--s7-akzent); --s7-komplett-knopf-text: var(--s7-tinte);
  --s7-lage-1: #dededb; --s7-lage-2: #e9e9e7; --s7-lage-3: #f2f2f1;   /* Lagen des Trichters */
  --s7-rund: 18px;              /* Rundung Karten */
  --s7-rund-knopf: 999px;       /* Rundung Knöpfe */
  --s7-band: clamp(4.5rem, 9vw, 7.5rem);   /* Abstand oben/unten je Band */
}

/* ---------- Grundlagen ---------- */
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: #fff; color: #3b3b3b; font: 400 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; -webkit-font-smoothing: antialiased; }
img, svg { display: block; max-width: 100%; }
img { height: auto; }
a { color: inherit; }
p { margin: 0; }
.s7-stil { background: var(--s7-grund); color: var(--s7-text); font-family: var(--s7-schrift-text); font-size: var(--s7-text-groesse); line-height: 1.6; }
.s7-stil h1, .s7-stil h2, .s7-stil h3 { margin: 0; color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-weight: var(--s7-titel-gewicht); letter-spacing: var(--s7-titel-abstand); text-wrap: balance; }
.s7-wrap { width: min(100% - 2.5rem, 76rem); margin-inline: auto; }
.s7-band { padding: var(--s7-band) 0; }
.s7-band--flaeche { background: var(--s7-flaeche); }
.s7-band--akzent { background: var(--s7-band-akzent); }
.s7-band--tinte { background: var(--s7-tinte); color: #e9e9e9; }
.s7-stil .s7-band--tinte h2 { color: #fff; }
.s7-kicker { margin-bottom: 1rem; color: var(--s7-grau); font-size: .78rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
.s7-stil .s7-h2 { max-width: 22ch; font-size: var(--s7-h2); line-height: var(--s7-h2-hoehe); }
.s7-lead { max-width: 40rem; margin-top: 1.2rem; font-size: 1.15rem; line-height: 1.6; }
.s7-knopf { display: inline-flex; align-items: center; gap: .6rem; padding: .95rem 1.5rem; border: 2px solid var(--s7-knopf-grund); border-radius: var(--s7-rund-knopf); background: var(--s7-knopf-grund); color: var(--s7-knopf-text); font-weight: 600; font-size: 1rem; text-decoration: none; transition: transform .15s ease; }
.s7-knopf:hover { transform: translateY(-2px); }
.s7-knopf--rand { background: transparent; border-color: var(--s7-tinte); color: var(--s7-tinte); }
.s7-pfeil { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.s7-link { display: inline-flex; align-items: center; gap: .45rem; color: var(--s7-tinte); font-weight: 600; text-decoration: none; }
.s7-link:hover { text-decoration: underline; }
.s7-wort { color: var(--s7-wort); background-image: var(--s7-wort-verlauf); -webkit-background-clip: text; background-clip: text; }

/* ---------- Entwicklungsleiste + Kopf ---------- */
.s7-dev { background: #111; color: #bbb; font-size: 12.5px; }
.s7-dev .s7-wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .3rem 1rem; padding: .45rem 0; }
.s7-dev b { color: #fff; font-weight: 600; }
.s7-dev a { color: #fff; margin-left: 1rem; }
.s7-schalter { display: inline-flex; align-items: center; gap: .3rem; margin-left: .4rem; }
.s7-schalter button { width: 1.6rem; height: 1.3rem; padding: 0; border: 1px solid #555; border-radius: 6px; background: transparent; color: #ddd; font: 600 11px/1 system-ui, sans-serif; cursor: pointer; }
.s7-schalter button[aria-pressed="true"] { border-color: #fff; background: #fff; color: #111; }
.s7-kopf { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--s7-grund) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--s7-linie); }
.s7-kopf .s7-wrap { display: flex; align-items: center; gap: 2rem; height: 72px; }
.s7-marke { display: flex; align-items: center; gap: .35rem; }
.s7-marke img { height: 2.4rem; width: auto; }
.s7-nav { display: flex; gap: 1.8rem; margin-left: auto; }
.s7-nav a { color: var(--s7-text); font-size: .95rem; text-decoration: none; }
.s7-nav a:hover { color: var(--s7-tinte); }
.s7-kopf .s7-knopf { padding: .6rem 1.1rem; font-size: .9rem; }
.s7-kopf--nur-marke .s7-knopf { margin-left: auto; }
.s7-dd { position: relative; }
.s7-dd__auf { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; padding: 0; border: 0; border-radius: 50%; background: none; color: var(--s7-grau); cursor: pointer; }
.s7-dd__auf:hover, .s7-dd__auf[aria-expanded="true"] { background: var(--s7-flaeche); color: var(--s7-tinte); }
.s7-dd__auf svg { width: .7rem; height: .7rem; fill: currentColor; }
.s7-dd__panel { position: absolute; top: calc(100% + .9rem); left: -6rem; z-index: 80; width: 21rem; max-height: calc(100vh - 140px); overflow-y: auto; padding: .7rem; border: 1px solid var(--s7-linie); border-radius: 16px; background: #fff; box-shadow: 0 20px 50px rgba(0,0,0,.12); }
.s7-dd__panel[hidden] { display: none; }
.s7-dd__hinweis { margin: 0 0 .5rem; padding: .7rem .8rem; border-radius: 10px; background: var(--s7-flaeche); color: var(--s7-tinte); font-size: .78rem; line-height: 1.45; }
.s7-dd__gruppe { margin: .7rem .8rem .2rem; color: var(--s7-grau); font-size: .7rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
.s7-dd__panel a { display: block; padding: .5rem .8rem; border-radius: 8px; color: var(--s7-tinte); font-size: .9rem; text-decoration: none; }
.s7-dd__panel a:hover { background: var(--s7-flaeche); }
.s7-dd__panel a[aria-current="page"] { font-weight: 600; background: var(--s7-flaeche); }

/* ---------- Einstieg ---------- */
.s7-held { padding: clamp(3.5rem, 7vw, 6rem) 0 calc(var(--s7-band) * .7); }
.s7-stil .s7-held h1 { max-width: 16ch; font-size: var(--s7-h1); line-height: var(--s7-h1-hoehe); letter-spacing: calc(var(--s7-titel-abstand) * 1.6); }
.s7-held .s7-lead { font-size: clamp(1.15rem, 1.7vw, 1.35rem); max-width: 36rem; }
.s7-held__knoepfe { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.2rem; }
.s7-maschine { margin: clamp(3rem, 6vw, 4.5rem) 0 0; padding: clamp(1.6rem, 3.5vw, 3rem) clamp(1.2rem, 3vw, 2.8rem) clamp(1.6rem, 3vw, 2.4rem); border-radius: calc(var(--s7-rund) * 1.4); background: var(--s7-buehne); }
.s7-maschine__bild { overflow-x: auto; }
.s7-maschine__bild svg { width: 100%; min-width: 640px; height: auto; }
/* Farben der Grafik an die Stellschrauben koppeln (CSS schlägt die Attribute der Grafik) */
.s7-maschine svg [fill="#fff400"] { fill: var(--s7-akzent-fill); }
.s7-maschine svg [stroke="#fff400"] { stroke: var(--s7-akzent); }
.s7-maschine svg [fill="#dcd8d2"] { fill: var(--s7-lage-1); }
.s7-maschine svg [fill="#e8e5e0"] { fill: var(--s7-lage-2); }
.s7-maschine svg [fill="#f3f1ee"] { fill: var(--s7-lage-3); }
.s7-maschine svg [fill="#1a1817"] { fill: var(--s7-tinte); }
.s7-maschine svg [stroke="#1a1817"] { stroke: var(--s7-tinte); }
.s7-maschine svg [fill="#3d3a37"] { fill: var(--s7-text); }
.s7-maschine svg [fill="#6f6a64"] { fill: var(--s7-grau); }
.s7-maschine svg text { font-family: var(--s7-schrift-text); }
.s7-maschine svg .s7-kern { fill: var(--s7-auf-akzent); }
.s7-maschine svg g.s7-kern { fill: none; stroke: var(--s7-auf-akzent); }

/* ---------- Erklärbild „Die digitale Maschine“ (erklaerbild.py): zwei Formen, ein Highlight; quer ab 820px, darunter hochkant ---------- */
.ek2 svg { display: block; width: 100%; height: auto; overflow: visible; }
.ek2-svg--hoch { display: none !important; max-width: 23rem; margin: 0 auto; }
.ek2 text { font-family: var(--s7-schrift-text); }
.ek2-t { fill: var(--s7-tinte); }
.ek2-grau { fill: var(--s7-grau); }
.ek2-lage { stroke: var(--s7-grund); stroke-width: 2; }
.ek2-l2, .ek2-l2-h { fill: var(--s7-lage-1); }
.ek2-l3, .ek2-l3-h { fill: var(--s7-lage-2); }
.ek2-l4, .ek2-l4-h { fill: var(--s7-lage-3); }
.ek2-kern { fill: var(--s7-akzent-fill); }
.ek2-kern-h { fill: var(--s7-akzent-fill-hoch); }
.ek2-kern-t, .ek2-kern-p { fill: var(--s7-auf-akzent); }
.ek2-band { fill: var(--s7-tinte); }
.ek2-band-t { fill: #ffffff; }
.ek2-band-s { fill: #a1a1a6; }
.ek2-linie { fill: none; stroke: var(--s7-tinte); stroke-width: 2; }
.ek2-linie--grau { stroke: var(--s7-linie); }
.ek2-linie--fein { stroke-width: 1.4; }
.ek2-pfeilkopf { fill: none; stroke: var(--s7-tinte); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.ek2-grund { fill: var(--s7-buehne); }
.ek__mehr { margin-top: 2.2rem; text-align: center; }
@media (max-width: 820px) { .ek2-svg--quer { display: none !important; } .ek2-svg--hoch { display: block !important; } }

/* ---------- Ablauf: Strategie → Maschine → Steuerung ---------- */
.s7-ablauf { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(5, auto); column-gap: clamp(2rem, 4vw, 3.6rem); margin: 3.2rem 0 0; padding: 0; list-style: none; }
.s7-ablauf__schritt { display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 0; }
.s7-ablauf__bild { position: relative; display: grid; align-items: center; min-height: 14rem; padding: 1.7rem 1.6rem; border-radius: var(--s7-rund); background: var(--s7-karte); }
.s7-mini { display: grid; gap: .8rem; font-size: .85rem; line-height: 1.3; color: var(--s7-tinte); }
.s7-mini__kopf { color: var(--s7-grau); font-size: .7rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
.s7-mini__zeile { display: grid; grid-template-columns: 5.2rem 1fr; align-items: center; gap: .5rem; }
.s7-mini__zeile > span { color: var(--s7-grau); font-size: .68rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
.s7-mini__zeile > div { display: flex; flex-wrap: wrap; gap: .3rem; }
.s7-mini i { padding: .24rem .6rem; border: 1px solid var(--s7-linie); border-radius: 99px; font-style: normal; white-space: nowrap; }
.s7-mini i.an { border-color: var(--s7-tinte); background: var(--s7-tinte); color: #fff; font-weight: 600; }
.s7-mini i.mehr { border-style: dashed; color: var(--s7-grau); }
.s7-mini__strecke { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: .6rem; }
.s7-mini__strecke ul { display: grid; gap: .35rem; margin: 0; padding: 0; list-style: none; }
.s7-mini__strecke li { padding: .42rem .6rem; border: 1px solid var(--s7-linie); border-radius: 8px; font-weight: 500; }
.s7-mini__strecke svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: var(--s7-tinte); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.s7-mini__lead { display: grid; gap: .15rem; padding: .7rem .75rem; border-radius: 10px; background: var(--s7-tinte); color: #c7c7cc; }
.s7-mini__lead b { color: #fff; font-weight: 700; }
.s7-mini__balken { display: grid; grid-template-columns: 6.4rem 1fr; align-items: center; gap: .55rem .6rem; }
.s7-mini__balken i { display: block; height: .6rem; padding: 0; border: 0; border-radius: 99px; background: var(--s7-tinte); }
.s7-mini__empf { padding: .5rem .65rem; border: 1px solid var(--s7-linie); border-radius: 8px; }
.s7-mini__kacheln { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; }
.s7-mini__kacheln > div { display: grid; gap: .3rem; padding: .5rem .6rem .45rem; border: 1px solid var(--s7-linie); border-radius: 8px; }
.s7-mini__kacheln b { font-weight: 600; }
.s7-mini__kacheln svg { width: 100%; height: .9rem; fill: none; stroke: var(--s7-tinte); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.s7-mini__kacheln > div.ziel { border-color: transparent; background: var(--s7-akzent-verlauf); color: var(--s7-auf-akzent); }
.s7-mini__kacheln > div.ziel svg { stroke: var(--s7-auf-akzent); }
/* Farbe als roter Faden: in jedem Bild nur das Ergebnis des Schritts in der Akzentfarbe */
.s7-mini i.ziel, .s7-mini__lead.ziel, .s7-mini__balken i.ziel { border-color: transparent; background: var(--s7-akzent-verlauf); color: var(--s7-auf-akzent); }
.s7-mini__lead.ziel { color: color-mix(in srgb, var(--s7-auf-akzent) 85%, transparent); }
.s7-mini__lead.ziel b { color: var(--s7-auf-akzent); }
.s7-ablauf__schritt:not(:last-child) .s7-ablauf__bild::after { content: ""; position: absolute; top: 50%; right: calc(-1 * clamp(2rem, 4vw, 3.6rem) / 2 - .55rem); width: 1.1rem; height: 1.1rem; border-top: 2px solid var(--s7-tinte); border-right: 2px solid var(--s7-tinte); transform: translateY(-50%) rotate(45deg); }
.s7-ablauf__nr { margin-top: 1.6rem; color: var(--s7-grau); font-size: .95rem; font-weight: 600; }
.s7-stil .s7-ablauf h3 { margin-top: .4rem; font-size: clamp(1.4rem, 2vw, 1.7rem); line-height: 1.2; }
.s7-ablauf__t { margin-top: .6rem; font-size: 1.02rem; line-height: 1.55; text-wrap: pretty; }
.s7-ablauf .s7-link { margin-top: 1rem; align-self: start; }

/* ---------- Zielgruppen: Bild + Liste ---------- */
.s7-zg-bild { margin: 3rem auto 0; max-width: 56rem; }
.s7-zg-bild img { width: 100%; }
.s7-zg-listen { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(2rem, 5vw, 4rem); margin-top: 3rem; }
.s7-zg-listen__titel { padding-bottom: .8rem; border-bottom: 2px solid var(--s7-tinte); color: var(--s7-tinte); font-size: .95rem; font-weight: 700; }
.s7-zg-listen ul { margin: 0; padding: 0; list-style: none; }
.s7-zg-listen a { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .85rem 0; border-bottom: 1px solid var(--s7-linie); text-decoration: none; }
.s7-zg-listen b { color: var(--s7-tinte); font-weight: 600; }
.s7-zg-listen span { color: var(--s7-grau); font-size: .92rem; text-align: right; }
.s7-zg-listen a:hover b { text-decoration: underline; }

/* ---------- Pakete ---------- */
.s7-pakete { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: auto repeat(7, auto); column-gap: 1.2rem; margin-top: 3rem; }
.s7-gruppe { grid-row: 1; display: flex; align-items: center; gap: .8rem; margin-bottom: 1rem; color: var(--s7-tinte); font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
.s7-gruppe::after { content: ""; flex: 1; height: 2px; background: var(--s7-tinte); }
.s7-gruppe--a { grid-column: 1 / span 2; }
.s7-gruppe--b { grid-column: 3; }
.s7-paket { display: grid; grid-row: 2 / span 7; grid-template-rows: subgrid; row-gap: 0; padding: 2rem 2rem 1.8rem; border: 1px solid var(--s7-linie); border-radius: var(--s7-rund); background: var(--s7-karte); box-shadow: var(--s7-schatten); }
.s7-paket--komplett { border-color: transparent; background: var(--s7-komplett-grund); color: var(--s7-komplett-text); }
.s7-stil .s7-paket--komplett h3, .s7-paket--komplett .s7-paket__preis b { color: var(--s7-komplett-titel); }
.s7-stil .s7-paket h3 { font-size: 1.7rem; line-height: 1.2; }
.s7-paket__fuer { margin-top: .5rem; font-size: 1rem; line-height: 1.5; }
.s7-paket__preis { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid var(--s7-linie); color: var(--s7-grau); font-size: .9rem; }
.s7-paket--komplett .s7-paket__preis { border-top-color: color-mix(in srgb, var(--s7-komplett-text) 25%, transparent); color: color-mix(in srgb, var(--s7-komplett-text) 75%, transparent); }
.s7-paket__preis span { display: block; margin-top: .15rem; }
.s7-paket__preis b { display: block; color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: 1.9rem; font-weight: 700; line-height: 1.15; }
.s7-paket__vorspann { margin-top: 1.2rem; font-size: .88rem; font-weight: 600; color: var(--s7-tinte); min-height: 1.3em; }
.s7-paket--komplett .s7-paket__vorspann { color: var(--s7-komplett-titel); }
.s7-paket ul { list-style: none; margin: .5rem 0 0; padding: 0; }
.s7-paket li { position: relative; padding: .45rem 0 .45rem 1.6rem; font-size: .98rem; line-height: 1.45; }
.s7-paket li::before { content: ""; position: absolute; left: .15rem; top: .85rem; width: .7rem; height: .35rem; border-left: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(-45deg); }
.s7-paket--komplett li::before { color: var(--s7-komplett-haken); }
.s7-paket .s7-knopf { margin-top: 1.4rem; align-self: end; justify-content: center; }
.s7-paket--komplett .s7-knopf { border-color: var(--s7-komplett-titel); background: var(--s7-komplett-titel); color: var(--s7-komplett-knopf-text); }
.s7-pakete__fuss { margin-top: 1.4rem; color: var(--s7-grau); font-size: .95rem; }

/* ---------- Zielgruppen · Vertrauen · Kontakt (nur Startseite) ---------- */
.s7-zg__fuss { margin-top: 2rem; }
.s7-stil .s7-vertrauen .s7-h2 { max-width: none; }

.s7-vertrauen { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(2rem, 5vw, 4rem); align-items: stretch; }
.s7-vertrauen__text { padding: 1rem 0; }

.s7-zitat { margin: 2rem 0 0; padding: 0 0 0 1.2rem; border-left: 2px solid var(--s7-tinte); }
.s7-zitat p { color: var(--s7-tinte); font-size: 1.15rem; line-height: 1.6; }
.s7-zitat cite { display: block; margin-top: .5rem; color: var(--s7-grau); font-size: .9rem; font-style: normal; }
/* Gruppenbild in eigenem Rahmen: so hoch wie die Textspalte, das Bild steht unten auf der Kante und füllt die Breite (Schnittkanten = Rahmenkante) */
.s7-vertrauen__bild { display: flex; flex-direction: column; justify-content: space-between; margin: 0; padding-top: 1.4rem; border-radius: var(--s7-rund); background: var(--s7-flaeche); overflow: hidden; }
.s7-vertrauen__bild figcaption { padding: 0 1.6rem; color: var(--s7-grau); font-size: .9rem; }
.s7-nowrap { white-space: nowrap; }
@media (max-width: 600px) { .s7-vertrauen__bild figcaption { padding: 0 1rem; font-size: .8rem; } }
.s7-vertrauen__bild img { display: block; width: 107%; max-width: none; margin-right: -7%; mix-blend-mode: multiply; } /* helle Reste im Foto verschmelzen mit der Fläche */
.s7-kontakt { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem 4rem; align-items: end; }
.s7-kontakt .s7-lead { color: #cfcfcf; }
.s7-kontakt__wege { display: grid; gap: .8rem; justify-items: start; }
.s7-kontakt__wege .s7-knopf { border-color: #fff; background: #fff; color: var(--s7-tinte); }
.s7-kontakt__wege a:not(.s7-knopf) { color: #fff; text-decoration: none; }
.s7-fuss { padding: 2rem 0; border-top: 1px solid #2a2a2a; background: var(--s7-tinte); color: #888; font-size: .85rem; }
.s7-fuss .s7-wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
.s7-fuss a { color: #bbb; text-decoration: none; margin-left: 1.2rem; }


/* ---------- Unterseite Marketing as a Service (mx7-) ---------- */
/* Ausführliche Maschine: quer erst ab 1100px, darunter hochkant (mehr Inhalt, sonst zu kleine Schrift) */
.ek2-kasten { fill: var(--s7-grund); stroke: var(--s7-tinte); stroke-width: 2; }
@media (max-width: 1100px) { .ek2--detail .ek2-svg--quer { display: none !important; } .ek2--detail .ek2-svg--hoch { display: block !important; } }

/* Kreislauf: vier Schritte mit Ausschnitten, Bogen „Nächster Monat“ darüber */
.mx7-kreis { --g: clamp(1.6rem, 3vw, 2.6rem); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(4, auto); column-gap: var(--g); margin: 0; padding: 0; list-style: none; }
.mx7-kreis__schritt { display: grid; grid-row: span 4; grid-template-rows: subgrid; row-gap: 0; }
.mx7-kreis__bild { position: relative; display: grid; align-items: center; min-height: 12.5rem; padding: 1.4rem; border-radius: var(--s7-rund); background: var(--s7-karte); }
.mx7-kreis__schritt:not(:last-child) .mx7-kreis__bild::after { content: ""; position: absolute; top: 50%; right: calc(-1 * var(--g) / 2 - .5rem); width: 1rem; height: 1rem; border-top: 2px solid var(--s7-tinte); border-right: 2px solid var(--s7-tinte); transform: translateY(-50%) rotate(45deg); }
.mx7-kreis__zurueck { --g: clamp(1.6rem, 3vw, 2.6rem); position: relative; height: 2.2rem; margin: 3.4rem calc((100% - 3 * var(--g)) / 8) .9rem; border: 2px solid var(--s7-tinte); border-bottom: 0; border-radius: 14px 14px 0 0; }
.mx7-kreis__zurueck::after { content: ""; position: absolute; left: -.42rem; bottom: .15rem; width: .7rem; height: .7rem; border-right: 2px solid var(--s7-tinte); border-bottom: 2px solid var(--s7-tinte); transform: rotate(45deg); }
.mx7-kreis__zurueck span { position: absolute; left: 50%; top: 0; padding: 0 .9rem; background: var(--s7-band-akzent); color: var(--s7-tinte); font-size: .95rem; font-weight: 600; white-space: nowrap; transform: translate(-50%, -55%); }
.mx7-rolle { justify-self: start; margin-top: 1.4rem; padding: .2rem .75rem; border: 1.5px solid var(--s7-tinte); border-radius: 99px; color: var(--s7-tinte); font-size: .85rem; font-weight: 600; }
.mx7-rolle--du { border-color: transparent; background: var(--s7-akzent-verlauf); color: var(--s7-auf-akzent); }
.s7-stil .mx7-kreis h3 { margin-top: .7rem; font-size: clamp(1.4rem, 2vw, 1.7rem); line-height: 1.2; }
.mx7-kreis__t { margin-top: .5rem; text-wrap: pretty; }
/* Ausschnitte (gleiche Bildsprache wie s7-mini auf der Startseite) */
.mx7-mliste { display: grid; margin: 0; padding: 0; list-style: none; }
.mx7-mliste li { display: flex; justify-content: space-between; gap: .6rem; padding: .5rem 0; border-bottom: 1px solid var(--s7-linie); font-weight: 500; }
.mx7-mliste li:last-child { border-bottom: 0; }
.mx7-mliste em { color: var(--s7-grau); font-style: normal; white-space: nowrap; }
.mx7-mlead { display: grid; gap: .15rem; padding: .65rem .75rem; border: 1px solid var(--s7-linie); border-radius: 10px; }
.mx7-mlead b { font-weight: 700; }
.mx7-mlead span { color: var(--s7-grau); }
.mx7-mpost { display: grid; gap: .3rem; padding: .7rem .75rem; border-radius: 10px; background: var(--s7-grund); }
.mx7-mpost b { font-weight: 700; }
.mx7-mbrowser { display: grid; gap: .5rem; justify-items: start; padding: .6rem .75rem .8rem; border-radius: 10px; background: var(--s7-grund); }
.mx7-mbrowser > span { display: flex; gap: .25rem; margin-bottom: .2rem; }
.mx7-mbrowser > span i { width: .45rem; height: .45rem; border-radius: 50%; background: var(--s7-linie); }
.mx7-mbrowser b { font-family: var(--s7-schrift-titel); font-size: 1.05rem; font-weight: 700; letter-spacing: -0.02em; }
.mx7-mbrowser em { display: block; width: 100%; height: .45rem; border-radius: 99px; background: var(--s7-linie); }
.mx7-mbrowser em + em { width: 70%; }

/* Bausteine */
.mx7-art { color: var(--s7-grau); font-size: .9rem; font-weight: 600; }
.mx7-kern .mx7-art, .mx7-karte .mx7-art { margin-bottom: .4rem; }
.s7-stil .mx7-kern h3, .s7-stil .mx7-karte h3 { font-size: 1.7rem; line-height: 1.2; }
.mx7-preis { margin-top: 1rem; color: var(--s7-grau); font-size: .95rem; }
.mx7-preis b { color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: 2.2rem; font-weight: 700; letter-spacing: -0.02em; }
.mx7-kurz { margin-top: 1rem; text-wrap: pretty; }
.mx7-haken { list-style: none; margin: 0; padding: 0; }
.mx7-haken li { position: relative; padding: .45rem 0 .45rem 1.6rem; font-size: 1rem; line-height: 1.45; }
.mx7-haken li::before { content: ""; position: absolute; left: .15rem; top: .85rem; width: .7rem; height: .35rem; border-left: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(-45deg); }
.mx7-kern { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1fr); gap: 2rem clamp(2rem, 4vw, 3.6rem); margin-top: 3rem; padding: clamp(1.8rem, 3vw, 2.8rem); border-radius: var(--s7-rund); background: var(--s7-tinte); color: #d2d2d7; }
.s7-stil .mx7-kern h3, .mx7-kern .mx7-preis b, .mx7-kern .mx7-haken li { color: #fff; }
.mx7-kern .mx7-art, .mx7-kern .mx7-preis { color: #a1a1a6; }
.mx7-kern > div + div { padding-left: clamp(2rem, 4vw, 3.6rem); border-left: 1px solid #3a3a3c; }
.mx7-kern > div + div .mx7-art { margin-bottom: .6rem; }
.mx7-erg { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(8, auto); gap: 0 1.2rem; margin-top: 1.2rem; }
.mx7-karte { display: grid; grid-row: span 8; grid-template-rows: subgrid; padding: 1rem 1rem clamp(1.4rem, 2.4vw, 2rem); border: 1px solid var(--s7-linie); border-radius: var(--s7-rund); background: var(--s7-karte); }
.mx7-karte > :not(.mx7-karte__bild):not(dialog) { margin-inline: clamp(.6rem, 1.4vw, 1.2rem); }
.mx7-karte__bild { display: grid; align-items: center; min-height: 10rem; margin-bottom: 1.4rem; padding: 1.2rem; border-radius: calc(var(--s7-rund) - 8px); background: var(--s7-flaeche); }
.mx7-zusatz { color: var(--s7-grau); font-size: .9rem; }
.mx7-karte__punkte { margin-top: 1rem; padding-top: .6rem; border-top: 1px solid var(--s7-linie); }
.mx7-mehr { justify-self: start; align-self: end; display: inline-flex; align-items: center; gap: .45rem; margin-top: 1.4rem; padding: 0; border: 0; background: none; color: var(--s7-tinte); font: inherit; font-weight: 600; cursor: pointer; }
.mx7-mehr:hover { text-decoration: underline; }
.mx7-mehr--hell { color: #fff; }
.mx7-fuss { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem 2rem; margin-top: 1.6rem; color: var(--s7-grau); font-size: .95rem; }

/* Team: fünf gleich breite Karten, Zeilen über subgrid auf gleicher Höhe */
.mx7-team { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); grid-template-rows: repeat(5, auto); gap: 0 1rem; margin-top: 3rem; }
.mx7-team__g1 { grid-column: 1 / span 4; }
.mx7-team__g2 { grid-column: 5; }
.mx7-profil { display: grid; grid-row: 2 / span 4; grid-template-rows: subgrid; row-gap: 0; padding: 1.5rem 1.3rem 1.4rem; border-radius: var(--s7-rund); background: var(--s7-karte); }
.s7-stil .mx7-profil h3 { font-size: 1.3rem; line-height: 1.2; }
.mx7-profil__stelle { margin-top: .4rem; color: var(--s7-grau); font-size: .9rem; line-height: 1.4; }
.mx7-profil__t { margin-top: .8rem; font-size: 1rem; text-wrap: pretty; }

/* Pop-ups: hell und ruhig, Grundschrift */
.mx7-d { width: min(100% - 2rem, 46rem); max-height: 86vh; padding: clamp(1.6rem, 4vw, 2.6rem); border: 0; border-radius: var(--s7-rund); background: #fff; color: var(--s7-text); font-family: var(--s7-schrift-text); font-size: 1rem; line-height: 1.6; text-align: left; }
.mx7-d__zu:focus { outline: none; }
.mx7-d__zu:focus-visible { background: var(--s7-linie); }
.mx7-d::backdrop { background: rgba(0, 0, 0, .35); backdrop-filter: blur(4px); }
.mx7-d__zu { position: absolute; top: 1rem; right: 1rem; width: 2.2rem; height: 2.2rem; border: 0; border-radius: 50%; background: var(--s7-flaeche); color: var(--s7-tinte); font-size: 1.3rem; line-height: 1; cursor: pointer; }
.mx7-d__meta { color: var(--s7-grau); font-size: .9rem; font-weight: 600; }
.s7-stil .mx7-d h3 { margin: .3rem 2.5rem 1.2rem 0; font-size: 1.7rem; line-height: 1.2; }
.mx7-d > p + p { margin-top: .8rem; }
.mx7-d > .mx7-d__stelle { margin-top: -.8rem; margin-bottom: 1rem; color: var(--s7-grau); }
.mx7-d > .mx7-d__label { margin: 1.8rem 0 .4rem; color: var(--s7-tinte); font-weight: 700; }
.mx7-d__punkt { padding: .8rem 0; border-top: 1px solid var(--s7-linie); }
.mx7-d__punkt b { color: var(--s7-tinte); }
.mx7-d__punkt p { margin-top: .2rem; }
.mx7-d ul { margin: .4rem 0 0; padding-left: 1.2rem; }
.mx7-d li { margin: .25rem 0; }
.mx7-d__hinweis { margin-top: 1.6rem !important; color: var(--s7-grau); font-size: .9rem; }

@media (max-width: 1100px) {
  .mx7-kreis { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(8, auto); }
  .mx7-kreis__t { padding-bottom: 2.4rem; }
  .mx7-kreis__schritt .mx7-kreis__bild::after, .mx7-kreis__zurueck { display: none; }
  .mx7-kreis { margin-top: 3rem; }
}
@media (max-width: 1000px) {
  .mx7-kern, .mx7-erg { grid-template-columns: minmax(0, 1fr); }
  .mx7-kern > div + div { padding-left: 0; padding-top: 1.6rem; border-left: 0; border-top: 1px solid #3a3a3c; }
  .mx7-erg { grid-template-rows: none; gap: 1.2rem; }
  .mx7-karte { grid-row: auto; grid-template-rows: none; }
  .mx7-team { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; gap: 1rem; }
  .mx7-team .s7-gruppe { display: none; }
  .mx7-profil { grid-row: auto; grid-template-rows: auto auto 1fr auto; }
}
@media (max-width: 600px) { .mx7-kreis, .mx7-team { grid-template-columns: minmax(0, 1fr); } .mx7-kreis { grid-template-rows: none; } .mx7-kreis__schritt { grid-row: auto; grid-template-rows: none; } }

/* ===================================================================================
   STILRICHTUNGEN – jede setzt die Stellschrauben neu, dazu wenige eigene Regeln
   =================================================================================== */

/* 1 · Apple-klar: Weiß/Hellgrau, sehr große Grotesk, Verlauf nur punktuell */
.s7-stil--apple {
  --s7-schrift-titel: "Inter Tight", "Inter", system-ui, sans-serif;
  --s7-schrift-text: "Inter", system-ui, sans-serif;
  --s7-titel-gewicht: 700; --s7-titel-abstand: -0.025em;
  --s7-h1: clamp(3rem, 7.6vw, 6.6rem); --s7-h1-hoehe: 1.0;
  --s7-h2: clamp(2.3rem, 5vw, 4rem);   --s7-h2-hoehe: 1.05;
  --s7-grund: #ffffff; --s7-flaeche: #f5f5f7; --s7-tinte: #1d1d1f; --s7-text: #424245; --s7-grau: #86868b; --s7-linie: #e5e5ea;
  --s7-akzent: #e3e8ff; --s7-akzent-fill: url(#s7v-pastell); --s7-akzent-verlauf: linear-gradient(100deg, #dfe6ff, #eddcff); --s7-auf-akzent: #1d1d1f;
  --s7-wort: transparent; --s7-wort-verlauf: linear-gradient(100deg, #2f6bff 0%, #7b3fe4 55%, #b44ce0 100%);
  --s7-knopf-grund: #1d1d1f; --s7-knopf-text: #ffffff;
  --s7-buehne: #ffffff; --s7-band-akzent: #f5f5f7; --s7-karte: #ffffff;
  --s7-schatten: none;
  --s7-komplett-grund: #1d1d1f; --s7-komplett-text: #d2d2d7; --s7-komplett-titel: #ffffff; --s7-komplett-haken: #9d8cff;
  --s7-lage-1: #d5d5db; --s7-lage-2: #e1e1e6; --s7-lage-3: #ececf0;
  --s7-rund: 24px;
}
.s7-stil--apple .s7-held { text-align: center; }
.s7-stil--apple .s7-held h1, .s7-stil--apple .s7-held .s7-lead { margin-left: auto; margin-right: auto; }
.s7-stil--apple .s7-held__knoepfe { justify-content: center; }
.s7-stil--apple .s7-held .s7-lead { color: #6e6e73; }
.s7-stil--apple .s7-kicker { letter-spacing: .02em; text-transform: none; font-size: 1rem; font-weight: 600; color: #6e6e73; }
.s7-stil--apple .s7-pille--an, .s7-stil--apple .s7-dash__kachel--an, .s7-stil--apple .s7-strecke__ziel b { background: var(--s7-akzent-verlauf); }

/* Farbakzente für Apple-klar (Farbproben): Farbe immer vollflächig mit weißer Schrift, im Wort als Verlauf – keine zarten Tönungen */
.s7-farbe--cyanviolett {
  --s7-wort-verlauf: linear-gradient(100deg, #0b9fbd 0%, #8613a1 100%);
  --s7-akzent: #0b9fbd; --s7-akzent-verlauf: linear-gradient(100deg, #0b9fbd, #8613a1); --s7-akzent-fill: url(#s7v-cyanviolett); --s7-akzent-fill-hoch: url(#s7v-cyanviolett-h); --s7-akzent-ende: #8613a1; --s7-auf-akzent: #ffffff;
  --s7-komplett-grund: linear-gradient(140deg, #0b9fbd 0%, #8613a1 100%); --s7-komplett-text: #efe6f4; --s7-komplett-haken: #ffffff; --s7-komplett-knopf-text: #8613a1;
}
.s7-farbe--magentaviolett {
  --s7-wort-verlauf: linear-gradient(100deg, #c51f5d 0%, #8613a1 100%);
  --s7-akzent: #c51f5d; --s7-akzent-verlauf: linear-gradient(100deg, #c51f5d, #8613a1); --s7-akzent-fill: url(#s7v-magentaviolett); --s7-akzent-fill-hoch: url(#s7v-magentaviolett-h); --s7-akzent-ende: #8613a1; --s7-auf-akzent: #ffffff;
  --s7-komplett-grund: linear-gradient(140deg, #c51f5d 0%, #8613a1 100%); --s7-komplett-text: #f6e7ef; --s7-komplett-haken: #ffffff; --s7-komplett-knopf-text: #8613a1;
}
/* Flächen-Test (Farbproben) */
.fp-kacheln { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; margin-top: 2rem; }
.fp-k { display: flex; flex-direction: column; justify-content: space-between; gap: 1.6rem; min-height: 11rem; padding: 1.6rem; border-radius: var(--s7-rund); }
.fp-k b { display: block; font-size: .85rem; font-weight: 600; }
.fp-k small { display: block; margin-top: .2rem; font-size: .85rem; opacity: .8; }
.fp-k--voll { background: var(--s7-komplett-grund); color: #fff; }
.fp-k--zart { background: var(--s7-akzent-verlauf); color: var(--s7-tinte); }
.fp-k--text { background: #fff; border: 1px solid var(--s7-linie); color: var(--s7-tinte); }
.fp-k__gross { font-family: var(--s7-schrift-titel); font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; }
@media (max-width: 760px) { .fp-kacheln { grid-template-columns: minmax(0, 1fr); } }

/* ---------- Stilproben-Seite: Steckbriefe ---------- */
.sp-kopf { padding: clamp(3rem, 6vw, 5rem) 0 3rem; border-bottom: 1px solid #e2e2df; }
.sp-kopf h1 { max-width: 18ch; font-size: clamp(2.4rem, 5.4vw, 4.4rem); line-height: 1.04; letter-spacing: -0.03em; }
.sp-massstab { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem 2rem; margin: 2rem 0 0; padding: 0; list-style: none; }
.sp-massstab li { padding-top: .7rem; border-top: 1px solid #e2e2df; font-size: .95rem; line-height: 1.45; }
.sp-sprung { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2rem; }
.sp-sprung a { padding: .55rem 1rem; border: 1.5px solid #181818; border-radius: 99px; color: #181818; font-weight: 600; font-size: .92rem; text-decoration: none; }
.sp-brief { position: relative; z-index: 2; background: #111; color: #cfcfcf; }
.sp-brief .s7-wrap { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 1rem 2.4rem; align-items: center; padding: 1.6rem 0; }
.sp-brief__nr { color: #fff; font: 700 2.6rem/1 system-ui, sans-serif; }
.sp-brief h2 { margin: 0; color: #fff; font: 700 1.5rem/1.2 system-ui, sans-serif; }
.sp-brief p { margin-top: .3rem; font-size: .95rem; line-height: 1.5; }
.sp-brief dl { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .25rem 1rem; margin: .8rem 0 0; font-size: .85rem; }
.sp-brief dt { color: #8a8a8a; }
.sp-brief dd { margin: 0; color: #e9e9e9; }
.sp-farben { display: flex; gap: .5rem; }
.sp-farben i { width: 2.4rem; height: 2.4rem; border-radius: 50%; border: 1px solid rgba(255,255,255,.25); }
.sp-ende { padding: 4rem 0 5rem; background: #f4f4f3; }
.sp-ende h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); letter-spacing: -0.02em; }
.sp-ende p { max-width: 40rem; margin-top: .8rem; }

/* ---------- Mobil ---------- */
@media (max-width: 1000px) {
  .s7-nav { display: none; }
  .s7-kopf .s7-knopf { margin-left: auto; }
  .s7-ablauf, .s7-pakete { grid-template-columns: minmax(0, 1fr); row-gap: 1rem; }
  .s7-ablauf__schritt, .s7-paket { grid-row: auto; grid-template-rows: none; }
  .s7-ablauf__schritt { margin-bottom: 2.4rem; }
  .s7-ablauf__schritt:not(:last-child) .s7-ablauf__bild::after { display: none; }
  .s7-zg-listen { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  .s7-gruppe { grid-row: auto; grid-column: 1; margin: 1rem 0 .2rem; }
  .s7-gruppe--b { order: 3; }
  .s7-paket--komplett { order: 4; }
  .s7-vertrauen, .s7-kontakt { grid-template-columns: minmax(0, 1fr); }
  .s7-vertrauen__text { padding: 0; }

  .sp-massstab { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .sp-brief .s7-wrap { grid-template-columns: auto minmax(0, 1fr); }
  .sp-farben { grid-column: 1 / -1; }
}
@media (max-width: 600px) {
  .sp-massstab { grid-template-columns: minmax(0, 1fr); }
  .s7-kopf .s7-knopf { display: none; }
}
</style>
</head>
<body>
{#- Verläufe für Grafiken (fill: url(#…)) – einmal je Seite -#}
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
  <linearGradient id="s7v-pastell" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#d9e2ff"/><stop offset="1" stop-color="#ecdbff"/></linearGradient>
  <linearGradient id="s7v-cyanviolett" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#0b9fbd"/><stop offset="1" stop-color="#8613a1"/></linearGradient>
  <linearGradient id="s7v-cyanviolett-h" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0b9fbd"/><stop offset="1" stop-color="#8613a1"/></linearGradient>
  <linearGradient id="s7v-magentaviolett-h" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c51f5d"/><stop offset="1" stop-color="#8613a1"/></linearGradient>
  <linearGradient id="s7v-magentaviolett" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#c51f5d"/><stop offset="1" stop-color="#8613a1"/></linearGradient>
</defs></svg>

<div class="s7-dev"><div class="s7-wrap"><span><b>Storyboard · Homepage-Story 7</b> · {% if s.slug == "stilproben" %}Stilproben: Apple-klar gewählt{% elif s.slug == "farbproben" %}Farbproben: drei Farbakzente für Apple-klar{% elif s.slug == "marketing-as-a-service" %}Unterseite Marketing as a Service (Weg B) · <span class="s7-schalter" role="group" aria-label="Farbe umstellen">Farbe <button type="button" data-farbe="cyanviolett" aria-pressed="true" title="Cyan → Violett">1</button><button type="button" data-farbe="magentaviolett" aria-pressed="false" title="Magenta → Violett">2</button></span>{% endif %}</span><span>{% if s.slug %}<a href="/entwicklung/storyboard/story7/">Startseite (Arbeitslook)</a>{% endif %}{% if s.slug != "stilproben" %}<a href="/entwicklung/storyboard/story7/stilproben/">Stilproben</a>{% endif %}{% if s.slug != "farbproben" %}<a href="/entwicklung/storyboard/story7/farbproben/">Farbproben</a>{% endif %}<a href="{{ B6 }}/story-varianten/">Story-Varianten</a></span></div></div>

<div class="s7-stil{% if istSeite %} s7-stil--apple s7-farbe--cyanviolett{% endif %}" id="s7-seite">
<header class="s7-kopf{% if not istSeite %} s7-kopf--nur-marke{% endif %}">
  <div class="s7-wrap">
    <div class="s7-marke">
      <a href="/entwicklung/storyboard/story7/" aria-label="sofort sichtbar – Startseite"><img src="{{ B6 }}/assets/img/logo-dunkel.svg" alt="sofort sichtbar" width="78" height="40"></a>
      <div class="s7-dd" data-s7-dd>
        <button type="button" class="s7-dd__auf" aria-expanded="false" aria-controls="s7-dd-panel" aria-label="Entwicklungsmenü öffnen"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4z"/></svg></button>
        <div class="s7-dd__panel" id="s7-dd-panel" hidden>
          {%- for item in site.nav %}{% if item.devOnly %}{% for c in item.children %}
          {%- if c.typ == "hinweis" %}<p class="s7-dd__hinweis">{{ c.text }}</p>
          {%- elif c.typ == "gruppe" %}<p class="s7-dd__gruppe">{{ c.label }}</p>
          {%- else %}<a href="{{ c.href }}"{% if c.href | isCurrentPath(page.url) %} aria-current="page"{% endif %}>{{ c.label }}</a>{% endif %}
          {%- endfor %}{% endif %}{% endfor %}
        </div>
      </div>
    </div>
    {%- if istSeite %}
    {#- Hauptmenü: echte Unterseiten; „Pakete“ und „Über uns“ springen zur Startseite, bis sie eigene Seiten haben -#}
    <nav class="s7-nav" aria-label="Hauptnavigation">
      <a href="{{ H7 }}/marketing-as-a-service/"{% if s.slug == "marketing-as-a-service" %} aria-current="page"{% endif %}>Marketing as a Service</a>
      <a href="/vertriebsstrecken">Vertriebsstrecken</a>
      <a href="{{ H7 }}/#pakete">Pakete</a>
      <a href="{{ H7 }}/#ueber-uns">Über uns</a>
    </nav>
    {%- endif %}
    <a class="s7-knopf" href="#kontakt">Termin auswählen</a>
  </div>
</header>

{%- if s.slug == "stilproben" %}
{%- set SP = S.stilproben %}
<main>
  <section class="sp-kopf">
    <div class="s7-wrap">
      <p class="s7-kicker">Stilproben · zur Auswahl</p>
      <h1>{{ SP.h1 }} <span class="s7-wort">{{ SP.h1_akzent }}</span></h1>
      <p class="s7-lead">{{ SP.lead }}</p>
      <ul class="sp-massstab">{% for m in SP.massstab %}<li>{{ m }}</li>{% endfor %}</ul>
      <nav class="sp-sprung" aria-label="Zu den Richtungen">{% for st in SP.stile %}<a href="#stil-{{ st.id }}">{{ st.nr }} · {{ st.name }}</a>{% endfor %}</nav>
    </div>
  </section>
  {%- for st in SP.stile %}
  <section class="sp-brief" id="stil-{{ st.id }}">
    <div class="s7-wrap">
      <span class="sp-brief__nr">{{ st.nr }}</span>
      <div>
        <h2>{{ st.name }}</h2>
        <p>{{ st.satz }}</p>
        <dl><dt>Schrift</dt><dd>{{ st.schrift }}</dd><dt>Farbe</dt><dd>{{ st.farbe }}</dd><dt>Vorbilder</dt><dd>{{ st.vorbilder }}</dd><dt>Risiko</dt><dd>{{ st.risiko }}</dd></dl>
      </div>
      <div class="sp-farben" aria-hidden="true">{% for f in st.swatches %}<i style="background: {{ f }}"></i>{% endfor %}</div>
    </div>
  </section>
  <div class="s7-stil s7-stil--{{ st.id }}">
    {{ held(false) }}
    {{ schritte(false) }}
    {{ pakete(false) }}
  </div>
  {%- endfor %}
  <section class="sp-ende">
    <div class="s7-wrap">
      <h2>Weiter mit der Farbe.</h2>
      <p>Welcher Farbakzent zu Apple-klar passt, zeigen die <a href="/entwicklung/storyboard/story7/farbproben/">Farbproben</a>.</p>
    </div>
  </section>
</main>
{%- elif s.slug == "farbproben" %}
{%- set FP = S.farbproben %}
<main>
  <section class="sp-kopf">
    <div class="s7-wrap">
      <p class="s7-kicker">Farbproben · Apple-klar</p>
      <h1>{{ FP.h1 }} <span class="s7-wort">{{ FP.h1_akzent }}</span></h1>
      <p class="s7-lead">{{ FP.lead }}</p>
      <ul class="sp-massstab">{% for m in FP.stellen %}<li>{{ m }}</li>{% endfor %}</ul>
      <nav class="sp-sprung" aria-label="Zu den Farben">{% for f in FP.farben %}<a href="#farbe-{{ f.id }}">{{ f.nr }} · {{ f.name }}</a>{% endfor %}</nav>
    </div>
  </section>
  {%- for f in FP.farben %}
  <section class="sp-brief" id="farbe-{{ f.id }}">
    <div class="s7-wrap">
      <span class="sp-brief__nr">{{ f.nr }}</span>
      <div><h2>{{ f.name }}</h2><p>{{ f.satz }}</p></div>
      <div class="sp-farben" aria-hidden="true"><i style="background: {{ f.swatch }}; width: 7rem; border-radius: 99px"></i></div>
    </div>
  </section>
  <div class="s7-stil s7-stil--apple s7-farbe--{{ f.id }}">
    {{ held(false) }}
    <section class="s7-band">
      <div class="s7-wrap">
        <p class="s7-kicker">Flächen-Test</p>
        <h2 class="s7-h2">So wirkt die Farbe als Fläche.</h2>
        <div class="fp-kacheln">
          <div class="fp-k fp-k--voll"><span class="fp-k__gross">ab 1.800 €</span><span><b>Kräftig</b><small>Komplett-Paket, Kern der Maschine, Leads, gewählte Pills</small></span></div>
          <div class="fp-k fp-k--text"><span class="fp-k__gross s7-wort">vor deinem Vertrieb.</span><span><b>Als Schrift</b><small>Das hervorgehobene Wort</small></span></div>
        </div>
      </div>
    </section>
    {{ pakete(false) }}
  </div>
  {%- endfor %}
</main>
{%- elif s.slug == "marketing-as-a-service" %}
{#- Unterseite Weg B · Sicht der Vertriebsleitung (Daniel, 12.11.2026): ausführliche Maschine oben (Strategie davor, Lagen mit Namen, Steuerung danach),
    Kreislauf mit Ausschnitten aus dem echten Produkt (Bildsprache der Startseite, keine Icons), Bausteine mit Ausschnitten und Pop-ups,
    Team mit Rollenprofilen. Farbe je Abschnitt an genau einer Stelle. Inhalte: s7.maas -#}
{%- set M = S.maas %}
{%- macro schliessen() -%}<button type="button" class="mx7-d__zu" aria-label="Schließen">×</button>{%- endmacro -%}
<main>
  <section class="s7-held">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ M.held.kicker }}</p>
      <h1>{{ M.held.h1 }} <span class="s7-wort">{{ M.held.h1_akzent }}</span></h1>
      <p class="s7-lead">{{ M.held.lead }}</p>
      <div class="s7-held__knoepfe">
        <a class="s7-knopf" href="#kontakt">{{ M.held.knopf }} {{ pfeil | safe }}</a>
        <a class="s7-knopf s7-knopf--rand" href="#bausteine">{{ M.held.knopf2 }}</a>
      </div>
      <figure class="s7-maschine">{{ erklaerbild(true) }}</figure>
    </div>
  </section>

  {%- set MO = M.monat %}{%- set L = MO.liste %}
  <section class="s7-band s7-band--akzent" id="so-arbeiten-wir">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ MO.kicker }}</p>
      <h2 class="s7-h2">{{ MO.h2 }}</h2>
      <p class="s7-lead">{{ MO.lead }}</p>
      <div class="mx7-kreis__zurueck" aria-hidden="true"><span>{{ MO.zurueck }}</span></div>
      <ol class="mx7-kreis">
        <li class="mx7-kreis__schritt">
          <div class="mx7-kreis__bild" aria-hidden="true"><div class="s7-mini">
            <p class="s7-mini__kopf">Diese Woche</p>
            <ul class="mx7-mliste"><li><span>Landingpage Junge Familien</span><em>aktualisiert</em></li><li><span>Posting Bauherren</span><em>veröffentlicht</em></li><li><span>Posting Junge Familien</span><em>geplant</em></li></ul>
          </div></div>
          <p class="mx7-rolle">{{ MO.rollen[L[0].rolle] }}</p><h3>{{ L[0].titel }}</h3><p class="mx7-kreis__t">{{ L[0].text }}</p>
        </li>
        <li class="mx7-kreis__schritt">
          <div class="mx7-kreis__bild" aria-hidden="true"><div class="s7-mini">
            <p class="s7-mini__kopf">Neue Leads</p>
            <div class="s7-mini__lead ziel"><b>Familie M. · Junge Familien</b><span>Rückruf heute</span></div>
            <div class="mx7-mlead"><b>Herr K. · Bauherren</b><span>Termin gebucht: Donnerstag, 10:00 Uhr</span></div>
          </div></div>
          <p class="mx7-rolle mx7-rolle--du">{{ MO.rollen[L[1].rolle] }}</p><h3>{{ L[1].titel }}</h3><p class="mx7-kreis__t">{{ L[1].text }}</p>
        </li>
        <li class="mx7-kreis__schritt">
          <div class="mx7-kreis__bild" aria-hidden="true"><div class="s7-mini">
            <p class="s7-mini__kopf">Report November</p>
            <div class="s7-mini__kacheln"><div><b>Leads</b><svg viewBox="0 0 60 16" preserveAspectRatio="none"><polyline points="0,13 12,11 24,12 36,8 48,6 60,3"/></svg></div><div><b>Verweildauer</b><svg viewBox="0 0 60 16" preserveAspectRatio="none"><polyline points="0,4 12,5 24,4 36,8 48,10 60,13"/></svg></div></div>
