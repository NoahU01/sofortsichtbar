{%- elif s.slug == "strategiekompass" %}
{#- Unterseite Strategiekompass: Konfigurator (Logik und Daten unverändert aus story6/assets/kompass/kompass-g.js – eine Quelle),
    im Story-7-Stil; ohne Preisblock (Pakete haben noch keine festen Preise), Weiter führt zum Kontakt. -#}
{%- set KO = S.kompass %}
