<style>
.sb { display: flex; flex-flow: column; gap: 4rem; }

/* Roter Faden */
.sb-faden { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; counter-reset: f; }
.sb-faden li { counter-increment: f; }
.sb-faden a {
  display: flex; align-items: center; gap: 0.55rem;
  padding: 0.45rem 0.9rem 0.45rem 0.5rem;
  border: 1px solid var(--color-element); border-radius: var(--radius-pill);
  color: var(--color-grey-100); font-size: 0.85rem; text-decoration: none;
  transition: border-color var(--transition), color var(--transition);
}
.sb-faden a::before {
  content: counter(f); display: grid; place-items: center;
  width: 1.5rem; height: 1.5rem; border-radius: 50%;
  background: var(--color-element); color: #fff; font-size: 0.75rem; font-weight: 600;
}
.sb-faden a:hover { border-color: var(--color-accent); color: #fff; }

/* Szene: links Aufgabe, rechts Bild */
.sb-szene {
  display: grid; grid-template-columns: 17rem minmax(0, 1fr); gap: 2.5rem;
  padding-top: 2.5rem; border-top: 1px solid var(--color-element);
  scroll-margin-top: 6rem;
}
.sb-meta { display: flex; flex-flow: column; gap: 1.1rem; }
.sb-nr { color: var(--color-accent); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
.sb-titel { margin-top: -0.6rem; color: #fff; font-size: 1.5rem; font-weight: 600; line-height: 1.25; }
.sb-meta dl { display: flex; flex-flow: column; gap: 0.9rem; margin: 0; }
.sb-meta dt { color: var(--color-grey-400); font-size: 0.75rem; font-weight: 500; }
.sb-meta dd { margin: 0.15rem 0 0; color: var(--color-grey-100); font-size: 0.9rem; line-height: 1.5; }
.sb-meta dd.sb-gedanke { color: #fff; font-style: italic; }
.sb-meta ul { margin: 0.3rem 0 0; padding-left: 1.1rem; }
.sb-meta li + li { margin-top: 0.25rem; }

/* Bildrahmen im Stil der Startseite */
.sb-bild {
  position: relative; overflow: hidden;
  display: flex; flex-flow: column; justify-content: center; gap: 1.75rem;
  min-height: 24rem; padding: clamp(1.75rem, 4vw, 3.5rem);
  background: var(--color-background); border: 1px solid var(--color-element); border-radius: var(--radius-xl);
}
.sb-bild > * { position: relative; z-index: 1; }
.sb-bild::after {
  content: ""; position: absolute; z-index: 0; inset: -6rem -8rem auto auto;
  width: 28rem; height: 14rem; background: var(--glow-plum); filter: blur(7rem); opacity: 0.8;
}
.sb-eyebrow { color: var(--color-grey-100); font-size: 0.85rem; }
.sb-h { max-width: 42rem; color: #fff; font-size: clamp(1.75rem, 3.6vw, 3rem); font-weight: 600; line-height: 1.12; letter-spacing: -0.02em; }
.sb-h--m { font-size: clamp(1.5rem, 2.8vw, 2.25rem); }
.sb-h em { font-style: normal; color: var(--color-accent); }
.sb-text { max-width: 38rem; color: var(--color-grey-100); font-size: 1rem; line-height: 1.55; }
.sb-knoepfe { display: flex; flex-wrap: wrap; gap: 0.75rem; }
.sb-knoepfe .btn { padding: 0.85rem 1.5rem; font-size: 0.95rem; }

/* Szene 2: Eingang */
.sb-eingang { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0.6rem; }
.sb-post {
  padding: 0.85rem 1rem; border-radius: var(--radius-md);
  background: var(--color-surface); border: 1px solid var(--color-element);
}
.sb-post span { display: block; color: var(--color-grey-400); font-size: 0.72rem; }
.sb-post b { display: block; margin-top: 0.2rem; color: #fff; font-size: 0.9rem; font-weight: 500; }
.sb-schluss { color: #fff; font-size: 1.1rem; font-weight: 500; }

/* Szene 4: das Haus */
.sb-haus { display: grid; gap: 0.6rem; max-width: 46rem; }
.sb-dach {
  padding: 1.1rem 1rem 0.9rem; text-align: center;
  clip-path: polygon(6% 100%, 50% 0, 94% 100%);
  background: var(--color-accent); color: #fff;
}
.sb-dach b { display: block; padding-top: 1.6rem; font-size: 1rem; font-weight: 600; }
.sb-dach span { font-size: 0.78rem; opacity: 0.85; }
.sb-saeulen { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; align-items: end; }
.sb-saeule { display: flex; flex-flow: column; gap: 0.3rem; }
.sb-saeule__name { padding: 0.55rem 0.4rem; text-align: center; border-radius: var(--radius-sm); background: #fff; color: #000; font-size: 0.8rem; font-weight: 600; line-height: 1.25; }
.sb-saeule__teil { padding: 0.5rem 0.4rem; text-align: center; border-radius: var(--radius-sm); background: var(--color-surface); border: 1px solid var(--color-element); color: var(--color-grey-100); font-size: 0.72rem; line-height: 1.3; }
.sb-saeule--blind .sb-saeule__name { background: transparent; border: 1px dashed var(--color-grey-600); color: var(--color-grey-400); }
.sb-saeule--blind .sb-saeule__teil { border-style: dashed; color: var(--color-grey-600); background: transparent; }
.sb-saeule__fehlt { min-height: 4.6rem; margin: 0; padding: 0.4rem; color: var(--color-grey-400); font-size: 0.72rem; line-height: 1.35; text-align: center; }
.sb-fundament { padding: 0.75rem 1rem; text-align: center; border-radius: var(--radius-sm); background: var(--color-element); color: #fff; font-size: 0.85rem; font-weight: 500; }
.sb-fundament span { color: var(--color-grey-100); font-weight: 400; }

/* Szene 5: der Weg */
.sb-weg { display: flex; flex-flow: column; gap: 1.25rem; }
.sb-block { display: flex; flex-flow: column; gap: 0.5rem; }
.sb-block__titel { display: flex; align-items: baseline; gap: 0.6rem; color: #fff; font-size: 0.95rem; font-weight: 600; }
.sb-block__titel span { color: var(--color-grey-400); font-size: 0.8rem; font-weight: 400; }
.sb-block--mensch .sb-schritt { border-color: var(--color-accent); }
.sb-schritt {
  display: grid; grid-template-columns: 2rem minmax(0, 1.1fr) minmax(0, 1.4fr) minmax(0, 1fr); gap: 1rem; align-items: start;
  padding: 0.9rem 1rem; border-radius: var(--radius-md);
  background: var(--color-surface); border: 1px solid var(--color-element);
}
.sb-schritt__nr { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--color-element); color: #fff; font-size: 0.8rem; font-weight: 600; }
.sb-schritt__frage { color: #fff; font-size: 0.92rem; font-weight: 500; line-height: 1.4; }
.sb-schritt__wir { color: var(--color-grey-100); font-size: 0.85rem; line-height: 1.45; }
.sb-schritt__du { color: var(--color-grey-400); font-size: 0.82rem; line-height: 1.45; }
.sb-schritt__du::before { content: "+ "; color: var(--color-accent); font-weight: 600; }
.sb-schritt__du:empty::before { content: ""; }
.sb-weg__kopf { display: grid; grid-template-columns: 2rem minmax(0, 1.1fr) minmax(0, 1.4fr) minmax(0, 1fr); gap: 1rem; padding: 0 1rem; color: var(--color-grey-400); font-size: 0.72rem; font-weight: 500; }

/* Szene 6: Beleg */
.sb-zitat { max-width: 40rem; margin: 0; color: #fff; font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 500; line-height: 1.25; letter-spacing: -0.015em; }
.sb-zitat-quelle { color: var(--color-grey-400); font-size: 0.9rem; }

/* Szene 7: zwei Einstiege */
.sb-einstiege { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
.sb-einstieg { display: flex; flex-flow: column; align-items: flex-start; gap: 0.75rem; padding: 1.5rem; border-radius: var(--radius-lg); background: var(--color-surface); border: 1px solid var(--color-element); }
.sb-einstieg__wer { color: var(--color-accent); font-size: 0.8rem; font-weight: 600; }
.sb-einstieg h3 { color: #fff; font-size: 1.25rem; font-weight: 600; line-height: 1.3; }
.sb-einstieg p { color: var(--color-grey-100); font-size: 0.9rem; line-height: 1.5; }
.sb-einstieg .btn { margin-top: auto; padding: 0.8rem 1.4rem; font-size: 0.9rem; }

/* Offene Punkte */
.sb-offen { padding: 2rem; border: 1px dashed var(--color-grey-600); border-radius: var(--radius-xl); background: var(--color-background); }
.sb-offen h2 { color: #fff; font-size: 1.2rem; font-weight: 600; }
.sb-offen ol { margin: 1rem 0 0; padding-left: 1.25rem; color: var(--color-grey-100); font-size: 0.92rem; line-height: 1.55; }
.sb-offen li + li { margin-top: 0.5rem; }
.sb-offen b { color: #fff; font-weight: 500; }

@media (max-width: 991px) {
  .sb-szene { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  .sb-weg__kopf { display: none; }
  .sb-schritt { grid-template-columns: 2rem minmax(0, 1fr); }
  .sb-schritt__wir, .sb-schritt__du { grid-column: 2; }
  .sb-schritt__du:empty { display: none; }
}
@media (max-width: 600px) {
  .sb-saeulen { gap: 0.3rem; }
  .sb-saeule__name { padding: 0.45rem 0.2rem; font-size: 0.66rem; hyphens: manual; }
  .sb-saeule__teil { padding: 0.35rem 0.15rem; font-size: 0.58rem; }
  .sb-saeule__fehlt { font-size: 0.58rem; padding: 0.3rem 0.1rem; }
  .sb-dach { clip-path: polygon(0 100%, 50% 0, 100% 100%); }
  .sb-dach b { padding-top: 2rem; font-size: 0.85rem; }
  .sb-einstiege { grid-template-columns: minmax(0, 1fr); }
  .sb-bild { min-height: 0; padding: 1.5rem 1.25rem; border-radius: var(--radius-lg); }
  .sb-eingang { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .sb-szene { padding-top: 2rem; }
  .sb { gap: 3rem; }
  .dev-page__box { padding: 1.5rem 1.25rem; }
  .sb-offen { padding: 1.5rem; }
}
</style>

