<script>
(function () {
  // Platzhalter-Zuordnung, bis die Kompass-Logik feststeht.
  var Z = {
    berufseinsteiger: ["Berufseinsteiger", "/zielgruppen/berufseinsteiger-im-ersten-job", "berufseinsteiger"],
    familien: ["Junge Familien", "/zielgruppen/werdende-eltern", "werdende-eltern"],
    angestellte: ["Kommunale Angestellte", "/zielgruppen/kommunale-angestellte", "angestellte"],
    digital: ["Digital aktive Personen", "/zielgruppen/digital-aktive-privatpersonen", "digital-aktive"],
    bauherren: ["Private Bauherren", "/zielgruppen/bauherren", "bauherren"],
    umzug: ["Umzug", "/zielgruppen/umzug", "umzug"],
    tierhalter: ["Private Tierhalter", "/zielgruppen/private-tierhalter-im-lokalen-umfeld", "tierhalter"],
    ehepaare: ["Junge Ehepaare", "/zielgruppen/junge-ehepaare", "junge-ehepaare"],
    firmen: ["Inhabergeführte Firmen", "/zielgruppen/gewerbekunden", "kmu"],
    aerzte: ["Ärzte und Zahnärzte", "/zielgruppen/arzte", "arzte"],
    kanzlei: ["Kanzleiinhaber", "/zielgruppen/anwalte-und-kanzleiinhaber", "kanzleiinhaber"],
    it: ["IT-lastige Firmen", "/zielgruppen/cyber-firmen", "cyber-firmen"],
    heilberufe: ["Gesundheitsnahe Heilberufe", "/zielgruppen/physio-und-pflege", "physio-pfleger"],
    landwirte: ["Landwirte", "/zielgruppen/landwirte", "landwirte"],
    hausverwaltung: ["Hausverwaltungen", "/zielgruppen/hausverwalter", "hausverwaltung"],
    gruender: ["Gründer & Freelancer", "/zielgruppen/freelancer-und-grunder", "grunder-und-freelancer"]
  };
  var K = {
    privat: { leben: ["berufseinsteiger", "familien", "ehepaare"], kranken: ["angestellte", "berufseinsteiger", "digital"], sach: ["bauherren", "umzug", "tierhalter"], kfz: ["berufseinsteiger", "familien", "umzug"] },
    gewerbe: { leben: ["firmen", "aerzte", "kanzlei"], kranken: ["firmen", "it", "heilberufe"], sach: ["landwirte", "it", "hausverwaltung"], kfz: ["firmen", "landwirte", "gruender"] }
  };
  var stand = { segment: "privat", sparte: "leben" };
  var liste = document.getElementById("v4-treffer");

  function zeigen() {
    liste.innerHTML = K[stand.segment][stand.sparte].map(function (id) {
      var z = Z[id];
      return '<li><a href="' + z[1] + '"><img src="/assets/img/zielgruppen/' + z[2] + '-style-1.webp" alt="" loading="lazy"><b>' + z[0] + '</b><i>Paket ansehen →</i></a></li>';
    }).join("");
  }

  document.querySelectorAll(".v4-wahl").forEach(function (gruppe) {
    gruppe.addEventListener("click", function (e) {
      var knopf = e.target.closest("button");
      if (!knopf) return;
      gruppe.querySelectorAll("button").forEach(function (b) { b.setAttribute("aria-pressed", b === knopf ? "true" : "false"); });
      stand[gruppe.dataset.gruppe] = knopf.dataset.wert;
      zeigen();
    });
  });
  zeigen();
})();
</script>
