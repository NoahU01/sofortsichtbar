  {%- set DL = S.maas.download if art == "b" else S.weg_a.download %}{% set DP = (A7 + "/maas") if art == "b" else DL.pfad %}
  <section class="s9-band s9-band--flaeche">
    <div class="s7-wrap s9-pdf">
      <div class="s9-pdf__bild" aria-hidden="true"><img src="{{ DP }}/{{ DL.bild2 }}" alt="" width="637" height="900"><img src="{{ DP }}/{{ DL.bild1 }}" alt="" width="636" height="900"></div>
      <div><h2 class="s9-h2">{{ Z.pdf_h2 }}</h2><p class="s9-lead s9-lead--dunkel">{{ Z.pdf_lead }}</p><a class="s7-knopf" href="{{ DP }}/{{ DL.datei }}" target="_blank" rel="noopener">PDF herunterladen <svg class="s7-pfeil" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg></a></div>
    </div>
  </section>

  {{ kontaktBand() }}
</main>
<script>
/* Story 9: Schalter Selbst machen / Machen lassen – zeigt, welche Rolle wir dazustellen */
document.querySelectorAll("[data-s9]").forEach(function (k) {
  k.addEventListener("click", function () {
    var t = k.closest(".s9-team"); t.setAttribute("data-paket", k.getAttribute("data-s9"));
    t.querySelectorAll("[data-s9]").forEach(function (x) { x.setAttribute("aria-checked", x === k ? "true" : "false"); });
  });
});
</script>
{%- elif s.slug == "mit-deinem-team" or s.basis == "mit-deinem-team" %}
