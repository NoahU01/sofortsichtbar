          {%- for b in BS %}{% if not loop.first %}<p class="s9-zeile"><span>{{ b.name }}</span><b>{{ b.preis }}</b><small>{{ b.einheit }}</small></p>{% endif %}{% endfor %}
        </div>
      </div>
      {%- else %}
      <div class="s9-preis s9-preis--zwei">
        {%- for p in S.pakete.liste %}{% if p.id != "komplett" %}
        <div class="s9-paket"><p class="s9-wer">Paket</p><p class="s9-preis__name">{{ p.name }}</p><p class="s9-paket__fuer">{{ p.fuer }}</p></div>
        {%- endif %}{% endfor %}
      </div>
      {%- endif %}
