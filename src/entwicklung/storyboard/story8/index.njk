      <div class="ks7__kalender"><div id="cal-inline-{{ C.namespace }}"></div></div>
    </div>
  </section>
</main>
<script>
  (function (C, A, L) { var p = function (a, ar) { a.q.push(ar); }; var d = C.document;
    C.Cal = C.Cal || function () { var cal = C.Cal, ar = arguments;
      if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; }
      if (ar[0] === L) { var api = function () { p(api, arguments); }; var ns = ar[1]; api.q = api.q || [];
        if (typeof ns === "string") { cal.ns[ns] = cal.ns[ns] || api; p(cal.ns[ns], ar); p(cal, ["initNamespace", ns]); } else { p(cal, ar); } return; }
      p(cal, ar); };
  })(window, "{{ C.origin }}/embed/embed.js", "init");
  Cal("init", "{{ C.namespace }}", { origin: "{{ C.origin }}" });
  Cal.ns["{{ C.namespace }}"]("inline", { elementOrSelector: "#cal-inline-{{ C.namespace }}", config: { layout: "month_view", theme: "dark" }, calLink: "{{ C.link }}" });
  /* Kalender verschmilzt mit der dunklen Fläche: Hintergrund = Fläche, kein Rahmen, Auswahl in Cyan */
  Cal.ns["{{ C.namespace }}"]("ui", { theme: "dark", hideEventTypeDetails: false, layout: "month_view", cssVarsPerTheme: { dark: {
    "cal-brand": "#0b9fbd", "cal-brand-emphasis": "#0b9fbd", "cal-brand-text": "#ffffff",
    "cal-bg": "#1d1d1f", "cal-bg-muted": "#1d1d1f", "cal-bg-subtle": "#2c2c2e", "cal-bg-emphasis": "#2c2c2e",
    "cal-border-booker": "#1d1d1f", "cal-border": "#3a3a3c", "cal-border-subtle": "#2c2c2e", "cal-border-emphasis": "#48484a",
    "cal-text": "#d2d2d7", "cal-text-emphasis": "#ffffff", "cal-text-subtle": "#a1a1a6", "cal-text-muted": "#86868b" } } });
</script>
