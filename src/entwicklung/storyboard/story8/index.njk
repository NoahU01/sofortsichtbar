        {%- endfor %}
      </ol>
    </div>
  </section>

  <section class="s9-band" id="start">
    <div class="s7-wrap">
      <h2 class="s9-h2">{{ X.start_h2 }}</h2>
      {%- set SL = S.maas.start.liste if art == "b" else S.weg_a.start.liste %}
