{%- elif s.slug == "seitenplan" %}
{#- Seitenplan (Entwicklung): alle Seiten als Baum – je Seite Frage, Herkunft, Ziel, Stand. Ein Highlight: der Stand „neu gebaut“. Inhalte: s7.seitenplan -#}
{%- set P = S.seitenplan %}
{%- macro karte(x, klasse="") -%}
<article class="sp7-karte sp7-karte--{{ x.stand }} {{ klasse }}">
  <p class="sp7-stand">{{ P.staende[x.stand] }}</p>
  <h3>{% if x.link %}<a href="{{ x.link }}">{{ x.name }}</a>{% else %}{{ x.name }}{% endif %}</h3>
  {%- if x.zusatz %}<p class="sp7-zusatz">{{ x.zusatz }}</p>{% endif %}
  <p class="sp7-frage">„{{ x.frage }}“</p>
  <dl>
    <dt>Kommt von</dt><dd>{{ x.von }}</dd>
    {%- if x.zu %}<dt>Führt zu</dt><dd>{{ x.zu }}</dd>{% endif %}
  </dl>
  {%- if x.offen %}<p class="sp7-offen">{{ x.offen }}</p>{% endif %}
</article>
{%- endmacro -%}
<main>
  <section class="s7-band sp7">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ P.kicker }}</p>
      <h1 class="sp7-h1">{{ P.h1 }}</h1>
      <p class="s7-lead">{{ P.lead }}</p>
      <p class="sp7-legende">{% for k, v in P.staende %}<span class="sp7-stand sp7-stand--{{ k }}">{{ v }}</span>{% endfor %}</p>

      <div class="sp7-baum">
        <div class="sp7-wurzel">{{ karte(P.start) }}</div>
        <div class="sp7-ebene">
          {%- for x in P.ebene %}
          <div class="sp7-ast">
            {{ karte(x) }}
            {%- if x.unter %}
            <article class="sp7-unter"><h4><a href="{{ x.unter.link }}">{{ x.unter.name }}</a></h4><p class="sp7-frage">„{{ x.unter.frage }}“</p><p class="sp7-zusatz">{{ x.unter.hinweis }}</p></article>
            {%- endif %}
          </div>
          {%- endfor %}
        </div>
        <div class="sp7-immer">{{ karte(P.immer) }}</div>
      </div>

      <div class="sp7-neben">
        <div>
          <h2 class="sp7-h2">Entfällt</h2>
          <ul class="sp7-liste">{% for x in P.entfallen %}<li><a href="{{ x.link }}">{{ x.name }}</a><span>→ Umleitung auf {{ x.ersatz }}</span></li>{% endfor %}</ul>
        </div>
        <div>
          <h2 class="sp7-h2">Dokumente</h2>
          <ul class="sp7-liste">{% for x in P.dokumente %}<li><b>{{ x.name }}</b><span>{{ P.staende[x.stand] }} – {{ x.hinweis }}</span></li>{% endfor %}</ul>
        </div>
      </div>
    </div>
  </section>
  <section class="s7-band s7-band--flaeche">
    <div class="s7-wrap">
      <p class="s7-kicker">Vorgehen</p>
      <h2 class="s7-h2">In dieser Reihenfolge bauen wir.</h2>
      <ol class="sp7-schritte">{% for x in P.reihenfolge %}<li{% if x.erledigt %} class="sp7-schritte--erledigt"{% endif %}><span>{{ loop.index }}{% if x.erledigt %} · erledigt{% endif %}</span><h3>{{ x.titel }}</h3><p>{{ x.text }}</p></li>{% endfor %}</ol>
      <p class="sp7-fuss">{{ P.stufe2 }}</p>
    </div>
  </section>
</main>
{%- elif s.zg %}
{#- Zielgruppenseite (Vorlage für alle 20, Seitenplan): „Was bekomme ich für genau diese Zielgruppe, und warum lohnt sie sich?“
    Inhalte aus zielgruppen.json (intro, heroImage, infoItems, faq) und vertriebsstrecken.json (Name, Segment, Anlässe) – nichts doppelt.
    Style-Auswahl entfällt (nur noch Elegant). -#}
{%- set Z = null %}{% for x in zielgruppen %}{% if x.slug == s.zg %}{% set Z = x %}{% endif %}{% endfor %}
{%- set ZV = null %}{% for v in vertriebsstrecken.zielgruppen %}{% if v.href == "/zielgruppen/" + s.zg %}{% set ZV = v %}{% endif %}{% endfor %}
{%- set name = ZV.label if ZV else Z.name %}
{%- set anl = [] %}{% for a in vertriebsstrecken.anlaesse %}{% if a.href == "/zielgruppen/" + s.zg %}{% set anl = (anl.push(a.label), anl) %}{% endif %}{% endfor %}
{%- set ZT = S.zg %}
<main>
  <section class="s7-held">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ ZT.kicker }}{% if ZV %} · {{ "Privatkunden" if ZV.filter == "privat" else "Firmenkunden" }}{% endif %}</p>
      <h1 class="zg7-h1">{{ name }}.<br><span class="s7-wort">{{ ZT.h1_akzent }}</span></h1>
      <p class="s7-lead vs7-lead">{{ Z.intro | replace("<p>‍</p>", "") | striptags }}</p>
      {%- if anl.length %}<p class="zg7-anlaesse"><span>{{ ZT.anlass }}</span>{% for a in anl %}<b>{{ a }}</b>{% endfor %}</p>{% endif %}
      <div class="s7-held__knoepfe">
        <a class="s7-knopf" href="#kontakt">{{ ZT.knopf }} {{ pfeil | safe }}</a>
        <a class="s7-knopf s7-knopf--rand" href="#fragen">{{ ZT.knopf2 }}</a>
      </div>
      <figure class="vs7-held__bild"><img src="/assets/img/{{ Z.heroImage }}" alt="Vertriebsstrecke {{ name }}: Posting, Landingpage und Kundenmailing" width="1664" height="658"></figure>
    </div>
  </section>

  <section class="s7-band s7-band--akzent">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ ZT.wer_kicker }}</p>
      <h2 class="s7-h2">{{ ZT.wer_h2 }}</h2>
      <div class="zg7-wer">
        {%- for i in Z.infoItems %}
        <article class="zg7-wer__karte"><h3>{{ i.title }}</h3>{{ i.html | replace(' role="list"', '') | safe }}</article>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section class="s7-band" id="fragen">
    <div class="s7-wrap zg7-fragen">
      <div>
        <p class="s7-kicker">{{ ZT.fragen_kicker }}</p>
        <h2 class="s7-h2">{{ ZT.fragen_h2 }}</h2>
      </div>
      <div class="zg7-faq">
        {%- for f in Z.faq %}
        <details{% if loop.first %} open{% endif %}><summary>{{ f.question }}</summary><div class="zg7-faq__a">{{ f.answer | replace("<p>‍</p>", "") | replace(' role="list"', '') | safe }}</div></details>
        {%- endfor %}
      </div>
    </div>
  </section>

  {%- if ZV %}
  <section class="s7-band s7-band--flaeche zg7-weitere">
    <div class="s7-wrap">
      <div class="vs7-reihe" data-vs7-reihe>
        <div class="vs7-reihe__kopf">
          <h2 class="zg7-weitere__h2">{{ ZT.weitere }}</h2>
          <span class="vs7-reihe__pfeile"><button type="button" data-richtung="-1" aria-label="Zurück">‹</button><button type="button" data-richtung="1" aria-label="Weiter">›</button></span>
        </div>
        <ul class="vs7-scroller">
          {%- for z in vertriebsstrecken.zielgruppen %}{% if z.filter == ZV.filter and z.href != ZV.href %}
          {{ zgKarte(z) }}
          {%- endif %}{% endfor %}
        </ul>
      </div>
      <p class="zg7-alle"><a class="s7-link" href="{{ H7 }}/vertriebsstrecken/">{{ ZT.alle }} {{ pfeil | safe }}</a></p>
    </div>
  </section>
  {%- endif %}

  {{ kontaktBand() }}
</main>
<script>
document.querySelectorAll("[data-vs7-reihe]").forEach(function (r) {
  var s = r.querySelector(".vs7-scroller");
  r.querySelectorAll("[data-richtung]").forEach(function (k) {
    k.addEventListener("click", function () { var w = s.querySelector("li").offsetWidth + 16; s.scrollBy({ left: Number(k.dataset.richtung) * w * 2, behavior: "smooth" }); });
  });
});
</script>
{%- elif s.slug == "vertriebsstrecken" %}
{#- Unterseite Vertriebsstrecken (Seitenplan): „Welche Zielgruppen gibt es, und was läuft je Zielgruppe?“
