          </div>
          {%- endfor %}
        </div>
        <p class="s9-satz">{% for id in ["a", "b"] %}<span class="nur-{{ id }}">{{ Z.schalter[id][1] }} {% if id != art %}<a class="s7-link" href="{{ Z.schalter[id][2] }}">Zu {{ Z.schalter[id][0] }} ›</a>{% endif %}</span>{% endfor %}</p>
