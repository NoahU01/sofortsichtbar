---
{#- Homepage-Story 8 (Duplikat von Story 7, 16.11.2026: Startseite, Mit deinem Team und Marketing as a Service werden hier weiterentwickelt; Vertriebsstrecken, Kompass, Kontakt, Preise unverändert mitgenommen. Assets und Generatoren liegen weiter in story7) · Startseite mit der Grundstory „Die digitale Maschine vor deinem Vertrieb“ (A und B vereint)
    und die Stilproben (drei Richtungen auf denselben Bausteinen).
    Der Stil hängt ausschließlich an den Stellschrauben (:root = Arbeitslook; .s7-stil--… = eine Richtung).
    Bausteine (Einstieg, Schritte, Pakete …) als Makros – Startseite und Stilproben nutzen dieselben.
    Inhalte: story7.11tydata.json → s7 · Grafik: maschine_holen.py · Schriften: assets/fonts (OFL, selbst gehostet).
    Eigenständige Seiten (layout: false), alles in src/entwicklung/. -#}
{%- set S = s7 -%}
{%- set H7 = "/entwicklung/storyboard/story8" -%}
{#- Echte Seiten (Startseite und Unterseiten) tragen Stil, Farbschalter und Hauptmenü; Stil- und Farbproben nicht -#}
{%- set istSeite = s.slug != "stilproben" and s.slug != "farbproben" and s.slug != "seitenplan" and s.slug != "infografik" and s.slug != "mehrwerte" -%}
{%- set B6 = "/entwicklung/storyboard/story6" -%}
{%- set A7 = "/entwicklung/storyboard/story7/assets" -%}
{%- set pfeil -%}<svg class="s7-pfeil" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endset -%}

{#- ======================= Bausteine ======================= -#}
{%- macro erklaerbild(detail=false) -%}
{%- set E = S.erklaerbild -%}
{%- if detail %}
{#- Schnitt durch die Maschine: quer als Grafik, am Handy als Liste derselben Lagen (Quelle: erklaerbild.py SCHNITT) -#}
<div class="ek2 ek2--schnitt" role="img" aria-label="Schnitt durch die Maschine: {% for z in S.maas.schnitt %}{{ z.name }} ({{ z.marke }}): {{ z.text }}. {% endfor %}An der Mündung der Messpunkt Leads, danach dein Vertrieb, der daraus Kunden macht.">{{ S.ek_schnitt_quer | safe }}</div>
<div class="mx7-schnitt" aria-hidden="true">
  {%- for z in S.maas.schnitt %}
  <div class="mx7-schnitt__lage mx7-schnitt__lage--{{ loop.index }}"><p><b>{{ z.name }}</b><span>{{ z.marke }}</span></p><p>{{ z.text }}</p></div>
  {%- endfor %}
  <span class="mx7-schnitt__unten mx7-schnitt__unten--1"></span><span class="mx7-schnitt__unten mx7-schnitt__unten--2"></span><span class="mx7-schnitt__unten mx7-schnitt__unten--3"></span>
  <p class="mx7-schnitt__mess">Messpunkt: Leads</p>
  <div class="mx7-schnitt__vertrieb"><b>Dein Vertrieb</b><span>macht daraus Kunden</span></div>
</div>
{%- else %}
{#- Story 8: drei Varianten des Kopfbilds zum Vergleich (Daniel, 16.11.2026) – umschaltbar; je Stufe ausgraubar -#}
<div class="ek8" data-aus="">
  <div class="ek2 ek8-var ek8-var--kopf" role="img" aria-label="Die digitale Maschine: Marketing in zwei Stufen – Aufbauen (Zielgruppen, Kanäle, Medien) und Betreiben (posten, vernetzen, nachhalten). Am Ende der Messpunkt Leads. Vertrieb: Ansprechen, Terminieren, Beraten, dann Betreuen.">{{ S.ek_kopf | safe }}</div>
  <div class="ek2 ek8-hoch">{{ S.ek_hoch | safe }}</div>
</div>
{%- endif %}
{%- endmacro -%}

{%- macro held(mitIds=true) -%}
  <section class="s7-held">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ S.hero.kicker }}</p>
      <h1>{{ S.hero.h1 }} <span class="s7-wort">{{ S.hero.h1_akzent }}</span></h1>
      <p class="s7-lead">{{ S.hero.lead }}</p>
      <div class="s7-held__knoepfe">
        <a class="s7-knopf" href="#kontakt">{{ S.hero.knopf }} {{ pfeil | safe }}</a>
        <a class="s7-knopf s7-knopf--rand" href="#beispiel">{{ S.hero.knopf2 }}</a>
      </div>
      <figure class="s7-maschine">
        {{ erklaerbild() }}
      </figure>
    </div>
  </section>
{%- endmacro -%}

{%- macro beispiel() -%}
  {#- Story 8 (16.11.2026): der konkrete Mehrwert an einer echten Vertriebsstrecke – vom Anlass bis in den Vertrieb.
      Strategie (Kompass) und Steuerung (Dashboard) nur als Nebensatz. Inhalte: s7.beispiel -#}
  {%- set BP = S.beispiel %}
  <section class="s7-band s7-band--flaeche" id="beispiel">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ BP.kicker }}</p>
      <h2 class="s7-h2">{{ BP.h2 }}</h2>
      <p class="s7-lead bp8-lead">{{ BP.lead }}</p>
      <figure class="bp8-strecke">
        <img src="/assets/img/{{ BP.bild }}" alt="{{ BP.bild_alt }}" width="1664" height="658" loading="lazy">
        <figcaption>{% for x in BP.teile %}<span>{{ x }}</span>{% endfor %}</figcaption>
      </figure>
      <div class="bp8-fluss">
        <div class="bp8-anlass">
          <p class="bp8-anlass__kopf">{{ BP.anlass.kopf }}</p>
          <b>{{ BP.anlass.name }}</b>
          {%- for z in BP.anlass.zeilen %}<span>{{ z }}</span>{% endfor %}
        </div>
        <span class="bp8-pfeil" aria-hidden="true">{{ pfeil | safe }}</span>
        <div class="bp8-vertrieb">
          <p class="bp8-vertrieb__titel">{{ BP.vertrieb_titel }}</p>
          <ol>{% for v in BP.vertrieb %}<li><b>{{ v[0] }}</b><span>{{ v[1] }}</span></li>{% endfor %}</ol>
        </div>
      </div>
      <div class="bp8-neben">
        {%- for n in BP.neben %}
        <p><b>{{ n[0] }}</b> {{ n[1] }}{% if n[2] %} <a class="s7-link" href="{{ H7 }}/{{ n[2] }}">Kompass starten {{ pfeil | safe }}</a>{% endif %}</p>
        {%- endfor %}
        <p class="bp8-neben__link"><a class="s7-link" href="{{ H7 }}/vertriebsstrecken/">{{ BP.link }} {{ pfeil | safe }}</a></p>
      </div>
    </div>
  </section>
{%- endmacro -%}
{%- macro icon(n) -%}
<svg viewBox="0 0 24 24" aria-hidden="true">
{%- if n == "ziel" %}<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r=".8"/>
{%- elif n == "stift" %}<path d="M4 20l1-4.5L16 4.5l3.5 3.5L8.5 19z M13.5 7l3.5 3.5"/>
{%- elif n == "form" %}<rect x="3.5" y="3.5" width="8" height="8" rx="1.5"/><circle cx="16.5" cy="16.5" r="4"/>
{%- elif n == "code" %}<path d="M8.5 7l-5 5 5 5 M15.5 7l5 5-5 5"/>
{%- elif n == "handy" %}<rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 18.5h3"/>
{%- elif n == "werbung" %}<path d="M4 9.5v5h3.5l6 4v-13l-6 4z M17 9a4 4 0 0 1 0 6"/>
{%- elif n == "telefon" %}<path d="M6 3.5h3l1.8 4.5-2.3 1.5a11 11 0 0 0 6 6l1.5-2.3 4.5 1.8v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5.5a2 2 0 0 1 2-2z"/>
{%- elif n == "gespraech" %}<path d="M4 5h16v10.5H10l-6 4z M8 9.5h8 M8 12.5h5"/>
{%- elif n == "haus" %}<path d="M3.5 11L12 4l8.5 7 M6 9.5V20h12V9.5 M10 20v-5h4v5"/>
{%- endif %}</svg>
{%- endmacro -%}
{%- macro balken9(art, klein=false) -%}
  {#- Story 9: das eine Unterscheidungsmerkmal – vier Stufen, farbig = machen wir, schwarz = machst du (Daniel, 17.11.2026) -#}
  {%- set B = S.s9.balken[art] %}{% set ST = S.team8.v2.a.spalten %}
  <div class="b9{% if klein %} b9--klein{% endif %}" role="img" aria-label="{% for g in B %}{{ g[0] }}{% if not loop.last %}, {% endif %}{% endfor %}">
    <div class="b9-wer">{% for g in B %}<span class="b9-wer--{{ g[2] }}" style="grid-column: span {{ g[1] }}">{{ g[0] }}</span>{% endfor %}</div>
    <div class="b9-stufen">
      {%- set nwir = 2 if art == "b" else 1 %}
      {%- for i in range(4) %}<span class="b9-stufe{% if i < nwir %} b9-stufe--wir b9-stufe--teil{{ i }}{% if art == "a" %} b9-stufe--halb{% endif %}{% endif %}"><b>{{ ST[i][0] }}</b>{% if not klein %}<small>{{ ST[i][1] }}</small>{% endif %}</span>{% endfor %}
    </div>
    <p class="b9-legende"><i class="b9-legende--wir"></i>Machen wir <i></i>Machst du</p>
  </div>
{%- endmacro -%}
{%- macro mehrwert(MW) -%}
  {#- Was du bekommst (Daniel, 16.11.2026): positiv, aus Sicht der Agentur, darf provozieren – dunkles Band, je Punkt ein echtes Produktbild, freigestellt, ohne Kästen -#}
  <section class="s7-band s7-band--tinte mw8-band" id="mehrwert">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ MW.kicker }}</p>
      <h2 class="s7-h2">{{ MW.h2 }}<br><span class="s7-wort">{{ MW.h2_akzent }}</span></h2>
      <div class="mw8">
        {%- for x in MW.punkte %}
        <article class="mw8-punkt">
          {%- if x[2] == "freiheit" %}
          <div class="mw8-bild mw8-bild--freiheit" aria-hidden="true"><div class="mw8-stapel">
            <div class="pk8 pk8--wir pk8--teil0"><p class="pk8-label">Musst du nicht besetzen</p><p class="pk8-titel">Online-Marketing-Manager/in</p></div>
            <div class="pk8 pk8--wir pk8--teil1"><p class="pk8-label">Musst du nicht besetzen</p><p class="pk8-titel">Content- und Social-Media-Manager/in</p></div>
          </div></div>
          {%- else %}
          <div class="mw8-bild mw8-bild--{{ x[2] }}" aria-hidden="true"><img src="{{ x[3] }}" alt="" loading="lazy"></div>
          {%- endif %}
          <h3>{{ x[0] }}</h3><p>{{ x[1] }}</p>
        </article>
        {%- endfor %}
      </div>
      <p class="mw8-passt">{{ MW.passt }}</p>
    </div>
  </section>
{%- endmacro -%}
{%- macro figur(f) -%}
{#- Personen aus figuren9.py (Daniel, 16.11.2026): gezeichnet, straight, modern – Ganzkörper, Haltung und Arbeitsgerät statt Gesicht, je Person ein Farbton -#}
{{ S.team8.figuren[f] | safe }}
{%- endmacro -%}
{%- macro teamBild(art) -%}
  {#- Variante 2 (Daniel, 17.11.2026): die vier Stufen wie im Trichter, darunter je Stufe EINE Rolle als Profilkarte wie im PDF –
      Jobtitel groß, ein Satz zur Denkweise. Farbe = sofort sichtbar (Verlauf einmal durch alle Karten von uns), Schwarz = deine Agentur -#}
  {%- set T = S.team8.v2[art] %}{% set K = S.team8.karten[art] %}{% set nw = 0 %}
  <div class="tm8" role="img" aria-label="{% for sp in T.spalten %}{{ sp[0] }}: {{ K[loop.index0].titel | replace('­', '') }}. {% endfor %}">
    {%- for sp in T.spalten %}
    <div class="tm8-kopf tm8-kopf--{{ sp[2] }}"><b>{{ sp[0] }}</b><span>{{ sp[1] }}</span></div>
    {%- endfor %}
    {%- for k in K %}
    <div class="pk8 pk8--{{ k.wer }}{% if k.wer == "wir" %} pk8--teil{{ loop.index0 }}{% endif %}">
      <p class="pk8-label">{{ k.label }}</p>
      <p class="pk8-titel">{{ k.titel }}</p>
      <p class="pk8-denk">{{ k.denk }}</p>
    </div>
    {%- endfor %}
  </div>
  <p class="pk8-hinter">{{ S.team8.karten.hintergrund }}</p>
{%- endmacro -%}
{%- macro zusammenspiel(art) -%}
  {%- set T = S.team8[art] %}{% set P = S.team8.personen %}
  <section class="s7-band s7-band--flaeche" id="zusammenspiel">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ T.kicker }}</p>
      <h2 class="s7-h2">{{ T.h2 }} <span class="s7-wort">{{ T.h2_akzent }}</span></h2>
      <p class="s7-lead">{{ T.lead }}</p>
      <p class="zs8-legende"><span class="tm8-av tm8-av--wir"></span>sofort sichtbar <span class="tm8-av tm8-av--ihr"></span>Deine Agentur</p>
      <ol class="zs8">
        {%- for st in T.ablauf %}{% set p = P[st[0]] %}
        <li><span class="tm8-av tm8-av--{{ p.wer }}">{{ icon(p.icon) }}</span><h3>{{ st[1] }}</h3><p>{{ st[2] }}</p></li>
        {%- endfor %}
      </ol>
    </div>
  </section>
{%- endmacro -%}
{%- macro download(DL, ordner) -%}
  <section class="s7-band{% if ordner == "team" %} s7-band--flaeche{% endif %}" id="download">
    <div class="s7-wrap mx7-dl">
      <div class="mx7-dl__bild" aria-hidden="true">
        <img class="mx7-dl__seite mx7-dl__seite--hinten" src="{{ DL.pfad }}/{{ DL.bild2 }}" alt="" width="637" height="900">
        <img class="mx7-dl__seite mx7-dl__seite--vorn" src="{{ DL.pfad }}/{{ DL.bild1 }}" alt="" width="636" height="900">
      </div>
      <div>
        <p class="s7-kicker">{{ DL.kicker }}</p>
        <h2 class="s7-h2">{{ DL.h2 }}</h2>
        <p class="s7-lead">{{ DL.lead }}</p>
        <p class="mx7-dl__meta">{% for x in DL.meta %}{% if x %}<span>{{ x }}</span>{% endif %}{% endfor %}</p>
        <a class="s7-knopf" href="{{ DL.pfad }}/{{ DL.datei }}" target="_blank" rel="noopener">{{ DL.knopf }} <svg class="s7-pfeil" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg></a>
      </div>
    </div>
  </section>
{%- endmacro -%}
{%- macro rollen(nur="") -%}
  {#- Wer macht was (Daniel, 16.11.2026): je Stufe die Rolle in Selbst machen (a) und Machen lassen (b).
      Auf den Unterseiten nur die eigene Spalte (nur="a" | "b"). Inhalte: s7.rollen -#}
  {%- set R = S.rollen %}{% set T = R.seite[nur] if nur else R %}
  <section class="s7-band s7-band--flaeche" id="wer-macht-was">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ R.kicker }}</p>
      <h2 class="s7-h2">{{ T.h2 }}</h2>
      <p class="s7-lead">{{ T.lead }}</p>
      <div class="rl8{% if nur %} rl8--eins{% endif %}" role="table" aria-label="Wer macht was je Stufe">
        {%- if not nur %}
        <div class="rl8-kopf" role="row"><span role="columnheader"></span>{% for p in R.pakete %}<a role="columnheader" class="rl8-paket" href="{{ H7 }}/{{ p.link }}"><b>{{ p.name }}</b><span>{{ p.satz }}</span></a>{% endfor %}</div>
        {%- endif %}
        {%- for g in R.gruppen %}
        <p class="rl8-gruppe" role="row"><span role="cell">{{ g.titel }}</span></p>
        {%- for z in g.zeilen %}
        <div class="rl8-zeile" role="row">
          <div role="rowheader"><b>{{ z.stufe }}</b><span>{{ z.was }}</span></div>
          {%- for x in ([z[nur]] if nur else [z.a, z.b]) %}<div role="cell" class="rl8-zelle rl8-zelle--{{ x[0] }}"><i>{% if x[0] == "wir" %}sofort sichtbar{% elif z.stufe == "Betreiben" %}Dein Team{% else %}Deine Agentur{% endif %}</i>{% if x[1] %}<span>{{ x[1] }}</span>{% endif %}</div>{% endfor %}
        </div>
        {%- endfor %}
        {%- endfor %}
      </div>
    </div>
  </section>
{%- endmacro -%}
{%- macro schritte(mitIds=true) -%}
  {#- Ablauf statt drei Kästen: eine Linie Strategie → Maschine → Steuerung, eine Bildsprache (graue Linien, Tinte), Farbe nur im Trichter -#}
  {%- set L = S.schritte.liste %}
  <section class="s7-band s7-band--akzent"{% if mitIds %} id="maschine"{% endif %}>
    <div class="s7-wrap">
      <p class="s7-kicker">{{ S.schritte.kicker }}</p>
      <h2 class="s7-h2">{{ S.schritte.h2 }}</h2>
      <ol class="s7-ablauf">
        <li class="s7-ablauf__schritt">
          <div class="s7-ablauf__bild" aria-hidden="true"><div class="s7-mini">
            <div class="s7-mini__zeile"><span>Segment</span><div><i class="an">Privatkunden</i><i>Firmenkunden</i></div></div>
            <div class="s7-mini__zeile"><span>Sparte</span><div><i class="an">Leben</i><i>Kranken</i><i>Schaden/Unfall</i><i>Kfz</i></div></div>
            <div class="s7-mini__zeile"><span>Zielgruppe</span><div><i class="an ziel">Junge Familien</i><i class="an">Bauherren</i><i class="mehr">+ weitere</i></div></div>
          </div></div>
          <p class="s7-ablauf__nr">{{ L[0].nr }} · {{ L[0].label }}</p>
          <h3>{{ L[0].h | replace('|', '<br>') | safe }}</h3>
          <p class="s7-ablauf__t">{{ L[0].t }}</p>
          <a class="s7-link" href="{{ H7 }}/strategiekompass/">{{ L[0].link }} {{ pfeil | safe }}</a>
        </li>
        <li class="s7-ablauf__schritt">
          <div class="s7-ablauf__bild" aria-hidden="true"><div class="s7-mini">
            <p class="s7-mini__kopf">Vertriebsstrecke · Junge Familien</p>
