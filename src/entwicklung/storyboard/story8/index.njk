}

/* Story 9 · Grundstory (gs9-): Arbeitsgrundlage, ruhig gesetzt */
.gs9-wrap { max-width: 50rem; }
.gs9-h1 { margin-top: .6rem; color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: clamp(2.6rem, 5vw, 3.6rem); font-weight: 700; letter-spacing: -0.035em; }
.gs9-lead { margin-top: 1rem; color: var(--s7-text); font-size: 1.15rem; line-height: 1.55; }
.gs9-teile { display: grid; gap: 0; margin: 3rem 0 0; padding: 0; list-style: none; }
.gs9-teil { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 1rem; padding: 2rem 0; border-top: 1px solid var(--s7-linie); }
.gs9-nr { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--s7-tinte); color: #fff; font-weight: 700; }
.gs9-teil h2 { color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; }
.gs9-unter { margin-top: .2rem; color: var(--s7-grau); font-weight: 600; }
.gs9-label { margin-top: 1.1rem; color: var(--s7-tinte); font-weight: 700; }
.gs9-teil ul { display: grid; gap: .45rem; margin: .7rem 0 0; padding: 0 0 0 1.1rem; color: var(--s7-text); line-height: 1.55; }

/* Grundstory in einem Bild (px9-, 2. Fassung): jedes Element als erkennbares Objekt */
.px9-rahmen { margin-top: 1.6rem; overflow-x: auto; border-radius: 28px; background: var(--s7-flaeche); }
.gb9-rahmen { padding: 2rem 2.2rem 1.6rem; background: #fff; box-shadow: 0 0 0 1px var(--s7-linie); }
.gb9 { display: block; width: 100%; min-width: 1000px; height: auto; }
.px9 { position: relative; width: 100%; min-width: 1150px; padding: 34px 36px 30px; }
.px9-stufen, .px9-zonen, .px9-ergebnisse { display: grid; grid-template-columns: 1.55fr 1fr 1fr 1fr; gap: 28px; }
.px9-stufen span { padding-bottom: 8px; border-bottom: 2px solid #1d1d1f; color: #1d1d1f; font-weight: 700; font-size: 15px; }
.px9-zonen { margin-top: 20px; align-items: start; }
.px9-zone { display: grid; gap: 8px; align-content: start; }
.px9-ergebnisse { margin-top: 22px; padding-top: 16px; border-top: 1px solid #d2d2d7; }
.px9-ergebnisse p { color: #1d1d1f; font-family: var(--s7-schrift-titel); font-size: 18px; font-weight: 700; line-height: 1.2; letter-spacing: -0.015em; }
.px9-cap { margin-top: 6px; color: #6e6e73; font-size: 12px; font-weight: 600; }
.px9-cap:first-child { margin-top: 0; }
.px9-reihe .px9-cap { min-height: 2.7em; }
.px9-lpbild { aspect-ratio: 2; overflow: hidden; }
.px9-lpbild img { display: block; width: 112%; max-width: none; height: auto; margin: -5% 0 0 -6%; }
.px9-pfeile { position: relative; height: 40px; margin: -6px 0 2px; }
.px9-pfeile svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.px9-pfeile span { position: absolute; left: 50%; top: 14px; padding: 2px 8px; border-radius: 99px; background: var(--s7-flaeche); color: #1d1d1f; font-size: 11px; font-weight: 600; white-space: nowrap; transform: translateX(-50%); }
.px9-reihe { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 14px; }
.px9-reihe > div:first-child { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 8px; align-items: start; align-content: start; }
.px9-reihe > div:first-child .px9-cap { grid-column: 1 / -1; }
.px9-post { border-radius: 10px; background: #fff; box-shadow: 0 6px 16px rgba(0,0,0,.08); overflow: hidden; }
.px9-post__kopf { display: flex; align-items: center; gap: 5px; padding: 6px 7px; font-size: 9px; white-space: nowrap; overflow: hidden; }
.px9-post__kopf i { flex: none; display: grid; place-items: center; width: 16px; height: 16px; border-radius: 4px; color: #fff; font-size: 8.5px; font-style: normal; font-weight: 700; }
.px9-post__kopf i.in { background: #0a66c2; } .px9-post__kopf i.fb { background: #1877f2; border-radius: 50%; } .px9-post__kopf i.ig { background: linear-gradient(135deg, #f58529, #dd2a7b, #8134af); border-radius: 5px; }
.px9-post__kopf b { color: #1d1d1f; }
.px9-post__bild { display: flex; align-items: flex-end; aspect-ratio: 1.15; padding: 7px; background: linear-gradient(160deg, #0b9fbd, #3d5bd1); color: #fff; }
.px9-post__bild--q { aspect-ratio: 1; background: #1d1d1f; }
.px9-post__bild--v { background: linear-gradient(160deg, #3d5bd1, #8613a1); }
.px9-post__bild b { font-family: var(--s7-schrift-titel); font-size: 10.5px; line-height: 1.08; hyphens: auto; }
.px9-post__leiste { display: flex; align-items: center; gap: 8px; padding: 5px 7px; border-top: 1px solid #f0f0f2; color: #6e6e73; font-size: 9.5px; }
.px9-post__leiste svg, .px9-btn svg { width: 13px; height: 13px; fill: none; stroke: #6e6e73; stroke-width: 1.8; stroke-linejoin: round; }
.px9-mail2 { margin-top: 0; border-radius: 10px; background: #fff; box-shadow: 0 6px 16px rgba(0,0,0,.08); overflow: hidden; }
.px9-mail2__kopf { display: flex; gap: 6px; padding: 6px 9px; border-bottom: 1px solid #f0f0f2; color: #1d1d1f; font-size: 10.5px; font-weight: 600; }
.px9-mail2__kopf span { width: 38px; color: #8e8e93; font-weight: 500; }
.px9-mail2__text { display: grid; gap: 5px; padding: 9px; }
.px9-mail2__text i { display: block; height: 5px; border-radius: 3px; background: #e5e5ea; }
.px9-mail2__text i.kurz { width: 60%; }
.px9-mail2__text em { justify-self: start; margin-top: 4px; padding: 4px 9px; border-radius: 99px; background: #3d5bd1; color: #fff; font-size: 9.5px; font-style: normal; font-weight: 600; }
.px9-ui { display: grid; gap: 8px; padding: 11px 12px; border-radius: 14px; background: #fff; box-shadow: 0 8px 20px rgba(0,0,0,.08); }
.px9-ui__t { color: #1d1d1f; font-size: 12.5px; font-weight: 700; }
.px9-check { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 5px; color: #1d1d1f; font-size: 10.5px; }
.px9-check i + i, .px9-check i:not(:first-child) { margin-left: 4px; }
.px9-check i { width: 11px; height: 11px; border-radius: 3px; box-shadow: inset 0 0 0 1.5px #c7c7cc; }
.px9-check i.an { background: #1d1d1f; box-shadow: none; }
.px9-ui__fuss { display: flex; align-items: center; justify-content: space-between; color: #6e6e73; font-size: 11px; }
.px9-btn { position: relative; padding: 5px 11px; border-radius: 99px; background: #1d1d1f; color: #fff; font-size: 11px; font-weight: 600; }
.px9-btn--rand { margin-left: auto; background: #fff; box-shadow: inset 0 0 0 1.5px #1d1d1f; color: #1d1d1f; }
.px9-zeiger { position: absolute; right: -8px; bottom: -12px; width: 20px; height: 20px; fill: #fff; stroke: #1d1d1f; stroke-width: 1.4; stroke-linejoin: round; }
.px9-person { display: flex; align-items: center; gap: 8px; color: #1d1d1f; font-size: 11px; line-height: 1.3; }
.px9-person i { flex: none; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: #e5e5ea; color: #1d1d1f; font-size: 9.5px; font-style: normal; font-weight: 700; }
.px9-antwort { padding: 6px 10px; border-radius: 99px; box-shadow: inset 0 0 0 1px #d2d2d7; color: #8e8e93; font-size: 11px; }
.px9-gesendet { grid-template-columns: auto minmax(0, 1fr); align-items: center; }
.px9-gesendet b { display: block; color: #1d1d1f; font-size: 12.5px; } .px9-gesendet span { display: block; color: #6e6e73; font-size: 11px; }
.px9-haken { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: #34c759; }
.px9-haken svg { width: 16px; height: 16px; fill: none; stroke: #fff; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
.px9-anruf { display: grid; justify-items: center; gap: 4px; padding: 14px 12px 12px; border-radius: 18px; background: #1d1d1f; color: #fff; }
.px9-anruf__name { font-family: var(--s7-schrift-titel); font-size: 16px; font-weight: 700; }
.px9-anruf__zeit { color: #a1a1a6; font-size: 11px; }
.px9-anruf__knoepfe { display: flex; gap: 26px; margin-top: 6px; }
.px9-anruf__knoepfe i { width: 30px; height: 30px; border-radius: 50%; background: #ff3b30; }
.px9-anruf__knoepfe i.an { background: #34c759; }
.px9-kal { border-radius: 14px; background: #fff; box-shadow: 0 8px 20px rgba(0,0,0,.08); overflow: hidden; }
.px9-kal__kopf { padding: 6px 12px; background: #1d1d1f; color: #fff; font-size: 12px; font-weight: 700; }
.px9-kal__termin { margin: 10px; padding: 8px 10px; border-left: 3px solid #8613a1; border-radius: 6px; background: #f3e8f6; }
.px9-kal__termin b { display: block; color: #1d1d1f; font-size: 12.5px; } .px9-kal__termin span { display: block; color: #6e6e73; font-size: 10.5px; line-height: 1.3; }
.px9-post--breit .px9-post__bild { aspect-ratio: 1.9; }
.px9-post--breit .px9-post__bild b { font-size: 14px; }
.px9-post--breit .px9-post__leiste { font-size: 10.5px; color: #1d1d1f; }
.px9-chat { display: grid; gap: 4px; }
.px9-chat__wer { color: #6e6e73; font-size: 11px; font-weight: 600; }
.px9-chat__blase { padding: 10px 12px; border-radius: 16px 16px 16px 4px; background: #fff; box-shadow: 0 8px 20px rgba(0,0,0,.08); color: #1d1d1f; font-size: 12.5px; line-height: 1.4; }

/* Erklärvideo und Storyboard (vd9-, sb9-) */
.vd9 { display: block; width: 100%; margin-top: 1.6rem; border-radius: 22px; background: #000; box-shadow: 0 0 0 1px var(--s7-linie); }
.vd9 + .gs9-h2, .sb9 + .gs9-h2 { margin-top: 4.5rem; }
.gs9-h2--abstand { padding-top: 2rem; }
.sb9 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.6rem 1.2rem; margin: 1.6rem 0 0; padding: 0; list-style: none; }
.sb9 img { display: block; width: 100%; height: auto; border-radius: 14px; box-shadow: 0 0 0 1px var(--s7-linie); }
