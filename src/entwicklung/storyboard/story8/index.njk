<script>
/* Kopf-Varianten 1–3 (nur Entwicklung): ?kopf=2 in der Adresse merkt die Wahl */
(function () {
  var main = document.querySelector('[data-av9-kopf]'); if (!main) return;
  function zeige(v) {
    main.setAttribute('data-av9-kopf', v);
    document.querySelector('.av9-kopf1').hidden = v !== '1';
    document.querySelectorAll('.av9-kopfv').forEach(function (s) { s.hidden = s.getAttribute('data-v') !== v; });
    document.querySelectorAll('[data-av9-v]').forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-av9-v') === v ? 'true' : 'false'); });
    var u = new URL(location.href); u.searchParams.set('kopf', v); history.replaceState(null, '', u);
  }
  document.querySelectorAll('[data-av9-v]').forEach(function (b) { b.addEventListener('click', function () { zeige(b.getAttribute('data-av9-v')); }); });
  var start = new URLSearchParams(location.search).get('kopf');
  if (start === '2') zeige(start);
})();
/* Black Week 2.0: Konfigurator – die echte Landingpage live im MacBook, Farbe stufenlos über Farbton und Helligkeit.
   Die Seite wird über ihre Farbvariablen eingefärbt; Fotos bleiben unverändert. Schritt 2 zeigt dieselbe Seite. */
(function () {
  var k = document.querySelector('[data-b2-konfig]'); if (!k) return;
  var ton = k.querySelector('[data-b2-ton]'), hell = k.querySelector('[data-b2-hell]'), stil = '3';
  var LP = '/entwicklung/kampagnen/avrg/landingpage-';
  function hsl(h, s, l) { return 'hsl(' + h + ' ' + s + '% ' + Math.max(0, Math.min(100, l)) + '%)'; }
  function hex(h, s, l) { s /= 100; l /= 100; var f = function (n) { var k2 = (n + h / 30) % 12, a = s * Math.min(l, 1 - l); return l - a * Math.max(-1, Math.min(k2 - 3, 9 - k2, 1)); }; return [f(0), f(8), f(4)]; }
  function lum(rgb) { var c = rgb.map(function (v) { return v <= .03928 ? v / 12.92 : Math.pow((v + .055) / 1.055, 2.4); }); return .2126 * c[0] + .7152 * c[1] + .0722 * c[2]; }
  function vars() {
    var h = Number(ton.value), l = Number(hell.value), s = 82, hellGrund = lum(hex(h, s, l)) > .42;
    var auf = hellGrund ? '#111' : '#fff', rgb = hex(h, s, l).map(function (v) { return Math.round(v * 255); }).join(',');
    return { '--rot': hsl(h, s, l), '--rot-dunkel': hsl(h, s, l - 8), '--rot-text': hellGrund ? hsl(h, s, Math.min(l, 34)) : hsl(h, s, l),
      '--rot-hell': hsl(h, s, Math.max(l, 62)), '--rot-betont': hellGrund ? hsl(h, s, 20) : hsl(h, s, 86), '--rot-glut': 'rgba(' + rgb + ',.38)',
      '--rot-schatten': 'rgba(' + rgb + ',.45)', '--auf-rot': auf, '--auf-rot-leise': hellGrund ? 'rgba(17,17,17,.78)' : 'rgba(255,255,255,.86)',
      '--auf-rot-rand': hellGrund ? 'rgba(17,17,17,.4)' : 'rgba(255,255,255,.55)', '--auf-rot-linie': hellGrund ? 'rgba(17,17,17,.2)' : 'rgba(255,255,255,.3)', farbe: hsl(h, s, l) };
  }
  function faerben(fr) {
    try {
      var d = fr.contentDocument; if (!d || !d.documentElement) return;
      var v = vars(); Object.keys(v).forEach(function (n) { if (n.indexOf('--') === 0) d.documentElement.style.setProperty(n, v[n]); });
    } catch (e) {}
  }
  function vorbereiten(fr) {
    try {
      var d = fr.contentDocument;
      d.querySelectorAll('img[src*="logo-platzhalter"]').forEach(function (i) { i.src = '/entwicklung/kampagnen/avrg/assets/black-week/dein-logo.svg'; });
      var w = d.createTreeWalker(d.body, NodeFilter.SHOW_TEXT), n; while ((n = w.nextNode())) n.nodeValue = n.nodeValue.replace(/15(\s| )Minuten/g, '30$1Minuten');
      var st = d.createElement('style'); st.textContent = 'html,body{overflow:hidden!important}*{scroll-behavior:auto!important}'; d.head.appendChild(st);
      // kein Anschnitt des nächsten Abschnitts unten im Bildschirm (Daniel: keine halluzinierten Balken)
      var kappen = function () {
        var nr = (fr.getAttribute('src').match(/landingpage-(\d)/) || [])[1];
        if (nr !== '1') d.querySelectorAll('section').forEach(function (sec) { var t = sec.getBoundingClientRect().top; if (t > 120 && t < 900) sec.style.visibility = 'hidden'; });
        d.querySelectorAll('body *').forEach(function (el) { var r = el.getBoundingClientRect(); if (r.top > 830 && r.top < 900 && r.height > 40) el.style.visibility = 'hidden'; });
      };
      kappen(); setTimeout(kappen, 800);
    } catch (e) {}
    faerben(fr); fr.parentNode.classList.add('ist-bereit');
  }
  var rahmen = [];
  document.querySelectorAll('[data-b2-live]').forEach(function (box) {
    var fr = document.createElement('iframe');
    fr.setAttribute('title', 'Vorschau der Landingpage'); fr.setAttribute('aria-hidden', 'true'); fr.setAttribute('tabindex', '-1');
    fr.setAttribute('loading', box.getAttribute('data-b2-live') === 'haupt' ? 'eager' : 'lazy');
    fr.addEventListener('load', function () { vorbereiten(fr); });
    box.appendChild(fr); rahmen.push(fr);
    var passen = function () { fr.style.transform = 'scale(' + (box.clientWidth / 1440) + ')'; };
    if (window.ResizeObserver) new ResizeObserver(passen).observe(box); passen();
  });
  function laden() { rahmen.forEach(function (fr) { fr.parentNode.classList.remove('ist-bereit'); fr.src = LP + stil + '/?farbe=sofort&vorschau'; }); }
  function zeige() {
    var v = vars();
    k.querySelectorAll('[data-b2-stil]').forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-b2-stil') === stil ? 'true' : 'false'); });
    document.querySelectorAll('[data-b2-schritt-stil]').forEach(function (sp) { sp.classList.toggle('an', sp.getAttribute('data-b2-schritt-stil') === stil); });
    document.querySelectorAll('[data-b2-farbpunkt]').forEach(function (i) { i.style.background = v.farbe; });
    hell.style.setProperty('--ton', ton.value);
    rahmen.forEach(faerben);
  }
  k.querySelectorAll('[data-b2-stil]').forEach(function (b) { b.addEventListener('click', function () { stil = b.getAttribute('data-b2-stil'); laden(); zeige(); }); });
  ton.addEventListener('input', zeige); hell.addEventListener('input', zeige);
  laden(); zeige();
})();
/* Black-Week-Countdown bis 04.12.2026, 23:59:59 (deutsche Zeit); danach Normalpreis 89 € ohne Aktion */
(function () {
  var ende = new Date('2026-12-04T23:59:59+01:00').getTime();
  function zwei(n) { return (n < 10 ? '0' : '') + n; }
  function tick() {
    var rest = ende - Date.now();
    if (rest <= 0) {
      document.querySelectorAll('[data-av9-uhr], [data-av9-stoerer]').forEach(function (u) { u.hidden = true; });
      document.querySelectorAll('[data-av9-preis2]').forEach(function (p) { p.innerHTML = '<small>AVRG-Vertriebsstrecke</small><b>89 €</b><span>im Monat</span>'; });
      var m = document.querySelector('[data-av9-marke]'); if (m) m.textContent = 'AVRG-Vertriebsstrecke';
      var p = document.querySelector('[data-av9-preis]'); if (p) p.innerHTML = '<b>89 €</b> im Monat';
      var b = document.querySelector('[data-av9-betrag]'); if (b) b.textContent = '89 €';
      var st = document.querySelector('[data-av9-statt]'); if (st) st.textContent = 'im Monat';
      return;
    }
    var t = Math.floor(rest / 864e5), s = Math.floor(rest % 864e5 / 36e5), mi = Math.floor(rest % 36e5 / 6e4), se = Math.floor(rest % 6e4 / 1e3);
    document.querySelectorAll('[data-av9-uhr]').forEach(function (u) {
      u.querySelector('[data-t]').textContent = t; u.querySelector('[data-s]').textContent = zwei(s); u.querySelector('[data-m]').textContent = zwei(mi); u.querySelector('[data-sek]').textContent = zwei(se);
    });
    setTimeout(tick, 1000 - Date.now() % 1000);
  }
  tick();
})();
</script>
