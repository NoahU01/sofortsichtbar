      <p class="s7-kicker">{{ T.kicker }}</p>
      <h2 class="s7-h2">{{ T.h2 }}<br><span class="s7-wort">{{ T.h2_akzent }}</span></h2>
      <div class="vs7-wege">
        {%- for x in T.liste %}
        <article class="vs7-weg">
          <h3>{{ x.titel }}</h3>
          <p>{{ x.text }}</p>
          <img src="/assets/img/{{ x.bild }}" alt="" width="{{ x.b }}" height="{{ x.h }}" loading="lazy">
        </article>
        {%- endfor %}
      </div>
    </div>
  </section>

  {%- set L = V.liste %}
  <section class="s7-band" id="zielgruppen">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ L.kicker }}</p>
      <h2 class="s7-h2">{{ L.h2 }}</h2>
      <p class="s7-lead">{{ L.lead }}</p>
      {%- for g in L.gruppen %}
      <div class="vs7-reihe" data-vs7-reihe>
        <div class="vs7-reihe__kopf">
          <p class="s7-gruppe vs7-gruppe">{{ g[1] }}</p>
          <span class="vs7-reihe__pfeile"><button type="button" data-richtung="-1" aria-label="{{ L.zurueck }}">‹</button><button type="button" data-richtung="1" aria-label="{{ L.weiter }}">›</button></span>
        </div>
        <ul class="vs7-scroller">
          {%- for z in vertriebsstrecken.zielgruppen %}{% if z.filter == g[0] %}
          {{ zgKarte(z) }}
          {%- endif %}{% endfor %}
        </ul>
      </div>
      {%- endfor %}
      <p class="vs7-kompass"><span>{{ V.kompass.text }}</span><a class="s7-link" href="{{ H7 }}/strategiekompass/">{{ V.kompass.link }} {{ pfeil | safe }}</a></p>
    </div>
  </section>

  {{ kontaktBand() }}
</main>
<script>
/* Wisch-Reihen: Pfeile blättern um zwei Karten */
document.querySelectorAll("[data-vs7-reihe]").forEach(function (r) {
  var s = r.querySelector(".vs7-scroller");
  r.querySelectorAll("[data-richtung]").forEach(function (k) {
    k.addEventListener("click", function () { var w = s.querySelector("li").offsetWidth + 16; s.scrollBy({ left: Number(k.dataset.richtung) * w * 2, behavior: "smooth" }); });
  });
});
</script>
{%- elif s.v9 == "start" %}
