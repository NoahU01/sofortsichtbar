  {%- if s.v2 %}{{ zusammenspiel("b") }}{% endif %}
  {{ mehrwert(M.mehrwert) }}

  {%- set BS = M.bausteine %}{%- set K = BS.liste[0] %}
  {%- macro bfenster(b) -%}
  {%- set F = b.fenster %}
  <dialog class="mx7-d" id="mx7-{{ b.id }}" aria-labelledby="mx7-{{ b.id }}-t">
    <button type="button" class="mx7-d__zu" aria-label="Schließen">×</button>
    <p class="mx7-d__meta">{{ F.meta }}</p>
    <h3 id="mx7-{{ b.id }}-t">{{ F.titel }}</h3>
    {%- for x in F.intro %}<p>{{ x }}</p>{% endfor %}
    {%- for g in F.gruppen %}
    <p class="mx7-d__label">{{ g.label }}</p>
    {%- for l in g.leistungen %}
    <div class="mx7-d__punkt"><b>{{ l.titel }}</b>{% if l.text %}<p>{{ l.text }}</p>{% endif %}{% if l.liste %}<ul>{% for x in l.liste %}<li>{{ x }}</li>{% endfor %}</ul>{% endif %}</div>
    {%- endfor %}
    {%- endfor %}
    {%- if F.hinweis %}<p class="mx7-d__hinweis">{{ F.hinweis }}</p>{% endif %}
  </dialog>
  {%- endmacro %}
  <section class="s7-band" id="bausteine">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ BS.kicker }}</p>
      <h2 class="s7-h2">{{ BS.h2 }}<br><span class="s7-wort">{{ BS.h2_akzent }}</span></h2>
      <p class="s7-lead">{{ BS.lead }}</p>
      <div class="mx7-bs">
        <article class="mx7-basis">
          <p class="mx7-marke">{{ BS.basis }}</p>
          <h3>Kernpaket „{{ K.name }}“</h3>
          <p class="mx7-basis__preis"><b>{{ K.preis }}</b><span>{{ K.einheit }}</span></p>
          <p class="mx7-basis__kurz">{{ K.kurz }}</p>
          <div class="mx7-basis__gruppen">
            {%- for g in K.gruppen %}
            <div><p class="mx7-basis__g">{{ g.titel }}</p><ul class="mx7-haken">{% for y in g.punkte %}<li>{{ y }}</li>{% endfor %}</ul></div>
            {%- endfor %}
          </div>
          <button type="button" class="s7-knopf mx7-basis__knopf" data-mx7-auf="mx7-{{ K.id }}">Alle Leistungen {{ pfeil | safe }}</button>
          {{ bfenster(K) }}
        </article>
        <div class="mx7-dazu">
          <p class="mx7-marke">{{ BS.dazu }}</p>
          {%- for b in BS.liste %}{% if not loop.first %}
          <article class="mx7-erg">
            <div class="mx7-erg__text">
              <h3>{{ b.name }}</h3>
              <p>{{ b.kurz }}</p>
              <p class="mx7-erg__punkte">{{ b.punkte | join(" · ") }}</p>
            </div>
            <div class="mx7-erg__preis">
              <b>{{ b.preis }}</b><span>{{ b.einheit }}</span>{% if b.zusatz %}<span>{{ b.zusatz }}</span>{% endif %}
              <button type="button" class="mx7-mehr" data-mx7-auf="mx7-{{ b.id }}">Alle Leistungen {{ pfeil | safe }}</button>
            </div>
            {{ bfenster(b) }}
          </article>
          {%- endif %}{% endfor %}
        </div>
      </div>
      <p class="mx7-fuss">{{ BS.hinweis }}</p>
    </div>
  </section>

  {%- set ST = M.start %}
  <section class="s7-band s7-band--flaeche" id="start">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ ST.kicker }}</p>
      <h2 class="s7-h2">{{ ST.h2 }}</h2>
      <p class="s7-lead">{{ ST.lead }}</p>
      <ol class="mx7-zeit">
        {%- for x in ST.liste %}
        <li class="mx7-zeit__schritt{% if loop.last %} mx7-zeit__schritt--ziel{% endif %}">
          <p class="mx7-zeit__wann">{{ x.wann }}</p>
          <span class="mx7-zeit__punkt" aria-hidden="true"></span>
          <h3>{{ x.titel }}</h3>
          <p class="mx7-zeit__t">{{ x.text }}</p>
        </li>
        {%- endfor %}
      </ol>
      <div class="mx7-aufwand">
        <p class="mx7-aufwand__titel">{{ ST.aufwand_titel }}</p>
        <ul>{% for y in ST.aufwand %}<li>{{ y }}</li>{% endfor %}</ul>
      </div>
    </div>
  </section>

  {%- set DL = M.download %}
  <section class="s7-band" id="download">
    <div class="s7-wrap mx7-dl">
      <div class="mx7-dl__bild" aria-hidden="true">
        <img class="mx7-dl__seite mx7-dl__seite--hinten" src="{{ A7 }}/maas/{{ DL.bild2 }}" alt="" width="637" height="900">
        <img class="mx7-dl__seite mx7-dl__seite--vorn" src="{{ A7 }}/maas/{{ DL.bild1 }}" alt="" width="636" height="900">
      </div>
      <div>
        <p class="s7-kicker">{{ DL.kicker }}</p>
        <h2 class="s7-h2">{{ DL.h2 }}</h2>
        <p class="s7-lead">{{ DL.lead }}</p>
        <p class="mx7-dl__meta">{% for x in DL.meta %}<span>{{ x }}</span>{% endfor %}</p>
        <a class="s7-knopf" href="{{ A7 }}/maas/{{ DL.datei }}" target="_blank" rel="noopener">{{ DL.knopf }} <svg class="s7-pfeil" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg></a>
      </div>
    </div>
  </section>

  <!-- Beleg: ein ruhiger Satz vor dem Kontakt, dazu der Weg zur Startseite -->
  <section class="s7-band s7-band--flaeche mx7-beleg">
    <div class="s7-wrap">
      <blockquote><p>„{{ M.beleg.zitat }}“</p><cite>{{ M.beleg.quelle }}</cite></blockquote>
      <p class="mx7-beleg__link"><a class="s7-link" href="{{ H7 }}/#maschine">{{ M.beleg.link }} {{ pfeil | safe }}</a></p>
    </div>
  </section>

  {{ kontaktBand() }}
</main>
<script>
/* Pop-ups: Knopf öffnet, Kreuz, Escape oder Klick daneben schließt */
(function () {
  document.querySelectorAll("[data-mx7-auf]").forEach(function (k) {
    k.addEventListener("click", function () { var d = document.getElementById(k.getAttribute("data-mx7-auf")); if (d) d.showModal(); });
  });
  document.querySelectorAll(".mx7-d").forEach(function (d) {
    d.querySelector(".mx7-d__zu").addEventListener("click", function () { d.close(); });
    d.addEventListener("click", function (e) { if (e.target === d) d.close(); });
  });
})();
</script>
{%- else %}
<main>
  {{ held() }}
  {{ beispiel() }}

  <!-- Zielgruppen: ein großes Bild als Beweis, die 20 Zielgruppen als ruhige Liste mit Anlass -->
  {%- set Z = S.zielgruppen %}
  <section class="s7-band" id="zielgruppen">
    <div class="s7-wrap">
      <p class="s7-kicker">{{ Z.kicker }}</p>
      <h2 class="s7-h2">{{ Z.h2 }}</h2>
      <p class="s7-lead">{{ Z.lead }}</p>
      <figure class="s7-zg-bild"><img src="/assets/img/{{ Z.bild }}.webp" alt="{{ Z.bild_alt }}" width="868" height="446"></figure>
      <div class="s7-zg-listen">
        {%- for g in Z.gruppen %}
        <div>
          <p class="s7-zg-listen__titel">{{ g.name }}</p>
          <ul>{% for z in g.liste %}<li><a href="/zielgruppen/{{ z[2] }}"><b>{{ z[0] }}</b><span>{{ z[1] }}</span></a></li>{% endfor %}</ul>
        </div>
        {%- endfor %}
      </div>
      <p class="s7-zg__fuss"><a class="s7-link" href="{{ H7 }}/vertriebsstrecken/">{{ Z.link }} {{ pfeil | safe }}</a></p>
    </div>
  </section>

  {{ pakete() }}

  <!-- Über uns: Text und Zitat links, Gruppenbild rechts unten bündig auf der Kante -->
  <section class="s7-band" id="ueber-uns">
    <div class="s7-wrap s7-vertrauen">
      <div class="s7-vertrauen__text">
        <p class="s7-kicker">{{ S.vertrauen.kicker }}</p>
        <h2 class="s7-h2">{{ S.vertrauen.h2 }}<br><span class="s7-wort">{{ S.vertrauen.h2_akzent }}</span></h2>
        <p class="s7-lead">{{ S.vertrauen.t }}</p>
        <blockquote class="s7-zitat"><p>„{{ S.vertrauen.zitat }}“</p><cite>{{ S.vertrauen.quelle }}</cite></blockquote>
      </div>
      <figure class="s7-vertrauen__bild"><figcaption>{{ S.vertrauen.namen }}</figcaption><img src="{{ B6 }}/assets/img/{{ S.vertrauen.bild }}.webp" alt="{{ S.vertrauen.bild_alt }}" width="759" height="411"></figure>
    </div>
  </section>

  {{ kontaktBand() }}
</main>
{%- endif %}

<footer class="s7-fuss"><div class="s7-wrap"><span>© sofort sichtbar 2026</span><span><a href="/datenschutzerklarung">Datenschutz</a><a href="/impressum">Impressum</a></span></div></footer>
</div>

<script>
/* Menüfläche für schmale Bildschirme: Knopf öffnet/schließt, Escape und Wahl eines Punktes schließen */
(function () {
  var k = document.querySelector(".s7-burger"), m = document.getElementById("s7-menue"); if (!k || !m) return;
  function setze(auf) { m.hidden = !auf; k.setAttribute("aria-expanded", auf ? "true" : "false"); k.setAttribute("aria-label", auf ? "Menü schließen" : "Menü öffnen"); document.body.classList.toggle("s7-menue-offen", auf); }
  k.addEventListener("click", function () { setze(m.hidden); });
  m.addEventListener("click", function (e) { if (e.target.closest("a")) setze(false); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !m.hidden) { setze(false); k.focus(); } });
  window.addEventListener("resize", function () { if (window.innerWidth > 1279 && !m.hidden) setze(false); });
})();
</script>
<script>
(function () {
  var dd = document.querySelector("[data-s7-dd]"); if (!dd) return;
  var auf = dd.querySelector(".s7-dd__auf"), panel = dd.querySelector(".s7-dd__panel");
  function zu() { panel.hidden = true; auf.setAttribute("aria-expanded", "false"); }
  auf.addEventListener("click", function (e) { e.stopPropagation(); var offen = panel.hidden; panel.hidden = !offen; auf.setAttribute("aria-expanded", offen ? "true" : "false"); });
  document.addEventListener("click", function (e) { if (!dd.contains(e.target)) zu(); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") zu(); });
})();
</script>
</body>
</html>
