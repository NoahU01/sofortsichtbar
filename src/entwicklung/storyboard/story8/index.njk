.av9-feed { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; padding: 0 22px; height: 100%; min-height: 36rem; overflow: hidden; transform: rotate(-5deg) scale(1.16);
  -webkit-mask: linear-gradient(180deg, transparent 0, #000 12%, #000 88%, transparent 100%); mask: linear-gradient(180deg, transparent 0, #000 12%, #000 88%, transparent 100%); }
.av9-spalte { position: relative; overflow: hidden; }
