          <figcaption><span>Leeres Arbeitsblatt · DIN A3 quer</span><a class="s7-link" href="{{ OP }}maschine-detail-leer-a3-quer.pdf{{ OPV }}" target="_blank" rel="noopener">PDF</a><a class="s7-link" href="{{ OP }}maschine-detail-leer-a3-quer.png{{ OPV }}" download>PNG</a></figcaption>
