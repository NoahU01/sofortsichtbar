{# Cal.com wie in partials/cal-embed.njk, aber hell. Nur Entwicklungsumgebung,
   daher ohne Cookie-Sperre; vor einem Live-Gang die Einwilligungslogik von dort übernehmen. #}
<script>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal, ar = arguments;
      if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); }
        else { p(cal, ar); }
        return;
      }
      p(cal, ar);
    };
  })(window, "{{ kontakt.cal.origin }}/embed/embed.js", "init");
  Cal("init", "{{ kontakt.cal.namespace }}", { origin: "{{ kontakt.cal.origin }}" });
  Cal.ns["{{ kontakt.cal.namespace }}"]("inline", {
    elementOrSelector: "#cal-inline-{{ kontakt.cal.namespace }}",
    config: { layout: "month_view", useSlotsViewOnSmallScreen: "true", theme: "light" },
    calLink: "{{ kontakt.cal.link }}"
  });
  Cal.ns["{{ kontakt.cal.namespace }}"]("ui", {
    theme: "light",
    cssVarsPerTheme: { light: { "cal-brand": "#1a1817" }, dark: { "cal-brand": "#fff400" } },
    hideEventTypeDetails: false,
    layout: "month_view"
  });
</script>
