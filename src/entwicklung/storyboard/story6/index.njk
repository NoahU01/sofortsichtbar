{%- set nav = [["strategiekompass","Strategiekompass"],["zielgruppenpakete","Zielgruppenpakete"],["anwendungsfaelle","Anwendungsfälle"],["dein-style","Dein Style"],["ueber-uns","Über uns"]] -%}
<div class="s6-dev"><div class="container"><span><b>Storyboard · Homepage-Story 6</b> · Grundstil empiria-Repo · Texte sind Entwürfe, Unterseiten sind Platzhalter</span><a href="/entwicklung/storyboard/klarer-kern-hell">← Homepage-Story 5 hell</a></div></div>
<header class="site-header" id="top">
  <div class="container nav">
    <div class="s6-marke">
      <a class="brand" href="{{ B }}/" aria-label="sofort sichtbar – Startseite"><img src="{{ A }}/img/logo-dunkel.svg" alt="sofort sichtbar" width="78" height="40"></a>
      {#- Entwicklungsmenü (nur Entwicklungsumgebung – Story 6 liegt komplett unter /entwicklung/). Einträge aus site.json (devOnly). -#}
      <div class="s6-dd" data-s6-dd>
        <button type="button" class="s6-dd__auf" aria-expanded="false" aria-controls="s6-dd-panel" aria-label="Entwicklungsmenü öffnen"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4z"/></svg></button>
        <div class="s6-dd__panel" id="s6-dd-panel" hidden>
          {%- for item in site.nav %}{% if item.devOnly %}{% for c in item.children %}
          {%- if c.typ == "hinweis" %}<p class="s6-dd__hinweis">{{ c.text }}</p>
          {%- elif c.typ == "gruppe" %}<p class="s6-dd__gruppe">{{ c.label }}</p>
          {%- else %}<a href="{{ c.href }}"{% if c.href | isCurrentPath(page.url) %} aria-current="page"{% endif %}>{{ c.label }}</a>{% endif %}
          {%- endfor %}{% endif %}{% endfor %}
        </div>
      </div>
    </div>
    <nav class="nav-links" aria-label="Hauptnavigation">
      {%- for n in nav %}
      <a href="{{ B }}/{{ n[0] }}/"{% if s.slug == n[0] or (n[0] == "strategiekompass" and s.kompass) %} aria-current="page"{% endif %}>{{ n[1] }}</a>
      {%- endfor %}
    </nav>
    <a class="btn btn--dark btn--sm nav-cta" href="{{ B }}/kontakt/">Termin auswählen</a>
    <button class="nav-toggle" id="navToggle" aria-label="Menü öffnen" aria-expanded="false">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/></svg>
    </button>
  </div>
  <nav class="mobile-menu" id="mobileMenu" aria-label="Mobile Navigation">
    {%- for n in nav %}
    <a href="{{ B }}/{{ n[0] }}/">{{ n[1] }}</a>
    {%- endfor %}
    <a href="{{ B }}/kontakt/">Termin auswählen</a>
  </nav>
</header>
