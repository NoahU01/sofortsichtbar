{#- Storyboard 6: Startseite und vier Unterseiten (Dummys) im Grundstil des
    empiria-Repos (Seite „sofort sichtbar“ unter Marketing 2.0, Kopf wie
    empiria-Startseite ohne Logo-Laufband). Stylesheets, Schriften und Bilder
    1:1 aus dem empiria-Repo kopiert, liegen unter story6/assets/.
    Eigenständige Seiten (layout: false), alles in src/entwicklung/. -#}
{%- set A = "/entwicklung/storyboard/story6/assets" -%}
{%- set B = "/entwicklung/storyboard/story6" -%}
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if s.slug %}{{ s.titel }} · {% endif %}Homepage-Story 6 – Entwicklung</title>
<meta name="robots" content="noindex,nofollow">
<link rel="icon" href="/assets/img/logos/favicon.png" type="image/png">
<link rel="stylesheet" href="{{ A }}/css/styles.css">
<link rel="stylesheet" href="{{ A }}/css/e2.css">
<link rel="stylesheet" href="{{ A }}/css/e2-seiten.css">
<link rel="stylesheet" href="{{ A }}/css/e2-runde5.css">
<link rel="stylesheet" href="{{ A }}/css/schwarzgelb-ergaenzung.css">
<link rel="stylesheet" href="{{ A }}/css/sofort-sichtbar-seite.css">
<link rel="stylesheet" href="{{ A }}/css/kontakt.css">
{% if s.kompass %}<link rel="stylesheet" href="{{ A }}/kompass/kompass-g.css">{% if s.kompass != "g" %}<link rel="stylesheet" href="{{ A }}/kompass/kompass-cd.css">{% endif %}{% endif %}
<style>
/* Ergänzungen Story 6 – nur, was das Vorbild nicht mitbringt */
.s6-dev { background: #1a1817; color: #cfcac3; font-size: 12.5px; }
.s6-dev .container { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .3rem 1rem; padding-top: .45rem; padding-bottom: .45rem; }
.s6-dev b { color: #fff; font-weight: 600; }
.s6-dev a { color: #fff400; text-decoration: none; }
.s6-dev__var { justify-content: flex-start !important; gap: .4rem 1.2rem !important; border-top: 1px solid #3d3a37; }
.s6-dev__var a { color: #cfcac3; }
.s6-dev__var a[aria-current="page"] { color: #1a1817; background: #fff400; padding: 0 .5rem; border-radius: 4px; }
.site-header .brand img { height: 2.5rem; width: auto; max-width: none; } /* wie .nav__logo auf sofortsichtbar.de */
.nav-links a[aria-current="page"] { font-weight: 600; }
.e2v-held__pfeil.s6-mockup { width: min(100%, 34rem) !important; }
.e2v-held__pfeil.s6-mockup img { display: block; width: 100%; height: auto; }
/* Einstieg Strategiekompass (Startseite) */
.s6-kompass { padding: 6rem 0; background: #f6f5f2; }
.s6-kompass__raster { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
.s6-kompass h2 { font-size: clamp(2.1rem, 4.4vw, 3.4rem); max-width: 14ch; }
html body.e2 main .s6-kompass__schritte { margin: 2rem 0 0; padding: 0; list-style: none; counter-reset: k; }
.s6-kompass__schritte li { counter-increment: k; display: grid; grid-template-columns: 2.6rem minmax(0, 1fr); column-gap: 1rem; padding: 1rem 0; border-top: 1px solid #e7e4df; color: #3d3a37; font-size: .98rem; line-height: 1.5; }
.s6-kompass__schritte li::before { content: counter(k); grid-row: 1 / span 2; display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: #fff400; color: #1a1817; font: 700 1.1rem "Lora", Georgia, serif; }
.s6-kompass__schritte b { display: block; color: #1a1817; font-weight: 600; font-size: 1.05rem; }
html body.e2 main .s6-kompass__ende { margin-top: 1.2rem; color: #1a1817; font-weight: 600; }
.s6-kompass__karte { padding: clamp(1.6rem, 3vw, 2.4rem); border-radius: 22px; background: #1a1817; color: #fff; }
.s6-kompass__frage1 { color: #fff400; font-size: .8rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
html body.e2 .s6-kompass__karte h3 { margin-top: .6rem; color: #fff; font-size: clamp(1.7rem, 2.8vw, 2.2rem); }
.s6-kompass__wahl { display: grid; gap: .7rem; margin-top: 1.6rem; }
.s6-kompass__wahl a { position: relative; display: block; padding: 1.1rem 3.6rem 1.1rem 1.2rem; border-radius: 16px; background: #fff; color: #1a1817; text-decoration: none; transition: background .15s ease, transform .15s ease; }
.s6-kompass__wahl a:hover { background: #fff400; transform: translateX(4px); }
.s6-kompass__wahl b { display: block; font-weight: 600; font-size: 1.05rem; }
.s6-kompass__wahl span { display: block; margin-top: .15rem; color: #6f6a64; font-size: .9rem; }
.s6-kompass__wahl a:hover span { color: #3d3a37; }
.s6-kompass__wahl svg { position: absolute; right: 1.2rem; top: 50%; width: 1.4rem; height: 1.4rem; transform: translateY(-50%); fill: none; stroke: #1a1817; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
html body.e2 main .s6-kompass__fuss { margin-top: 1.2rem; color: #9b958e; font-size: .88rem; }
/* Termin */
.s6-termin { padding: 6rem 0; background: #fff; }
.s6-termin__raster { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; align-items: center; }
.s6-termin h2 { font-size: clamp(2.1rem, 4.4vw, 3.4rem); }
.s6-termin__text { margin-top: 1.2rem; max-width: 32rem; color: #3d3a37; font-size: 1.12rem; line-height: 1.6; }
.s6-termin__wege { display: grid; gap: .6rem; margin-top: 1.8rem; }
.s6-termin__wege a { display: inline-flex; align-items: center; gap: .7rem; color: #1a1817; font-weight: 500; text-decoration: none; }
.s6-termin__wege svg { width: 1.3rem; height: 1.3rem; flex: none; }
.s6-termin__karte { padding: 2.4rem; border-radius: 18px; background: #1a1817; color: #fff; }
.s6-termin__karte h3 { color: #fff; font-size: clamp(1.6rem, 2.6vw, 2.1rem); }
.s6-termin__karte p { margin-top: 1rem; color: #cfcac3; font-size: 1.02rem; line-height: 1.6; }
.s6-termin__karte .btn { margin-top: 1.8rem; }
/* Dummy-Unterseiten */
.s6-folgt { padding: 5rem 0 6rem; background: #fff400; }
.s6-folgt__kasten { padding: 2.4rem; border: 2px dashed #1a1817; border-radius: 18px; }
.s6-folgt h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); }
.s6-folgt p { margin-top: .8rem; max-width: 40rem; font-size: 1.05rem; line-height: 1.6; }
html body.e2 .site-header .nav-links { gap: 1.6rem; position: static; transform: none; margin-left: auto; } /* empiria zentriert absolut – bei fünf Punkten läuft das in den Knopf */
html body.e2 .site-header .nav-cta { margin-left: 2rem !important; }
html body.e2 .site-header .nav-links a { white-space: nowrap; font-size: .9rem; }
/* Fünf Menüpunkte plus Knopf: Burger-Menü schon ab 1200px statt 900px */
@media (max-width: 1200px) {
  html body.e2 .site-header .nav-links, html body.e2 .site-header .nav-cta { display: none; }
  html body.e2 .site-header .nav-toggle { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; background: none; color: var(--ink); margin-left: auto; }
  html body.e2 .site-header .nav { height: 68px; }
  html body.e2 .mobile-menu { position: fixed; inset: 68px 0 auto 0; z-index: 55; background: #fff; border-bottom: 1px solid #ededed; display: flex; flex-direction: column; padding: 12px var(--pad-x, 20px) 24px; box-shadow: 0 12px 24px rgba(0,0,0,.06); transform: translateY(-120%); transition: transform .3s ease; }
  html body.e2 .mobile-menu.open { transform: none; }
  html body.e2 .mobile-menu a { padding: 14px 0; font-size: 1.15rem; border-bottom: 1px solid #f2f2f2; color: var(--ink); text-decoration: none; }
}
.mobile-menu:not(.open) { visibility: hidden; }
@media (max-width: 960px) {
  html body.e2 .e2v-held__raster .e2v-held__pfeil.s6-mockup { position: static !important; grid-column: 1 !important; grid-row: auto !important; order: 3 !important; width: 100% !important; max-width: 26rem; margin: 2rem 0 0 !important; justify-self: start !important; }
  html body.e2 .e2v-held__text-oben h1 { padding-right: 0 !important; }
}
/* Kontakt-Abschnitt und Kontaktseite */
html body.e2 .s6-ks .kontakt-standalone-text :is(h1, h2) { font-size: clamp(3rem, 7.2vw, 6.2rem) !important; line-height: 1.22 !important; }
html body.e2 .s6-ks .kontakt-standalone-text .lead { margin-top: 1.8rem !important; }
html body.e2 .s6-ks .kontakt-standalone-side { margin-top: 6.49rem; }
.s6-ks__label { font-size: .8rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #6f6a64; }
html body.e2 main .s6-ks__themen { margin: 1rem 0 0; padding: 0; list-style: none; }
.s6-ks__themen li { display: flex; align-items: center; gap: 1rem; padding: 1rem 0; border-top: 1px solid #e7e4df; color: #1a1817; font-size: 1.05rem; font-weight: 600; line-height: 1.35; }
.s6-ks__themen li:last-child { border-bottom: 1px solid #e7e4df; }
.s6-ks__themen svg { width: 2.2rem; height: 2.2rem; flex: none; padding: .4rem; border-radius: 10px; background: #fff400; color: #1a1817; }
html body.e2 main .s6-ks__knopf { margin-top: 1.8rem; align-self: flex-start; }
.s6-ks__zeichen { width: clamp(320px, 42vw, 640px) !important; bottom: 12% !important; color: rgba(26,24,23,.08) !important; }
.s6-kalender { margin-bottom: clamp(40px, 6vw, 80px); min-height: 600px; }
html body.e2 .s6-ks--seite .kontakt-standalone-side { margin-top: 6.49rem; }
@media (max-width: 900px) {
  html body.e2 .s6-ks .kontakt-standalone-side { margin-top: 1.6rem; }
}
/* Zielgruppenpakete */
/* Die Übersicht ist der zweite Abschnitt – die empiria-Vorlage färbt ihn gelb (gewollt). */
html body .e2-alt.e2-alt.e2-alt.e2-alt.e2-alt .e2-kopf .e2-knopf.e2-knopf.e2-knopf--rand { background: transparent !important; color: #1a1817 !important; border: 2px solid #1a1817 !important; }
.zp__tabs { background: #fff !important; }
.zp__suche { background: #fff; border-color: #fff !important; }
.zp__suche:focus-within { border-color: #1a1817 !important; }
.zp__leiste { border-bottom-color: rgba(26,24,23,.15) !important; }
.zp__anlaesse li { border-top-color: rgba(26,24,23,.15) !important; }
.zp__anlaesse em { color: #3d3a37 !important; }
.zp__text small { display: none !important; }
.zp__raster.zp--gemischt .zp__text small { display: block !important; }
.zp { padding: 1rem 0 6rem; background: #fff; }
.zp__leiste { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; padding-bottom: 1.6rem; border-bottom: 1px solid #e7e4df; }
.zp__tabs { display: inline-flex; flex-wrap: wrap; gap: .4rem; padding: .3rem; border-radius: 999px; background: #f6f5f2; }
.zp__tabs button { display: inline-flex; align-items: center; gap: .5rem; padding: .65rem 1.2rem; border: 0; border-radius: 999px; background: none; color: #3d3a37; font: 600 .95rem/1 "Poppins", sans-serif; cursor: pointer; }
.zp__tabs button span { display: grid; place-items: center; min-width: 1.6rem; height: 1.6rem; padding: 0 .35rem; border-radius: 999px; background: #e7e4df; color: #1a1817; font-size: .75rem; }
.zp__tabs button[aria-selected="true"] { background: #1a1817; color: #fff; }
.zp__tabs button[aria-selected="true"] span { background: #fff400; }
.zp__suche { display: flex; align-items: center; gap: .6rem; flex: 0 1 22rem; padding: .7rem 1.1rem; border: 1.5px solid #e7e4df; border-radius: 999px; }
.zp__suche:focus-within { border-color: #1a1817; }
.zp__suche svg { width: 1.1rem; height: 1.1rem; flex: none; fill: none; stroke: #6f6a64; stroke-width: 2; stroke-linecap: round; }
.zp__suche input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font: 400 .95rem "Poppins", sans-serif; color: #1a1817; }
.zp__raster { display: grid; grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr)); gap: 1.2rem; margin-top: 2.4rem; }
.zp__raster[hidden], .zp__anlaesse[hidden], .zp__leer[hidden], .zp__karte[hidden], .zp__anlaesse li[hidden] { display: none !important; }
.zp__karte { position: relative; display: flex; flex-direction: column; overflow: hidden; border: 1px solid #e7e4df; border-radius: 18px; background: #fff; color: #1a1817; text-decoration: none; transition: border-color .15s ease, transform .15s ease; }
.zp__karte:hover { border-color: #1a1817; transform: translateY(-2px); }
.zp__bild { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #f6f5f2; border-bottom: 1px solid #e7e4df; }
.zp__bild img { width: 100%; height: 100%; object-fit: cover; object-position: left top; display: block; }
.zp__text { display: block; padding: 1.1rem 3.2rem 1.2rem 1.2rem; }
.zp__text small { display: block; color: #6f6a64; font-size: .75rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
.zp__text b { display: block; margin-top: .3rem; font-family: "Lora", Georgia, serif; font-size: 1.3rem; font-weight: 700; line-height: 1.2; letter-spacing: -.01em; }
.zp__pfeil { position: absolute; right: 1.1rem; bottom: 1.3rem; width: 1.6rem; height: 1.6rem; padding: .3rem; border-radius: 50%; background: #fff400; fill: none; stroke: #1a1817; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
html body.e2 main .zp__anlaesse { margin: 2.4rem 0 0; padding: 0; list-style: none; columns: 2; column-gap: 3rem; }
.zp__anlaesse li { break-inside: avoid; border-top: 1px solid #e7e4df; }
.zp__anlaesse a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .2rem 1rem; align-items: center; padding: 1rem 0; color: #1a1817; text-decoration: none; }
.zp__anlaesse span { font-weight: 600; line-height: 1.35; }
.zp__anlaesse em { grid-column: 1; font-style: normal; color: #6f6a64; font-size: .9rem; }
.zp__anlaesse svg { grid-column: 2; grid-row: 1 / span 2; width: 1.2rem; height: 1.2rem; fill: none; stroke: #1a1817; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.zp__anlaesse a:hover span { text-decoration: underline; text-underline-offset: 3px; }
html body.e2 main .zp__leer { margin-top: 2.4rem; color: #3d3a37; }
.zp-band { padding: 4.5rem 0; background: #fff; }
.zp-band__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem 2rem; }
.zp-band h2 { font-size: clamp(2rem, 4vw, 3rem); }
@media (max-width: 760px) { html body.e2 main .zp__anlaesse { columns: 1; } .zp__suche { flex-basis: 100%; } }
@media (max-width: 640px) {
  .zp__tabs { display: flex; flex-wrap: nowrap; overflow-x: auto; width: 100%; scrollbar-width: none; }
  .zp__tabs button { flex: none; padding: .6rem 1rem; }
  .zp__raster { grid-template-columns: minmax(0, 1fr); gap: .6rem; margin-top: 1.6rem; }
  .zp__karte { flex-direction: row; align-items: center; border-radius: 14px; }
  .zp__bild { width: 6.5rem; flex: none; border-bottom: 0; border-right: 1px solid #e7e4df; }
  .zp__text { padding: .8rem 3rem .8rem 1rem; }
  .zp__text b { font-size: 1.05rem; }
  .zp__pfeil { top: 50%; bottom: auto; transform: translateY(-50%); }
}
/* .e2 main p setzt margin:0 – Abstände daher mit höherer Spezifität */
html body.e2 main .s6-termin__text { margin-top: 1.2rem; }
html body.e2 main .s6-termin__karte p { margin-top: 1rem; }
html body.e2 main .s6-termin__karte .e2-knopf { margin-top: 1.8rem; }
html body.e2 main .s6-folgt p { margin-top: .8rem; }
@media (max-width: 960px) {
  .s6-kompass__raster, .s6-termin__raster { grid-template-columns: minmax(0, 1fr); }
  .e2v-held__pfeil.s6-mockup { width: min(100%, 26rem) !important; }
}
@media (max-width: 640px) {
  .s6-termin__karte, .s6-folgt__kasten { padding: 1.4rem; }
}
</style>
</head>
