  <!-- ===== Strategisches Marketing (hellgrau): vier Stufen als erste Ebene, die sechs Fragen (Szene 05) im Fenster als zweite Ebene ===== -->
  {%- set W = M.weg %}{%- set ST = M.stufen %}
  <section class="mx-band mx-band--hell" id="weg">
    <div class="container">
      <p class="kicker">{{ W.kicker }}</p>
      <h2 class="h-serif">{{ W.h2 }}</h2>
      <p class="mx-lead">{{ ST.lead }}</p>
      <figure class="mx-bild">
        <div class="mx-bild__rahmen">{{ M.maschine | safe }}</div>
        <figcaption class="mx-bild__fuss">
          <span class="mx-bild__wisch">Seitlich wischen</span>
          <button type="button" class="mx-bild__detail" data-maas-auf="maas-detail">Ablauf im Detail ansehen →</button>
          <a class="mx-bild__dl" href="{{ A }}/maas/maschine.png" download>Bild herunterladen (PNG)</a>
        </figcaption>
      </figure>
      <dialog class="e2-dialog maas-d maas-d--weit" id="maas-detail" aria-labelledby="maas-detail-t">
        <button type="button" class="e2-dialog__zu" aria-label="Schließen">×</button>
        <p class="maas-d__meta">Arbeitsgrundlage</p>
        <h3 id="maas-detail-t">Der Ablauf im Detail.</h3>
        <p>Mit diesem Bild klären wir im Auftakt, welche Kanäle wir nutzen, wer Interessenten qualifiziert und wie wir sie warmhalten, bis sie abschlussbereit sind.</p>
        <div class="mx-detail">{{ M.strukturbild | safe }}</div>
        <p class="maas-d__hinweis mx-detail__fuss"><span class="mx-bild__leg mx-bild__leg--wir">übernehmen wir</span><span class="mx-bild__leg">dein Vertrieb – wir docken an</span><a href="{{ A }}/maas/strukturbild.png" download>Bild (PNG)</a><a class="mx-detail__pdf" href="{{ A }}/maas/{{ M.pdf_ablauf.datei }}" target="_blank" rel="noopener">Arbeitsgrundlage als PDF</a></p>
      </dialog>
      <div class="mx-fundament">
        <div><p class="mx-fundament__label">{{ ST.fundament.label }}</p><p class="mx-fundament__text">{{ ST.fundament.text }}</p></div>
        <button type="button" class="mx-fundament__knopf" data-maas-auf="maas-weg">{{ ST.fundament.knopf }} →</button>
      </div>
      <dialog class="e2-dialog maas-d maas-d--weit" id="maas-weg" aria-labelledby="maas-weg-t">
        <button type="button" class="e2-dialog__zu" aria-label="Schließen">×</button>
        <p class="maas-d__meta">{{ W.kicker }} · {{ ST.fundament.label }}</p>
        <h3 id="maas-weg-t">{{ W.h2_fenster }}</h3>
        <p>{{ W.lead }}</p>
      <div class="mx-weg">
          <div class="mx-weg__kopf" aria-hidden="true"><span></span>{% for s in W.spalten %}<span>{{ s }}</span>{% endfor %}</div>
          {%- for ph in W.phasen %}
          {%- if loop.index == 2 %}
          <p class="mx-weg__uebergabe"><b>{{ W.uebergabe.label }}</b>{{ W.uebergabe.text }}</p>
          {%- endif %}
          <div class="mx-weg__block{% if ph.dunkel %} mx-weg__block--dunkel{% endif %}">
            <p class="mx-weg__phase"><b>{{ ph.name }}</b><span>{{ ph.hinweis }}</span></p>
            {%- for s in ph.schritte %}
            <div class="mx-weg__schritt">
              <span class="mx-weg__nr">{{ s.nr }}</span>
              <h3>{{ s.frage }}</h3>
              <p class="mx-weg__wir"><span class="mx-weg__mobil">{{ W.spalten[1] }}</span>{{ s.wir }}</p>
              <p class="mx-weg__du">{% if s.du %}<span class="mx-weg__mobil">{{ W.spalten[2] }}</span>{{ s.du }}{% endif %}</p>
            </div>
            {%- endfor %}
          </div>
          {%- endfor %}
        </div>
      </dialog>
      <p class="mx-weg__fuss"><a href="#bausteine">{{ W.fuss }} {{ pfeil | safe }}</a></p>
    </div>
  </section>

  <!-- ===== 2 · So arbeiten wir (gelb) ===== -->
  <section class="mx-band mx-band--gelb" id="ablauf">
    <div class="container">
      <p class="kicker">So arbeiten wir</p>
      <h2 class="h-serif">Jeden Monat ein Stück besser.</h2>
      <p class="mx-lead">{{ M.ablauf_lead }}</p>
      <ol class="mx-ablauf">
        {%- for a in M.ablauf %}
        <li><span class="mx-ablauf__nr">{{ loop.index }}</span>{{ ico(a.ico, "mx-ablauf__ico") }}<h3>{{ a.titel }}</h3><p>{{ a.text }}</p></li>
        {%- endfor %}
      </ol>
    </div>
  </section>

  <!-- ===== 3 · Die Bausteine (weiß) ===== -->
  <section class="mx-band" id="bausteine">
    <div class="container">
      <p class="kicker">Die Bausteine</p>
      <h2 class="h-serif">Ein Kernpaket. Drei Ergänzungen.</h2>
      <p class="mx-lead">Das Kernpaket ist die Basis der Zusammenarbeit. Die Ergänzungen buchst du dazu, wenn du sie brauchst.</p>

      <article class="mx-kern">
        <div class="mx-kern__links">
          <div class="mx-kern__kopf">{{ ico(K.ico, "mx-kern__ico") }}<span>Baustein {{ K.nr }} · {{ K.art }}</span></div>
          <h3>{{ K.name }}</h3>
          <p class="mx-preis"><b>{{ K.preis }}</b> pro Monat</p>
          <p class="mx-kern__kurz">{{ K.kurz }}</p>
          <button type="button" class="mx-mehr" data-maas-auf="maas-{{ K.id }}">Alle Leistungen →</button>
        </div>
        <div class="mx-kern__rechts">
          <p class="mx-label">Enthalten</p>
          <ul class="mx-haken">{% for x in K.punkte %}<li>{{ x }}</li>{% endfor %}</ul>
        </div>
        {{ fenster(K) }}
      </article>

      <div class="mx-erg">
        {%- for b in M.bausteine %}{% if not loop.first %}
        <article class="mx-karte">
          <div class="mx-karte__kopf">{{ ico(b.ico, "mx-karte__ico") }}<span>Baustein {{ b.nr }} · {{ b.art }}</span></div>
          <h3>{{ b.name }}</h3>
          <p class="mx-preis"><b>{{ b.preis }}</b> {% if b.einheit != "mtl." %}einmalig{% elif "Kanal" in b.abrechnung %}pro Monat und Kanal{% else %}pro Monat{% endif %}</p>
          <p class="mx-karte__zusatz">{{ b.zusatz or "" }}</p>
          <p class="mx-karte__kurz">{{ b.kurz }}</p>
          <ul class="mx-punkte">{% for x in b.punkte %}<li>{{ x }}</li>{% endfor %}</ul>
          <button type="button" class="mx-mehr" data-maas-auf="maas-{{ b.id }}">Alle Leistungen →</button>
          {{ fenster(b) }}
        </article>
        {%- endif %}{% endfor %}
      </div>
      <p class="mx-notiz">{{ M.hinweis_preise }} Paid Ads je Werbekanal, Werbebudget nicht enthalten.</p>
    </div>
  </section>

  <!-- ===== 4 · Dein Team (schwarz) ===== -->
  <section class="mx-band mx-band--schwarz" id="team">
    <div class="container">
      <p class="kicker">Dein Team</p>
      <h2 class="h-serif">Fünf Profile. Ein Team.</h2>
      <p class="mx-lead">{{ PR.lead }}</p>
      <div class="mx-team">
        <p class="mx-team__klammer mx-team__klammer--kern">Im Kernpaket</p>
        <p class="mx-team__klammer">Mit Paid Ads</p>
        {%- for x in PR.liste %}
        {%- set wo = "Im Kernpaket" if x.gruppe == "kern" else "Mit Paid Ads" %}
        <article class="mx-profil">
          {{ ico(x.ico, "mx-profil__ico") }}
          <h3>{{ x.klartext | replace("Werbekampagnen", "Werbe&shy;kampagnen") | safe }}</h3>
          <p class="mx-profil__stelle">{{ x.stelle }}</p>
          <p>{{ x.denkweise }}</p>
          <button type="button" class="mx-mehr" data-maas-auf="maas-profil-{{ x.id }}">Rollenprofil →</button>
          {{ profilfenster(x, wo) }}
        </article>
        {%- endfor %}
      </div>
      <p class="mx-notiz">{{ PR.hinweis_ergaenzungen }}</p>
      <div class="mx-immer"><span>Immer dabei</span>{% for x in M.immer %}<b>{{ x }}</b>{% endfor %}</div>
    </div>
  </section>

  <!-- ===== 5 · Download (hellgrau) ===== -->
  <section class="mx-band mx-band--hell" id="download">
    <div class="container">
      <div class="pdf-dl pdf-dl--mist" style="--dl-acc:#fff400;">
        <div class="pdf-dl-visual" aria-hidden="true">
          <img class="pdf-dl-page pdf-dl-page--back" src="{{ A }}/maas/marketing-as-a-service-2.png" alt="" loading="lazy">
          <img class="pdf-dl-page pdf-dl-page--front" src="{{ A }}/maas/marketing-as-a-service-1.png" alt="" loading="lazy">
        </div>
        <div class="pdf-dl-text">
          <p class="pdf-dl-kicker">Download</p>
          <h2 class="pdf-dl-h">Alles drin.</h2>
          <p class="pdf-dl-lead">Alle Bausteine mit Preisen, dein Team – und fünf komplette Stellenbeschreibungen mit fertigen Postings, falls du die Profile lieber selbst besetzt.</p>
          <div class="pdf-dl-meta"><span>PDF</span><span>{{ M.pdf.seiten }} Seiten</span><span>{{ M.pdf.groesse }}</span></div>
          <a class="pdf-dl-btn" href="{{ A }}/maas/{{ M.pdf.datei }}" target="_blank" rel="noopener">PDF herunterladen <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2.5v8M4.5 7.5 8 11l3.5-3.5M3 13.5h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
    </div>
  </section>
</div>
</main>
<script>
(function () {
  document.querySelectorAll("[data-maas-auf]").forEach(function (k) {
    k.addEventListener("click", function () { var d = document.getElementById(k.getAttribute("data-maas-auf")); if (d) d.showModal(); });
  });
  document.querySelectorAll(".maas-d").forEach(function (d) {
    d.querySelector(".e2-dialog__zu").addEventListener("click", function () { d.close(); });
