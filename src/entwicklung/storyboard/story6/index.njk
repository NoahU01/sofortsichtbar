<script>
(function () {
  var t = document.getElementById("navToggle"), m = document.getElementById("mobileMenu");
  if (!t || !m) return;
  t.addEventListener("click", function () {
    var auf = !m.classList.contains("open");
    m.classList.toggle("open", auf);
    t.setAttribute("aria-expanded", auf ? "true" : "false");
  });
  m.querySelectorAll("a").forEach(function (a) { a.addEventListener("click", function () { m.classList.remove("open"); t.setAttribute("aria-expanded", "false"); }); });
})();
</script>
<script>
(function () {
  var dd = document.querySelector("[data-s6-dd]"); if (!dd) return;
  var auf = dd.querySelector(".s6-dd__auf"), panel = dd.querySelector(".s6-dd__panel");
  function zu() { panel.hidden = true; auf.setAttribute("aria-expanded", "false"); }
  auf.addEventListener("click", function (e) { e.stopPropagation(); var offen = panel.hidden; panel.hidden = !offen; auf.setAttribute("aria-expanded", offen ? "true" : "false"); });
  document.addEventListener("click", function (e) { if (!dd.contains(e.target)) zu(); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape") zu(); });
})();
</script>
