{% elif s.slug == "zielgruppenpakete" %}
{#- Übersicht der Zielgruppenpakete als Verzeichnis: zwei Spalten (Privat, Firmen), nur Namen.
    Daten aus _data/zielgruppen.json und _data/vertriebsstrecken.json – neue Zielgruppen erscheinen automatisch.
    Bewusst ohne Bildschirmfotos: Vorschaubilder gehören auf die Einzelseiten (nur Style „Elegant“, -style-3). -#}
<main>
<div class="zp-seite">
  <section class="e2-kopf zp-kopf"><div class="e2-wrap">
    <h1>Zielgruppenpakete. <span class="hl">Fertig für dich.</span></h1>
    <p class="zp-kopf__lead">Jedes Paket: Landingpage, Postings und Kundenmailings – für genau eine Zielgruppe.</p>
  </div></section>

  <section class="zp">
    <div class="container zp__spalten">
      {%- for seg in [["privat","Privatkunden"],["gewerbe","Firmenkunden"]] %}
      <div class="zp__spalte">
        <h2 class="h-serif">{{ seg[1] }}</h2>
        <ul class="zp__liste">
          {%- for z in zielgruppen | sort(false, false, "name") %}
          {%- set zseg = "" %}{% for v in vertriebsstrecken.zielgruppen %}{% if v.href == "/zielgruppen/" + z.slug %}{% set zseg = v.filter %}{% endif %}{% endfor %}
          {%- if zseg == seg[0] %}
          <li><a href="/zielgruppen/{{ z.slug }}"><span>{{ z.name }}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></li>
          {%- endif %}
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </div>
  </section>

  <script>
    /* Deutsche Sortierung (Ä wie A) – Nunjucks sortiert nach Zeichencode */
    document.querySelectorAll(".zp__liste").forEach(function (ul) {
      var c = new Intl.Collator("de");
      Array.from(ul.children).sort(function (a, b) { return c.compare(a.textContent.trim(), b.textContent.trim()); }).forEach(function (li) { ul.appendChild(li); });
    });
  </script>

  <section class="zp-band">
    <div class="container zp-band__in">
      <h2 class="h-serif">Welche passen zu dir?</h2>
      <a class="zp-band__knopf" href="{{ B }}/strategiekompass/">Zum Strategiekompass<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </section>
</div>
</main>
{% elif s.slug == "anspracheanlaesse" %}
{#- Interne Seite (nur im Entwicklungsmenü): welche Anspracheanlässe zu welcher Zielgruppe gehören.
    Daten aus _data/vertriebsstrecken.json (anlaesse → href der Zielgruppenseite). -#}
<main>
<div class="zp-seite">
  <section class="e2-kopf zp-kopf"><div class="e2-wrap">
    <h1>Anspracheanlässe. <span class="hl">Wer wann zuhört.</span></h1>
    <p class="zp-kopf__lead">Welcher Anlass zu welcher Zielgruppe gehört – {{ vertriebsstrecken.anlaesse | length }} Anlässe für {{ zielgruppen | length }} Zielgruppen. Intern, nicht auf der Startseite.</p>
  </div></section>

  <section class="zp">
    <div class="container zp__spalten">
      {%- for seg in [["privat","Privatkunden"],["gewerbe","Firmenkunden"]] %}
      <div class="zp__spalte">
        <h2 class="h-serif">{{ seg[1] }}</h2>
        <ul class="zp__liste aa__liste">
          {%- for z in zielgruppen | sort(false, false, "name") %}
          {%- set zseg = "" %}{% for v in vertriebsstrecken.zielgruppen %}{% if v.href == "/zielgruppen/" + z.slug %}{% set zseg = v.filter %}{% endif %}{% endfor %}
          {%- if zseg == seg[0] %}
          <li>
            <a href="/zielgruppen/{{ z.slug }}"><span>{{ z.name }}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            {%- set anz = 0 %}
            <ul class="aa__anlaesse">
              {%- for a in vertriebsstrecken.anlaesse %}{% if a.href == "/zielgruppen/" + z.slug %}{% set anz = anz + 1 %}<li>{{ a.label }}</li>{% endif %}{% endfor %}
              {%- if anz == 0 %}<li class="aa__leer">Noch kein Anlass hinterlegt</li>{% endif %}
            </ul>
          </li>
          {%- endif %}
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </div>
    <div class="container"><p class="aa__quelle">Quelle: <code>src/_data/vertriebsstrecken.json</code>, Feld „anlaesse“. Neue Anlässe dort eintragen, die Seite aktualisiert sich selbst.</p></div>
  </section>
  <script>
    document.querySelectorAll(".zp__liste").forEach(function (ul) {
      var c = new Intl.Collator("de");
      Array.from(ul.children).sort(function (a, b) { return c.compare(a.querySelector("span").textContent.trim(), b.querySelector("span").textContent.trim()); }).forEach(function (li) { ul.appendChild(li); });
    });
  </script>
</div>
</main>
