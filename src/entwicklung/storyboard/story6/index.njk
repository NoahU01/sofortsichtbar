{% elif s.slug == "zielgruppenpakete" %}
{#- Übersicht der Zielgruppenpakete. Daten aus _data/zielgruppen.json (Name, Bild) und
    _data/vertriebsstrecken.json (Segment, Anlässe) – neue Zielgruppen erscheinen automatisch. -#}
{%- set nPrivat = 0 %}{% set nGewerbe = 0 -%}
{%- for v in vertriebsstrecken.zielgruppen %}{% if v.filter == "privat" %}{% set nPrivat = nPrivat + 1 %}{% elif v.filter == "gewerbe" %}{% set nGewerbe = nGewerbe + 1 %}{% endif %}{% endfor -%}
<main>
<div class="e2-alt e2-alt--cyan e2-seite--sofort-sichtbar">
  <section class="e2-kopf" id="intro"><div class="e2-wrap e2-kopf__raster">
  <div class="e2-kopf__text"><h1>Zielgruppenpakete. <span class="hl">Fertig für dich.</span></h1>
    <div class="e2-kopf__inhalt"><p>{{ zielgruppen | length }} Zielgruppen – {{ nPrivat }} für Privatkunden, {{ nGewerbe }} für Firmenkunden. Jede mit Landingpage, Postings und Kundenmailings. Laufend kommen neue dazu.</p></div>
    <div class="e2-knoepfe"><a class="e2-knopf" href="#uebersicht">Zur Übersicht <svg class="e2-pfeil" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a><a class="e2-knopf e2-knopf--rand" href="{{ B }}/strategiekompass/">Passende finden</a></div></div>
  <div class="e2-kopfbild e2-kopfbild--foto"><img src="{{ A }}/img/sofort-sichtbar-mockup.webp" alt="Mockup: Landingpage von sofort sichtbar" width="772" height="644"></div>
</div></section>

  <section class="zp" id="uebersicht">
    <div class="container">
      <div class="zp__leiste">
        <div class="zp__tabs" role="tablist" aria-label="Zielgruppen filtern">
          <button type="button" role="tab" data-tab="privat" aria-selected="true">Privatkunden <span>{{ nPrivat }}</span></button>
          <button type="button" role="tab" data-tab="gewerbe" aria-selected="false">Firmenkunden <span>{{ nGewerbe }}</span></button>
          <button type="button" role="tab" data-tab="anlass" aria-selected="false">Nach Anlass <span>{{ vertriebsstrecken.anlaesse | length }}</span></button>
        </div>
        <label class="zp__suche"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input type="search" placeholder="Zielgruppe oder Anlass suchen" aria-label="Zielgruppe oder Anlass suchen" data-suche></label>
      </div>

      <div class="zp__raster" data-raster>
        {%- for z in zielgruppen | sort(false, false, "name") %}
        {%- set seg = "" %}{% for v in vertriebsstrecken.zielgruppen %}{% if v.href == "/zielgruppen/" + z.slug %}{% set seg = v.filter %}{% endif %}{% endfor -%}
        {%- set such = z.name -%}
        {%- for a in vertriebsstrecken.anlaesse %}{% if a.href == "/zielgruppen/" + z.slug %}{% set such = such + " " + a.label %}{% endif %}{% endfor %}
        <a class="zp__karte" href="/zielgruppen/{{ z.slug }}" data-seg="{{ seg }}" data-such="{{ such | lower }}">
          <span class="zp__bild"><img src="/assets/img/{{ z.styles[0].image }}" alt="" loading="lazy"></span>
          <span class="zp__text"><small>{{ "Privatkunden" if seg == "privat" else "Firmenkunden" }}</small><b>{{ z.name }}</b></span>
          <svg class="zp__pfeil" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        {%- endfor %}
      </div>

      <ul class="zp__anlaesse" data-anlaesse hidden>
        {%- for a in vertriebsstrecken.anlaesse | sort(false, false, "label") %}
        {%- set zslug = a.href | replace("/zielgruppen/", "") -%}
        {%- set zname = "" %}{% for z in zielgruppen %}{% if z.slug == zslug %}{% set zname = z.name %}{% endif %}{% endfor %}
        <li data-such="{{ (a.label + " " + zname) | lower }}"><a href="{{ a.href }}"><span>{{ a.label }}</span><em>{{ zname }}</em><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></li>
        {%- endfor %}
      </ul>
      <p class="zp__leer" data-leer hidden>Keine Zielgruppe gefunden. <a href="{{ B }}/kontakt/">Frag uns – wir bauen laufend neue.</a></p>
    </div>
  </section>

  <section class="zp-band">
    <div class="container zp-band__in">
      <h2 class="h-serif">Nicht sicher, welche passen?</h2>
      <a class="e2-knopf" href="{{ B }}/strategiekompass/">Zum Strategiekompass <svg class="e2-pfeil" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </section>
</div>
</main>
<script>
(function () {
  var tabs = document.querySelectorAll("[data-tab]"), raster = document.querySelector("[data-raster]"),
      anl = document.querySelector("[data-anlaesse]"), suche = document.querySelector("[data-suche]"),
      leer = document.querySelector("[data-leer]"), tab = "privat";
  function zeigen() {
    var q = (suche.value || "").trim().toLowerCase(), n = 0;
    var aufAnlass = tab === "anlass";
    raster.hidden = aufAnlass; anl.hidden = !aufAnlass; raster.classList.toggle("zp--gemischt", !!q);
    if (aufAnlass) {
      anl.querySelectorAll("li").forEach(function (li) { var ok = !q || li.dataset.such.indexOf(q) >= 0; li.hidden = !ok; if (ok) n++; });
    } else {
      raster.querySelectorAll(".zp__karte").forEach(function (k) {
        var ok = q ? k.dataset.such.indexOf(q) >= 0 : k.dataset.seg === tab; k.hidden = !ok; if (ok) n++;
      });
    }
    leer.hidden = n > 0;
  }
  tabs.forEach(function (b) { b.addEventListener("click", function () {
    tab = b.dataset.tab; tabs.forEach(function (x) { x.setAttribute("aria-selected", x === b ? "true" : "false"); }); zeigen();
  }); });
  suche.addEventListener("input", zeigen);
  zeigen();
})();
</script>
