{% if not s.slug %}
<main>
<!-- ===== Kopf wie empiria-Startseite, ohne Logo-Laufband ===== -->
<section class="e2v-held" id="hero"><div class="e2-wrap e2v-held__raster">
  <div class="e2v-held__text-oben"><h1>Digital sichtbar.<br><span class="hl">Sofort.</span></h1>
    <div class="e2v-held__text"><p>Für Versicherungsagenturen und Maklerbüros mit Team: fertige Postings, Landingpages und Kundenmailings für 20 Zielgruppen. Ohne Briefing, in wenigen Tagen einsatzbereit.</p></div></div>
  <div class="e2v-held__pfeil s6-mockup"><img src="{{ A }}/img/sofort-sichtbar-mockup.webp" alt="Mockup: Landingpage von sofort sichtbar" width="772" height="644"></div>
  <div class="e2-knoepfe e2v-held__knoepfe"><a class="e2-knopf" href="#kompass">Zielgruppen finden <svg class="e2-pfeil" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a><a class="e2-knopf e2-knopf--rand" href="{{ B }}/kontakt/">Termin auswählen</a></div>
</div></section>

<div class="e2-alt e2-alt--cyan e2-seite--sofort-sichtbar">
  <!-- ===== Einstieg in den Strategiekompass ===== -->
  <section class="s6-kompass" id="kompass">
    <div class="container s6-kompass__raster">
      <div>
        <p class="kicker">Strategiekompass</p>
        <h2 class="h-serif">In drei Fragen zu deiner Strategie.</h2>
        <ol class="s6-kompass__schritte">
          <li><b>Wen willst du erreichen?</b>Privatkunden, Firmenkunden oder beide.</li>
          <li><b>Wo willst du wachsen?</b>Die Sparten, in denen du zulegen willst.</li>
          <li><b>Worauf legst du den Schwerpunkt?</b>Schneller Abschluss, Bestand, Kundenwert …</li>
        </ol>
        <p class="s6-kompass__ende">Am Ende stehen deine passenden Zielgruppen – und das Paket dazu.</p>
      </div>
      <div class="s6-kompass__karte">
        <p class="s6-kompass__frage1">Frage 1 von 3</p>
        <h3 class="h-serif">Wen willst du erreichen?</h3>
        <div class="s6-kompass__wahl">
          <a href="{{ B }}/strategiekompass/?seg=Privat#app"><b>Privatkunden</b><span>Familien, Berufseinsteiger, Bauherren …</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a href="{{ B }}/strategiekompass/?seg=Gewerbe#app"><b>Firmenkunden</b><span>Handwerk, Praxen, Kanzleien, Mittelstand …</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a href="{{ B }}/strategiekompass/?seg=Beides#app"><b>Beides</b><span>Privat- und Firmenkunden gleichermaßen</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
        <p class="s6-kompass__fuss">Weiter im Strategiekompass – kostenlos, ohne Anmeldung.</p>
      </div>
    </div>
  </section>

  <!-- ===== Gelber Balken: Fertig gedacht ===== -->
  <section class="produkt-grid">
    <div class="container">
      <div class="produkt-section-head reveal">
        <p class="kicker">Was sofort sichtbar mitbringt</p>
        <h2 class="h-serif">Fertig gedacht, nicht nur fertig gebaut.</h2>
        <p>Alles in einem Paket – abgestimmt auf deine Vertriebsschwerpunkte.</p>
      </div>
      <div class="produkt-grid-cards">
      <div class="produkt-glass sofort-feature-card reveal">
        <h3>Social Media Postings</h3>
        <p>Fertige Postings, die genau auf deine Zielgruppe abgestimmt sind – sofort einsetzbar, ohne eigene Content-Produktion.</p>
        <img src="{{ A }}/img/sofort-sichtbar-preview-postings.png" alt="Vorschau: fertige Social-Media-Postings von sofort sichtbar" class="sofort-feature-img" loading="lazy">
      </div>
      <div class="produkt-glass sofort-feature-card reveal">
        <h3>E-Mail-Funnel</h3>
        <p>Aktiviert deine Bestandskunden und leitet sie auf die passende, zielgruppenspezifische Landingpage weiter.</p>
        <img src="{{ A }}/img/sofort-sichtbar-preview-funnel.png" alt="Vorschau: E-Mail-Funnel von sofort sichtbar" class="sofort-feature-img" loading="lazy">
      </div>
      <div class="produkt-glass sofort-feature-card reveal">
        <h3>Passende Landingpages</h3>
        <p>Mit Download-Dokument, integrierter Podcast-Folge und optimierten Kontaktdaten – fertig für jede Zielgruppe und jeden Anlass.</p>
        <img src="{{ A }}/img/sofort-sichtbar-preview-landingpages.png" alt="Vorschau: Landingpage von sofort sichtbar" class="sofort-feature-img" loading="lazy">
      </div>
      </div>
      <div class="usp-highlight reveal">
        <div class="usp-highlight-icon"><svg><use href="#ic-check"/></svg></div>
        <div class="usp-highlight-body">
          <p class="usp-highlight-kicker">Individualisierung</p>
          <h3>Alles in deinem Corporate Design.</h3>
          <p>Logo, Bilder, Kontaktdaten und Farbwelt werden eingebunden, damit alles aussieht, als wäre es für deine Agentur gebaut.</p>
        </div>
      </div>
    </div>
  </section>
  <!-- ===== Pricing ===== -->
  <section class="produkt-grid produkt-pricing e2-posts-sek"><div class="container">
  <div class="e2-s2-split e2-faelle__kopf"><div><p class="kicker">Preise</p><h2 class="h-serif">Die passenden Pakete für deinen Vertriebsfokus.</h2></div><p class="lead">Monatlich buchbar, mit Rabatt bei jährlicher Zahlung – jede Vertriebsstrecke mit einer Mindestlaufzeit von drei Monaten.</p></div>
  <div class="e2-posts"><article class="e2-post"><div class="e2-post__kopf"><span>Eine Zielgruppe</span></div><div class="e2-post__bild"><small>1 Vertriebsstrecke</small><div class="e2-post__unten"><div><b>Fokus</b><span class="e2-post__preis">349 € <small>/Monat</small></span></div><svg class="e2-post__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /> <circle cx="12" cy="12" r="6" /> <circle cx="12" cy="12" r="2" /></svg></div></div><div class="e2-post__text"><p>Erreiche eine klar definierte Zielgruppe ganzjährig – mit fertigen Postings, Mailings und Landingpage.</p><ul><li>1 digitale Vertriebsstrecke</li><li>Individualisierungspaket</li><li>Contentplan für Social Media</li></ul><p class=e2-post__hinweis>bei jährlicher Zahlung · 435 €/Monat bei monatlicher Zahlung</p></div></article><article class="e2-post e2-post--top"><div class="e2-post__kopf"><span>Mehrere Zielgruppen</span><em>Beliebt</em></div><div class="e2-post__bild"><small>3 Vertriebsstrecken</small><div class="e2-post__unten"><div><b>Reichweite</b><span class="e2-post__preis">499 € <small>/Monat</small></span></div><svg class="e2-post__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /> <path d="M16 3.128a4 4 0 0 1 0 7.744" /> <path d="M22 21v-2a4 4 0 0 0-3-3.87" /> <circle cx="9" cy="7" r="4" /></svg></div></div><div class="e2-post__text"><p>Gewinne Kontakte aus mehreren Zielgruppen, ohne eigenen Aufwand für Content oder Kampagnen.</p><ul><li>3 digitale Vertriebsstrecken</li><li>Erweiterte Individualisierung</li><li>Performance-Reporting</li></ul><p class=e2-post__hinweis>bei jährlicher Zahlung · 625 €/Monat bei monatlicher Zahlung</p></div></article><article class="e2-post"><div class="e2-post__kopf"><span>Planbare Neukontakte</span></div><div class="e2-post__bild"><small>10 Vertriebsstrecken</small><div class="e2-post__unten"><div><b>Marktposition</b><span class="e2-post__preis">999 € <small>/Monat</small></span></div><svg class="e2-post__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 7h6v6" /> <path d="m22 7-8.5 8.5-5-5L2 17" /></svg></div></div><div class="e2-post__text"><p>Positioniere deine Berater gezielt, mach Stärken sichtbar und sorge für planbare Neukontakte.</p><ul><li>10 digitale Vertriebsstrecken</li><li>Automatisierung der Postings</li><li>Regelmäßige 1:1-Beratung</li></ul><p class=e2-post__hinweis>bei jährlicher Zahlung · 1.250 €/Monat bei monatlicher Zahlung</p></div></article></div>
</div></section>
  <!-- ===== Prozess ===== -->
  <section class="produkt-section produkt-process">
    <div class="container">
      <div class="produkt-section-head reveal">
        <p class="kicker">Ablauf</p>
        <h2 class="h-serif">Monate werden zu Tagen.</h2>
        <p>Mit sofort sichtbar bist du online, bevor eine klassische Agentur die Auftragsklärung abgeschlossen hat.</p>
      </div>
      <div class="vergleich-bild reveal">
        <div class="vergleich-row">
          <div class="vergleich-label">Klassische<br>Agentur</div>
          <div class="vergleich-timeline">
            <span class="vergleich-pill">Auftragsklärung</span>
            <span class="vergleich-pill">Konzeption</span>
            <span class="vergleich-pill">Umsetzung</span>
            <span class="vergleich-pill">Optimierung</span>
            <span class="vergleich-rocket"><svg width="28" height="28"><use href="#ic-rocket"/></svg></span>
          </div>
        </div>
        <div class="vergleich-row">
          <div class="vergleich-label vergleich-label--brand"><img src="{{ A }}/img/sofort-sichtbar-logo-stacked-gelb.svg" alt="sofort sichtbar" class="vergleich-label-logo"></div>
          <div class="vergleich-timeline vergleich-timeline--outline">
            <span class="vergleich-pill">Auftragsklärung</span>
            <span class="vergleich-rocket"><svg width="28" height="28"><use href="#ic-rocket"/></svg></span>
            <span class="vergleich-bonus"><svg width="20" height="20"><use href="#ic-clock"/></svg>Mehr Zeit für Kundengespräche</span>
          </div>
        </div>
      </div>
      <div class="produkt-process-list">
        <div class="produkt-process-step reveal">
          <span class="step-num">01</span>
          <h3>Auftragsklärung</h3>
          <p>Wir klären kurz deinen Vertriebsfokus – ohne die wochenlange Konzeptphase einer klassischen Agentur.</p>
        </div>
        <div class="produkt-process-step reveal">
          <span class="step-num">02</span>
          <h3>Zielgruppen auswählen</h3>
          <p>Du wählst aus den vorbereiteten Profilen die aus, die zu deinen Kundinnen und Kunden passen.</p>
        </div>
        <div class="produkt-process-step reveal">
          <span class="step-num">03</span>
          <h3>Stil & Auftritt festlegen</h3>
          <p>Du wählst deinen Stil und bringst dein Design ein – Logo, Bilder, Kontaktdaten, Farbwelt.</p>
        </div>
