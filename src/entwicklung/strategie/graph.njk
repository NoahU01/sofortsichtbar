---
title: "Graph – Strategie"
description: "Konzept Graph – der Abhängigkeitsbaum aller Schritte."
permalink: /entwicklung/strategie/graph/index.html
konzept: "graph"
---
{%- set g = strategieGraph -%}

<div class="gr">

  <div class="gr__kopf">
    <h1>Was hängt woran?</h1>
    <p class="gr__lies">
      Jeder Pfeil heißt <strong>„muss vorher fertig sein"</strong>. Links steht, was zuerst dran ist.
      Grün umrandet heißt: nichts blockiert es mehr — das kann heute jemand anfangen.
    </p>
  </div>

  <div class="gr__leiste">
    <div class="gr__legende">
      <span class="gr__leg gr__leg--fertig">erledigt</span>
      <span class="gr__leg gr__leg--machbar">jetzt machbar</span>
      <span class="gr__leg gr__leg--wartet">wartet noch</span>
      <span class="gr__leg gr__leg--linie">Abhängigkeit</span>
      <span class="gr__leg gr__leg--quer">über Strangrenze</span>
    </div>
    <div class="gr__schalter">
      <button class="gr__knopf" type="button" data-kritisch>Längsten Weg zeigen</button>
      <button class="gr__knopf" type="button" data-graph-reset hidden>Zurücksetzen</button>
    </div>
  </div>

  <div class="gr__scroll">
    <div class="gr__flaeche" style="width: {{ g.graph.breite }}px; height: {{ g.graph.hoehe }}px">

      {% for sp in g.graph.spalten %}
        <div class="gr__spalte" style="left: {{ sp.x }}px; width: {{ sp.breite }}px">Ebene {{ sp.nr }}</div>
      {% endfor %}

      {% for spur in g.graph.spuren %}
        <div class="gr__spur" style="top: {{ spur.y }}px; height: {{ spur.hoehe }}px; --f: {{ spur.farbe }}"></div>
        <div class="gr__spur-name" style="top: {{ spur.y }}px; --f: {{ spur.farbe }}">{{ spur.label }}</div>
      {% endfor %}

      <svg class="gr__kanten" width="{{ g.graph.breite }}" height="{{ g.graph.hoehe }}" aria-hidden="true">
        <defs>
          <marker id="pfeil" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 8 4 L 0 8 z" fill="#6a6276" />
          </marker>
          <marker id="pfeil-hell" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 8 4 L 0 8 z" fill="#c9a6ff" />
          </marker>
        </defs>
        {% for k in g.graph.kanten %}
          <path class="gr__kante{% if k.quer %} is-quer{% endif %}{% if k.kritisch %} is-kritisch{% endif %}"
                data-von="{{ k.von }}" data-nach="{{ k.nach }}" d="{{ k.pfad }}"
                marker-end="url(#pfeil)" />
        {% endfor %}
      </svg>

      {% for s in g.schritte %}
        <button class="gr__knoten gr__knoten--{{ s.status }}{% if s.machbar %} is-machbar{% endif %}{% if s.kritisch %} is-kritisch{% endif %}"
                type="button"
                data-knoten="{{ s.id }}"
                data-schritt="{{ s.id }}"
                data-braucht="{{ s.braucht | join(" ") }}"
                data-nachfolger="{{ s.nachfolger | join(" ") }}"
                style="left: {{ s.gx }}px; top: {{ s.gy }}px; width: {{ g.graph.knotenBreite }}px; height: {{ g.graph.knotenHoehe }}px; --f: {{ s.farbe }}">
          <span class="gr__kopfzeile">
            <i class="gr__punkt"></i>
            <em>{{ s.strangKurz }}</em>
            {% if s.status == "erreicht" %}<b class="gr__haken">fertig</b>{% endif %}
            {% if s.machbar %}<b class="gr__jetzt">jetzt</b>{% endif %}
          </span>
          <span class="gr__knoten-titel">{{ s.titel }}</span>
        </button>
      {% endfor %}

    </div>
  </div>

  <p class="gr__fuss">
    {{ g.anzahl }} Schritte · {{ g.graph.kanten.length }} Abhängigkeiten, davon {{ g.graph.querAnzahl }}
    über Strangrenzen. Der längste Weg bis zum Ziel führt über {{ g.kritischerPfad.length }} Schritte —
    er bestimmt, wie lange das Ganze mindestens dauert.
  </p>
</div>
