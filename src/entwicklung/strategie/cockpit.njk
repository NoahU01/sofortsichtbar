---
title: "Cockpit – Strategie"
description: "Konzept Cockpit – machbar, blockiert, erledigt."
permalink: /entwicklung/strategie/cockpit/index.html
konzept: "cockpit"
---
{%- set g = strategieGraph -%}

<div class="co">

  <header class="co__kopf">
    <div class="co__ziel">
      <span>Zielbild</span>
      <p>{{ g.zielbild.kurz }}</p>
    </div>
    <div class="co__stand">
      {% for s in g.straenge %}
        <div class="co__strang" style="--f: {{ s.farbe }}">
          <span class="co__strang-name">{{ s.label }}</span>
          <span class="co__strang-zahl">{{ s.fortschritt }}%</span>
          <span class="co__strang-balken"><i style="width: {{ s.fortschritt }}%"></i></span>
        </div>
      {% endfor %}
    </div>
  </header>

  <div class="co__filter" role="group" aria-label="Nach Strang filtern">
    <button class="co__chip is-aktiv" type="button" data-filter="alle">Alle</button>
    {% for s in g.straenge %}
      <button class="co__chip" type="button" data-filter="{{ s.id }}" style="--f: {{ s.farbe }}">{{ s.label }}</button>
    {% endfor %}
    <span class="co__stufe-hinweis">Ergebnisstufe {{ g.aktuellerMeilenstein.nr }} · {{ g.aktuellerMeilenstein.titel }}</span>
  </div>

  <div class="co__spalten">

    <section class="co__spalte co__spalte--jetzt">
      <h2>Jetzt machbar <span>{{ g.machbar.length }}</span></h2>
      <div class="co__liste">
        {% for s in g.machbar %}
          <button class="co__karte" type="button" data-schritt="{{ s.id }}" data-strang="{{ s.strang }}" style="--f: {{ s.farbe }}">
            <span class="co__karte-kopf">{{ s.strangKurz }}<i>Stufe {{ s.meilensteinNr }} · {{ s.aufwand }}</i></span>
            <span class="co__karte-titel">{{ s.titel }}</span>
            <span class="co__karte-ziel">{{ s.ergebnis }}</span>
            {% if s.nachfolgerListe.length %}
              <span class="co__karte-frei">schaltet {{ s.nachfolgerListe.length }} Schritt{% if s.nachfolgerListe.length > 1 %}e{% endif %} frei</span>
            {% endif %}
          </button>
        {% endfor %}
      </div>
    </section>

    <section class="co__spalte co__spalte--blockiert">
      <h2>Blockiert <span>{{ g.blockiert.length }}</span></h2>
      <div class="co__liste">
        {% for s in g.blockiert %}
          <button class="co__karte co__karte--matt" type="button" data-schritt="{{ s.id }}" data-strang="{{ s.strang }}" style="--f: {{ s.farbe }}">
            <span class="co__karte-kopf">{{ s.strangKurz }}<i>Stufe {{ s.meilensteinNr }} · {{ s.aufwand }}</i></span>
            <span class="co__karte-titel">{{ s.titel }}</span>
            <span class="co__karte-warte">
              wartet auf
              {% for b in s.blockiertListe %}<em style="--f: {{ b.farbe }}">{{ b.titel }}</em>{% if not loop.last %}, {% endif %}{% endfor %}
            </span>
          </button>
        {% endfor %}
      </div>
    </section>

    <section class="co__spalte co__spalte--fertig">
      <h2>Erledigt <span>{{ g.erledigt.length }}</span></h2>
      <div class="co__liste">
        {% for s in g.erledigt %}
          <button class="co__karte co__karte--fertig" type="button" data-schritt="{{ s.id }}" data-strang="{{ s.strang }}" style="--f: {{ s.farbe }}">
            <span class="co__karte-kopf">{{ s.strangKurz }}<i>Stufe {{ s.meilensteinNr }}</i></span>
            <span class="co__karte-titel">{{ s.titel }}</span>
          </button>
        {% endfor %}
        {% if not g.erledigt.length %}<p class="co__leer">Noch nichts.</p>{% endif %}
      </div>
    </section>

  </div>
</div>
