---
title: "Fokus – Strategie"
description: "Konzept Fokus – radikal reduziert auf den aktuellen Meilenstein."
permalink: /entwicklung/strategie/fokus/index.html
konzept: "fokus"
---
{%- set g = strategieGraph -%}

<div class="fo">
  {% for m in g.meilensteine %}
    <section class="fo__stufe" data-stufe="{{ m.id }}" {% if m.id != g.aktuellerMeilenstein.id %}hidden{% endif %}>

      <p class="fo__wo">Ergebnisstufe {{ m.nr }} von {{ g.meilensteine.length }}</p>
      <h1 class="fo__titel">{{ m.titel }}</h1>
      <p class="fo__satz">{{ m.ergebnis }}</p>

      <div class="fo__balken" role="img" aria-label="{{ m.fortschritt }} Prozent erledigt">
        <span style="width: {{ m.fortschritt }}%"></span>
      </div>

      {%- set machbar = [] -%}
      {%- set rest = [] -%}
      {%- for s in m.schritte -%}
        {%- if s.machbar -%}{%- set machbar = (machbar.push(s), machbar) -%}
        {%- elif s.status != "erreicht" -%}{%- set rest = (rest.push(s), rest) -%}{%- endif -%}
      {%- endfor -%}

      {% if machbar.length %}
        <h2 class="fo__label">Jetzt dran</h2>
        <div class="fo__jetzt">
          {% for s in machbar %}
            <button class="fo__karte" type="button" data-schritt="{{ s.id }}" style="--f: {{ s.farbe }}">
              <span class="fo__karte-strang">{{ s.strangLabel }}</span>
              <span class="fo__karte-titel">{{ s.titel }}</span>
              <span class="fo__karte-ziel">{{ s.ergebnis }}</span>
            </button>
          {% endfor %}
        </div>
      {% else %}
        <h2 class="fo__label">Jetzt dran</h2>
        <p class="fo__leer">Nichts frei – diese Stufe wartet vollständig auf die Stufe davor.</p>
      {% endif %}

      {% if rest.length %}
        <details class="fo__spaeter">
          <summary>{{ rest.length }} weitere Schritte in dieser Stufe</summary>
          <ul>
            {% for s in rest %}
              <li>
                <button type="button" data-schritt="{{ s.id }}" style="--f: {{ s.farbe }}">
                  <span>{{ s.titel }}</span>
                  <em>wartet auf {{ s.blockiertListe[0].titel }}{% if s.blockiertListe.length > 1 %} +{{ s.blockiertListe.length - 1 }}{% endif %}</em>
                </button>
              </li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}

      {% if m.erreicht %}
        <p class="fo__fertig">Diese Stufe steht.</p>
      {% endif %}

    </section>
  {% endfor %}

  <nav class="fo__schiene" aria-label="Ergebnisstufen">
    {% for m in g.meilensteine %}
      <button class="fo__punkt{% if m.id == g.aktuellerMeilenstein.id %} is-aktiv{% endif %}"
              type="button" data-stufe-zu="{{ m.id }}">
        <span class="fo__punkt-nr">{{ m.nr }}</span>
        <span class="fo__punkt-titel">{{ m.titel }}</span>
        <span class="fo__punkt-balken"><i style="width: {{ m.fortschritt }}%"></i></span>
      </button>
    {% endfor %}
  </nav>
</div>
