{# Terminbuchung über Cal.com.

   Der Embed lädt ein Drittanbieter-Script und setzt Cookies von cal.eu.
   Er wird deshalb erst nach der Einwilligung ausgeführt: Das Script trägt
   type="text/plain" und data-cookieconsent – Cookiebot startet es, sobald
   die Kategorie freigegeben ist. Kategorie steht in site.json unter
   tracking.calConsentCategory.

   Cookiebots automatische Blockade greift hier nicht von allein, weil der
   Embed Inline-JavaScript ist und cal.eu nicht in der Erkennungsliste steht.
   Deshalb die ausdrückliche Auszeichnung. #}

{# Ohne Cookie-Banner (Vorschau, lokal) gibt es niemanden, der das Script
   freigeben könnte – dort lädt der Kalender direkt, damit er prüfbar ist. #}
{% set cat = site.tracking.calConsentCategory %}
{% set gated = env.isProduction %}
<div class="cal-embed">
  <div id="cal-inline-{{ kontakt.cal.namespace }}" style="width:100%;height:100%;overflow:scroll"></div>

  {% if gated %}
  <div class="cal-notice" data-cal-notice hidden>
    <h3 class="text-white heading-h4">Terminkalender ist ausgeblendet</h3>
    <p class="text-secondary">
      Für die Terminbuchung binden wir Cal.com ein. Der Dienst setzt eigene Cookies,
      deshalb zeigen wir ihn erst nach deiner Zustimmung.
    </p>
    <button class="btn btn--primary" type="button" data-cal-consent>Cookies zulassen und Kalender laden</button>
    <p class="text-small text-grey">
      Lieber ohne? Schreib uns an <a class="cal-notice__link" href="mailto:{{ site.email }}">{{ site.email }}</a>
      oder ruf an: <a class="cal-notice__link" href="tel:{{ site.phoneHref }}">{{ site.phone }}</a>.
    </p>
  </div>
  {% endif %}
</div>

<script{% if gated %} type="text/plain" data-cookieconsent="{{ cat }}"{% endif %}>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal, ar = arguments;
      if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); }
        else { p(cal, ar); }
        return;
      }
      p(cal, ar);
    };
  })(window, "{{ kontakt.cal.origin }}/embed/embed.js", "init");

  Cal("init", "{{ kontakt.cal.namespace }}", { origin: "{{ kontakt.cal.origin }}" });

  Cal.ns["{{ kontakt.cal.namespace }}"]("inline", {
    elementOrSelector: "#cal-inline-{{ kontakt.cal.namespace }}",
    config: { layout: "month_view", useSlotsViewOnSmallScreen: "true", theme: "dark" },
    calLink: "{{ kontakt.cal.link }}"
  });

  Cal.ns["{{ kontakt.cal.namespace }}"]("ui", {
    theme: "dark",
    cssVarsPerTheme: { light: { "cal-brand": "#292929" }, dark: { "cal-brand": "{{ kontakt.cal.brand }}" } },
    hideEventTypeDetails: false,
    layout: "month_view"
  });
</script>

{% if gated %}
<script data-cookieconsent="ignore">
  // Blendet den Hinweis ein, solange die Einwilligung fehlt, und wieder aus,
  // sobald sie da ist. Ohne JavaScript bleibt der Hinweis verborgen und der
  // Kalender leer – dann greifen die Kontaktwege im Hinweistext daneben.
  (function () {
    var kategorie = "{{ cat }}";
    var hinweis = document.querySelector("[data-cal-notice]");
    var knopf = document.querySelector("[data-cal-consent]");
    if (!hinweis) return;

    function erlaubt() {
      var c = window.Cookiebot && window.Cookiebot.consent;
      return !!(c && c[kategorie]);
    }
    function pruefen() { hinweis.hidden = erlaubt(); }

    hinweis.hidden = false;
    pruefen();

    ["CookiebotOnLoad", "CookiebotOnAccept", "CookiebotOnDecline"].forEach(function (e) {
      window.addEventListener(e, pruefen);
    });

    if (knopf) {
      knopf.addEventListener("click", function () {
        if (window.Cookiebot) window.Cookiebot.renew();
      });
    }
  })();
</script>
{% endif %}
