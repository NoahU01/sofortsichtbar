{# ==================================================================
   Consent und Tracking – Reihenfolge ist hier entscheidend:

   1. Consent Mode v2 mit Standard "abgelehnt"
   2. Cookiebot (setzt den Zustand nach der Auswahl auf "granted")
   3. Google Tag Manager

   Läuft GTM vor Schritt 1, feuern Tags ohne gültigen Consent-Zustand.
   Genau das passiert, wenn man Cookiebot über GTM nachlädt – im alten
   Webflow-Auftritt war das so.

   Die eigenen Snippets tragen data-cookieconsent="ignore", damit
   Cookiebots automatische Blockade sie nicht selbst blockiert.
   ================================================================== #}

<script data-cookieconsent="ignore">
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }

  // Vor jeder Auswahl gilt: nichts erlaubt außer dem technisch Nötigen.
  gtag("consent", "default", {
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    analytics_storage: "denied",
    functionality_storage: "denied",
    personalization_storage: "denied",
    security_storage: "granted",
    wait_for_update: 500
  });

  // Ohne Marketing-Consent keine Nutzerkennungen an Google, dafür
  // Weitergabe der Klick-ID über die URL statt über Cookies.
  gtag("set", "ads_data_redaction", true);
  gtag("set", "url_passthrough", true);
</script>

<script id="Cookiebot"
        src="https://consent.cookiebot.com/uc.js"
        data-cbid="{{ site.tracking.cookiebotId }}"
        data-blockingmode="auto"
        type="text/javascript"></script>

<script data-cookieconsent="ignore">
  // Übersetzt die vier Cookiebot-Kategorien in die sieben Consent-Mode-Signale.
  // Ist "Google Consent Mode" im Cookiebot-Dashboard aktiv, macht Cookiebot das
  // selbst – dann greift die Prüfung unten und es wird nichts doppelt gesendet.
  // Ist es dort abgeschaltet, springt diese Brücke ein.
  (function () {
    function schonGesendet(next) {
      var dl = window.dataLayer || [];
      for (var i = dl.length - 1; i >= 0; i--) {
        var e = dl[i];
        if (e && e[0] === "consent" && e[1] === "update") {
          var prev = e[2] || {};
          return Object.keys(next).every(function (k) { return prev[k] === next[k]; });
        }
      }
      return false;
    }

    function update() {
      var c = (window.Cookiebot && window.Cookiebot.consent) || {};
      var next = {
        ad_storage: c.marketing ? "granted" : "denied",
        ad_user_data: c.marketing ? "granted" : "denied",
        ad_personalization: c.marketing ? "granted" : "denied",
        analytics_storage: c.statistics ? "granted" : "denied",
        functionality_storage: c.preferences ? "granted" : "denied",
        personalization_storage: c.preferences ? "granted" : "denied",
        security_storage: "granted"
      };
      if (!schonGesendet(next)) gtag("consent", "update", next);
    }

    window.addEventListener("CookiebotOnAccept", update);
    window.addEventListener("CookiebotOnDecline", update);

    // Wiederkehrende Besucher: die Entscheidung steht schon beim Laden.
    window.addEventListener("CookiebotOnLoad", function () {
      if (window.Cookiebot && window.Cookiebot.hasResponse) update();
    });
  })();
</script>

{# Google Analytics 4 – erst nach Consent-Default und Cookiebot.

   data-cookieconsent="ignore" ist hier richtig: Das Tag soll laden dürfen,
   die Steuerung übernimmt Consent Mode. Ohne Einwilligung setzt es keine
   Cookies, sondern sendet höchstens cookielose Signale. Würde man das Script
   stattdessen blockieren, käme Consent Mode gar nicht zum Zug.

   ID in src/_data/site.json unter tracking.ga4Id. #}
{% if site.tracking.ga4Id %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.tracking.ga4Id }}"
        data-cookieconsent="ignore"></script>
<script data-cookieconsent="ignore">
  // dataLayer und gtag stammen aus dem Consent-Block oben und werden bewusst
  // nicht neu angelegt – sonst wäre der gesetzte Standard wieder weg.
  gtag("js", new Date());
  gtag("config", "{{ site.tracking.ga4Id }}");
</script>
{% endif %}

{# Google Tag Manager ist bewusst nicht mehr eingebunden. Der alte Container
   GTM-KLVD3FCX enthielt ausschließlich GA4; gemessen kamen darüber keine
   weiteren Dienste. Soll später Ads oder Meta dazu, kann hier wieder ein
   Container stehen – dann aber weiterhin erst nach Cookiebot. #}
{% if site.tracking.gtmId %}
<script data-cookieconsent="ignore">
  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
  var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
  j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
  f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','{{ site.tracking.gtmId }}');
</script>
{% endif %}
