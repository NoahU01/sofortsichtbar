<header class="nav" role="banner">
  <div class="padding-global">
    <div class="container nav__inner">

      <a class="nav__brand" href="/" aria-label="{{ site.name }} – zur Startseite">
        <img class="nav__logo" src="/assets/img/logos/logo-white.svg" alt="{{ site.name }}" width="78" height="40">
      </a>

      <nav class="nav__menu" id="nav-menu" aria-label="Hauptnavigation">
        <div class="nav__content">
          <div class="nav__top">
            <div class="nav__links">
              {% for item in site.nav %}
                <a class="nav__link" href="{{ item.href }}"
                   {% if item.href == page.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
              {% endfor %}
            </div>
            <a class="btn btn--primary btn--full" href="{{ site.navCta.href }}">{{ site.navCta.label }}</a>
          </div>

          <div class="nav__social">
            {% for icon in site.socialNavOrder %}
              {% for s in site.social %}{% if s.icon == icon %}
                <a class="nav__social-link" href="{{ s.href }}" aria-label="{{ s.label }}"
                   {% if "http" in s.href %}target="_blank" rel="noopener"{% endif %}>
                  <img class="nav__social-icon" src="/assets/img/icons/{{ s.icon }}.svg" alt="" aria-hidden="true">
                </a>
              {% endif %}{% endfor %}
            {% endfor %}
          </div>
        </div>
      </nav>

      <button class="nav__toggle" type="button"
              aria-controls="nav-menu" aria-expanded="false" aria-label="Menü öffnen">
        <span class="nav__burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>

    </div>
  </div>
</header>
