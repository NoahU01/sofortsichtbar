{% set h = home.hero %}
<section class="hero">
  <div class="padding-global">
    <div class="container">
      <div class="hero__grid">

        <div class="glow hero__glow-1 reveal"></div>
        <div class="glow hero__glow-2 reveal"></div>

        <div class="hero__content reveal">
          <div class="hero__header">
            <div class="text-white">{{ h.eyebrow }}</div>

            <h1 class="hero__headline">
              <span>Die</span>
              <span class="hero__icon-wrapper" aria-hidden="true">
                <img class="hero__icon" src="/assets/img/logos/logo-icon.svg" alt="">
              </span>
              <span>schnellste</span>
              <strong>Sichtbarkeit</strong>
              <span>für</span>
              <span>dich</span>
              <span>&amp;</span>
              <span>dein</span>
              <span>Vertriebsteam</span>
            </h1>

            <p class="text-regular text-white">{{ h.text }}</p>
          </div>

          <div class="hero__cta-desktop">
            <a class="btn btn--primary" href="{{ h.cta.href }}">{{ h.cta.label }}</a>
          </div>
        </div>

        <div class="hero__visual reveal">
          {% for b in h.badges %}
            <div class="hero__badge-{{ b.pos }}">
              <div class="badge">
                <img class="icon-sm" src="/assets/img/icons/{{ b.icon }}.svg" alt="" aria-hidden="true">
                <div class="badge__text">{{ b.label }}</div>
              </div>
            </div>
          {% endfor %}

          <div class="hero__image-mobile">
            <img class="hero__couple" src="/assets/img/hero-couple.png"
                 srcset="/assets/img/hero-couple-500.png 500w, /assets/img/hero-couple.png 777w"
                 sizes="100vw" alt="Zwei Berater:innen Rücken an Rücken" fetchpriority="high" decoding="async">
          </div>

          <img class="hero__image" src="/assets/img/hero-image.png"
               srcset="/assets/img/hero-image-500.png 500w, /assets/img/hero-image.png 734w"
               sizes="(max-width: 734px) 100vw, 734px"
               alt="Zwei Berater:innen Rücken an Rücken" fetchpriority="high" decoding="async">

          <div class="hero__cta-mobile">
            <a class="btn btn--primary" href="{{ h.cta.href }}">{{ h.cta.label }}</a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
