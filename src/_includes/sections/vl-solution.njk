{% set s = vertriebsleiter.solution %}
<section class="vl-solution" id="solution">
  <div class="padding-global">
    <div class="section-padding section-padding--top-4">
      <div class="container">
        <div class="vl-solution__container">

          <div class="themes__content">
            <div class="themes__text">
              <div class="eyebrow"><div class="eyebrow__text">{{ s.eyebrow }}</div></div>
              <h2 class="text-white heading-h2 text-center vl-solution__headline">{{ s.headline }}</h2>
              <p class="text-white text-center">{{ s.text }}</p>
            </div>
          </div>

          <div class="vl-solution__items">
            {% for item in s.items %}
              <article class="vl-solution__item">
                <div class="solution__item-content">
                  <div class="solution__item-header">
                    <img class="icon-md" src="/assets/img/icons/check.svg" alt="" aria-hidden="true" loading="lazy">
                    <h3 class="text-white heading-h4">{{ item.title }}</h3>
                  </div>
                  <p class="text-secondary">{{ item.text }}</p>
                </div>
                <img class="vl-solution__preview{% if item.wide %} vl-solution__preview--wide{% endif %}"
                     src="/assets/img/{{ item.image }}" alt="" aria-hidden="true" loading="lazy" decoding="async">
              </article>
            {% endfor %}
          </div>

          <div class="vl-solution__buttons">
            {% for b in s.buttons %}
              <a class="btn {{ 'btn--primary' if loop.first else 'btn--secondary' }}" href="{{ b.href }}">{{ b.label }}</a>
            {% endfor %}
          </div>

          <div class="glow vl-solution__glow"></div>
        </div>
      </div>
    </div>
  </div>
</section>
