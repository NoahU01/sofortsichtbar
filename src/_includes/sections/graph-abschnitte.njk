{#- Gemeinsame Darstellung für Graph V2 (dunkel) und V3 (hell).
    Farben kommen aus CSS-Variablen, die Struktur ist identisch. -#}
{%- set g = strategieGraph -%}
{%- set G = g.graph2 -%}

<div class="g2 g2--{{ g2Variante }}" data-g2>

  {% include "sections/meilenstein-kopf.njk" %}

  <div class="g2__buehne">

    <aside class="g2__rail" aria-hidden="true">
      {% for spur in G.spuren %}
        <div class="g2__rail-bahn" style="top: {{ spur.y - G.bandLuft }}px; height: {{ spur.hoehe + (G.bandLuft * 2) }}px; --f: {{ spur.farbe }}">
          <b>{{ spur.label }}</b>
          <span>{{ spur.frage }}</span>
          <i>{{ spur.fortschritt }}%</i>
        </div>
      {% endfor %}
    </aside>

    <div class="g2__scroll">
    <div class="g2__inhalt" style="width: {{ G.breite }}px">

      <div class="g2__stationsreihe">
        {% for st in G.stationen %}
          <div class="g2__station{% if st.erreicht %} is-erreicht{% endif %}" style="left: {{ st.x }}px">
            <span class="g2__station-nr">{{ st.nr }}</span>
            <span class="g2__station-titel">{{ st.titel }}</span>
            <span class="g2__station-text">{{ st.ergebnis }}</span>
            <span class="g2__station-balken"><i style="width: {{ st.fortschritt }}%"></i></span>
            <span class="g2__station-quote">{{ st.fortschritt }}% · {{ st.anzahl }} Schritte</span>
          </div>
        {% endfor %}
      </div>

      <div class="g2__flaeche" style="height: {{ G.hoehe }}px">

        {% for st in G.stationen %}
          <div class="g2__tor{% if st.erreicht %} is-erreicht{% endif %}" style="left: {{ st.x }}px"></div>
        {% endfor %}

        {# Das Band greift oben und unten über die Karten hinaus #}
        {% for spur in G.spuren %}
          <div class="g2__bahn" style="top: {{ spur.y - G.bandLuft }}px; height: {{ spur.hoehe + (G.bandLuft * 2) }}px; --f: {{ spur.farbe }}"></div>
        {% endfor %}

        <svg class="g2__kanten" width="{{ G.breite }}" height="{{ G.hoehe }}" aria-hidden="true">
          <defs>
            <marker id="g2pfeil" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M 0 0 L 8 4 L 0 8 z" class="g2__spitze" />
            </marker>
          </defs>
          {% for k in G.kanten %}
            <path class="g2__kante{% if k.quer %} is-quer{% endif %}"
                  data-von="{{ k.von }}" data-nach="{{ k.nach }}" d="{{ k.pfad }}"
                  marker-end="url(#g2pfeil)" />
          {% endfor %}
        </svg>

        {% for s in g.schritte %}
          <button class="g2__karte g2__karte--{{ s.status }}{% if s.dran %} is-machbar{% endif %}"
                  type="button"
                  data-knoten="{{ s.id }}"
                  data-schritt="{{ s.id }}"
                  data-braucht="{{ s.braucht | join(" ") }}"
                  data-nachfolger="{{ s.nachfolger | join(" ") }}"
                  style="left: {{ s.g2x }}px; top: {{ s.g2y }}px; width: {{ G.knotenBreite }}px; height: {{ G.knotenHoehe }}px; --f: {{ s.farbe }}">
            <span class="g2__karte-kopf">
              <i class="g2__zeichen" aria-hidden="true"></i>
              <span class="g2__karte-titel">{{ s.titel }}</span>
              {% if s.wer %}<span class="g2__wer" title="{{ s.werName }}">{{ s.wer }}</span>{% endif %}
            </span>
            <span class="g2__karte-satz">{{ s.ergebnis }}</span>
          </button>
        {% endfor %}

      </div>
    </div>
    </div>

  </div>
</div>
