{#- Liniennetz. Mit metroV2 = true zeigt die Linie den Fortschritt:
    dick bis zum aktuellen Halt, danach dünn. -#}
{%- set g = strategieGraph -%}

<div class="me{% if metroV2 %} me--v2{% endif %}">

  <div class="me__kopf">
    <h1>{{ metroTitel }}</h1>
    <p class="me__lies">
      Drei Linien laufen nebeneinander nach rechts. Jeder Halt ist ein Schritt.
      Die <strong>nummerierten Stationen</strong> sind Ergebnisstufen — dort muss jede Linie
      angekommen sein, bevor es weitergeht.
      {% if metroV2 %}
        Die Linie ist <strong>dick, solange der Weg hinter uns liegt</strong>, und wird dünn,
        sobald er noch vor uns liegt.
      {% endif %}
    </p>
  </div>

  <div class="me__legende">
    <div class="me__leg-gruppe">
      <span class="me__leg-titel">Linien</span>
      {% for l in g.metro.linien %}
        <span class="me__leg-linie" style="--f: {{ l.farbe }}">{{ l.label }} <i>{{ l.fortschritt }}%</i></span>
      {% endfor %}
    </div>
    <div class="me__leg-gruppe">
      <span class="me__leg-titel">Halte</span>
      <span class="me__leg-halt"><i class="me__muster me__muster--fertig"></i>erledigt</span>
      <span class="me__leg-halt"><i class="me__muster me__muster--jetzt"></i>jetzt machbar</span>
      <span class="me__leg-halt"><i class="me__muster me__muster--wartet"></i>wartet noch</span>
      {% if metroV2 %}
        <span class="me__leg-halt"><i class="me__muster me__muster--dick"></i>schon gegangen</span>
        <span class="me__leg-halt"><i class="me__muster me__muster--duenn"></i>liegt noch vor uns</span>
      {% else %}
        <span class="me__leg-halt"><i class="me__muster me__muster--bogen"></i>wartet auf andere Linie</span>
      {% endif %}
    </div>
  </div>

  <div class="me__scroll">
    <div class="me__plan" style="width: {{ g.metro.breite }}px; height: {{ g.metro.hoehe }}px">

      <svg class="me__svg" width="{{ g.metro.breite }}" height="{{ g.metro.hoehe }}" aria-hidden="true">
        <defs>
          <marker id="mpfeil" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 0 L 8 4 L 0 8 z" fill="#8d8797" />
          </marker>
        </defs>

        {% for s in g.metro.stationen %}
          <line class="me__stationslinie" x1="{{ s.x }}" y1="96" x2="{{ s.x }}" y2="{{ g.metro.hoehe - 30 }}" />
        {% endfor %}

        {% if metroV2 %}
          {% for l in g.metro.linien %}
            <path class="me__linie me__linie--offen" d="{{ l.pfadOffen }}" style="--f: {{ l.farbe }}" />
            <path class="me__linie me__linie--gegangen" d="{{ l.pfadGegangen }}" style="--f: {{ l.farbe }}" />
          {% endfor %}
        {% else %}
          {% for l in g.metro.linien %}
            <path class="me__linie" d="{{ l.pfad }}" style="--f: {{ l.farbe }}" />
          {% endfor %}
        {% endif %}

        {% for q in g.metro.quer %}
          <path class="me__quer" data-von="{{ q.von }}" data-nach="{{ q.nach }}" d="{{ q.pfad }}"
                marker-end="url(#mpfeil)"><title>{{ q.text }}</title></path>
        {% endfor %}
      </svg>

      {% for l in g.metro.linien %}
        <span class="me__linienname" style="top: {{ l.y }}px; --f: {{ l.farbe }}">{{ l.kurz }}</span>
      {% endfor %}

      {% for s in g.metro.stationen %}
        <div class="me__station{% if s.erreicht %} is-erreicht{% endif %}" style="left: {{ s.x }}px">
          <span class="me__station-nr">{{ s.nr }}</span>
          <span class="me__station-titel">{{ s.titel }}</span>
          <span class="me__station-text">{{ s.ergebnis }}</span>
          <span class="me__station-balken"><i style="width: {{ s.fortschritt }}%"></i></span>
        </div>
      {% endfor %}

      {% for s in g.schritte %}
        <button class="me__halt me__halt--{{ s.status }}{% if s.machbar %} is-machbar{% endif %}"
                type="button" data-schritt="{{ s.id }}" data-halt="{{ s.id }}"
                style="left: {{ s.mx }}px; top: {{ s.my }}px; --f: {{ s.farbe }}">
          <span class="me__halt-punkt"></span>
          <span class="me__halt-label">{{ s.titel }}</span>
          {% if s.wer %}<span class="me__halt-wer">{{ s.wer }}</span>{% endif %}
          {% if s.machbar and not metroV2 %}<span class="me__halt-jetzt">jetzt machbar</span>{% endif %}
        </button>
      {% endfor %}

    </div>
  </div>
</div>
