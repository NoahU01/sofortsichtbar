<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">

  {% if noindex %}<meta name="robots" content="noindex,nofollow">{% endif %}
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
  <meta property="og:locale" content="de_DE">
  <meta property="og:image" content="{{ site.url }}/assets/img/og-image.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="sofort sichtbar – die schnellste Sichtbarkeit für dich und dein Vertriebsteam">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}/assets/img/og-image.jpg">

  <link rel="icon" href="/assets/img/logos/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/assets/img/logos/webclip.png">

  {# Schriften liegen lokal (siehe assets/css/00-fonts.css) – keine Verbindung
     zu Google-Servern. Die beiden meistgenutzten Schnitte vorladen. #}
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/poppins-400-latin.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/poppins-500-latin.woff2" crossorigin>

  <link rel="stylesheet" href="/assets/css/main.css">

  {# Strukturierte Daten: hilft Google und KI-Crawlern, das Unternehmen
     eindeutig zuzuordnen. Nur auf der Startseite, sonst dupliziert es. #}
  {% if page.url == "/" %}
  {%- set socialUrls = [] -%}
  {%- for s in site.social %}{% if "http" in s.href %}{% set socialUrls = (socialUrls.push(s.href), socialUrls) %}{% endif %}{% endfor -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/assets/img/logos/logo-white.svg",
    "image": "{{ site.url }}/assets/img/og-image.jpg",
    "description": {{ site.description | dump | safe }},
    "email": "{{ site.email }}",
    "telephone": "{{ site.phoneHref }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Kapellengasse 6",
      "postalCode": "74564",
      "addressLocality": "Crailsheim",
      "addressCountry": "DE"
    },
    "sameAs": {{ socialUrls | dump | safe }}
  }
  </script>
  {% endif %}

  {% include "partials/schema-page.njk" %}

  {# Tracking-Snippets (GTM, Consent o. ä.) kommen hier hinein #}
  {% include "partials/head-scripts.njk" %}
</head>
<body>
  {% include "partials/body-scripts.njk" %}

  <a class="visually-hidden" href="#main">Zum Inhalt springen</a>

  <div class="page-wrapper">
    <div class="main-wrapper">
      {% include "partials/nav.njk" %}

      <main id="main">
        {{ content | safe }}
      </main>

      {% include "partials/footer.njk" %}
    </div>
  </div>

  <script src="/assets/js/main.js" defer></script>
  {% if site.tracking.ga4Id or site.tracking.gtmId %}
  <script src="/assets/js/tracking.js" defer></script>
  {% endif %}
</body>
</html>
