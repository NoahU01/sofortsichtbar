---
layout: layouts/base.njk
---
{%- set g = strategieGraph -%}
<div class="k k--{{ konzept }}">

  <header class="k-bar">
    <a class="k-bar__zurueck" href="/entwicklung/strategie-zielbild">Strategie und Zielbild</a>
    <span class="k-bar__label">Darstellung</span>
    <nav class="k-bar__wechsel" aria-label="Darstellung">
      {% for k in konzepte %}
        <a class="k-bar__pill{% if k.id == konzept %} is-aktiv{% endif %}"
           href="{{ k.href }}"{% if k.id == konzept %} aria-current="page"{% endif %}>{{ k.name }}</a>
      {% endfor %}
    </nav>
    <span class="k-bar__meta">{{ g.fortschritt }}% · {{ g.erledigt.length }}/{{ g.anzahl }}</span>
  </header>

  {{ content | safe }}

  {# Detail-Popover: nur was nicht schon im Bild steht –
     Aufwand, Inhalte, Ergebnis. Abhängigkeiten sieht man an den Pfeilen. #}
  <div class="k-pop" data-pop hidden role="dialog" aria-label="Schrittdetails">
    <button class="k-pop__zu" type="button" data-pop-zu aria-label="Schließen">&times;</button>
    {% for s in g.schritte %}
      <article class="k-detail" data-detail="{{ s.id }}" hidden>

        <div class="k-detail__kopf">
          <span class="k-detail__strang" style="--f: {{ s.farbe }}">{{ s.strangLabel }}</span>
          {% if s.wer %}<span class="k-detail__wer" title="{{ s.werName }}">{{ s.wer }}</span>{% endif %}
        </div>

        <h2 class="k-detail__titel">{{ s.titel }}</h2>

        <div class="k-detail__block">
          <h3>Aufwand</h3>
          <p>{{ s.aufwandLabel }}</p>
        </div>

        {% if s.details.length %}
          <div class="k-detail__block">
            <h3>Inhalte</h3>
            <ul>{% for d in s.details %}<li>{{ d }}</li>{% endfor %}</ul>
          </div>
        {% endif %}

        <div class="k-detail__block">
          <h3>Ergebnis</h3>
          <p>{{ s.ergebnis }}</p>
        </div>

        {% if s.offen.length %}
          <div class="k-detail__block">
            <h3>Offen</h3>
            <ul class="k-detail__offen">{% for o in s.offen %}<li>{{ o }}</li>{% endfor %}</ul>
          </div>
        {% endif %}

      </article>
    {% endfor %}
  </div>

</div>
