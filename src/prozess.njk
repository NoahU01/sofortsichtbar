---
layout: layouts/base.njk
title: Prozessbild – sofort sichtbar
description: Interne Arbeitsgrundlage.
permalink: /prozess/index.html
noindex: true
prozessSeite: true
eleventyExcludeFromCollections: true
---
{% set p = prozess %}

{% macro icons(liste) %}
  {% for i in liste %}<img class="pz-node__icon" src="/assets/img/icons/{{ i }}.svg" alt="" aria-hidden="true">{% endfor %}
{% endmacro %}

<section class="pz-board" data-board>
  <div class="padding-global">
    <div class="section-padding--top-4">
      <div class="container">

        {# --- Kopf: wechselt zwischen Überblick und Kanal ------------------ #}
        <div class="pz-kopf">
          <div class="pz-kopf__links">
            <button class="pz-zurueck" type="button" data-zurueck hidden>
              <img src="/assets/img/icons/chevron.svg" alt="" aria-hidden="true"> Überblick
            </button>
            <span class="eyebrow"><span class="eyebrow__text">{{ p.hinweis }}</span></span>
            <h1 class="heading-h3 text-white" data-titel>Überblick</h1>
          </div>

          <nav class="pz-tabs" aria-label="Kanal wählen">
            {% for k in p.kanaele %}
              <button class="pz-tab" type="button" data-tab="{{ k.id }}">
                <span class="pz-node__status" data-status="{{ k.status }}"></span>{{ k.name }}
              </button>
            {% endfor %}
          </nav>
        </div>

        {# --- Bühne: eine Ansicht sichtbar -------------------------------- #}
        <div class="pz-stage" data-stage>

          {# Überblick #}
          <div class="pz-view is-aktiv" data-view="ueberblick">
            <svg class="pz-lines" data-lines aria-hidden="true"></svg>

            <div class="pz-node pz-node--nabe" data-node="datenbank">
              <span class="pz-node__status" data-status="{{ p.nabe.status }}"></span>
              <span class="pz-node__name">{{ p.nabe.name }}</span>
            </div>

            {% for k in p.kanaele %}
              <button class="pz-node pz-node--kanal{% if k.istWebsite %} pz-node--ziel{% endif %}"
                      type="button" data-node="{{ k.id }}">
                <span class="pz-node__status" data-status="{{ k.status }}"></span>
                {{ icons(k.icons) }}
                <span class="pz-node__name">{{ k.name }}</span>
              </button>
            {% endfor %}
          </div>

          {# Ein Prozessbild je Kanal #}
          {% for k in p.kanaele %}
            <div class="pz-view" data-view="{{ k.id }}" hidden>
              <svg class="pz-lines" data-lines aria-hidden="true"></svg>

              {% for s in k.prozess %}
                <div class="pz-node pz-node--schritt" data-schritt="{{ s.nr }}" data-typ="{{ s.typ }}"{% if s.zurWebsite %} data-zur-website{% endif %}{% if s.istLead %} data-lead{% endif %}>
                  <span class="pz-node__nr">{{ s.nr }}</span>
                  {% if s.status %}<span class="pz-node__status" data-status="{{ s.status }}"></span>{% endif %}
                  <span class="pz-node__name">{{ s.text }}</span>
                </div>
              {% endfor %}

              {% if k.zurWebsite and not k.istWebsite %}
                <div class="pz-node pz-node--zweig" data-zweig="website">
                  <img class="pz-node__icon" src="/assets/img/icons/eye.svg" alt="" aria-hidden="true">
                  <span class="pz-node__name">Website</span>
                </div>
                <div class="pz-node pz-node--zweig pz-node--ziel" data-zweig="lead">
                  <span class="pz-node__name">Konversion → Lead</span>
                  <span class="pz-node__hinweis">Hauptziel</span>
                </div>
              {% endif %}

              {# Zuletzt im Markup, damit die Kette auf dem Handy richtig herum liest #}
              <div class="pz-node pz-node--nabe" data-node="datenbank">
                <span class="pz-node__status" data-status="{{ p.nabe.status }}"></span>
                <span class="pz-node__name">{{ p.nabe.name }}</span>
              </div>
            </div>
          {% endfor %}
        </div>

        {# --- Was die Linien bedeuten ------------------------------------- #}
        <div class="pz-legende">
          <span class="pz-legende__item"><svg class="pz-legende__linie" viewBox="0 0 40 8" aria-hidden="true"><path d="M0 4H34"/><path class="pz-legende__spitze" d="M34 1l6 3-6 3z"/></svg> unsere Aktion</span>
          <span class="pz-legende__item"><svg class="pz-legende__linie" viewBox="0 0 40 8" aria-hidden="true"><path stroke-dasharray="5 4" d="M0 4H34"/><path class="pz-legende__spitze" d="M34 1l6 3-6 3z"/></svg> Signal in die Datenbank</span>
          <span class="pz-legende__item"><svg class="pz-legende__linie" viewBox="0 0 40 8" aria-hidden="true"><path stroke-dasharray="2 4" d="M0 4H34"/><path class="pz-legende__spitze" d="M34 1l6 3-6 3z"/></svg> Traffic zur Website</span>
          <span class="pz-legende__item pz-legende__item--ziel"><svg class="pz-legende__linie pz-legende__linie--stark" viewBox="0 0 40 8" aria-hidden="true"><path d="M0 4H34"/><path class="pz-legende__spitze" d="M34 0.5l6.5 3.5-6.5 3.5z"/></svg> Lead — Hauptziel</span>
          <span class="pz-legende__trenner" aria-hidden="true"></span>
          {% for s in p.statusLegende %}
            <span class="pz-legende__item">
              <span class="pz-node__status" data-status="{{ s.id }}"></span>{{ s.name }}
              <span class="pz-legende__klein">{{ s.text }}</span>
            </span>
          {% endfor %}
        </div>

      </div>
    </div>
  </div>
</section>

{# --- Text unter dem Bild ------------------------------------------------ #}
<section class="pz-detail" aria-live="polite">
  <div class="padding-global">
    <div class="section-padding--top-4">
      <div class="container">

        <article class="pz-panel" data-panel="ueberblick">
          <div class="pz-panel__grid">
            <div class="pz-card">
              <h2 class="heading-h5 text-white">{{ p.nabe.name }}</h2>
              <p class="text-small text-secondary">{{ p.nabe.beschreibung }}</p>
              <ul class="pz-list">{% for i in p.nabe.inhalt %}<li>{{ i }}</li>{% endfor %}</ul>
            </div>
            <div class="pz-card">
              <h2 class="heading-h5 text-white">Signale, Beispiele</h2>
              <ul class="pz-list pz-list--tags">{% for s in p.nabe.signalBeispiele %}<li>{{ s }}</li>{% endfor %}</ul>
            </div>
          </div>
        </article>

        {% for k in p.kanaele %}
          <article class="pz-panel" data-panel="{{ k.id }}" hidden>
            {% if k.accounts or k.notiz or k.grenze %}
              <div class="pz-panel__meta">
                {% if k.accounts %}<p class="text-small text-grey">Accounts: {{ k.accounts | join(" · ") }}</p>{% endif %}
                {% if k.notiz %}<p class="text-small text-grey">{{ k.notiz }}</p>{% endif %}
                {% if k.grenze %}<p class="pz-grenze"><strong class="text-white">Grenze:</strong> {{ k.grenze }}</p>{% endif %}
              </div>
            {% endif %}

            <div class="pz-aufgaben">
              <h2 class="heading-h5 text-white">Wer macht was</h2>
              <p class="text-small text-grey">Entwurf — legen wir im nächsten Schritt gemeinsam fest.</p>
              <table class="pz-tabelle">
                <thead><tr><th>Wer</th><th>Was</th><th>Takt</th></tr></thead>
                <tbody>
                  {% for a in k.aufgaben %}
                    <tr{% if a.status %} data-geplant="1"{% endif %}>
                      <td>{{ a.wer }}</td>
                      <td>{{ a.was }}{% if a.status %} <span class="pz-tag">{{ a.status }}</span>{% endif %}</td>
                      <td>{{ a.takt }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </article>
        {% endfor %}

      </div>
    </div>
  </div>
</section>
