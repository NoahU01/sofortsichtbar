@media (max-width: 560px) { .sb9 { grid-template-columns: minmax(0, 1fr); } }
/* ---------- AVRG · Black Week (Daniel, 20.11.2026): eigenständige Landingpage /zielgruppen/avrg im Look von Story 9 ---------- */
.av9 { overflow-x: clip; }
.av9 .s9-held { text-align: center; }
.av9-aktion { display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .5rem 1rem; margin-top: 2.4rem; padding: .7rem .8rem .7rem 1.2rem; border-radius: 99px; background: #fff; box-shadow: 0 14px 40px rgba(0,0,0,.08), 0 0 0 1px rgba(0,0,0,.05); }
.av9-aktion__marke { color: var(--s7-tinte); font-weight: 700; }
.av9-aktion__preis { color: var(--s7-text); }
.av9-aktion__preis b { color: var(--s7-tinte); font-size: 1.15rem; }
.av9-aktion__preis s { color: var(--s7-grau); }
.av9-uhr { display: inline-flex; align-items: baseline; gap: .3rem; white-space: nowrap; padding: .45rem .8rem; border-radius: 99px; background: linear-gradient(100deg, #0b9fbd, #8613a1); color: #fff; font-weight: 600; font-variant-numeric: tabular-nums; }
.av9-uhr span { min-width: 1.6em; text-align: right; }
.av9-uhr small { opacity: .8; margin-right: .35rem; font-size: .85em; }
/* Postings-Kasten: dunkel, Text links, schräge Bahnen rechts (Vorbild: alte AVRG-Übersicht der SV Owen) */
.av9-kasten { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); min-height: 36rem; border-radius: 28px; overflow: hidden; background: #0e0e10; color: #e9e9e9; }
