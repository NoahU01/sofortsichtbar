.av9-pl__pfeil { width: 2.2rem; height: 2.2rem; fill: none; stroke: var(--s7-tinte); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.av9-ticket { position: relative; padding: clamp(1.6rem, 3vw, 2.2rem); border-radius: 22px; background: linear-gradient(130deg, #0b9fbd, #8613a1); color: #fff; transform: rotate(-3deg); box-shadow: 0 30px 60px -20px rgba(134,19,161,.55); }
.av9-ticket::after { content: ""; position: absolute; right: 22%; top: 0; bottom: 0; border-right: 2px dashed rgba(255,255,255,.45); }
.av9-ticket__marke { font-size: .72rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; opacity: .85; }
.av9-ticket__zeit { margin-top: .4rem; font-family: var(--s7-schrift-titel); font-size: clamp(2.2rem, 4vw, 3rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
.av9-ticket ul { display: grid; gap: .45rem; margin: 1rem 0 0; padding: 0; list-style: none; max-width: 76%; }
.av9-ticket li { display: flex; align-items: center; gap: .6rem; font-weight: 600; }
.av9-ticket li::before { content: "✓"; display: grid; place-items: center; flex: none; width: 1.3rem; height: 1.3rem; border-radius: 6px; background: #fff; color: #8613a1; font-size: .8rem; font-weight: 700; }
.av9-ticket__fuss { margin-top: 1.2rem; padding-top: .9rem; border-top: 1px solid rgba(255,255,255,.35); font-family: var(--s7-schrift-titel); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; max-width: 76%; }
/* Drei Schritte mit Bildern */
.av9 .av9-schritte li { display: flex; flex-direction: column; padding: 0 0 clamp(1.6rem, 3vw, 2.2rem); overflow: hidden; background: var(--s7-flaeche); box-shadow: none; }
