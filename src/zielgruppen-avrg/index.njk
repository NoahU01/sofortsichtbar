.av9-liste li::before { content: ""; position: absolute; left: 0; top: .5em; width: .55rem; height: .55rem; border-radius: 50%; background: linear-gradient(135deg, #0b9fbd, #8613a1); }
.av9-feed { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; padding: 0 22px; height: 100%; min-height: 36rem; overflow: hidden; transform: rotate(-5deg) scale(1.16);
  -webkit-mask: linear-gradient(180deg, transparent 0, #000 12%, #000 88%, transparent 100%); mask: linear-gradient(180deg, transparent 0, #000 12%, #000 88%, transparent 100%); }
.av9-spalte { position: relative; overflow: hidden; }
.av9-band { position: absolute; inset: 0 0 auto; display: flex; flex-direction: column; gap: 14px; animation: av9-hoch 70s linear infinite; }
.av9-spalte:nth-child(2) .av9-band { animation-direction: reverse; animation-duration: 82s; }
.av9-spalte:nth-child(3) .av9-band { animation-duration: 62s; }
.av9-band img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 12px; box-shadow: 0 12px 24px rgba(0,0,0,.35); }
.av9-kasten:hover .av9-band { animation-play-state: paused; }
@keyframes av9-hoch { from { transform: translateY(0); } to { transform: translateY(calc(-50% - 7px)); } }
.av9 .s9-held .av9-einleitung { max-width: 54rem; }
/* Dreiklang: Landingpage groß links, Postings und Mailings rechts */
.av9-drei { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); grid-template-rows: auto auto; gap: 1rem; margin-top: 3.2rem; }
