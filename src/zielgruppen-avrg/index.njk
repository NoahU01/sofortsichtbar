.av9-kasten__text p { margin-top: 1.2rem; color: #a1a1a6; font-size: 1.08rem; line-height: 1.55; max-width: 30rem; }
.av9-liste { display: grid; gap: .7rem; margin: 1.8rem 0 0; padding: 0; list-style: none; }
