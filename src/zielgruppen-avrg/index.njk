.av9 .av9-schritte li > b::before { content: counter(av9); display: inline-grid; place-items: center; width: 1.7rem; height: 1.7rem; margin-right: .6rem; border-radius: 50%; background: var(--s7-tinte); color: #fff; font-family: var(--s7-schrift-text); font-size: .85rem; vertical-align: .15em; }
