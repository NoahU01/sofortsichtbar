.av9 .av9-schritte li { position: relative; }
.av9-schritt__bild { display: grid; place-items: center; height: 11rem; margin-bottom: 1.2rem; background: radial-gradient(70% 80% at 50% 100%, rgba(134,19,161,.14), transparent 70%), radial-gradient(60% 70% at 30% 100%, rgba(11,159,189,.14), transparent 70%); }
.av9 .av9-schritte li > b, .av9 .av9-schritte li > p { padding-inline: clamp(1.6rem, 3vw, 2.2rem); }
.av9 .av9-schritte li > b { margin-top: 0 !important; }
.av9-mini { padding: .9rem 1rem; border-radius: 16px; background: #fff; box-shadow: 0 16px 40px -16px rgba(0,0,0,.25), 0 0 0 1px rgba(0,0,0,.04); }
.av9-wahl { display: flex; gap: .6rem; padding-inline: 1rem; }
.av9-wahl span { position: relative; width: 6.4rem; border-radius: 8px; overflow: hidden; background: #fff; box-shadow: 0 10px 24px -12px rgba(0,0,0,.3), 0 0 0 1px rgba(0,0,0,.06); }
.av9-wahl img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
.av9-wahl span.an { box-shadow: 0 0 0 2px #11708a, 0 14px 30px -12px rgba(17,112,138,.45); transform: translateY(-4px); }
.av9-wahl span.an::after { content: "✓"; position: absolute; right: .3rem; top: .3rem; display: grid; place-items: center; width: 1.2rem; height: 1.2rem; border-radius: 50%; background: #11708a; color: #fff; font-size: .7rem; font-weight: 700; }
.av9-mini--kal p { color: var(--s7-tinte); font-size: .8rem; font-weight: 700; }
.av9-mini--kal div { display: grid; grid-template-columns: repeat(7, 1.6rem); gap: .25rem; margin-top: .5rem; }
.av9-mini--kal i { display: grid; place-items: center; height: 1.6rem; border-radius: 6px; color: var(--s7-text); font-size: .75rem; font-style: normal; }
.av9-mini--kal i.an { background: linear-gradient(135deg, #0b9fbd, #8613a1); color: #fff; font-weight: 700; }
.av9-mini--marke { display: grid; justify-items: center; gap: .7rem; }
.av9-mini--marke img { width: 9rem; height: auto; }
.av9-mini--marke p { display: flex; gap: .45rem; }
.av9-mini--marke i { width: 1.4rem; height: 1.4rem; border-radius: 50%; }
.av9-mini--marke i.an { background: #11708a; box-shadow: 0 0 0 2px #fff, 0 0 0 4px #11708a; }
.av9 .av9-mini--note { position: static; max-width: calc(100% - 2.4rem); }
.av9 .av9-mini--note b { font-size: .95rem; }
/* Problemlöser statt Detailberater */
.av9-kopf { max-width: 52rem; margin-inline: auto; text-align: center; }
.av9-kopf .s9-lead { margin-inline: auto; }
.av9-gegen { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; max-width: 56rem; margin: 3.2rem auto 0; }
.av9-gegen__karte { padding: clamp(1.6rem, 3vw, 2.4rem); border-radius: 24px; background: #fff; box-shadow: 0 0 0 1px var(--s7-linie); }
.av9-gegen__karte--neu { background: linear-gradient(140deg, #0b9fbd, #8613a1); box-shadow: 0 24px 60px -20px rgba(134,19,161,.5); }
.av9-gegen__karte p:first-child { color: var(--s7-grau); font-size: .95rem; font-weight: 600; }
.av9-gegen__karte h3 { margin-top: .6rem !important; font-size: clamp(1.5rem, 2.6vw, 2.1rem); line-height: 1.08; letter-spacing: -0.025em; }
.av9-gegen__karte p + h3 + p { margin-top: .8rem; color: var(--s7-text); line-height: 1.5; }
