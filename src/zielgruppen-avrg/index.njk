.av9-kachel--posts .av9-kachel__text p:last-child { color: #a1a1a6; }
.av9-kachel--posts .av9-marke { color: #a1a1a6; }
.av9-kachel--posts .av9-feed { position: absolute; inset: 0 -12% -30% 46%; min-height: 0; height: auto; padding: 0; gap: 10px; transform: rotate(-6deg); }
.av9-kachel--posts .av9-band { gap: 10px; }
.av9-kachel--posts .av9-band img { border-radius: 9px; }
.av9-kachel--posts .av9-kachel__text { max-width: 54%; padding-bottom: clamp(1.6rem, 3vw, 2.4rem); }
.av9-kachel--mail { justify-content: space-between; padding-bottom: clamp(1.6rem, 3vw, 2.4rem); }
.av9-post { position: relative; margin: 0 clamp(1.6rem, 3vw, 2.4rem); padding-top: 1.2rem; }
.av9-post__hinten { position: absolute; left: 6%; right: 6%; height: 3rem; border-radius: 14px; background: #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.06); }
