.px9-reihe > div:first-child .px9-cap { grid-column: 1 / -1; }
.px9-post { border-radius: 10px; background: #fff; box-shadow: 0 6px 16px rgba(0,0,0,.08); overflow: hidden; }
.px9-post__kopf { display: flex; align-items: center; gap: 5px; padding: 6px 7px; font-size: 9px; white-space: nowrap; overflow: hidden; }
.px9-post__kopf i { flex: none; display: grid; place-items: center; width: 16px; height: 16px; border-radius: 4px; color: #fff; font-size: 8.5px; font-style: normal; font-weight: 700; }
