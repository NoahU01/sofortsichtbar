.av9-reihe figcaption b { display: block; color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: 1.3rem; letter-spacing: -0.02em; }
.av9-mac--klein { width: 100%; }
.av9-stapel { position: relative; }
.av9-stapel img { position: absolute; bottom: 0; left: 50%; width: clamp(6.4rem, 10vw, 8.4rem); border-radius: 10px; box-shadow: 0 18px 36px -14px rgba(0,0,0,.4); }
.av9-stapel img:nth-child(1) { transform: translateX(-95%) rotate(-9deg); }
.av9-stapel img:nth-child(2) { transform: translateX(-5%) rotate(8deg); }
.av9-stapel img:nth-child(3) { transform: translateX(-50%) translateY(-.6rem); }
.av9-reihe__mail .av9-mail { width: 100%; text-align: left; }
.av9-held3 .s9-knoepfe { margin-top: 2.6rem; }
/* Problemlöser statt Detailberater: Begriffswust → Ticket */
.av9-pl { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: clamp(1rem, 3vw, 2.6rem); max-width: 60rem; margin: 3.2rem auto 0; }
.av9-pl__wust { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; padding: 1.4rem; -webkit-mask: radial-gradient(75% 75% at 50% 50%, #000 40%, transparent 100%); mask: radial-gradient(75% 75% at 50% 50%, #000 40%, transparent 100%); }
.av9-pl__wust span { padding: .45rem .8rem; border-radius: 99px; background: #fff; box-shadow: 0 0 0 1px var(--s7-linie); color: var(--s7-grau); font-size: .92rem; text-decoration: line-through; text-decoration-color: rgba(122,122,122,.5); }
