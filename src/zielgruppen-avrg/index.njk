.av9-kachel h3 { margin-top: .5rem !important; font-size: clamp(1.5rem, 2.4vw, 2.1rem); line-height: 1.08; letter-spacing: -0.025em; }
.av9-kachel__text p:last-child { margin-top: .7rem; max-width: 30rem; color: var(--s7-text); line-height: 1.5; }
.av9-marke { color: var(--s7-grau); font-size: .95rem; font-weight: 600; }
.av9-drei { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
.av9-kachel--lp { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.6fr); align-items: center; gap: 1rem; min-height: 30rem;
  background: radial-gradient(55% 70% at 75% 60%, rgba(134,19,161,.13), transparent 70%), radial-gradient(45% 60% at 55% 70%, rgba(11,159,189,.12), transparent 70%), var(--s7-flaeche); }
.av9-kachel--lp .av9-kachel__text { padding-bottom: clamp(1.6rem, 3vw, 2.4rem); }
.av9-geraete { position: relative; padding: clamp(1.6rem, 3vw, 2.6rem) clamp(2.4rem, 5vw, 4.4rem) clamp(1.6rem, 3vw, 2.6rem) 0; }
.av9-mac__bild { padding: 1.4% 1.4% 1.8%; border-radius: 16px 16px 4px 4px; background: #1d1d1f; box-shadow: inset 0 0 0 2px #3a3a3c, 0 30px 60px -24px rgba(29,29,31,.5); }
.av9-mac__bild img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-radius: 4px; background: #fff; }
.av9-mac__fuss { position: relative; height: 14px; margin: 0 -6%; border-radius: 0 0 14px 14px; background: linear-gradient(180deg, #d9d9de, #a9a9b0); box-shadow: 0 12px 24px -10px rgba(0,0,0,.35); }
.av9-mac__fuss::before { content: ""; position: absolute; left: 50%; top: 0; width: 14%; height: 5px; border-radius: 0 0 6px 6px; background: #9a9aa2; transform: translateX(-50%); }
.av9-phone { position: absolute; right: clamp(.6rem, 2vw, 1.6rem); bottom: clamp(.4rem, 1.4vw, 1rem); width: 21%; padding: .9%; border-radius: 17% / 8%; background: #1d1d1f; box-shadow: inset 0 0 0 1px #4a4a4e, 0 24px 48px -16px rgba(29,29,31,.5); }
.av9-phone::before { content: ""; position: absolute; left: 50%; top: 2.4%; width: 28%; height: 2.6%; border-radius: 99px; background: #000; transform: translateX(-50%); z-index: 1; }
.av9-phone img { display: block; width: 100%; aspect-ratio: 390 / 844; object-fit: cover; object-position: top; border-radius: 15.5% / 7.2%; background: #fff; }
.av9-kachel--posts { min-height: 26rem; background: #0e0e10; }
