.av9-gegen__karte--neu p + h3 + p { color: rgba(255,255,255,.88) !important; }
.av9-claim { margin-top: 2.6rem; text-align: center; color: var(--s7-grau); font-size: 1.05rem; }
.av9-claim b { display: block; margin-top: .3rem; color: var(--s7-tinte); font-family: var(--s7-schrift-titel); font-size: clamp(1.6rem, 3vw, 2.4rem); letter-spacing: -0.03em; }
/* Landingpage: iPad mini + Varianten */
.av9-lp { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 5vw, 4.5rem); }
.av9-lp .s9-h2 { font-size: clamp(2rem, 4vw, 3.4rem); }
.av9-lp .s9-lead { margin: 1.2rem 0 0; }
.av9-ipad { position: relative; width: min(100%, 26rem); margin-inline: auto; transform: rotate(-4deg); }
.av9-ipad::before { content: ""; position: absolute; inset: -14% -22%; background: radial-gradient(closest-side, rgba(11,159,189,.42), rgba(134,19,161,.28) 55%, transparent 78%); filter: blur(24px); }
.av9-ipad__geraet { position: relative; padding: 14px; border-radius: 28px; background: #1d1d1f; box-shadow: 0 30px 60px -16px rgba(29,29,31,.45), inset 0 0 0 3px #3a3a3c; }
.av9-ipad__geraet::before { content: ""; position: absolute; left: 50%; top: 5px; width: 5px; height: 5px; border-radius: 50%; background: #3a3a3c; transform: translateX(-50%); }
.av9-ipad__geraet img { display: block; width: 100%; aspect-ratio: 744 / 1133; object-fit: cover; object-position: top; border-radius: 14px; background: #fff; }
