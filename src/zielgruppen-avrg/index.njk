.av9-collage__posts img:nth-child(3) { margin-left: -2.2rem; transform: rotate(6deg); }
.av9-collage__mail { position: absolute; right: 16%; bottom: -2%; width: 42%; transform: rotate(2deg); }
.av9 .av9-collage__phone { right: -1%; bottom: 0; width: 17%; }
.av9-mail--klein .av9-mail__kopf { padding: .6rem .8rem; font-size: .75rem; }
.av9-mail--klein .av9-mail__inhalt { padding: .7rem .8rem .8rem; font-size: .78rem; gap: .5rem; }
.av9-mail--klein .av9-mail__knopf { padding: .35rem .7rem; font-size: .74rem; }
.av9-mail--klein .av9-mail__leiste { padding: .4rem .7rem; font-size: .7rem; }
/* Kopf 3: Überschrift mittig, darunter die drei Teile nebeneinander */
.av9-held3 { text-align: center; }
.av9-reihe { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr); align-items: end; gap: clamp(1rem, 3vw, 2.4rem); max-width: 66rem; margin: clamp(3.4rem, 6vw, 4.8rem) auto 0; }
.av9-reihe__teil { margin: 0; }
