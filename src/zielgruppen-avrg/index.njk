.av9-schalter button[aria-pressed="true"] { background: #fff; color: #1d1d1f; }
/* Kopf 2: Text links, Collage rechts */
.av9-held2 { padding-block: clamp(3.5rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem); overflow: hidden; background: radial-gradient(45% 55% at 75% 55%, rgba(134,19,161,.10), transparent 70%), radial-gradient(40% 50% at 60% 70%, rgba(11,159,189,.10), transparent 70%); }
.av9-held2__in { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.25fr); align-items: center; gap: clamp(2rem, 4vw, 3.5rem); }
.av9-h1 { margin-top: .8rem !important; font-size: clamp(2.4rem, 4.6vw, 4.2rem); line-height: 1.02; letter-spacing: -0.04em; }
.av9-held2__lead { margin-top: 1.3rem; color: var(--s7-text); font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.5; max-width: 30rem; }
.av9-links { justify-content: flex-start; }
.av9-held2 .av9-aktion { margin-top: 1.8rem; justify-content: flex-start; padding-left: .8rem; }
.av9-held2 .av9-aktion__marke { display: none; }
.av9-collage { position: relative; aspect-ratio: 1.25 / 1; }
.av9-collage__mac { position: absolute; left: 6%; right: 0; top: 4%; }
.av9-collage__posts { position: absolute; left: -2%; bottom: 2%; display: flex; }
.av9-collage__posts img { width: clamp(5.4rem, 10vw, 8.6rem); border-radius: 10px; box-shadow: 0 18px 36px -14px rgba(0,0,0,.4); }
