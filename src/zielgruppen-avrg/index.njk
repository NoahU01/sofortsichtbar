/* Kopf-Umschalter (Entwicklung) */
.av9-schalter { position: fixed; left: 50%; bottom: 1.2rem; z-index: 60; display: flex; align-items: center; gap: .3rem; padding: .35rem .4rem .35rem .9rem; border-radius: 99px; background: rgba(29,29,31,.92); color: #fff; font-size: .85rem; font-weight: 600; transform: translateX(-50%); box-shadow: 0 12px 30px rgba(0,0,0,.25); }
